  "lorePages": [
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-1",
      "categoryId": "odyssey-lore-category-epic",
      "title": "The Poem’s Two Temporal Layers",
      "body": "Books 1–8 and 13–24 follow the final return; Books 9–12 are Odysseus’s retrospective account at Scheria.",
      "tags": [],
      "coverImageId": "odyssey-image-art-homecoming",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-020"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-2",
      "categoryId": "odyssey-lore-category-epic",
      "title": "Nostos",
      "body": "Homecoming means more than arrival: identity, household authority, kinship, and civic order must all be restored.",
      "tags": [],
      "coverImageId": "odyssey-image-art-bow",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-001"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-3",
      "categoryId": "odyssey-lore-category-gods",
      "title": "Athena and Poseidon",
      "body": "The poem balances Athena’s intelligent aid against Poseidon’s elemental obstruction.",
      "tags": [],
      "coverImageId": "odyssey-image-art-athena",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-011"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-4",
      "categoryId": "odyssey-lore-category-gods",
      "title": "Zeus and Responsibility",
      "body": "Divine decisions frame events, yet the poem repeatedly insists that mortals worsen suffering through their own recklessness.",
      "tags": [],
      "coverImageId": "odyssey-image-art-zeus",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-001"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-5",
      "categoryId": "odyssey-lore-category-custom",
      "title": "Xenia",
      "body": "Guest-friendship requires welcome, food, inquiry, gifts, and safe departure; its observance or violation organizes the moral geography.",
      "tags": [],
      "coverImageId": "odyssey-image-art-phaeacia",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-001"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-6",
      "categoryId": "odyssey-lore-category-custom",
      "title": "The Ithacan Household",
      "body": "The palace is an economic, familial, and political institution, not merely a private residence.",
      "tags": [],
      "coverImageId": "odyssey-image-art-suitors",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-001"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-7",
      "categoryId": "odyssey-lore-category-places",
      "title": "Phaeacia",
      "body": "Scheria is a liminal ideal of navigation, song, craft, and hospitality that returns Odysseus to ordinary human society.",
      "tags": [],
      "coverImageId": "odyssey-image-art-alcinous",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-014"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-8",
      "categoryId": "odyssey-lore-category-places",
      "title": "The Underworld",
      "body": "The dead offer prophecy and memory but also expose the poverty of heroic glory after life.",
      "tags": [],
      "coverImageId": "odyssey-image-art-underworld",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-032"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-9",
      "categoryId": "odyssey-lore-category-objects",
      "title": "The Bow and the Bed",
      "body": "The bow proves public mastery; the rooted bed proves private identity and marital knowledge.",
      "tags": [],
      "coverImageId": "odyssey-image-art-bow",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-064"
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-lore-10",
      "categoryId": "odyssey-lore-category-objects",
      "title": "Signs of Recognition",
      "body": "The scar, brooch, dog, orchard trees, and bed each authenticate identity for a different relationship.",
      "tags": [],
      "coverImageId": "odyssey-image-art-eurycleia",
      "linkedEntityIds": [],
      "visibleFromEventId": "odyssey-event-066"
    }
  ],
