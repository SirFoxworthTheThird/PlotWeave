  "characterGoals": [
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-goal-1",
      "characterId": "odyssey-char-odysseus",
      "startEventId": "odyssey-event-011",
      "endEventId": "odyssey-event-068",
      "type": "want",
      "text": "Return to Ithaca, recover his identity, and restore household and civic order."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-goal-2",
      "characterId": "odyssey-char-penelope",
      "startEventId": "odyssey-event-001",
      "endEventId": "odyssey-event-065",
      "type": "need",
      "text": "Protect the household and determine whether the returning stranger is truly her husband."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-goal-3",
      "characterId": "odyssey-char-telemachus",
      "startEventId": "odyssey-event-001",
      "endEventId": "odyssey-event-068",
      "type": "need",
      "text": "Become capable of public judgment and stand beside his father without losing himself in imitation."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-goal-4",
      "characterId": "odyssey-char-athena",
      "startEventId": "odyssey-event-001",
      "endEventId": "odyssey-event-068",
      "type": "want",
      "text": "Bring the homecoming to completion through intelligence, restraint, and controlled force."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-goal-5",
      "characterId": "odyssey-char-poseidon",
      "startEventId": "odyssey-event-020",
      "endEventId": "odyssey-event-043",
      "type": "want",
      "text": "Make Odysseus’s journey long, solitary, and painful in answer to Polyphemus."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-goal-6",
      "characterId": "odyssey-char-antinous",
      "startEventId": "odyssey-event-001",
      "endEventId": "odyssey-event-063",
      "type": "want",
      "text": "Eliminate Telemachus and convert occupation of the palace into kingship."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-goal-7",
      "characterId": "odyssey-char-eumaeus",
      "startEventId": "odyssey-event-044",
      "endEventId": "odyssey-event-063",
      "type": "want",
      "text": "Serve the absent household faithfully and protect the stranger entrusted to him."
    }
  ],
  "plotThreads": [
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-homecoming",
      "name": "The Return to Ithaca",
      "color": "#4f7284",
      "description": "Every voyage, disguise, recognition, and act of endurance converges on restoring home."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-telemachy",
      "name": "Telemachus Comes of Age",
      "color": "#7a8d55",
      "description": "The son searches for news, claims public speech, escapes murder, and fights beside his father."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-suitors",
      "name": "The Occupied Household",
      "color": "#924d48",
      "description": "The suitors consume the estate, pressure Penelope, and plot against Telemachus."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-hospitality",
      "name": "Hospitality Tested",
      "color": "#a47c4b",
      "description": "Hosts and guests reveal moral character from Pylos and Scheria to the Cyclops and the palace."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-poseidon",
      "name": "Poseidon’s Anger",
      "color": "#45678f",
      "description": "The Cyclops’s prayer converts a local escape into prolonged divine persecution."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-identity",
      "name": "Disguise and Recognition",
      "color": "#7b5d85",
      "description": "Names, clothing, scars, stories, songs, and the olive bed establish who can truly know Odysseus."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-crew",
      "name": "The Loss of the Crew",
      "color": "#6c665e",
      "description": "Indiscipline, hunger, and failures of command reduce twelve ships to one survivor."
    },
    {
      "worldId": "odyssey-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "odyssey-thread-divine",
      "name": "Divine Justice and Human Choice",
      "color": "#a88939",
      "description": "The gods constrain events, but mortals remain responsible for appetite, loyalty, and violence."
    }
  ],
