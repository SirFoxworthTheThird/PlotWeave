      "id": "time-machine-relationship-2",
      "characterAId": "time-machine-char-traveller",
      "characterBId": "time-machine-char-weena",
      "label": "Protector and companion",
      "strength": "strong",
      "sentiment": "positive",
      "description": "Rescue grows into mutual trust; Weena gives affection while the traveller gives protection and care.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
