      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 19,
      "title": "Book the Second — The Golden Thread: The Fellow of No Delicacy",
      "synopsis": "Carton confesses that Lucie awakens his last dream of a better life and promises he would sacrifice anything for her or anyone dear to her.",
      "notes": "",
      "wordGoal": null
    },
