  "timelines": [
    {
      "id": "tale-of-two-cities-timeline-main",
      "worldId": "tale-of-two-cities-world",
      "name": "London and Paris, 1775–1793",
      "description": "One chronological reading timeline across all three books. The Bastille manuscript remains attached to the chapter in which it is read and is explicitly flagged as a flashback.",
      "color": "#805746",
      "dayOffset": 0,
      "createdAt": 1786377600000
    }
  ],
  "chapters": [
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-001",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 1,
      "title": "Book the First — Recalled to Life: The Period",
      "synopsis": "England and France enter 1775 convinced their institutions are permanent while violence and inequality deepen beneath them.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-002",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 2,
      "title": "Book the First — Recalled to Life: The Mail",
      "synopsis": "Lorry and wary strangers walk beside the coach while mud, darkness, and fear of highwaymen slow the ascent. Jerry reaches the mail with “Wait at Dover for Mam’selle,” and Lorry answers “Recalled to life.”",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-003",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 3,
      "title": "Book the First — Recalled to Life: The Night Shadows",
      "synopsis": "Inside the coach, Lorry imagines digging a white-haired prisoner from an eighteen-year grave.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-004",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 4,
      "title": "Book the First — Recalled to Life: The Preparation",
      "synopsis": "At the Royal George, Lorry tells Lucie that the father she believed dead has been released in Paris.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-005",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 5,
      "title": "Book the First — Recalled to Life: The Wine-shop",
      "synopsis": "A cask breaks outside the Defarge wine-shop and hungry neighbours scoop wine from the mud. Defarge takes Lucie and Lorry above the shop while three Jacques peer at the prisoner as a revolutionary exhibit.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-006",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 6,
      "title": "Book the First — Recalled to Life: The Shoemaker",
      "synopsis": "In the locked garret, Manette answers to One Hundred and Five, North Tower and works at a lady’s shoe. Lucie’s hair and voice connect the daughter before him with the wife and keepsake he remembers.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-007",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 7,
      "title": "Book the Second — The Golden Thread: Five Years Later",
      "synopsis": "Five years later Jerry and his son occupy the bank’s narrow public threshold while business passes around them.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-008",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 8,
      "title": "Book the Second — The Golden Thread: A Sight",
      "synopsis": "Barsad and Cly identify Darnay as a French agent while Lucie and Manette reluctantly recall the Channel crossing.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-009",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 9,
      "title": "Book the Second — The Golden Thread: A Disappointment",
      "synopsis": "Carton directs Stryver to the resemblance that makes the witnesses’ identification uncertain.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-chapter-010",
      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 10,
      "title": "Book the Second — The Golden Thread: Congratulatory",
      "synopsis": "After the acquittal Carton studies the man he resembles and resents the life that resemblance reflects back at him.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "tale-of-two-cities-world",
