  "lorePages": [
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-1",
      "categoryId": "tale-of-two-cities-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The example follows all three books and forty-five chapters of the public-domain Project Gutenberg text. Visuals link to mature period engravings by Fred Barnard and Hablot K. Browne (“Phiz”) on Wikimedia Commons and Project Gutenberg. The route, London, and Paris layers use linked historical maps rather than decorative scene art.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-cover",
      "linkedEntityIds": [
        "tale-of-two-cities-world"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-001"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-2",
      "categoryId": "tale-of-two-cities-lore-category-history",
      "title": "From 1775 to the Terror",
      "body": "The story begins before the American Revolution and moves through the fall of the Bastille into the French Revolutionary Terror. Exact event dates outside firmly dated public events are editorial reconstruction for a coherent calendar.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-barnard-16",
      "linkedEntityIds": [
        "tale-of-two-cities-map-route"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-001"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-3",
      "categoryId": "tale-of-two-cities-lore-category-history",
      "title": "The Bastille and Prison Memory",
      "body": "Manette’s eighteen years in the Bastille make a destroyed fortress remain active in his habits, authority, and hidden testimony. One Hundred and Five, North Tower becomes both address and identity.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-phiz-6",
      "linkedEntityIds": [
        "tale-of-two-cities-char-manette",
        "tale-of-two-cities-loc-bastille"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-008"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-4",
      "categoryId": "tale-of-two-cities-lore-category-history",
      "title": "Revolutionary Prisons and the Tribunal",
      "body": "La Force and the Conciergerie held prisoners during the Revolution, while extraordinary courts accelerated accusation, judgment, and execution under political pressure.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-barnard-22",
      "linkedEntityIds": [
        "tale-of-two-cities-loc-la-force",
        "tale-of-two-cities-loc-conciergerie",
        "tale-of-two-cities-loc-tribunal"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-038"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-5",
      "categoryId": "tale-of-two-cities-lore-category-society",
      "title": "The Old Bailey and Treason Evidence",
      "body": "The English trial tests recognition, informers, and credibility. Carton’s observation of resemblance creates reasonable doubt without proving Darnay’s movements harmless.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-phiz-11",
      "linkedEntityIds": [
        "tale-of-two-cities-loc-old-bailey",
        "tale-of-two-cities-char-barsad"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-010"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-6",
      "categoryId": "tale-of-two-cities-lore-category-society",
      "title": "Resurrection Men",
      "body": "Before legal medical supply met demand, grave robbers sold bodies for anatomical study. Jerry’s “fishing” literalizes the novel’s language of recalled life while exposing a hidden economy around death.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-barnard-25",
      "linkedEntityIds": [
        "tale-of-two-cities-char-jerry",
        "tale-of-two-cities-loc-st-pancras"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-024"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-7",
      "categoryId": "tale-of-two-cities-lore-category-society",
      "title": "Knitting as Register",
      "body": "Madame Defarge’s textile code turns ordinary public work into durable surveillance. The register joins household craft to political intelligence and makes forgetting impossible.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-barnard-5",
      "linkedEntityIds": [
        "tale-of-two-cities-item-knitted-register",
        "tale-of-two-cities-char-madame-defarge"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-016"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-8",
      "categoryId": "tale-of-two-cities-lore-category-society",
      "title": "Mail, Road, and Channel",
      "body": "The Dover road and Channel crossing connect Tellson’s two houses. Mud, weather, papers, and suspicion make travel time a force in every rescue and arrest.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-phiz-11",
      "linkedEntityIds": [
        "tale-of-two-cities-map-route",
        "tale-of-two-cities-loc-shooters-hill"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-002"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-9",
      "categoryId": "tale-of-two-cities-lore-category-society",
      "title": "Guillotine and Tumbrils",
      "body": "Condemned prisoners travelled by open cart to the execution square. Dickens presents the machine as the endpoint of decisions that crowds and institutions repeatedly choose.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-barnard-4",
      "linkedEntityIds": [
        "tale-of-two-cities-item-guillotine",
        "tale-of-two-cities-item-tumbril"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-057"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-10",
      "categoryId": "tale-of-two-cities-lore-category-themes",
      "title": "Doubling and Chosen Identity",
      "body": "Carton and Darnay look alike but live under different relations to talent, love, inheritance, and responsibility. The final exchange makes likeness a deliberate moral act.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-phiz-12",
      "linkedEntityIds": [
        "tale-of-two-cities-char-carton",
        "tale-of-two-cities-char-darnay"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-012"
    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-lore-page-11",
      "categoryId": "tale-of-two-cities-lore-category-themes",
      "title": "Resurrection and the Golden Thread",
      "body": "Return from prison, empty coffins, acquittals, and substituted identities complicate resurrection. Lucie’s care gives those returns a household in which they can become life rather than spectacle.",
      "tags": [],
      "coverImageId": "tale-of-two-cities-image-barnard-1",
      "linkedEntityIds": [
        "tale-of-two-cities-char-lucie",
        "tale-of-two-cities-char-manette"
      ],
      "visibleFromEventId": "tale-of-two-cities-event-005"
    }
  ],
