      "timelineId": "tale-of-two-cities-timeline-main",
      "number": 31,
      "title": "Book the Third — The Track of a Storm: In Secret",
      "synopsis": "Revolutionary guards identify him as an emigrant aristocrat and send him under escort to La Force. At La Force, aristocratic prisoners greet Darnay with spectral courtesy before his solitary confinement.",
      "notes": "",
      "wordGoal": null
    },
