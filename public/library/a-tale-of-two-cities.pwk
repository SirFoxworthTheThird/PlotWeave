    },
    {
      "worldId": "tale-of-two-cities-world",
      "createdAt": 1786377600000,
      "updatedAt": 1786377600000,
      "id": "tale-of-two-cities-faction-relationship-revolution-estate",
      "factionAId": "tale-of-two-cities-faction-saint-antoine",
      "factionBId": "tale-of-two-cities-faction-evremonde",
      "stance": "adversarial",
      "notes": "The knitted register and burning château answer generations of estate violence."
    },
    {
      "worldId": "tale-of-two-cities-world",
