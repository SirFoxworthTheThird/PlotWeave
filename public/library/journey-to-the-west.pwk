      "eventId": "jw-event-pine-tree-expelled",
      "sortKey": 90001,
      "isAlive": true,
      "currentLocationMarkerId": "jw-location-subhuti-cave",
      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Expels his best student for performing, and forbids him to use his teacher’s name even to save himself.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-010-wukong",
