    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-mountains",
      "chapterId": "jw-chapter-033",
      "timelineId": "jw-timeline-road",
      "title": "Sumeru, Emei, Tai",
      "description": "Silver Horn plays a priest with a broken leg and gets himself carried up the slope on the monkey’s back. Then the mountains come down one at a time — Sumeru shrugged off, Emei shouldered, and Tai, which pins him. The rest of the party is walked away while he is under it.",
      "locationMarkerId": "jw-location-pingding-mountain",
