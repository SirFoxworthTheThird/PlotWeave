    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-tiger-pit",
      "chapterId": "jw-chapter-013",
      "timelineId": "jw-timeline-road",
      "title": "General Yin’s Table",
      "description": "They ride out before the moon has set and go into a pit. The owner is a tiger spirit entertaining a bear lord and a buffalo, and the two attendants are cut open and eaten at the table while the monk is held aside for later. At daybreak an old man cuts the ropes, names the three beasts, and leaves on a white crane.",
      "locationMarkerId": "jw-location-shuangcha-ridge",
      "involvedCharacterIds": [
