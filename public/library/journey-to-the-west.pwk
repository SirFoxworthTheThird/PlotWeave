    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-four-saints-offer",
      "chapterId": "jw-chapter-023",
      "timelineId": "jw-timeline-road",
      "title": "The Widow and Her Three Daughters",
      "description": "A rich house on an empty road, a widow with land in every direction, three daughters, and an offer: stay, marry, and stop walking. Three of them refuse flatly — one sits like stone, one looks at the floor, one says nothing — and the fourth cannot keep still on his chair.",
      "locationMarkerId": "jw-location-four-saints-house",
      "involvedCharacterIds": [
