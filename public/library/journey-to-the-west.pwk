    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-register-struck",
      "chapterId": "jw-chapter-003",
      "timelineId": "jw-timeline-age",
      "title": "The Register of Life and Death",
      "description": "Two summoners rope his sleeping soul and walk it to the Gate of Ghosts. He beats them flat, walks into the Hall of Judgment armed, has the book fetched, finds his own line — soul 1350, stone monkey, three hundred and forty-two years — and strikes out every monkey name on the page with the brush he was handed.",
      "locationMarkerId": "jw-location-underworld-register",
      "involvedCharacterIds": [
        "jw-character-wukong"
      ],
      "mentionedCharacterIds": [],
