    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-polite-offering",
      "chapterId": "jw-chapter-048",
      "timelineId": "jw-timeline-road",
      "title": "A Sacrifice That Answers Back",
      "description": "The offerings have never spoken before. Suspicious, the thing changes the order it usually eats in and reaches for the girl, and gets a rake in the scales for it. What is left behind on the temple floor is two fish-scales the size of dishes.",
      "locationMarkerId": "jw-location-tongtian-river",
