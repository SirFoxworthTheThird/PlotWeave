    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-whose-son",
      "chapterId": "jw-chapter-040",
      "timelineId": "jw-timeline-road",
      "title": "The Bull Demon King’s Son",
      "description": "The weight on his back grows to a thousand catties, so he throws the boy down on a stone — and the demon leaves the empty body behind, rides a whirlwind, and takes the monk out of the saddle. The mountain gods supply the name: Red Boy, Sagely Boy King, three hundred years at the Fiery Mountains learning true fire. Which makes him, by an oath sworn five hundred years ago, the monkey’s nephew.",
      "locationMarkerId": "jw-location-roaring-mountain",
      "involvedCharacterIds": [
