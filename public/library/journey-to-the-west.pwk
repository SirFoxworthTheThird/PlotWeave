      "sortKey": 80001,
      "isAlive": true,
      "currentLocationMarkerId": "jw-location-subhuti-cave",
      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Names the three calamities without softening them, and teaches the transformations as a way of not being found by them.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-009-wukong",
      "characterId": "jw-character-wukong",
      "eventId": "jw-event-pine-tree-expelled",
      "sortKey": 90000,
      "isAlive": true,
      "currentLocationMarkerId": "jw-location-subhuti-cave",
      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Shows off once, is expelled for it, and gives his word never to name the man who taught him — and keeps it for the whole book.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-009-subhuti",
