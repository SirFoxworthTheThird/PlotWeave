    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-cassock-returned",
      "chapterId": "jw-chapter-018",
      "timelineId": "jw-timeline-road",
      "title": "The Cave Burnt, the Robe Back",
      "description": "He fires the Black Wind Cave behind him and brings the cassock back at dusk. What is left of the monastery empties its purse for a thanksgiving, and the party leaves the next morning with one robe, one horse and about two hundred fewer people in the world than when they arrived.",
      "locationMarkerId": "jw-location-guanyin-monastery",
