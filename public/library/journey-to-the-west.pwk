    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-goading",
      "chapterId": "jw-chapter-031",
      "timelineId": "jw-timeline-road",
      "title": "The Lie That Works",
      "description": "The horse tells him to go and say only that their master misses him. On the mountain the monkey hears the plea out politely, feeds him fruit and sends him off — and has him dragged back by the ears for what he says on the road down. So he tries the other thing: the demon swore to skin you. The cliff is empty before he has finished the sentence.",
      "locationMarkerId": "jw-location-ffm-main-peak",
