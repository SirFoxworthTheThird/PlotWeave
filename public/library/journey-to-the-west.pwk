    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-golden-queen",
      "chapterId": "jw-chapter-069",
      "timelineId": "jw-timeline-road",
      "title": "Three Years Since the Dragon-Boat Festival",
      "description": "What comes out of him is a rice dumpling swallowed in terror three years ago, at the Double Fifth, when a demon called Sai Tai Sui came out of the sky and took the Golden Queen out of the pomegranate pavilion — and has come back five times since for pairs of palace maids. The demon-avoiding tower is nine rooms sunk three fathoms under a paving slab with four vats of oil burning in it.",
      "locationMarkerId": "jw-location-zhuzi-kingdom",
      "involvedCharacterIds": [
