    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-great-vehicle",
      "chapterId": "jw-chapter-012",
      "timelineId": "jw-timeline-road",
      "title": "Small Vehicle, Great Vehicle",
      "description": "She interrupts the reading in front of the court: what is being recited cannot raise the dead, and there are three baskets in the west that can. Then she goes up on a cloud in her own shape long enough for a court painter to get it down, and the celebrant offers to go and fetch them.",
      "locationMarkerId": "jw-location-changan-assembly-temple",
