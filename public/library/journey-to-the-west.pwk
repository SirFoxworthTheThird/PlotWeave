    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-divided-plum-blossom",
      "chapterId": "jw-chapter-085",
      "timelineId": "jw-timeline-road",
      "title": "The Divided Plum Blossom Plan",
      "description": "A small demon who fled Lion Camel Ridge tells his king exactly what Sun Wukong is, and then how to beat him: three picked demons in the king’s own armour, one for each disciple, three separate ambushes, and a hand reaching down out of the sky for the man left alone in the saddle. It is the only plan in the book that treats the party as a formation to be broken up.",
      "locationMarkerId": "jw-location-hidden-mist-mountain",
      "involvedCharacterIds": [
        "jw-character-south-mountain-great-king",
        "jw-character-wukong",
        "jw-character-tripitaka",
        "jw-character-zhu-bajie",
