    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-rice-hill-flour-hill",
      "chapterId": "jw-chapter-087",
      "timelineId": "jw-timeline-road",
      "title": "A Chicken, a Dog and a Lamp",
      "description": "A prefecture three years dry, and a proclamation being hung under the eaves as they walk past. Up in the Hall of Diffused Fragrance the answer is on display: a hill of rice ten fathoms high with a fist-sized chicken pecking at it, a hill of flour twenty fathoms high with a lapdog licking, and a gold lock an inch thick with a lamp flame on the shackle. Rain comes when those three are gone.",
      "locationMarkerId": "jw-location-celestial-hall",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-jade-emperor"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "tags": [],
