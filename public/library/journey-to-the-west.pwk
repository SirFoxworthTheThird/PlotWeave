    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-disguises",
      "chapterId": "jw-chapter-027",
      "timelineId": "jw-timeline-road",
      "title": "Girl, Mother, Father",
      "description": "A corpse-spirit comes three times on a bare ridge — a girl with a rice pot full of maggots and toads, then an old woman looking for her, then an old man looking for both — and three times the cudgel comes down. Twice she sheds the body and gets away, and twice a monk sees his disciple murder a civilian on an empty road.",
      "locationMarkerId": "jw-location-white-tiger-ridge",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-white-bone-demon",
        "jw-character-tripitaka",
