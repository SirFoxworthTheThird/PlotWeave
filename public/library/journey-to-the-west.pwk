      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Returns the robe, having burnt two buildings and killed a snake to do it, and expects to be thanked.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
