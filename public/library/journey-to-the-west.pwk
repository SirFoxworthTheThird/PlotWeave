    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-drowned-king",
      "chapterId": "jw-chapter-037",
      "timelineId": "jw-timeline-road",
      "title": "A Wet King at the Door",
      "description": "A dripping figure at the meditation-hall door at the third watch. Three years ago a rainmaking Daoist pushed him down the octagonal glazed well in his own garden, took his face, and has been reigning ever since — over his court, his queen and his son. He leaves a gold-set white jade tablet on the desk as proof and goes to dream the same visit to his wife.",
      "locationMarkerId": "jw-location-baolin-monastery",
      "involvedCharacterIds": [
        "jw-character-wuji-king",
