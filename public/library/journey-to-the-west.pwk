    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-pledged-hair",
      "chapterId": "jw-chapter-042",
      "timelineId": "jw-timeline-road",
      "title": "One Hair for a Pledge",
      "description": "Told that a demon has been wearing her face, she throws the vase into the sea, and a turtle brings it back holding a whole ocean in it — and the monkey who once shook Heaven cannot lift it off the rock. She will not lend it without security, and takes the life-saving hair from the back of his head. He offers her the fillet instead. She declines.",
      "locationMarkerId": "jw-location-heaven-potalaka-annexe",
