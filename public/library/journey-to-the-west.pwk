    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-unkillable",
      "chapterId": "jw-chapter-007",
      "timelineId": "jw-timeline-age",
      "title": "Blade, Fire and Thunder",
      "description": "Tied to the demon-subduing pillar and worked on with everything the court has: sword, axe, spear, sabre, fire and the thunder department’s lightning. Not a mark. Laozi points out why — peaches, wine and elixir have been cooked into him — and asks to have him back for the furnace.",
      "locationMarkerId": "jw-location-celestial-execution-ground",
