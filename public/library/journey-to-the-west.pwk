    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-locked-room-opened",
      "chapterId": "jw-chapter-095",
      "timelineId": "jw-timeline-road",
      "title": "The Door in the Back Wall",
      "description": "A king who has never been outside his own city walls rides sixty li and has the iron lock struck off a door, and holds a filthy, raving daughter without minding the filth. The abbot who defamed her is made Monk Official of the Realm and the monastery is given a name by imperial grant.",
      "locationMarkerId": "jw-location-jetavana-monastery",
