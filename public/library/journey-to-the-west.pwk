    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-trunk-and-the-cudgel",
      "chapterId": "jw-chapter-076",
      "timelineId": "jw-timeline-road",
      "title": "Pull the Nose",
      "description": "He asks for a rope round his own waist and for his brothers to haul him back if he loses, and gets it slackened instead, and trips over the trailing line until a trunk takes him round the middle. Then the same trunk takes his brother, who has hands free, and is led down the slope by the nose with the rake handle beating time behind it.",
      "locationMarkerId": "jw-location-lion-camel-ridge",
      "involvedCharacterIds": [
