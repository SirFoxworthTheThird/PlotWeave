  "factionRelationships": [
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-faction-relationship-heaven-monkeys",
      "factionAId": "jw-faction-heaven",
      "factionBId": "jw-faction-ffm-monkeys",
      "stance": "hostile",
      "notes": "A hundred thousand troops and eighteen nets went to the island, and burnt out everything on it that could not fight back."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-faction-relationship-heaven-vulture-peak",
      "factionAId": "jw-faction-heaven",
      "factionBId": "jw-faction-vulture-peak",
      "stance": "allied",
      "notes": "Heaven sends for the Buddha when its own execution ground fails, and the Buddha lends four vajras when Heaven’s nets are not enough."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-faction-relationship-pilgrims-vulture-peak",
      "factionAId": "jw-faction-pilgrims",
      "factionBId": "jw-faction-vulture-peak",
      "stance": "allied",
      "notes": "The errand is Vulture Peak’s and so are most of the rescues, and the canon is still charged for at the end of it."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-faction-relationship-pilgrims-bull-clan",
      "factionAId": "jw-faction-pilgrims",
      "factionBId": "jw-faction-bull-clan",
      "stance": "hostile",
      "notes": "Three separate feuds — a son converted, a fan stolen twice, and a brother who wants revenge for a nephew who is not dead."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-faction-relationship-lion-camel-vulture-peak",
      "factionAId": "jw-faction-lion-camel-kings",
      "factionBId": "jw-faction-vulture-peak",
      "stance": "complicated",
      "notes": "Two of the three are bodhisattvas’ mounts and the third is the Buddha’s own kin, so the alliance that nearly ends the journey is undone by its owners rather than beaten."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-faction-relationship-dragon-kings-underworld",
      "factionAId": "jw-faction-dragon-kings",
      "factionBId": "jw-faction-underworld",
      "stance": "neutral",
      "notes": "Both petitioned the throne about the same monkey on the same morning, and neither got an army out of it."
    }
  ],
  "knowledgeFacts": [
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-register-struck",
      "title": "The monkeys’ names are struck out of the Register of Life and Death",
      "description": "One visit to the Hall of Judgment with a borrowed brush cancels the deaths of an entire species, and nobody in the underworld can put them back.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-register-struck",
      "originEventId": "jw-event-register-struck"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-furnace-eyes",
      "title": "The furnace gave him eyes that see through a shape",
      "description": "Forty-nine days in the wind corner of the eight-trigram furnace leave him with fiery golden eyes — which is why he is right about every disguise on the road, and why smoke is the one thing that still blinds him.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-furnace",
      "originEventId": "jw-event-furnace"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-fillet-spell",
      "title": "The gold fillet answers to a rhyme",
      "description": "An old woman on a road gives a monk a cap and teaches him a spell, and the band takes root in the skin the first time it is said.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-the-fillet",
      "originEventId": "jw-event-the-fillet"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-scriptures-price",
      "title": "The Buddha will not send the scriptures east himself",
      "description": "A thing carried easily is valued cheaply, so someone has to walk — which is the premise of ninety-two chapters.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-three-baskets",
      "originEventId": "jw-event-three-baskets"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-heaven-clock",
      "title": "A day in Heaven is a year on earth",
      "description": "Stated by the court itself when a missing star officer is found to have been absent four roll-calls, which is thirteen days above and thirteen years below.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-kui-wood-wolf",
      "originEventId": "jw-event-kui-wood-wolf"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-owner-rule",
      "title": "Almost every demon on the road belongs to somebody",
      "description": "A rat from Vulture Peak, a lion of Manjusri’s, an ox of Laozi’s, a goldfish of Guanyin’s: the ones that cannot be beaten are the ones that will be collected.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-marten-taken",
      "originEventId": "jw-event-marten-taken"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-killing-men",
      "title": "Killing men is not a merit, and killing demons is",
      "description": "The ruling Guanyin gives at the lotus throne after the bandits, and the one line in the book that explains both dismissals.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-nowhere-to-go",
      "originEventId": "jw-event-nowhere-to-go"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-six-eared",
      "title": "The Six-Eared Macaque hears everything spoken within a thousand li",
      "description": "Which is how it knew the errand, the passport, the party and the spell — and why every test in Heaven, earth and the underworld came back identical.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-the-species-ends-here",
      "originEventId": "jw-event-the-species-ends-here"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-fan-method",
      "title": "The fire only stays out after forty-nine strokes of the fan",
      "description": "One wave puts it out, two brings wind, three brings rain; forty-nine and it never comes back, which is the only permanent thing anybody does on the road.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-nets-on-four-sides",
      "originEventId": "jw-event-nets-on-four-sides"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-wordless-true",
      "title": "The wordless scrolls were the true scriptures",
      "description": "The blank canon was not a swindle by two servants but the better version, withheld because the eastern continent is not ready to read it.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-three-pecks-of-gold",
      "originEventId": "jw-event-three-pecks-of-gold"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-fact-ordeal-count-fact",
      "title": "The ordeals must come to nine times nine",
      "description": "The register the guardians keep the whole way comes to eighty, so one more disaster is ordered after the journey is already over.",
      "tags": [],
      "readerLearnsAtEventId": "jw-event-the-ledger-of-ordeals",
      "originEventId": "jw-event-the-ledger-of-ordeals"
    }
  ],
