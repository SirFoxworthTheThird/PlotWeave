      "isFlashback": false
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-hauntings",
      "chapterId": "jw-chapter-097",
      "timelineId": "jw-timeline-road",
      "title": "Three Visits Before Dawn",
      "description": "They meet the prefect’s constables on the road carrying the stolen property they had just recovered, and go into the cells with it. So: a voice from inside a coffin calling the widow by her childhood name; an uncle’s portrait on a wall speaking to a nephew at his morning incense; and a foot the size of a courtroom lowered out of the sky over the county bench. Then the old man is fetched back from the ledger of good deeds with twelve more years, and climbs out of his own coffin and asks the officials what they are doing in his house.",
      "locationMarkerId": "jw-location-tongtai",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-kou-hong",
        "jw-character-tongtai-prefect",
        "jw-character-tripitaka",
        "jw-character-dizang",
        "jw-character-kou-wife"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "tags": [],
