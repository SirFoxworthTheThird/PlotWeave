    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-bell-in-the-weeds",
      "chapterId": "jw-chapter-080",
      "timelineId": "jw-timeline-road",
      "title": "Speaking to a Bell",
      "description": "A bell half sunk in a courtyard of moss and frogs, white above from years of rain and blue-green below from the earth. He makes it a small speech about the founder and the caster both being dead, and a caretaker throws a brick at it to answer him. And the monastery is two monasteries: the ruined front given to the bandits who shelter there in bad weather, and a rebuilt back for the monks.",
      "locationMarkerId": "jw-location-zhenhai-monastery",
      "involvedCharacterIds": [
