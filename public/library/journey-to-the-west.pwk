    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-pine-branches",
      "chapterId": "jw-chapter-100",
      "timelineId": "jw-timeline-road",
      "title": "The Pines Turned East",
      "description": "Fourteen years ago he told the monks of his own temple that when the pines in the courtyard turned their heads east he would be coming back. On this morning they have, and the whole house is out of the gate and down the road before any messenger has arrived.",
      "locationMarkerId": "jw-location-changan-hongfu",
      "involvedCharacterIds": [
