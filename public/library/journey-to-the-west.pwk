    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-horse-swallowed",
      "chapterId": "jw-chapter-015",
      "timelineId": "jw-timeline-road",
      "title": "The Stream Takes the Horse",
      "description": "Something comes out of the gorge, takes the white horse whole with the saddle still on it, and goes back under. The luggage has to be carried by hand. Voices in the air name themselves — the Six Ding and Six Jia, the Guardians of the Five Quarters, the Four Sentinels — and say they have been assigned in shifts.",
      "locationMarkerId": "jw-location-eagle-grief-stream",
