    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-wordless-scriptures",
      "chapterId": "jw-chapter-098",
      "timelineId": "jw-timeline-road",
      "title": "Blank Paper for No Present",
      "description": "The two servants in the treasure loft ask what present has been brought and are told there is none. The scrolls loaded on the horse are white from end to end, and it takes a snatched-away bundle and a scattering wind before anybody thinks to open one.",
      "locationMarkerId": "jw-location-scripture-hall",
      "involvedCharacterIds": [
        "jw-character-ananda",
        "jw-character-kasyapa",
