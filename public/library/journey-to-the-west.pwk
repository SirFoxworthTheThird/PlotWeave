    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-borrowed-gold",
      "chapterId": "jw-chapter-011",
      "timelineId": "jw-timeline-road",
      "title": "A Storehouse Borrowed",
      "description": "The wrongly dead block the road and want their lives back. There is a Kaifeng waterseller who has been burning paper money down here for years and has a storehouse of it standing to his name, so the emperor signs a bond against a poor man’s savings, pays the crowd off, and is let through.",
      "locationMarkerId": "jw-location-underworld-city-of-the-wronged",
      "involvedCharacterIds": [
        "jw-character-taizong",
        "jw-character-cui-jue"
