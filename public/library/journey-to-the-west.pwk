    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-two-in-the-trays",
      "chapterId": "jw-chapter-047",
      "timelineId": "jw-timeline-road",
      "title": "Two Monks on Red Trays",
      "description": "The monkey takes the boy’s shape in a moment. The pig takes two attempts and a dropped spell to manage the girl, and his snout will not come right. Carried out to the temple on lacquer trays with gongs and torches in front, his only question is which one the thing eats first.",
