      "id": "jw-character-wukong",
      "name": "Sun Wukong",
      "aliases": [
        "The Handsome Monkey King",
        "Great Sage Equal to Heaven",
        "Pilgrim Sun"
      ],
      "description": "A stone monkey who learned immortality, fought Heaven to a standstill, and spends the rest of the book being right about people his master will not suspect.",
      "portraitImageId": "jw-image-portrait-sun-wukong",
      "color": "#c9803a",
      "tags": [],
      "isAlive": true,
      "birthDate": null
    },
