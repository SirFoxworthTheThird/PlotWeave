    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-question",
      "chapterId": "jw-chapter-038",
      "timelineId": "jw-timeline-road",
      "title": "Three Years of a Cold Bed",
      "description": "He will not believe it until he is sent to ask his mother one question about the last three years, and she has dreamt the same dream at the fourth watch, and she knows the jade tablet by sight. The answer is that the man in her bed has not been her husband since the year the garden was shut.",
      "locationMarkerId": "jw-location-wuji-kingdom",
