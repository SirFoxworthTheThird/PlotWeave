    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-species-ends-here",
      "chapterId": "jw-chapter-058",
      "timelineId": "jw-timeline-road",
      "title": "The Four Monkeys Outside the Ten Kinds",
      "description": "The Buddha names the categories — five immortals, five worms — and then four kinds of monkey that belong to none of them. The Six-Eared Macaque hears every word spoken within a thousand li, which is how it knew everything. The alms bowl comes down over a bee, and is lifted, and the cudgel comes down before anyone can stop it. He says only that it is a pity, and there have been no six-eared macaques since.",
      "locationMarkerId": "jw-location-great-hall",
      "involvedCharacterIds": [
