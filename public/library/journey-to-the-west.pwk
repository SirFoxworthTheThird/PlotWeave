    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-louse-in-the-ear",
      "chapterId": "jw-chapter-049",
      "timelineId": "jw-timeline-road",
      "title": "Carried Down as a Louse",
      "description": "He cannot fight under water, so he has to be carried, and the pig has been waiting for this since the manfruit. What is dropped halfway down is a hair; the real one is a pig-louse in the carrier’s ear, and says so out loud from inside it. A long-legged shrimp-wife points them past the hall to a thing like a stone trough, six feet long, with a man crying in it.",
      "locationMarkerId": "jw-location-tongtian-river-palace",
      "involvedCharacterIds": [
