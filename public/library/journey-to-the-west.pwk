    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-sweeping-the-pagoda",
      "chapterId": "jw-chapter-062",
      "timelineId": "jw-timeline-road",
      "title": "Thirteen Storeys, Swept",
      "description": "Two generations of monks have been beaten to death for a theft they did not commit, and the third is begging in cangues. Three years ago it rained blood at midnight, the pagoda’s light went out, and four tributary kingdoms stopped coming. He vowed at Famen Temple to sweep every pagoda he met, so he takes a broom and starts at the bottom.",
      "locationMarkerId": "jw-location-golden-light-monastery",
      "involvedCharacterIds": [
        "jw-character-tripitaka",
        "jw-character-wukong",
