      "currentMapLayerId": "jw-map-ffm",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Fights the first real fight of his life and wins it by turning his own hair into a crowd, which becomes his standard method.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
