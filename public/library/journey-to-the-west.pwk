    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-cassock-shown",
      "chapterId": "jw-chapter-016",
      "timelineId": "jw-timeline-road",
      "title": "Twelve Chests of Cassocks",
      "description": "The abbot is two hundred and seventy years old and has seven hundred robes in twelve chests, and has them all carried out to be admired. So the disciple opens their own bundle against explicit instructions, and the room fills with light, and an old man who has spent two and a half centuries collecting cloth stops being able to think about anything else.",
      "locationMarkerId": "jw-location-guanyin-monastery",
      "involvedCharacterIds": [
