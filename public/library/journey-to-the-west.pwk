    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-tripitaka-chosen",
      "chapterId": "jw-chapter-012",
      "timelineId": "jw-timeline-road",
      "title": "The Celebrant Chosen",
      "description": "Twelve hundred monks are examined and one is picked: a monk from the womb, the murdered scholar’s son, the chief minister’s grandson, raised in a monastery on a river. The whole of the ninth chapter turns out to have been the appointment papers.",
      "locationMarkerId": "jw-location-changan-assembly-temple",
