      "number": 3,
      "title": "The Four Seas and Thousand Mountains Submit · The Tenth Class of the Nine Dark Regions Is Struck Out",
      "summary": "An armoury is emptied, a dragon king is robbed of the pillar that gauges his sea, and a sleeping soul walks into the underworld and edits the register.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
