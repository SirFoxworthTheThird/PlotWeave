    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-ten-thousand-monks",
      "chapterId": "jw-chapter-096",
      "timelineId": "jw-timeline-road",
      "title": "Nine Thousand Nine Hundred and Ninety-Six",
      "description": "A tiger-seated gate with a board on it saying no monk is turned away. He is sixty-four, vowed at forty to feed ten thousand of them, and keeps a ledger: four short, and four arrive. The house wants them to stay — a wife offers her needlework money for another fortnight, two sons their school allowance for a third — and the answer is that he told an emperor three years and it has been fourteen.",
      "locationMarkerId": "jw-location-kou-mansion",
      "involvedCharacterIds": [
        "jw-character-kou-hong",
