    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-sweet-dew",
      "chapterId": "jw-chapter-026",
      "timelineId": "jw-timeline-road",
      "title": "The Water in the Vase",
      "description": "She writes a reviving character in his palm, has a spring opened under the root, and takes the dew off her willow spray. The leaves come back on the branch. The count of fruit comes to twenty-three, not twenty-two, because the one that sank into the earth has come back with the tree; and the man whose garden was wrecked swears brotherhood with the monkey who wrecked it.",
      "locationMarkerId": "jw-location-wuzhuang-temple",
      "involvedCharacterIds": [
        "jw-character-guanyin",
        "jw-character-zhenyuan",
        "jw-character-tripitaka",
        "jw-character-wukong"
      ],
      "mentionedCharacterIds": [],
