    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-stolen",
      "chapterId": "jw-chapter-024",
      "timelineId": "jw-timeline-road",
      "title": "The Golden Mallet",
      "description": "Bajie hears the boys through the kitchen wall and wants one. The garden god explains the rules — gold mallet, no iron near it, and the fruit sinks into earth the moment it touches the ground — and three come off the tree, one each. Then the boys count the branches, come up four short, and go into the hall to call a monk a thief to his face.",
      "locationMarkerId": "jw-location-wuzhuang-temple",
      "involvedCharacterIds": [
