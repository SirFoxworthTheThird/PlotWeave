    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-well",
      "chapterId": "jw-chapter-038",
      "timelineId": "jw-timeline-road",
      "title": "What the Well Dragon King Kept",
      "description": "Under the plantain in the sealed garden there is a stone lid, and under that a water-crystal palace. The well dragon has kept the body three years with a face-fixing pearl, unspoiled. The pig carries it up on the end of the cudgel complaining the whole way, and works out on the climb that if he presents a corpse, somebody will have to be ordered to raise it.",
      "locationMarkerId": "jw-location-wuji-kingdom",
