    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-master-begs",
      "chapterId": "jw-chapter-072",
      "timelineId": "jw-timeline-road",
      "title": "The One Time He Goes Himself",
      "description": "The house is close enough to call to, so for once he insists on begging the meal himself and his disciples let him. Silk-work and a kickball game in the yard, and past the arbour no rooms at all, only stone benches and cold air; and what comes out of the kitchen is called vegetarian and is human fat and brains. The door is blocked when he stands up.",
      "locationMarkerId": "jw-location-pansi-cave",
      "involvedCharacterIds": [
