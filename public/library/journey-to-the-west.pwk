      "id": "jw-character-tripitaka",
      "name": "Tripitaka",
      "aliases": [
        "Chen Xuanzang",
        "The Tang Monk",
        "River Float"
      ],
      "description": "The pilgrim: a monk of enormous constancy and no discernment at all, who cannot be frightened out of the road and cannot be taught to distrust a woman crying by it.",
      "portraitImageId": "jw-image-portrait-tripitaka",
      "color": "#b8912f",
      "tags": [],
