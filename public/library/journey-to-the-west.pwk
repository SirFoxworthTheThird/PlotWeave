    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-heart-sutra",
      "chapterId": "jw-chapter-019",
      "timelineId": "jw-timeline-road",
      "title": "The Crow’s Nest and the Heart Sutra",
      "description": "A Chan master living in a nest of woven grass in a juniper gives him fifty-four lines against the demons of the road, which he has by heart at one hearing. Then a verse about what is ahead, which the monkey takes as a personal insult and which turns out, eighty chapters later, to have been an itinerary.",
      "locationMarkerId": "jw-location-pagoda-mountain",
