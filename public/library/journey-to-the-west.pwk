    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-chang-an-shrine",
      "chapterId": "jw-chapter-008",
      "timelineId": "jw-timeline-age",
      "title": "Two Scabby Monks in Chang’an",
      "description": "They come into the capital as two mangy travelling monks with a bundle, take a corner of a local shrine, and swear the city’s gods to say nothing. Everything after this — the drowned dragon, the emperor’s tour of the underworld, the Grand Mass — happens with two of them sitting in the city watching it.",
      "locationMarkerId": "jw-location-changan-assembly-temple",
