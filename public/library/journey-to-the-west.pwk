    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-bimawen",
      "chapterId": "jw-chapter-004",
      "timelineId": "jw-timeline-age",
      "title": "Keeper of the Heavenly Horses",
      "description": "The Southern Gate stops him until the Gold Star vouches for him, and then there is a post waiting: the stables, a thousand horses of heaven, and nobody to answer to. For half a heavenly month he does it properly, and the horses have never been fatter.",
      "locationMarkerId": "jw-location-celestial-stables",
