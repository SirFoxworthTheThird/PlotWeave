    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-hanging-thread",
      "chapterId": "jw-chapter-068",
      "timelineId": "jw-timeline-road",
      "title": "Diagnosis by Hanging Thread",
      "description": "The king cannot bear to be looked at by a stranger, so the pulse is taken by thread: three hairs from a tail turned into three golden lines, two fathoms four feet each, tied to the left wrist and passed out through the window. Six pulses are read through them and the diagnosis is fright, grief and longing — two birds parted by a storm, each thinking of the other.",
      "locationMarkerId": "jw-location-zhuzi-kingdom",
      "involvedCharacterIds": [
