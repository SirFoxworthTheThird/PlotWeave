    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-wager",
      "chapterId": "jw-chapter-007",
      "timelineId": "jw-timeline-age",
      "title": "The Wager on the Palm",
      "description": "Thirty-six thunder generals ring him at the door of the throne hall and cannot close. The Buddha comes from Vulture Peak, listens to a demand for the throne, and offers a bet: one somersault out of an open hand. He goes a hundred and eight thousand li, finds five pink pillars at the end of the world, writes his name on the middle one and makes water at its foot.",
      "locationMarkerId": "jw-location-celestial-hall",
      "involvedCharacterIds": [
