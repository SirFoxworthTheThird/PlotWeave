    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-dragon-made-horse",
      "chapterId": "jw-chapter-015",
      "timelineId": "jw-timeline-road",
      "title": "The Third Prince Becomes the Horse",
      "description": "She calls the dragon out by name, takes the pearl from under his throat, and blows on him until he is the exact horse he swallowed. Then, before she goes, she pulls three hairs from the back of the monkey’s head and puts them there for a day when nobody is coming.",
      "locationMarkerId": "jw-location-eagle-grief-stream",
