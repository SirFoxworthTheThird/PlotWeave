    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-a-city-turned-good",
      "chapterId": "jw-chapter-087",
      "timelineId": "jw-timeline-road",
      "title": "The Hills Fall When the City Prays",
      "description": "Three years ago, on the twenty-fifth of the twelfth month, the prefect quarrelled with his wife, overturned the table of offerings to Heaven and called the dog to it — on the one day the Jade Emperor was passing overhead. The remedy is one good thought. Every household in the city burns incense and chants; the rice and the flour go, the shackle breaks, and the rain comes to three feet and forty-two drops.",
      "locationMarkerId": "jw-location-fengxian",
      "involvedCharacterIds": [
        "jw-character-shangguan-prefect",
        "jw-character-wukong",
        "jw-character-tripitaka"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "tags": [],
      "sortOrder": 1,
      "travelDays": 5,
