      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Has been raiding an unarmed troop for years, laughs at the small unarmed thing in front of him, and is cut down with his own scimitar.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
