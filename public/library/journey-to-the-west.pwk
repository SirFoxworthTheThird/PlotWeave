    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-tiger-in-the-hall",
      "chapterId": "jw-chapter-030",
      "timelineId": "jw-timeline-road",
      "title": "The Monk Made a Tiger",
      "description": "The demon walks into court as a handsome son-in-law, apologises charmingly for thirteen years of silence, and explains that the monk is the tiger that carried the princess off. Then he spits a mouthful of water at him and the court watches a monk become a tiger. He is caged in iron in the palace guardroom.",
      "locationMarkerId": "jw-location-precious-elephant-kingdom",
