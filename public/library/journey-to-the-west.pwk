    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-embroidered-ball",
      "chapterId": "jw-chapter-093",
      "timelineId": "jw-timeline-road",
      "title": "The Ball Falls on a Monk",
      "description": "A princess of twenty choosing a husband from a tower by throwing a ball into a crowd — and the ball is aimed. It knocks the pilgrim’s hat crooked and rolls into his sleeve, and a disciple grows three fathoms tall to keep the crowd off it. The plan settled on is to let the wedding proceed: agree, ask that the disciples be summoned to take their leave, and get one of them close enough to see what she is.",
      "locationMarkerId": "jw-location-tianzhu-capital",
      "involvedCharacterIds": [
