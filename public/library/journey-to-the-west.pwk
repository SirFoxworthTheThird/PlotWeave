    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-tiger-vanguard",
      "chapterId": "jw-chapter-020",
      "timelineId": "jw-timeline-road",
      "title": "The Skin on the Stone",
      "description": "A farmer of sixty-one has already told them the scriptures are not hard to fetch, only the road is. On the ridge the wind smells wrong. A tiger stands up on the path, tears its own hide off and throws it over a rock, and while both disciples are beating an empty skin their master is lifted out of the saddle.",
      "locationMarkerId": "jw-location-yellow-wind-ridge",
