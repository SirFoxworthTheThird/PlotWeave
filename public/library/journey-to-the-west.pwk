    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-peaches-eaten",
      "chapterId": "jw-chapter-005",
      "timelineId": "jw-timeline-age",
      "title": "He Eats the Ripe Ones",
      "description": "He sends the attendants out of the gate, hangs his cap and robe on a branch, and works through the oldest trees. Then he does it again every few days, and takes a nap in the branches afterwards at a size small enough not to be seen from the path.",
