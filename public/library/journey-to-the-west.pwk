    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-pre-death-mass",
      "chapterId": "jw-chapter-047",
      "timelineId": "jw-timeline-road",
      "title": "A Funeral for Children Still Alive",
      "description": "Drums in a rich house at night, and it is a mass for the dead said over two children who are in the next room. The Great King of Miraculous Response takes a boy and a girl a year in exchange for the rain, and this year it is the brothers’ turn: a son got at sixty-three, and a niece whose weight in gold has already been offered and refused.",
      "locationMarkerId": "jw-location-chen-village",
