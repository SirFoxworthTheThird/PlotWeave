    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-bajie-taken",
      "chapterId": "jw-chapter-032",
      "timelineId": "jw-timeline-road",
      "title": "The Portrait on a Spear",
      "description": "Sent to scout, he sleeps in the red grass, is woken twice by a woodpecker that is not one, and rehearses his excuse on three boulders standing in for his master and his brothers — who have heard the whole performance. Then the real patrol comes past with a painted likeness of all four of them on a spear, and hooks him out of his coat.",
      "locationMarkerId": "jw-location-pingding-mountain",
      "involvedCharacterIds": [
        "jw-character-zhu-bajie",
