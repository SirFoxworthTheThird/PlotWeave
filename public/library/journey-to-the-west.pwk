    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-melon-patch",
      "chapterId": "jw-chapter-066",
      "timelineId": "jw-timeline-road",
      "title": "A Ripe Melon in a Field of Green",
      "description": "Maitreya sets up a hut and a melon patch on the road. The demon is his own cymbal-striking boy, the wallet is his Human-Seed Bag and the wolf-tooth club is the hammer for the cymbals. A character meaning “forbid” written on a palm keeps the bag shut; a chase across a field ends at the only ripe melon in it; and the first thing he asks about afterwards is the cymbals, which are swept up broken and breathed whole.",
      "locationMarkerId": "jw-location-little-thunderclap",
