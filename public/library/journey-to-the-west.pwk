    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-white-deer",
      "chapterId": "jw-chapter-079",
      "timelineId": "jw-timeline-road",
      "title": "The Old Man of the South Pole’s Mount",
      "description": "The willow grove has no farm in it; the trick is the ninth-forked tree, three turns each way, both hands on the trunk, and the word said three times. The dragon-coiled staff the demon fights with is his master’s walking stick, also stolen. The deer went missing during an unfinished game of chess with the Eastern Flower Emperor, and would have been dead in another minute. The girl behind the stone screen is a white-faced fox, and the king is asked to look at what he took into his bed.",
      "locationMarkerId": "jw-location-willow-slope",
      "involvedCharacterIds": [
        "jw-character-shouxing",
        "jw-character-national-preceptor",
        "jw-character-fox-beauty",
