    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-goose-coops",
      "chapterId": "jw-chapter-078",
      "timelineId": "jw-timeline-road",
      "title": "A Goose Coop at Every Door",
      "description": "Every house on the street has a coop hung with coloured silk, and inside each one a boy between five and seven — some playing, some crying, some asleep, and no girls anywhere. The post-house warden clears the room before he will say it: three years ago a Daoist gave the king a girl of sixteen, and the prescription for what the king has done to himself since needs the hearts of one thousand one hundred and eleven boys.",
      "locationMarkerId": "jw-location-bhiksu-kingdom",
      "involvedCharacterIds": [
        "jw-character-tripitaka",
        "jw-character-wukong",
        "jw-character-zhu-bajie"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "tags": [],
      "sortOrder": 0,
      "travelDays": 183,
