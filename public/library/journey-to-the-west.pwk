    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-four-line-verse",
      "chapterId": "jw-chapter-085",
      "timelineId": "jw-timeline-road",
      "title": "The Four Lines He Had Forgotten",
      "description": "He can recite the Heart Sutra and has forgotten the four lines the Crow’s Nest master gave him with it. The lines say that fear is itself the distance from Vulture Peak: the Buddha is on Vulture Peak, and Vulture Peak is inside your own body. It is the closest thing to a thesis the book states out loud, and it is said by the monkey to the monk.",
      "locationMarkerId": "jw-location-hidden-mist-mountain",
      "involvedCharacterIds": [
        "jw-character-wukong",
