      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-dream-and-chess",
      "chapterId": "jw-chapter-010",
      "timelineId": "jw-timeline-road",
      "title": "Beheaded Over a Chessboard",
      "description": "The dragon kneels in the emperor’s dream and is promised his life, so the emperor keeps his minister at the chessboard all morning to stop him getting to the execution. Wei Zheng nods off over the board at the third quarter of noon, and a head falls out of the clouds into the street outside.",
      "locationMarkerId": "jw-location-changan-daming-palace",
