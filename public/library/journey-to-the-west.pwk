    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-queens-proposal",
      "chapterId": "jw-chapter-054",
      "timelineId": "jw-timeline-road",
      "title": "A Kingdom Offered for a Husband",
      "description": "The whole street claps and calls out that seed has arrived, and the pig clears the road by shaking out his ears. Then the queen, who has dreamt of a gold screen in colour and a jade mirror in light, offers the entire realm: he reigns, she is his consort, and the three disciples get their passport and the road.",
      "locationMarkerId": "jw-location-west-liang",
      "involvedCharacterIds": [
