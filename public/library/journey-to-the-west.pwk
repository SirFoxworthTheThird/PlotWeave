    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-night-of-razors",
      "chapterId": "jw-chapter-084",
      "timelineId": "jw-timeline-road",
      "title": "A Thousand Razors in One Night",
      "description": "Every hair on both arms becomes a small monkey or a sleep-insect, and the cudgel becomes a thousand razors. By dawn the king, the queens, the six palaces, the eunuchs and every ranked official in the capital have been shaved. The chest is opened before the court, and a king with no hair on his head comes down off the throne to ask them to take him as a disciple; and one character of the kingdom’s name is changed — not Destroying but Respecting.",
      "locationMarkerId": "jw-location-dharma-kingdom",
      "involvedCharacterIds": [
        "jw-character-dharma-destroying-king",
        "jw-character-wukong",
