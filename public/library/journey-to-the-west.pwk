    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-cotton-pulled",
      "chapterId": "jw-chapter-070",
      "timelineId": "jw-timeline-road",
      "title": "The Cotton Out of the Bells",
      "description": "Three hundred fathoms of fire in the first bell, three hundred of smoke in the second, three hundred of sand in the third, and it is the sand that kills. She asks for them as a wife’s due and hands them over stopped with cotton. Alone in the flaying pavilion he pulls the cotton out to look, and cannot stop what comes out; the gates go down, the bells go back on the demon’s belt, and the Great Sage spends the night as a fly on the one wall the fire has not reached.",
      "locationMarkerId": "jw-location-qilin-mountain",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-golden-queen",
        "jw-character-sai-tai-sui"
      ],
      "mentionedCharacterIds": [],
