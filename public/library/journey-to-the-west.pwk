    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-false-guanyin",
      "chapterId": "jw-chapter-041",
      "timelineId": "jw-timeline-road",
      "title": "A Bodhisattva on the Cliff",
      "description": "Sent to Potalaka for help, he is met halfway by a Guanyin who takes his story kindly and walks him home — into the Fire Cloud Cave and into an as-you-will leather bag, hung from the rafters beside his master. And the monkey, wearing the Bull Demon King’s face, gets a whole ceremony of filial respect out of the boy before being asked for his own birth-hour.",
      "locationMarkerId": "jw-location-fire-cloud-cave",
