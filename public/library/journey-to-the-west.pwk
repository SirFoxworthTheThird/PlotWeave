    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-a-thousand-eyes",
      "chapterId": "jw-chapter-073",
      "timelineId": "jw-timeline-road",
      "title": "A Thousand Eyes Under His Arms",
      "description": "Seventy tail-hairs become seventy little monkeys with two-pronged staves, and the web is wound up ten catties at a time until seven bushel-sized spiders come out of it. Then the Daoist strips his robe off and a thousand eyes open down both sides of him, pouring gold light that cannot be got out of. A woman in mourning on the hillside names him, and names the one being who can put the light out — who has not left her cave in three hundred years and whose only weapon is a needle forged in her son’s eye.",
      "locationMarkerId": "jw-location-yellow-flower-temple",
      "involvedCharacterIds": [
        "jw-character-pilanpo",
        "jw-character-hundred-eyed-demon",
        "jw-character-wukong",
