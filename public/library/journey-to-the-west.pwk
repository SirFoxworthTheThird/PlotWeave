      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Protects one room and lets two hundred and seventy monks burn their own house down, and finds it funny.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
