  "characterGoals": [
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-wukong-deathless",
      "characterId": "jw-character-wukong",
      "type": "want",
      "text": "Get out from under the Register of Life and Death, by learning, by force, or by ink.",
      "startEventId": "jw-event-fear-of-death",
      "endEventId": "jw-event-register-struck"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-wukong-rank",
      "characterId": "jw-character-wukong",
      "type": "want",
      "text": "Be given a title in Heaven that actually means something.",
      "startEventId": "jw-event-bimawen",
      "endEventId": "jw-event-rank-discovered"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-wukong-fillet",
      "characterId": "jw-character-wukong",
      "type": "want",
      "text": "Have the gold band taken off his head.",
      "startEventId": "jw-event-the-fillet",
      "endEventId": "jw-event-five-holy-ones"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-wukong-temper",
      "characterId": "jw-character-wukong",
      "type": "flaw",
      "text": "He cannot let an insult go, and it costs him the cudgel, the fan, the manfruit tree and his place in the party twice.",
      "startEventId": "jw-event-six-brigands",
      "endEventId": "jw-event-the-four-line-verse"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-tripitaka-scriptures",
      "characterId": "jw-character-tripitaka",
      "type": "want",
      "text": "Reach Vulture Peak and bring three baskets of scripture back to Chang’an.",
      "startEventId": "jw-event-great-vehicle",
      "endEventId": "jw-event-the-passport-returned"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-tripitaka-discernment",
      "characterId": "jw-character-tripitaka",
      "type": "need",
      "text": "Learn to tell a demon from a woman crying beside a road, which he never does.",
      "startEventId": "jw-event-three-disguises",
      "endEventId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-tripitaka-fear",
      "characterId": "jw-character-tripitaka",
      "type": "fear",
      "text": "He is frightened of every noise on the road, and is told at last that the fear is itself the distance from Vulture Peak.",
      "startEventId": "jw-event-famen-temple",
      "endEventId": "jw-event-the-four-line-verse"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-bajie-home",
      "characterId": "jw-character-zhu-bajie",
      "type": "want",
      "text": "Go back to Gao Village, or failing that, to a meal and a bed.",
      "startEventId": "jw-event-rake-and-oath",
      "endEventId": "jw-event-five-holy-ones"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-bajie-luggage",
      "characterId": "jw-character-zhu-bajie",
      "type": "flaw",
      "text": "He proposes selling the horse and dividing the luggage at every reverse, and carries it the whole way anyway.",
      "startEventId": "jw-event-the-goading",
      "endEventId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-sha-sentence",
      "characterId": "jw-character-sha-wujing",
      "type": "want",
      "text": "Work off a sentence of a hundred knives a week and get back on the heavenly rolls.",
      "startEventId": "jw-event-gourd-and-skulls",
      "endEventId": "jw-event-five-holy-ones"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-guanyin-errand",
      "characterId": "jw-character-guanyin",
      "type": "want",
      "text": "Deliver the scriptures east by assembling a party out of four convicted criminals and a monk.",
      "startEventId": "jw-event-three-baskets",
      "endEventId": "jw-event-the-ledger-of-ordeals"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-taizong-debt",
      "characterId": "jw-character-taizong",
      "type": "need",
      "text": "Pay for what he was shown in the underworld, which paper money will not cover.",
      "startEventId": "jw-event-borrowed-gold",
      "endEventId": "jw-event-the-passport-returned"
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-goal-bull-grievance",
      "characterId": "jw-character-bull-demon-king",
      "type": "want",
      "text": "Get satisfaction for a son converted, a wife insulted and a mistress frightened.",
      "startEventId": "jw-event-old-brother",
      "endEventId": "jw-event-nets-on-four-sides"
    }
  ],
  "sceneTexts": [],
  "plotThreads": [
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-scriptures",
      "name": "The Errand",
      "color": "#c2a14e",
      "description": "Three baskets of scripture in the west and a man who has to walk to them, because a thing carried easily is valued cheaply."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-heaven-vs-monkey",
      "name": "Heaven and the Monkey",
      "color": "#c9803a",
      "description": "Seven chapters of a stone monkey being appeased, promoted, fought, burned and finally sat on, and ninety-three of the bill for it."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-master-and-disciple",
      "name": "Master and Disciple",
      "color": "#b8912f",
      "description": "A monk who cannot tell a demon from a widow, a disciple who always can, and the two dismissals and one reconciliation between them."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-fillet",
      "name": "The Gold Fillet",
      "color": "#a8452f",
      "description": "A hat given by an old woman on a road, a rhyme taught to the only person who would use it, and a band that is gone before anyone notices."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-who-owns-the-demon",
      "name": "Whose Beast Is This",
      "color": "#6d8a5f",
      "description": "The book’s standing joke and its actual argument: almost every monster on the road has an owner upstairs who wants it back alive."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-bull-family",
      "name": "The Bull Demon King’s House",
      "color": "#8a4a44",
      "description": "A brotherhood sworn five hundred years ago, and a son, a wife, a mistress and a brother who all remember it differently."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-kingdoms",
      "name": "Kingdoms Set Right",
      "color": "#5f7fa8",
      "description": "A dozen realms passed through and left better than they were found: a drowned king raised, a religion freed, eleven hundred children carried out of a city in one night."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-bajie-appetite",
      "name": "The Luggage and the Appetite",
      "color": "#8f5a4a",
      "description": "The pig eats, complains, proposes selling the horse, and does the two most practical things anybody does on the whole road."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-sha-silence",
      "name": "The One Nobody Listens To",
      "color": "#5a6e78",
      "description": "Sha Wujing says the sensible thing in almost every argument in the book and carries the baggage through all of them."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-tang-emperor",
      "name": "The Emperor’s Debt",
      "color": "#7d6a86",
      "description": "A dragon beheaded over a chessboard, a tour of the underworld, a borrowed storehouse of paper gold, and a Grand Mass that needs a celebrant."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-thread-ordeal-count",
      "name": "Eighty-One Ordeals",
      "color": "#7a6d8f",
      "description": "A register kept the whole way by guardians nobody thanks, and an arithmetic that requires one more disaster after the work is finished."
    }
  ],
  "motifs": [
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-transformation",
      "name": "Changing Shape",
      "color": "#c9803a",
      "description": "Seventy-two changes, thirty-six, and one contest that runs from sparrow to shrine — and the flagpole behind it that gives the shrine away."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-disguise",
      "name": "Wearing Another Face",
      "color": "#7d6a86",
      "description": "A dead abbot, an old mother, a bull, a princess, a bodhisattva: half the fights in the book are won by turning up as somebody the enemy trusts."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-borrowed-treasure",
      "name": "Borrowed Treasures",
      "color": "#b0973f",
      "description": "A gourd, a vase, a bracelet, a bag, a fan, a set of bells — the decisive objects almost always belong to somebody who lent them out or lost them."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-false-buddha",
      "name": "The False Holy Place",
      "color": "#8a7a5e",
      "description": "A cave lit like a temple, a monastery one character short of the real one, three Buddhas on a lamp bridge: the pilgrim’s piety is the standard bait."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-names",
      "name": "Names and Titles",
      "color": "#c2a14e",
      "description": "A register struck through, an office with no rank, four characters on a banner, a gourd that will swallow anything that answers to a name."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-fire",
      "name": "Fire",
      "color": "#a8452f",
      "description": "A furnace that made the eyes, a monastery burnt for a robe, eight hundred li of mountain still alight from bricks kicked out of that same furnace."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-water",
      "name": "Water That Must Be Crossed",
      "color": "#4d6f8a",
      "description": "A river that will not float a feather, one eight hundred li wide, one that freezes on purpose, and a boat with no bottom at the end of them all."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-hunger",
      "name": "Something to Eat",
      "color": "#8f5a4a",
      "description": "Peaches, elixir, manfruit, a fruit shaped like a baby, and a whole book of demons who want the same meal for the same reason."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-motif-mercy-over-death",
      "name": "Taken Alive",
      "color": "#5f8f6a",
      "description": "The book’s quiet rule: a demon with an owner is collected, a demon without one is killed, and the collection is the commoner ending by a long way."
    }
  ],
  "continuitySuppressions": [],
  "writingLogs": [],
  "sceneRevisions": []
}
