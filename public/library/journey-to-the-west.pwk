    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-two-fish-on-watch",
      "chapterId": "jw-chapter-062",
      "timelineId": "jw-timeline-road",
      "title": "Ben-Bo-Er-Ba and Ba-Bo-Er-Ben",
      "description": "A catfish spirit and a snakehead spirit on the thirteenth storey, sent up from Green Wave Pool to watch for a monkey, give the whole thing up in one sitting: the Myriad-Sage Dragon King, his daughter, the nine-headed son-in-law, the relic taken out of the tower, and the Queen Mother’s nine-leaved fungus keeping it warm at the bottom of the pool.",
      "locationMarkerId": "jw-location-golden-light-monastery",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-wan-sheng-dragon-king",
