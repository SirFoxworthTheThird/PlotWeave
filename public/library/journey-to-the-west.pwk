    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-nine-mouths",
      "chapterId": "jw-chapter-090",
      "timelineId": "jw-timeline-road",
      "title": "Nine Mouths, Six Bites",
      "description": "While seven lions hold the two disciples at the wall, the grandsire comes over the tower and carries away six people in six of his nine mouths — the monk, the old king, three princes and the pig — and leaves three mouths empty. In the cave they break willow switches on the monkey’s skull all evening and he does not make a sound, and it is the quiet one who cannot watch it and offers to take a hundred.",
      "locationMarkerId": "jw-location-yuhua",
      "involvedCharacterIds": [
