    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-twelve-red-dates",
      "chapterId": "jw-chapter-073",
      "timelineId": "jw-timeline-road",
      "title": "Twelve Dates and a Milligram",
      "description": "The spiders’ fellow-student poisons four cups of date tea. Served last, the monkey notices that his two dates are black where everyone else’s are red, and says so — and is told to stop being rude to a host and drink it. The other three go down.",
      "locationMarkerId": "jw-location-yellow-flower-temple",
