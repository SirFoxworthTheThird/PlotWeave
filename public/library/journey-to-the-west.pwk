    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-four-and-a-half-myriad",
      "chapterId": "jw-chapter-074",
      "timelineId": "jw-timeline-road",
      "title": "Forty-Eight Thousand Small Demons",
      "description": "The old man on the slope makes him turn handsome before he will answer, and then gives the count: five thousand on each ridge, ten thousand at each road-mouth, five thousand patrolling, ten thousand on the gates, and cooks and woodcutters past counting. Then he vanishes, is caught in the air and called by his personal name, and this time the warning is not an exaggeration.",
      "locationMarkerId": "jw-location-lion-camel-ridge",
