    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-widows-accusation",
      "chapterId": "jw-chapter-097",
      "timelineId": "jw-timeline-road",
      "title": "Four Names Read Off in the Dark",
      "description": "A dozen men who have gambled their inheritances away come over the wall in the rain, and the old man who asks them to leave him something to be buried in is kicked to death. From under the bed his wife says she saw them by the lamp: the monk holding the torch, the pig with the knife, the quiet one carrying out the silver, and the monkey the one who kicked him. Her sons believe her, because she was the only one who looked.",
      "locationMarkerId": "jw-location-kou-mansion",
      "involvedCharacterIds": [
        "jw-character-kou-wife",
        "jw-character-kou-hong"
      ],
      "mentionedCharacterIds": [],
      "involvedItemIds": [],
      "tags": [],
      "sortOrder": 0,
      "travelDays": 5,
      "inWorldTime": 9240,
      "tension": 5,
      "structureBeat": null,
