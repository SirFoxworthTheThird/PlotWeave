    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-wind-stilling-post",
      "chapterId": "jw-chapter-020",
      "timelineId": "jw-timeline-road",
      "title": "Bound to the Wind-Stilling Post",
      "description": "The cave lord will not eat him for three or five days in case the disciples come — a caution the whole rest of the book confirms as sound. The monk is tied to a post in the back garden. Out at the gate the Tiger Vanguard, who lost his own skin winning him, dies on the rake.",
      "locationMarkerId": "jw-location-yellow-wind-ridge",
