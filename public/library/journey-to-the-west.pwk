    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-two-plates-of-buns",
      "chapterId": "jw-chapter-055",
      "timelineId": "jw-timeline-road",
      "title": "Meat Filling and Bean Paste",
      "description": "She offers both trays and he takes the vegetarian one; she asks why he split neither, and turns his own week on the Motherhood River against him in a joke. He answers in a couplet and keeps his belt tied, and that is the whole fight, which he wins.",
      "locationMarkerId": "jw-location-pipa-cave",
