    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-islands",
      "chapterId": "jw-chapter-026",
      "timelineId": "jw-timeline-road",
      "title": "Three Islands, No Cure",
      "description": "The bargain is a living tree for four freed prisoners, and three days to find the method. The Star of Longevity and his brothers on Penglai have nothing for a tree; nor has the Lord of the East at Fangzhang; nor the Nine Elders of Yingzhou. He comes back on the third day with an empty gourd and one idea left.",
      "locationMarkerId": "jw-location-wuzhuang-temple",
