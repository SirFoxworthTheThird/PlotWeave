    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-no-star-is-missing",
      "chapterId": "jw-chapter-051",
      "timelineId": "jw-timeline-road",
      "title": "Heaven Counted, and All Present",
      "description": "For once the roll-call comes back complete. Every lodge, every luminary, nobody down on earth without leave. Whatever has taken the cudgel is not a runaway from Heaven, which is the first time in the book that answer has come back, and the Jade Emperor lets him choose his own troops instead.",
      "locationMarkerId": "jw-location-celestial-hall",
