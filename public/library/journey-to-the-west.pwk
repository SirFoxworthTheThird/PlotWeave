    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-buddha-will-not-say",
      "chapterId": "jw-chapter-052",
      "timelineId": "jw-timeline-road",
      "title": "The Buddha Knows and Will Not Tell",
      "description": "He knows exactly what the thing is and declines to say so, on the ground that a name said here would bring it here, and then it would be Vulture Peak’s problem. What he sends instead is eighteen arhats with eighteen grains of golden sand — and two of them are told privately where to send the monkey when the sand is taken as well.",
      "locationMarkerId": "jw-location-great-hall",
