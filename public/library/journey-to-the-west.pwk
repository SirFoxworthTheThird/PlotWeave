    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-goats",
      "chapterId": "jw-chapter-091",
      "timelineId": "jw-timeline-road",
      "title": "Three Rams for Three Yangs",
      "description": "Four men driving three sheep down the west slope shouting a word that means the tai hexagram opening: the Year, Month, Day and Hour officers, arranging three yangs to break his master’s run of ill luck. They also supply the identification — three rhinoceroses a thousand years old, who have loved sweet-gum oil since they were young, in a cave hung with three banners.",
      "locationMarkerId": "jw-location-green-dragon-mountain",
