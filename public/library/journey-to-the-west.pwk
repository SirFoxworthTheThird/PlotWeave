    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-pecks-of-gold",
      "chapterId": "jw-chapter-098",
      "timelineId": "jw-timeline-road",
      "title": "Sold Too Cheap Already",
      "description": "He is not angry about the gratuity. Scripture is not given free: monks once recited these at a rich man’s house in Sravasti for three pecks and three pints of gold, and he told them they had sold it too cheap. And the wordless scrolls, he adds, were the true ones — the east is simply not ready for them. The only thing the party owns worth giving is the purple-gold begging bowl an emperor put into their hands at the gate of Chang’an.",
      "locationMarkerId": "jw-location-great-hall",
      "involvedCharacterIds": [
        "jw-character-buddha",
        "jw-character-tripitaka",
        "jw-character-ananda",
        "jw-character-wukong"
      ],
