    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-firefly",
      "chapterId": "jw-chapter-092",
      "timelineId": "jw-timeline-road",
      "title": "A Firefly in the First Month",
      "description": "He sees a light in the dark and says the season is wrong for fireflies — the insects have only just begun to stir — and it answers him in his disciple’s voice. The lock comes open under a hand and they are nearly out when the watch is woken, and the fighting goes out through several doors with one of them left chained behind it.",
      "locationMarkerId": "jw-location-mysterious-yin-cave",
