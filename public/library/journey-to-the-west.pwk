    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-a-heap-of-hearts",
      "chapterId": "jw-chapter-079",
      "timelineId": "jw-timeline-road",
      "title": "A Heap of Hearts, and Not One Black",
      "description": "Wearing his master’s face, he opens his own belly on the throne-room floor and the hearts roll out and are named one by one: red, white, yellow, greedy, ambitious, jealous, calculating, competitive, arrogant, murderous, fearful. Every kind but a black one. Then he offers, very politely, to fetch the State Preceptor’s instead.",
      "locationMarkerId": "jw-location-bhiksu-kingdom",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-national-preceptor",
        "jw-character-bhiksu-king"
      ],
      "mentionedCharacterIds": [],
