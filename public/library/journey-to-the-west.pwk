    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-mass-decreed",
      "chapterId": "jw-chapter-012",
      "timelineId": "jw-timeline-road",
      "title": "The Grand Mass of Land and Water",
      "description": "What he saw below cannot be paid off with paper money, so a Grand Mass for the Dead is decreed. A minister petitions against the whole Buddhist establishment as a foreign import and is overruled in open court, and the empire is searched for a celebrant.",
      "locationMarkerId": "jw-location-changan-assembly-temple",
