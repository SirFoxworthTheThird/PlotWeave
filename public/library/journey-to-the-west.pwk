    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-yin-yang-vase",
      "chapterId": "jw-chapter-075",
      "timelineId": "jw-timeline-road",
      "title": "Thirty-Six Bearers for a Two-Foot Vase",
      "description": "Two feet four inches high, and it takes thirty-six demons to carry, one for each star of the Dipper’s tally. Inside it is cool, until he says so out loud, and then it is fire, forty snakes and three fire dragons. Burned at the ankle and crying, he remembers the three hairs put into the back of his head at Coiled Snake Mountain, and makes a diamond drill, a bamboo bow and a cord out of them.",
      "locationMarkerId": "jw-location-lion-camel-cave",
