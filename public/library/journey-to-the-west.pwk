  "timelines": [
    {
      "id": "jw-timeline-age",
      "worldId": "journey-to-the-west-world",
      "name": "The Age of the Monkey",
      "description": "Four centuries in eight chapters: a stone monkey born on an island, taught in the west, promoted twice by a court that wanted him quiet, and pinned under a mountain for five hundred years — and the recruiting trip Guanyin makes east while he is still under it.",
      "color": "#c9803a",
      "dayOffset": 0,
      "createdAt": 1788393600000
    },
    {
      "id": "jw-timeline-road",
      "worldId": "journey-to-the-west-world",
      "name": "The Journey West",
      "description": "Chang’an to Vulture Peak and back: a murdered scholar’s son, an emperor’s debt, a rescript issued in the thirteenth year of Zhenguan and handed back in the twenty-seventh.",
      "color": "#c2a14e",
      "dayOffset": 0,
      "createdAt": 1788393600000
    }
  ],
