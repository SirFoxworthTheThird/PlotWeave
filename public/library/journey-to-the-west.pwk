    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-reading-the-passport",
      "chapterId": "jw-chapter-057",
      "timelineId": "jw-timeline-road",
      "title": "Reading the Passport Aloud",
      "description": "Something with the monkey’s face knocks the master down on the road for a cup of water and takes the two blue-felt bundles. On the mountain it is on the stone terrace reading the travel-rescript over and over, with its own Tripitaka, its own pig and its own Sand Monk standing ready. The real Sand Monk kills the imitation of himself and finds it is a monkey.",
      "locationMarkerId": "jw-location-ffm-water-curtain-cave",
