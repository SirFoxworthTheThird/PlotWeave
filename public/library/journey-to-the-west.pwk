    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-old-brother",
      "chapterId": "jw-chapter-060",
      "timelineId": "jw-timeline-road",
      "title": "Two Old Brothers on a Cliff",
      "description": "The local god of the burning mountain turns out to be the demoted furnace-keeper: the bricks kicked out of the eight-trigram furnace fell here still lit and have burned for five hundred years, so the fire is the monkey’s own. And the ox has a second wife two years old with a million in property, and greets his sworn brother of five hundred years with a list: my son, my wife, my mistress.",
      "locationMarkerId": "jw-location-thunder-heap-mountain",
      "involvedCharacterIds": [
