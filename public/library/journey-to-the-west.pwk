    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-kui-wood-wolf",
      "chapterId": "jw-chapter-031",
      "timelineId": "jw-timeline-road",
      "title": "Four Roll-Calls Missed",
      "description": "He takes the demon’s two children hostage, sits in the cave in the princess’s shape weeping until the thing offers up its own inner elixir to cure her heartache, and swallows it. Then Heaven counts the twenty-eight lodges and finds twenty-seven: Kui Wood Wolf has been absent four roll-calls, which is thirteen days above and thirteen years below.",
      "locationMarkerId": "jw-location-celestial-hall",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-jade-emperor",
