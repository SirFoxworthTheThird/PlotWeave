    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-four-dragons-shown",
      "chapterId": "jw-chapter-045",
      "timelineId": "jw-timeline-road",
      "title": "A King Who Has Never Seen a Dragon",
      "description": "The Daoists claim the rain was theirs and merely late. So the test becomes whether either side can call the dragons down where a court can look at them, and four of them come and circle the throne hall in the air until the king has had enough.",
      "locationMarkerId": "jw-location-cart-slow-kingdom",
