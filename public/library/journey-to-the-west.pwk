      "currentMapLayerId": "jw-map-ffm",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Comes out of the stone able to walk, bow to the four quarters and eat, and does all three within the hour.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-001-jade-emperor",
