      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Stops being a prince under sentence and becomes transport, and does not speak again for fifteen chapters.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
