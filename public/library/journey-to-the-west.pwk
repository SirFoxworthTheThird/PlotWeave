    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-nets-on-four-sides",
      "chapterId": "jw-chapter-061",
      "timelineId": "jw-timeline-road",
      "title": "Four Vajras and Nowhere to Run",
      "description": "Swan and gyrfalcon, hawk and black phoenix, crane and vermilion phoenix, musk deer and hungry tiger, leopard and lion, bear and elephant — and then a white ox a thousand fathoms long and a monkey grown to match it. North, south, east and west each has a diamond-guardian sent from Vulture Peak, and above them Li Jing and his son. Ten heads are cut off and ten grow back until a fire-wheel is hung on the horns.",
      "locationMarkerId": "jw-location-thunder-heap-mountain",
      "involvedCharacterIds": [
