      "timelineId": "jw-timeline-age",
      "number": 4,
      "title": "Appointed Keeper of Horses, His Heart Is Not Content · Named Equal to Heaven, His Mind Is Not Still",
      "summary": "Heaven offers a job with no rank, gets a wrecked stable and a banner in reply, and then offers a title with no duties.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
