    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-yang-farm",
      "chapterId": "jw-chapter-056",
      "timelineId": "jw-timeline-road",
      "title": "Sleeping in the Robbers’ House",
      "description": "An old man of seventy-four gives them beds, and in the night his son comes home hungry with the rest of the gang, sees a white horse in the yard, and starts sharpening knives in the kitchen. The old man walks his guests out of his own back gate in the dark and points them at the road.",
      "locationMarkerId": "jw-location-yang-farm",
