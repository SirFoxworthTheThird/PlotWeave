      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Walks the monk to the frontier, sees the mountain split, and goes home.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-064-wukong",
      "characterId": "jw-character-wukong",
      "eventId": "jw-event-six-brigands",
