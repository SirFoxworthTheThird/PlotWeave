    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-come-and-fetch-me",
      "chapterId": "jw-chapter-068",
      "timelineId": "jw-timeline-road",
      "title": "Medicine Is Not Hawked",
      "description": "A king three years sick and a proclamation under the drum tower calling for a physician. He takes the notice invisibly, tucks it into the sleeping pig’s robe, and walks back to the hostel to wait. When the guards find it they are told the terms: medicine is not hawked and a doctor is not sought out, so the court must come to him. It does.",
      "locationMarkerId": "jw-location-zhuzi-kingdom",
      "involvedCharacterIds": [
