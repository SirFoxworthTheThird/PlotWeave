    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-promise-at-the-mountain",
      "chapterId": "jw-chapter-008",
      "timelineId": "jw-timeline-age",
      "title": "A Promise at the Mountain",
      "description": "The mountain has a voice under it. He can speak and eat and nothing else, and has been doing both for five hundred years. She offers the road west and the discipline that comes with it, and finds when she asks his name that it already carries the generation word of the school she is recruiting for.",
      "locationMarkerId": "jw-location-five-phases-mountain",
