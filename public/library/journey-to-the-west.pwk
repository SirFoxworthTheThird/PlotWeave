    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-buddhas-on-the-bridge",
      "chapterId": "jw-chapter-091",
      "timelineId": "jw-timeline-road",
      "title": "Three Buddhas Come Down to the Lamps",
      "description": "Two hundred and forty households are assessed for the lamp oil: five hundred catties a vat, three vats, sweet-gum oil at thirty-two taels the catty, and by the third night it is gone and the people say the Buddhas took it. The wind rises before the third watch and the whole prefecture runs. The one man who walks towards it is on the bridge bowing when the lights go out.",
      "locationMarkerId": "jw-location-golden-lamp-bridge",
      "involvedCharacterIds": [
