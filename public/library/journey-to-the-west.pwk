    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-dismissal",
      "chapterId": "jw-chapter-027",
      "timelineId": "jw-timeline-road",
      "title": "The Letter of Dismissal",
      "description": "The third blow leaves a heap of bones with a name lettered along the spine, and it changes nothing, because the fat one still says it is a trick. The letter is written on a stone by the stream. He makes three doubles of himself so his master has to accept the bow from four sides at once, and then goes.",
      "locationMarkerId": "jw-location-white-tiger-ridge",
      "involvedCharacterIds": [
        "jw-character-tripitaka",
        "jw-character-wukong",
