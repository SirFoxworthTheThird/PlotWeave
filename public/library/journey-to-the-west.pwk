    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-nine-sons",
      "chapterId": "jw-chapter-043",
      "timelineId": "jw-timeline-road",
      "title": "Nine Sons, Each Different",
      "description": "The river god, dispossessed a year ago, names the demon’s uncle. The black-carp courier is intercepted on the road and the invitation read: the West Sea Dragon King’s birthday, and steamed monk to warm the table. The demon is the ninth son of the dragon whose head fell into a Chang’an street, and the other eight hold rivers, bells, roof-ridges and one of the pillars of Heaven.",
      "locationMarkerId": "jw-location-black-water-river",
      "involvedCharacterIds": [
