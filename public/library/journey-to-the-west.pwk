    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-baskets",
      "chapterId": "jw-chapter-008",
      "timelineId": "jw-timeline-age",
      "title": "Three Baskets for the East",
      "description": "The Buddha weighs the four continents out loud and finds the eastern one full of greed, killing and lawsuits, and beyond preaching to at a distance. There are three baskets of scripture that would answer it, and they will not be carried east by anyone who has not walked. He asks who will go and find the man to walk.",
      "locationMarkerId": "jw-location-great-hall",
      "involvedCharacterIds": [
        "jw-character-buddha",
        "jw-character-guanyin"
      ],
