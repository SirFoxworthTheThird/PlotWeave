    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-three-fights-in-water",
      "chapterId": "jw-chapter-022",
      "timelineId": "jw-timeline-road",
      "title": "Three Fights Under the Water",
      "description": "A tablet on the bank gives the width and the warning that a goose feather will not float here. Something comes straight out of the current at the monk. Bajie goes down after it twice and cannot win, and twice the ambush is spoiled by a brother who comes in too early; the third time it will not be drawn out at all.",
      "locationMarkerId": "jw-location-flowing-sands-river",
