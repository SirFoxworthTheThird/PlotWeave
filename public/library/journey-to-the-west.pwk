    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-boy-of-good-wealth",
      "chapterId": "jw-chapter-042",
      "timelineId": "jw-timeline-road",
      "title": "Thirty-Six Blades as a Lotus Throne",
      "description": "Three hundred li cleared of every living thing, the vase upended into a sea, and Nezha’s heaven-net sabres turned into a thousand-petalled seat. The demon takes it for a throne and sits down on the points. Shaved and renamed Sudhana, he picks the spear up again the moment the pain stops — so a gold fillet, the last of the Buddha’s three, goes on his head and his hands and his feet.",
      "locationMarkerId": "jw-location-roaring-mountain",
