    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-trees",
      "chapterId": "jw-chapter-064",
      "timelineId": "jw-timeline-road",
      "title": "A Pine, a Cypress, a Juniper, a Bamboo",
      "description": "The apricot girl comes in late, matches his poem, sits closer and dries his tears with a honey-coloured silk, and the four old men offer to be go-betweens — and the courtesy of the whole night turns out to have been the approach. By daylight the hermitage is a cliff face and the company are trees. The rake goes through all of them, the roots run with blood, and the man who was never harmed asks him to stop.",
      "locationMarkerId": "jw-location-wooden-immortal-hermitage",
      "involvedCharacterIds": [
