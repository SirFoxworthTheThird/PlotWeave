      "number": 6,
      "title": "Guanyin Comes to the Feast and Asks the Reason · The Little Sage Displays His Power",
      "summary": "A hundred thousand troops cannot hold him; the Jade Emperor’s own nephew can, through sparrow, fish, snake and a shrine that forgets its flagpole.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
