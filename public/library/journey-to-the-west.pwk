      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-moksa-loses",
      "chapterId": "jw-chapter-006",
      "timelineId": "jw-timeline-age",
      "title": "Moksa Cannot Hold Him",
      "description": "Fifty or sixty rounds in front of the whole camp, and then his arms go numb and he has to break off. He goes back up the hill to his father’s tent to say so, and the tent sends to Heaven for somebody else.",
      "locationMarkerId": "jw-location-ffm-encampment",
