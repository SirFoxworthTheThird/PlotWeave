      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Would pay any price to be rid of a son-in-law who works his fields, eats too much, and cannot be divorced.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
