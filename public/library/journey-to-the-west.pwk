    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-lawsuit",
      "chapterId": "jw-chapter-083",
      "timelineId": "jw-timeline-road",
      "title": "Bound and Nearly Beheaded by the Defendant",
      "description": "Li Jing has the plaintiff tied and draws the demon-slaying sabre before his son’s blade stops it. Three hundred years ago she stole the Buddha’s incense flowers and candles and was spared instead of killed, and in gratitude she set up their tablets and called them father and brother. And rolling on the floor, the plaintiff will not be untied by anybody but the Heavenly King himself.",
      "locationMarkerId": "jw-location-cloud-tower-palace",
