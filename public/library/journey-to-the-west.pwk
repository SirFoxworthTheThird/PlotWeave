    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-a-needle-for-a-toll",
      "chapterId": "jw-chapter-056",
      "timelineId": "jw-timeline-road",
      "title": "An Embroidery Needle for the Toll",
      "description": "Thirty men with spears across the road, and a monk who cannot lie tells them his disciple is carrying the silver. They give the disciple sixty blows on the skull and he thanks them for the compliment. Then he offers them a needle, plants it in the ground as a pole, invites them to lift it, and kills the two chiefs with it.",
      "locationMarkerId": "jw-location-seven-hundred-li-slope",
