      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Burns his own house to prove he means it, keeps the name Guanyin gave him, and takes a second one about food.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
