    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-white-ring",
      "chapterId": "jw-chapter-050",
      "timelineId": "jw-timeline-road",
      "title": "A Ring That Takes the Cudgel",
      "description": "Behind the yellow curtain is a skeleton with a skull the size of a peck-measure, and three lined waistcoats on the table that turn into ropes when they are put on. Then thirty rounds even at the cave mouth, a compliment on the staffwork, and a bright white circle that comes up out of a sleeve and comes down over the cudgel, and the Great Sage is standing there empty-handed.",
      "locationMarkerId": "jw-location-jindou-mountain",
      "involvedCharacterIds": [
