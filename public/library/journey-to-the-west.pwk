      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Kowtows four times to a man he could kill by accident, takes the road name Pilgrim, and is out.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
