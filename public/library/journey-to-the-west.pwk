    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-fillet",
      "chapterId": "jw-chapter-014",
      "timelineId": "jw-timeline-road",
      "title": "The Cap and the Spell",
      "description": "An old woman on the road gives the monk a cotton robe and a gold-flowered cap and teaches him a rhyme to go with them; then she goes up on a cloud eastward and the disciple, back from a cup of tea and a lecture at the dragon palace, works out who she was too late. The band takes root in the skin the first time the rhyme is said.",
      "locationMarkerId": "jw-location-five-phases-mountain",
      "involvedCharacterIds": [
