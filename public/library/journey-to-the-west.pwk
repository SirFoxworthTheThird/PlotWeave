    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-girl-in-the-cell",
      "chapterId": "jw-chapter-093",
      "timelineId": "jw-timeline-road",
      "title": "A Girl Kept in a Walled-Up Room",
      "description": "The Jetavana, whose ground was bought by covering it in gold bricks and still washes up gold and silver beads after heavy rain. A year ago tonight a wind put a girl on the old foundation who said she was the princess of India, blown out of a moonlit garden. The abbot walled her into a back room with a hole for a bowl and told the monastery she was a demon, and she understood at once and has feigned madness ever since.",
      "locationMarkerId": "jw-location-jetavana-monastery",
      "involvedCharacterIds": [
        "jw-character-hundred-year-abbot",
