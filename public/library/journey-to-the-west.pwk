    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-leopard",
      "chapterId": "jw-chapter-086",
      "timelineId": "jw-timeline-road",
      "title": "An Artemisia-Leaf Leopard",
      "description": "Not a water snake, because his master’s ghost would think ill of a monk turning into something that coils; not a crab, too many legs. A water rat, up the outflow drain, past a small demon laying strips of human flesh out to dry. From the roof beam he listens to the kitchen deciding between chopped with spices, steamed for flavour, boiled to save firewood, or salted to keep — and then a fistful of chewed hair goes into every nose in the hall.",
      "locationMarkerId": "jw-location-linked-ring-cave",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-south-mountain-great-king",
        "jw-character-tripitaka",
