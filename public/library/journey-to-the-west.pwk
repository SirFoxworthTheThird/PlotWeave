    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-severed-head",
      "chapterId": "jw-chapter-056",
      "timelineId": "jw-timeline-road",
      "title": "A Head Carried to the Horse",
      "description": "The pursuers are scattered at sunrise. Then he asks a wounded man which one is old Yang’s son, cuts the head off, and carries it up to the saddle to be thanked for it. The spell is recited a dozen times over, and this time the letter of dismissal is not written, because the master simply refuses to speak to him.",
      "locationMarkerId": "jw-location-seven-hundred-li-slope",
