      "number": 1,
      "title": "The Divine Root Conceives · The Mind Is Cultivated and the Way Is Born",
      "summary": "A stone on a mountain top splits, a monkey comes out of it, and three or five hundred years later he is weeping at his own feast because Yama still governs him.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
