    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-four-screens-of-verse",
      "chapterId": "jw-chapter-094",
      "timelineId": "jw-timeline-road",
      "title": "Four Seasons on a Gold Screen",
      "description": "A son-in-law should not be left standing among the courtiers, so a stool is fetched with some shouting. Then four screens of spring, summer, autumn and winter, painted with poems by court scholars, and the king asks his son-in-law to match the rhymes. He does, in four, and they are set to music the same day.",
      "locationMarkerId": "jw-location-tianzhu-capital",
      "involvedCharacterIds": [
