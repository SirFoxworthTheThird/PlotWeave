    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-rain-wager",
      "chapterId": "jw-chapter-045",
      "timelineId": "jw-timeline-road",
      "title": "Five Signals of a Cudgel",
      "description": "Tiger Power’s five-thunder rite is genuine, which is the problem. So the monkey goes up first and tells the wind, cloud, thunder and rain departments to answer his cudgel rather than the altar. Four command-blocks bring nothing down at all; then a monk sits silent through the Heart Sutra and the city floods.",
      "locationMarkerId": "jw-location-cart-slow-kingdom",
      "involvedCharacterIds": [
