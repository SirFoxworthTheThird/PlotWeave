      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Takes offence at a poem, swings at a tree, and is the only one who notices the verse was about all four of them.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
