      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-letter-to-cui",
      "chapterId": "jw-chapter-010",
      "timelineId": "jw-timeline-road",
      "title": "A Letter for the Underworld",
      "description": "The emperor is dying and everyone knows where he is going. His minister writes a letter to an old colleague — now a judge in the courts below — folds it, and puts it into the imperial sleeve, and tells him to hand it over at the gate.",
      "locationMarkerId": "jw-location-changan-daming-palace",
