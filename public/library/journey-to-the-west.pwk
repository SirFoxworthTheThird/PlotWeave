    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-pill-and-fillet",
      "chapterId": "jw-chapter-017",
      "timelineId": "jw-timeline-road",
      "title": "Guanyin as the Alchemist",
      "description": "She takes the shape of the wolf immortal whose invitation was intercepted; he becomes the larger of the two pills on the tray. The bear swallows him, and the second of the three fillets goes onto a head that cannot get it off. Rather than kill him she keeps him, and gives him a mountain of hers to guard.",
      "locationMarkerId": "jw-location-black-wind-mountain",
      "involvedCharacterIds": [
        "jw-character-guanyin",
        "jw-character-black-bear",
        "jw-character-wukong"
