    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-six-weapons-gone",
      "chapterId": "jw-chapter-051",
      "timelineId": "jw-timeline-road",
      "title": "Six Weapons and a Fire Department",
      "description": "Nezha’s six arms and six weapons multiply to ten thousand and the ring takes all of them. Then fire: fire dragons, fire crows, fire rats, fire horses, and the ring takes those too. Then water — the Yellow River in a jade bowl, which runs off down the valley without ever reaching the cave door.",
      "locationMarkerId": "jw-location-jindou-mountain",
