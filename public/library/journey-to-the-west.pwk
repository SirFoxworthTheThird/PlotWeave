    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-banquet-and-elixir",
      "chapterId": "jw-chapter-005",
      "timelineId": "jw-timeline-age",
      "title": "The Barefoot Immortal’s Face",
      "description": "He meets the Barefoot Immortal on the road, sends him to the wrong hall with a courteous lie, wears his shape past the door, and drinks the banquet dry before a single guest arrives. Then, looking for somewhere to sleep it off, he blunders into Tushita, finds the house empty, and eats five gourds of the finished elixir like roasted beans.",
      "locationMarkerId": "jw-location-yaochi-palace",
      "involvedCharacterIds": [
        "jw-character-wukong",
