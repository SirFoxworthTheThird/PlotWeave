    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-peacocks-brother",
      "chapterId": "jw-chapter-077",
      "timelineId": "jw-timeline-road",
      "title": "The Buddha’s Own Kin",
      "description": "Told the master has been eaten raw overnight, he goes to Vulture Peak to hand the whole errand back and weeps through the audience. The lion is Manjusri’s and the elephant Samantabhadra’s, seven days gone from their mountains. And the roc is the peacock’s brother, and the peacock once swallowed the Buddha whole on the Snow Mountain and was made a bodhisattva instead of killed, because harming her would have been harming his mother. The roc will not come quietly, and settles for the offerings made before every good deed in the four continents.",
      "locationMarkerId": "jw-location-great-hall",
      "involvedCharacterIds": [
        "jw-character-buddha",
        "jw-character-roc-demon",
        "jw-character-wukong",
