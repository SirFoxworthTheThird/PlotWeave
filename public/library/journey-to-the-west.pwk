  "itemSnapshots": [],
  "locationSnapshots": [
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-mountain-sealed",
      "locationMarkerId": "jw-location-five-phases-mountain",
      "eventId": "jw-event-five-phases-mountain",
      "sortKey": 0,
      "status": "Sealed with six gold characters",
      "notes": "Five joined peaks with a paper on the summit, and a local god instructed to feed what is under it iron pellets and molten copper."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-mountain-opened",
      "locationMarkerId": "jw-location-five-phases-mountain",
      "eventId": "jw-event-seal-peeled",
      "sortKey": 1,
      "status": "Open",
      "notes": "The seal has gone up on a scented wind and the mountain has split; the road past the frontier is walkable again."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-monastery-burnt",
      "locationMarkerId": "jw-location-guanyin-monastery",
      "eventId": "jw-event-monastery-burnt",
      "sortKey": 2,
      "status": "Burnt to the walls",
      "notes": "Two hundred and seventy monks set a fire to kill their guests and lost the whole house, the chests and the seven hundred robes."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-tree-down",
      "locationMarkerId": "jw-location-wuzhuang-temple",
      "eventId": "jw-event-tree-toppled",
      "sortKey": 3,
      "status": "The manfruit tree is on the ground",
      "notes": "A tree that fruits thirty times in ten thousand years has been pushed out of the earth by the root, and every fruit on it has sunk."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-tree-restored",
      "locationMarkerId": "jw-location-wuzhuang-temple",
      "eventId": "jw-event-sweet-dew",
      "sortKey": 4,
      "status": "The tree is standing, and counts twenty-three",
      "notes": "A spring under the root and dew off a willow spray have put the leaves back, and the fruit that sank into the earth has come back with it."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-fire-out",
      "locationMarkerId": "jw-location-flaming-mountains",
      "eventId": "jw-event-nets-on-four-sides",
      "sortKey": 5,
      "status": "The fire is out for good",
      "notes": "Forty-nine strokes of the fan, and eight hundred li that have burned for five hundred years will not light again."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-pagoda-relic",
      "locationMarkerId": "jw-location-golden-light-monastery",
      "eventId": "jw-event-nine-headed-consort",
      "sortKey": 6,
      "status": "The relic is back and the name is changed",
      "notes": "The tower has its light again, the stolen fungus is keeping it warm, and the monastery is renamed from Golden Light to Subdued Dragon."
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-location-snapshot-false-monastery-burnt",
      "locationMarkerId": "jw-location-little-thunderclap",
      "eventId": "jw-event-the-melon-patch",
      "sortKey": 7,
      "status": "Burnt behind them",
