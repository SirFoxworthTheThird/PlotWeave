    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-rank-discovered",
      "chapterId": "jw-chapter-004",
      "timelineId": "jw-timeline-age",
      "title": "An Office With No Rank",
      "description": "At a party thrown in his own honour he asks what grade a Bimawen is, and is told cheerfully that it has no grade at all — it is the bottom, the word is a joke, and everyone but him knew. The table goes over, the gate guards are knocked aside, and by nightfall there is a banner on the mountain with a new title on it.",
      "locationMarkerId": "jw-location-celestial-pastures",
