      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Loses the emperor’s horse on the third week and sits down on the bank rather than walk.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-066-wukong",
