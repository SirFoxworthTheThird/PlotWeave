    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-rake-banquet",
      "chapterId": "jw-chapter-089",
      "timelineId": "jw-timeline-road",
      "title": "The Nine-Toothed Rake Banquet",
      "description": "Two wolf-headed couriers on the road with twenty taels for pigs and sheep, planning to pad the bill by two or three for a winter coat. Their faces and their invitation get two of them through the door, with the third playing the livestock dealer come for his last five taels. The rake is set up on the middle table like an altar-piece, and the guest is told he may look at it but not talk about it.",
      "locationMarkerId": "jw-location-tiger-mouth-cave",
      "involvedCharacterIds": [
