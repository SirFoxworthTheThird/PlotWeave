    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-rake-and-oath",
      "chapterId": "jw-chapter-019",
      "timelineId": "jw-timeline-road",
      "title": "The Rake and the Oath",
      "description": "A night of fighting at the cave door, in which the rake is named as Laozi’s own work and not a farm tool. Then one phrase — scripture pilgrim — ends what a night of fighting could not. He throws the rake down, fires his own cave so there is nothing to come back to, kneels, and is given a by-name for the five pungent roots and three forbidden meats.",
      "locationMarkerId": "jw-location-cloud-ladder-cave",
      "involvedCharacterIds": [
