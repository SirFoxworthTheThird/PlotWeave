    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-pagoda",
      "chapterId": "jw-chapter-028",
      "timelineId": "jw-timeline-road",
      "title": "The Light Was Not a Temple",
      "description": "Left alone in a wood while both disciples are out looking for food, he walks toward a golden glitter that he takes for a pagoda, lifts a bamboo curtain, and finds a monster asleep on a stone bed. The stone over the door says Bowyue Cave, Wanzi Mountain. He is tied to the soul-fixing post before either of them gets back.",
      "locationMarkerId": "jw-location-bowyue-cave",
      "involvedCharacterIds": [
