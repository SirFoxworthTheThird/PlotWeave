    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-four-wood-stars",
      "chapterId": "jw-chapter-092",
      "timelineId": "jw-timeline-road",
      "title": "The Four Wood Beasts",
      "description": "The Gold Star names the species — rhinoceroses of seven kinds, one horn, three hairs, two horns, that part water and love to be clean — and names their masters, the four lodges of the twenty-eight whose element is wood. The sight of the four of them alone puts three demon kings back on four hooves. Their horns open a path through the western sea and they run down it, and one of them is a moment too late to be taken alive.",
      "locationMarkerId": "jw-location-mysterious-yin-cave",
      "involvedCharacterIds": [
