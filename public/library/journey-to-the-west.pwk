      "isAlive": true,
      "currentLocationMarkerId": "jw-location-six-brigands-road",
      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Kills the six senses in a single paragraph, is lectured for it, and walks out east in a temper.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-064-tripitaka",
      "characterId": "jw-character-tripitaka",
      "eventId": "jw-event-six-brigands",
      "sortKey": 640001,
      "isAlive": true,
      "currentLocationMarkerId": "jw-location-six-brigands-road",
      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Discovers on the second day what kind of disciple he has been given, and has no way at all of controlling him.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-065-tripitaka",
      "characterId": "jw-character-tripitaka",
