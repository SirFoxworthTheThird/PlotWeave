  "items": [
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-cudgel",
      "name": "The Gold-Banded Cudgel",
      "description": "The iron rod that set the depth of the seas, thirteen thousand five hundred catties, which grows and shrinks to order and lives in an ear when it is not wanted.",
      "iconType": "weapon",
      "imageId": "jw-image-item-gold-banded-cudgel",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-rake",
      "name": "The Nine-Toothed Rake",
      "description": "Five thousand and forty-eight catties of divine ice-iron, made in Heaven for a marshal of the reeds and used ever since on doors, demons and, once, eight hundred li of rotten fruit.",
      "iconType": "weapon",
      "imageId": "jw-image-item-nine-toothed-rake",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-staff",
      "name": "The Demon-Quelling Staff",
      "description": "A moon-laurel branch banded with gold, the same weight as the rake, carried by the quietest of the three.",
      "iconType": "weapon",
      "imageId": "jw-image-item-demon-quelling-staff",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-pilgrim-staff",
      "name": "The Nine-Ring Pilgrim Staff",
      "description": "One of the two things Guanyin sends ahead for the pilgrim: a ringed staff that is not a weapon and is never used as one.",
      "iconType": "tool",
      "imageId": "jw-image-item-nine-ring-staff",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-cassock",
      "name": "The Brocade Cassock",
      "description": "The other: a robe that keeps its wearer out of the three calamities, and which is coveted, stolen, burnt for and returned inside two chapters of its first outing.",
      "iconType": "clothing",
      "imageId": "jw-image-item-brocade-cassock",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-fillet",
      "name": "The Gold Fillet",
      "description": "One of three bands the Buddha gave Guanyin. It goes on under a lie about a nice hat, tightens on a spell, and is the only thing on the road the monkey cannot get off.",
      "iconType": "artifact",
      "imageId": "jw-image-item-golden-fillet",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-rescript",
      "name": "The Travel Rescript",
      "description": "The passport the emperor stamps, carried the whole way, sealed by every kingdom that lets them through, and read back at the end as the record of where they went.",
      "iconType": "document",
      "imageId": "jw-image-item-travel-rescript",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-scriptures",
      "name": "The Scriptures",
      "description": "Five thousand and forty-eight scrolls, one canon exactly, handed over twice — once blank, and once after the alms bowl.",
      "iconType": "artifact",
      "imageId": "jw-image-item-scripture-scrolls",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-alms-bowl",
      "name": "The Purple-Gold Alms Bowl",
      "description": "Put into the pilgrim’s hands by the emperor at the gate of Chang’an, carried for fourteen years, and given up at the last loft as the price of a canon with words in it.",
      "iconType": "container",
      "imageId": "jw-image-item-purple-gold-bowl",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-heart-sutra",
      "name": "The Heart Sutra",
      "description": "Fifty-four lines given away in a nest in a juniper, recited the whole way, and quoted back at the man who learned it whenever he is afraid of a noise.",
      "iconType": "document",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-ginseng-fruit",
      "name": "The Ginseng Fruit",
      "description": "Thirty fruit in ten thousand years from one tree, shaped like a newborn child, which dissolves in earth and cannot be caught in anything but a gold bowl.",
      "iconType": "consumable",
      "imageId": "jw-image-item-ginseng-fruit",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-plantain-fan",
      "name": "The Plantain Fan",
      "description": "A leaf of pure yin from behind Kunlun that puts the Flaming Mountains out — one wave for the fire, two for wind, three for rain, and forty-nine to end it.",
      "iconType": "artifact",
      "imageId": "jw-image-item-banana-leaf-fan",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-purple-gold-bells",
      "name": "The Three Purple-Gold Bells",
      "description": "Three hundred fathoms of fire, three hundred of smoke and three hundred of sand, stopped with cotton and carried on a cord at a demon’s belt.",
      "iconType": "artifact",
      "imageId": "jw-image-item-purple-gold-bells",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-diamond-bracelet",
      "name": "The Diamond Jade Bracelet",
      "description": "Made at the Han Pass and never lost an argument: it swallows any weapon thrown at it, including every weapon in Heaven, and ends up through an ox’s nose.",
      "iconType": "artifact",
      "imageId": "jw-image-item-diamond-bracelet",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-gourd-and-vase",
      "name": "The Gourd and the Jade Vase",
      "description": "Two of Laozi’s five: they take anyone who answers to their own name, and turn them to liquid in an hour and three quarters.",
      "iconType": "artifact",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-yin-yang-vase",
      "name": "The Yin-Yang Vase",
      "description": "Two feet four inches high and thirty-six bearers to carry it, with fire, snakes and three fire-dragons inside — and, after one visit, a hole in the bottom.",
      "iconType": "artifact",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-golden-cymbals",
      "name": "The Golden Cymbals",
      "description": "A pair that seal over a man with no seam, grow when he grows and shrink when he shrinks, and are opened only by a horn driven through the join.",
      "iconType": "artifact",
      "imageId": "jw-image-item-golden-cymbals",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-human-seed-bag",
      "name": "The Human-Seed Bag",
      "description": "An old white cloth wallet that holds however many people are thrown at it, including twenty-eight lodges of Heaven and five dragons.",
      "iconType": "container",
      "imageId": "jw-image-item-human-seed-bag",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-wind-pill",
      "name": "The Wind-Securing Pill",
      "description": "The Buddha left it with Lingji and Lingji sewed it into a collar, and it is why the second fanning does not move him.",
      "iconType": "consumable",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-sleep-insects",
      "name": "The Sleep-Insects",
      "description": "Won off a heavenly king at a guessing game five hundred years ago and kept in a belt since, spent one nostril at a time.",
      "iconType": "consumable",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-gold-bracelets",
      "name": "The Golden Queen’s Bracelets",
      "description": "A pair taken off at the Double Fifth to tie the five-coloured threads, left in a dressing case, and worn up a monkey’s arm as proof.",
      "iconType": "clothing",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-peaches",
      "name": "The Peaches of Immortality",
      "description": "Three thousand six hundred trees in three ranks, ripening at three thousand, six thousand and nine thousand years, and doing something different to whoever eats each rank.",
      "iconType": "artifact",
      "imageId": "jw-image-item-peaches-of-immortality",
      "tags": []
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-item-register",
      "name": "The Register of Life and Death",
      "description": "The book with everything alive written in it, from which one entry — stone monkey, three hundred and forty-two years — is struck out with a borrowed brush.",
      "iconType": "document",
      "imageId": null,
      "tags": []
    }
