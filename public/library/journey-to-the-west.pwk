    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-moon",
      "chapterId": "jw-chapter-036",
      "timelineId": "jw-timeline-road",
      "title": "A Poem About the Moon",
      "description": "Homesick under a full moon in a strange courtyard, he makes a poem about how far away Chang’an is. His disciple answers it with the waxing and waning as a figure for the work — the light gathers, holds, and is spent, and so does everything else — and for once the lesson goes the other way up the ladder.",
      "locationMarkerId": "jw-location-baolin-monastery",
      "involvedCharacterIds": [
        "jw-character-tripitaka",
