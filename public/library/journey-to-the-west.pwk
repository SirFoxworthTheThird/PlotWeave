    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-woodcutter",
      "chapterId": "jw-chapter-032",
      "timelineId": "jw-timeline-road",
      "title": "A Warning From a Woodcutter",
      "description": "A woodcutter on the slope names the mountain, the cave, two demon kings, five treasures between them, and their standing order: catch monks, and eat the one called Tang. Then he is not there, because he was the Day Sentinel, and the warnings from now on come with a name attached.",
      "locationMarkerId": "jw-location-pingding-mountain",
      "involvedCharacterIds": [
