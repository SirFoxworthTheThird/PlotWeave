    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-bedbug",
      "chapterId": "jw-chapter-046",
      "timelineId": "jw-timeline-road",
      "title": "A Bedbug and a Centipede",
      "description": "Fifty tables stacked into a seat, no hands, no ladder, and no moving. Deer Power flicks a hair that becomes a bedbug on the monk’s scalp; the monkey picks it off in mid-air and answers with a seven-inch centipede up Tiger Power’s nose, and a contest of pure stillness is decided by two insects.",
      "locationMarkerId": "jw-location-cart-slow-kingdom",
