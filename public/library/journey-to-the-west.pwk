      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Pays for his supper with the only currency he has, and it works.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
