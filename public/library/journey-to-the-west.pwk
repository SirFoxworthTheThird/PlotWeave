    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-cleansing-spring",
      "chapterId": "jw-chapter-072",
      "timelineId": "jw-timeline-road",
      "title": "Seven Sets of Clothes",
      "description": "The hot spring was the seven immortal maidens’ bathing pool until these took it. He will not fight women in the water, so he turns into a starving hawk and carries every set of clothes off the rack instead. His brother has no such scruple, jumps in as a catfish, slips through their hands until they are worn out, and then stands up in his own shape with the rake and spends the rest of the fight falling over.",
      "locationMarkerId": "jw-location-zhuogou-spring",
      "involvedCharacterIds": [
