    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-ferrywoman",
      "chapterId": "jw-chapter-053",
      "timelineId": "jw-timeline-road",
      "title": "A Ferry Rowed by a Woman",
      "description": "She only smiles when asked where the ferryman is. On the far bank the water is clear and cold and the master drinks half a bowl and the pig finishes it, and within half an hour they are both holding their bellies. An old woman selling tea explains the arrangement: this is the Women’s Kingdom, that was the Motherhood River, and the pig would like to know which side it comes out of.",
      "locationMarkerId": "jw-location-mother-child-river",
