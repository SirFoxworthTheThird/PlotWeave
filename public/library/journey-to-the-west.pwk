    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-golden-bracelet",
      "chapterId": "jw-chapter-070",
      "timelineId": "jw-timeline-road",
      "title": "Her Bracelet on His Arm",
      "description": "A small demon on the road with a gong, a yellow flag and a declaration of war, saying out loud to nobody that Heaven will not stand for what his king is doing; his name is on the tally at his belt, which is just as well. And in the cave the queen has never been touched, because an immortal gave her a five-coloured bridal gown the day she was taken and her whole body has grown needles since. She has left no token behind — but there is a pair of gold bracelets in her dressing case.",
      "locationMarkerId": "jw-location-qilin-mountain",
      "involvedCharacterIds": [
        "jw-character-golden-queen",
        "jw-character-wukong",
        "jw-character-you-lai-you-qu"
