      "sortKey": 650000,
      "isAlive": true,
      "currentLocationMarkerId": "jw-location-five-phases-mountain",
      "currentMapLayerId": "jw-map-route",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is handed the only piece of authority he will ever have over his own disciple, and is not told what it costs.",
      "travelModeId": null
    },
    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-snapshot-065-wukong",
