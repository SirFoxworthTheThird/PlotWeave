    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-pig-in-the-dark",
      "chapterId": "jw-chapter-018",
      "timelineId": "jw-timeline-road",
      "title": "Sitting in the Daughter’s Place",
      "description": "The squire has had a pig for a son-in-law for three years and his daughter shut in the back court for half of one. So the disciple takes her shape, sits in her room, and lets the thing that comes in at dusk talk: a rake of nine teeth, thirty-six transformations, a cave on Fuling Mountain, and a name. Then he shows his own face.",
      "locationMarkerId": "jw-location-gao-village",
      "involvedCharacterIds": [
        "jw-character-wukong",
        "jw-character-squire-gao",
