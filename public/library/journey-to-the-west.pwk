    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-the-court",
      "chapterId": "jw-chapter-029",
      "timelineId": "jw-timeline-road",
      "title": "The Letter Read Aloud",
      "description": "The rescript is stamped and the visit is nearly over when he remembers the letter, and it is read out to the whole court. A king who has punished half his household for losing a daughter puts his face in his sleeve, and then asks which of the assembled generals will go and fetch her, and gets no answer at all.",
      "locationMarkerId": "jw-location-precious-elephant-kingdom",
