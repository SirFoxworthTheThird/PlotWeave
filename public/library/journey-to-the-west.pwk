    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-nine-spirits-summoned",
      "chapterId": "jw-chapter-089",
      "timelineId": "jw-timeline-road",
      "title": "The Grandsire From Bamboo Node Mountain",
      "description": "The grandsire hears the whole story, names all three of them accurately, and says the boy has picked the wrong quarrel — and then brings six lions to settle it anyway. And the two real couriers wake at last, come home to a cold fire and no household, and are kneeling there crying when their king arrives and tries to dash his head on the rock.",
      "locationMarkerId": "jw-location-bamboo-node-mountain",
      "involvedCharacterIds": [
