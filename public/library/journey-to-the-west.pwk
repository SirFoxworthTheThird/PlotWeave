    {
      "worldId": "journey-to-the-west-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "jw-event-in-the-box",
      "chapterId": "jw-chapter-037",
      "timelineId": "jw-timeline-road",
      "title": "Two Inches Tall in a Red Box",
      "description": "The monkey becomes a white hare, takes the prince’s arrow in flight, and leads him to the monastery gate, where the arrow is standing in the threshold and the hare is not there. Inside he is sold a treasure in a red lacquer box that knows fifteen hundred years, and the treasure tells him whose son he is.",
      "locationMarkerId": "jw-location-baolin-monastery",
      "involvedCharacterIds": [
