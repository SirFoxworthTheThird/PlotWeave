,"imageId":"hound-image-paget-5"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-northumberland","mapLayerId":"hound-map-london","linkedMapLayerId":null,"name":"Northumberland Hotel","description":"Sir Henry stays here; boots vanish and the cut-paper warning arrives.","x":650,"y":480,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-8"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-charing-cross","mapLayerId":"hound-map-london","linkedMapLayerId":null,"name":"Charing Cross and Regent Street","description":"The investigators pursue the bearded cab passenger through central London.","x":620,"y":430,"iconType":"landmark","tags":[],"factionId":null,"imageId":"hound-image-paget-12"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-waterloo","mapLayerId":"hound-map-london","linkedMapLayerId":null,"name":"Waterloo Station","description":"Departure point for the journey to Devon.","x":710,"y":295,"iconType":"landmark","tags":[],"factionId":null,"imageId":"hound-image-paget-15"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-cartwright-route","mapLayerId":"hound-map-london","linkedMapLayerId":null,"name":"Hotel Wastepaper Route","description":"Cartwright searches hotel wastepaper for the cut Times page.","x":675,"y":510,"iconType":"custom","tags":[],"factionId":null,"imageId":"hound-image-paget-17"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-moor-gate","mapLayerId":"hound-map-dartmoor","linkedMapLayerId":null,"name":"Moor Gate and Road","description":"The road from the railway enters the guarded Baskerville district.","x":165,"y":180,"iconType":"landmark","tags":[],"factionId":null,"imageId":"hound-image-paget-18"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-hall-portal","mapLayerId":"hound-map-dartmoor","linkedMapLayerId":"hound-map-hall","name":"Baskerville Hall","description":"The ancient Baskerville seat and the investigation’s domestic centre.","x":380,"y":330,"iconType":"castle","tags":[],"factionId":null,"imageId":"hound-image-paget-20"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-merripit","mapLayerId":"hound-map-dartmoor","linkedMapLayerId":null,"name":"Merripit House","description":"Stapleton’s isolated home beside the mire.","x":850,"y":345,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-25"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-grimpen","mapLayerId":"hound-map-dartmoor","linkedMapLayerId":null,"name":"Great Grimpen Mire","description":"A treacherous bog crossed only by a hidden path marked with sticks.","x":950,"y":265,"iconType":"region","tags":[],"factionId":null,"imageId":"hound-image-paget-30"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-tor","mapLayerId":"hound-map-dartmoor","linkedMapLayerId":null,"name":"The Tor","description":"High ground from which the concealed watcher surveys the moor.","x":665,"y":475,"iconType":"landmark","tags":[],"factionId":null,"imageId":"hound-image-paget-31"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-stone-hut","mapLayerId":"hound-map-dartmoor","linkedMapLayerId":null,"name":"Neolithic Stone Hut","description":"Holmes’s concealed base, supplied by Cartwright.","x":620,"y":430,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-34"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-coombe-tracey","mapLayerId":"hound-map-dartmoor","linkedMapLayerId":null,"name":"Coombe Tracey","description":"The town where Laura Lyons lives and works.","x":1060,"y":150,"iconType":"town","tags":[],"faction