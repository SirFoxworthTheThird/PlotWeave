"Summer-house Gate","description":"The gate opening from the yew alley toward the moor.","x":1140,"y":150,"iconType":"landmark","tags":[],"factionId":null,"imageId":"hound-image-paget-23"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-great-hall","mapLayerId":"hound-map-hall","linkedMapLayerId":null,"name":"Great Hall","description":"The sombre central room where Sir Henry takes possession of the estate.","x":620,"y":390,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-19"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-dining-room","mapLayerId":"hound-map-hall","linkedMapLayerId":null,"name":"Dining Room","description":"Meals, plans, and the ancestral portrait bring the mystery into focus.","x":800,"y":410,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-21"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-sir-henry-room","mapLayerId":"hound-map-hall","linkedMapLayerId":null,"name":"Sir Henry’s Room","description":"Sir Henry sleeps here and lends Barrymore a suit later worn by Selden.","x":930,"y":620,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-26"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-watson-room","mapLayerId":"hound-map-hall","linkedMapLayerId":null,"name":"Watson’s Room","description":"Watson hears a woman sobbing and writes reports to Holmes.","x":630,"y":650,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-28"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-barrymore-room","mapLayerId":"hound-map-hall","linkedMapLayerId":null,"name":"Barrymores’ Quarters","description":"The servants conceal their aid to Selden.","x":310,"y":610,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-29"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-loc-portrait-gallery","mapLayerId":"hound-map-hall","linkedMapLayerId":null,"name":"Portrait Gallery","description":"Holmes recognises Stapleton in the face of Hugo Baskerville.","x":445,"y":430,"iconType":"building","tags":[],"factionId":null,"imageId":"hound-image-paget-27"}],"characters":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-holmes","name":"Sherlock Holmes","aliases":[],"description":"The consulting detective who directs the investigation while concealing his own movements on Dartmoor.","portraitImageId":"hound-image-paget-1","color":"#66798c","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-watson","name":"Dr. John Watson","aliases":[],"description":"Holmes’s friend, narrator, and field investigator at Baskerville Hall.","portraitImageId":"hound-image-paget-5","color":"#8b7355","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-sir-henry","name":"Sir Henry Baskerville","aliases":[],"description":"The Canadian-raised heir who returns to claim Baskerville Hall despite threats.","portraitImageId":"hound-image-paget-11","color":"#9b694e","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-mortimer","name":"Dr. James Mortimer","aliases":[],"description":"A country physician and friend of Sir Charles who brings the case to Holmes.","portraitImageId":"hound-image-paget-6","color":"#7c8068","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-sir-charles","name":"Sir Charles Baskerville","aliases":[],"description":"The late baronet whose terror and death initiate the investigation.","portraitImageId":"hound-image-paget-8","color":"#6d625f","tags":[],"isAlive":false,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-stapleton","name":"Jack Stapleton","aliases":[],"description":"A naturalist of the moor, secretly Roger Baskerville and architect of the murders.","portraitImageId":"hound-image-paget-9","color":"#6f8155","tags":[],"isAlive":false,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-beryl","name":"Beryl Stapleton","aliases":[],"description":"Stapleton’s wife, forced to pose as his sister and struggling to warn Sir Henry.","portraitImageId":"hound-image-paget-10","color":"#8f6b76","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-barrymore","name":"John Barrymore","aliases":[],"description":"The Hall’s bearded butler, initially suspected because he secretly aids Selden.","portraitImageId":"hound-image-paget-12","color":"#5d6670","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-mrs-barrymore","name":"Eliza Barrymore","aliases":[],"description":"The housekeeper and Selden’s sister, torn between duty and family loyalty.","portraitImageId":"hound-image-paget-14","color":"#7f625f","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-laura","name":"Laura Lyons","aliases":[],"description":"Frankland’s estranged daughter, manipulated by Stapleton into writing to Sir Charles.","portraitImageId":"hound-image-paget-15","color":"#9a7180","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-selden","name":"Selden","aliases":[],"description":"Mrs Barrymore’s brother, an escaped convict hiding on the moor.","portraitImageId":"hound-image-paget-selden","color":"#594f4b","tags":[],"isAlive":false,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-frankland","name":"Mr. Frankland","aliases":[],"description":"An elderly litigious neighbour whose telescope inadvertently helps Watson.","portraitImageId":"hound-image-paget-17","color":"#8b6f4e","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-cartwright","name":"Cartwright","aliases":[],"description":"The Baker Street page who searches hotel wastepaper and supplies Holmes’s hut.","portraitImageId":"hound-image-paget-18","color":"#667f74","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-lestrade","name":"Inspector Lestrade","aliases":[],"description":"The Scotland Yard inspector who joins Holmes for the final trap.","portraitImageId":"hound-image-paget-19","color":"#4f6474","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-perkins","name":"Perkins","aliases":[],"description":"The Baskerville coachman who carries guests between station and Hall.","portraitImageId":"hound-image-paget-20","color":"#75624d","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-clayton","name":"John Clayton","aliases":[],"description":"The cabman unknowingly hired by Stapleton under Holmes’s name.","portraitImageId":"hound-image-paget-21","color":"#686868","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-postmaster","name":"Postmaster","aliases":[],"description":"The Grimpen postmaster who reveals that Barrymore did not personally receive Holmes’s telegram.","portraitImageId":"hound-image-paget-22","color":"#7d725d","tags":[],"isAlive":true,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-hugo","name":"Hugo Baskerville","aliases":[],"description":"The violent ancestor at the centre of the Baskerville legend.","portraitImageId":"hound-image-paget-27","color":"#6f4841","tags":[],"isAlive":false,"birthDate":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-char-yeoman-daughter","name":"The Yeoman’s Daughter","aliases":[],"description":"The unnamed woman abducted by Hugo who escapes across the moor.","portraitImageId":"hound-image-paget-28","color":"#887373","tags":[],"isAlive":false,"birthDate":null}],"items":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-walking-stick","name":"Mortimer’s Walking Stick","description":"The forgotten stick from which Holmes and Watson infer Mortimer’s profession and habits.","iconType":"walking-stick","imageId":"hound-image-paget-24","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-manuscript","name":"Baskerville Manuscript","description":"The dated family account of Hugo Baskerville and the legendary hound.","iconType":"scroll","imageId":"hound-image-paget-27","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-newspaper","name":"Newspaper Account","description":"The report of Sir Charles’s death and the official inquest.","iconType":"newspaper","imageId":"hound-image-paget-25","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-warning","name":"Anonymous Warning Note","description":"Words cut from the Times warn Sir Henry to keep away from the moor.","iconType":"mail-warning","imageId":"hound-image-paget-26","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-brown-boot","name":"New Brown Boot","description":"A new boot stolen from Sir Henry’s hotel room and later returned.","iconType":"footprints","imageId":"hound-image-paget-29","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-old-boot","name":"Old Black Boot","description":"A worn boot stolen to give the hound Sir Henry’s scent.","iconType":"footprints","imageId":"hound-image-paget-30","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-telegram","name":"Barrymore Telegram","description":"Holmes’s test of whether Barrymore is truly at Baskerville Hall.","iconType":"send","imageId":"hound-image-paget-31","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-sir-charles-letter","name":"Burned Letter Fragment","description":"A fragment signed L.L. asks Sir Charles to wait at the yew-alley gate.","iconType":"mail","imageId":"hound-image-paget-32","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-candle","name":"Barrymore’s Candle","description":"The light in the window signals food and clothing to Selden.","iconType":"flame","imageId":"hound-image-paget-33","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-telescope","name":"Frankland’s Telescope","description":"The instrument that reveals Cartwright crossing the moor to Holmes.","iconType":"telescope","imageId":"hound-image-paget-34","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-reports","name":"Watson’s Reports","description":"Watson’s letters and diary preserve his investigation for Holmes and the reader.","iconType":"notebook","imageId":"hound-image-paget-35","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-portrait","name":"Portrait of Hugo Baskerville","description":"The family portrait exposes Stapleton’s Baskerville resemblance.","iconType":"image-frame","imageId":"hound-image-paget-56","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-sir-henry-suit","name":"Sir Henry’s Old Suit","description":"Clothes given to Selden cause the hound to pursue the wrong man.","iconType":"shirt","imageId":"hound-image-paget-57","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-phosphorus","name":"Phosphorus Preparation","description":"Stapleton paints the hound’s muzzle to create a supernatural glow.","iconType":"flask-conical","imageId":"hound-image-paget-58","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-revolver","name":"Holmes’s Revolver","description":"Holmes uses it to kill the attacking hound.","iconType":"target","imageId":"hound-image-paget-54","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-mire-marks","name":"Mire Path Markers","description":"Hidden rods indicate the only safe path across the Great Grimpen Mire.","iconType":"signpost","imageId":"hound-image-paget-59","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-hound","name":"The Hound","description":"A huge trained dog used by Stapleton as a weapon disguised by phosphorus.","iconType":"dog","imageId":"hound-image-paget-53","tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-item-net","name":"Butterfly Net","description":"Stapleton’s naturalist’s net, part vocation and part camouflage.","iconType":"bug","imageId":"hound-image-paget-60","tags":[]}],"characterSnapshots":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-snapshot-1-holmes","characterI