imedia.org/wiki/Special:Redirect/file/Houn-57.jpg?width=720","createdAt":1785585600000},{"id":"hound-image-paget-58","worldId":"hound-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Houn-58.jpg?width=720","createdAt":1785585600000},{"id":"hound-image-paget-59","worldId":"hound-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Houn-59.jpg?width=720","createdAt":1785585600000},{"id":"hound-image-paget-60","worldId":"hound-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Houn-60.jpg?width=720","createdAt":1785585600000},{"id":"hound-image-paget-selden","worldId":"hound-world","mimeType":"image/png","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/The%20Hound%20of%20the%20Baskervilles%2C%20pg.260.png?width=720","createdAt":1785585600000}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-route-london-pursuit","mapLayerId":"hound-map-london","name":"The London Pursuit","routeType":"carriage","waypoints":["hound-loc-northumberland","hound-loc-charing-cross","hound-loc-baker-street"],"color":"#66798c","notes":"The failed pursuit of Stapleton’s cab and the return to Baker Street."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-route-watson-moor","mapLayerId":"hound-map-dartmoor","name":"Watson’s Moor Investigation","routeType":"foot","waypoints":["hound-loc-hall-portal","hound-loc-merripit","hound-loc-grimpen","hound-loc-frankland","hound-loc-stone-hut","hound-loc-tor"],"color":"#8b7355","notes":"Watson’s expanding investigation across the fictional Baskerville district."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-route-hound","mapLayerId":"hound-map-dartmoor","name":"The Hound’s Scent Trails","routeType":"foot","waypoints":["hound-loc-hound-kennel","hound-loc-merripit","hound-loc-selden-refuge","hound-loc-merripit"],"color":"#7b443e","notes":"Editorially combines the pursuit of Selden and the final attack on Sir Henry."}],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"hound-lore-category-case","worldId":"hound-world","name":"The Baskerville Case","color":"#5c7080","sortOrder":1},{"id":"hound-lore-category-family","worldId":"hound-world","name":"Baskerville History","color":"#8b5b4d","sortOrder":2},{"id":"hound-lore-category-moor","worldId":"hound-world","name":"Dartmoor","color":"#697358","sortOrder":3},{"id":"hound-lore-category-method","worldId":"hound-world","name":"Detection and Evidence","color":"#6f6b80","sortOrder":4},{"id":"hound-lore-category-sources","worldId":"hound-world","name":"Sources and Editorial Notes","color":"#8b7355","sortOrder":5}],"lorePages":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-1","categoryId":"hound-lore-category-family","title":"The Baskerville Legend","body":"A manuscript dated 1742 recounts Hugo Baskerville’s death beside a spectral hound. Whether or not the legend began in fact, Stapleton turns inherited fear into a murder weapon.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-2","categoryId":"hound-lore-category-family","title":"The Line of Succession","body":"Sir Charles’s death brings Sir Henry from Canada. Stapleton is secretly the son of Roger Baskerville, a younger brother of Sir Charles, and therefore has a financial motive to remove the remaining heir.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-3","categoryId":"hound-lore-category-moor","title":"The Great Grimpen Mire","body":"The mire appears open but contains lethal bogs and only narrow islands of firm ground. Stapleton’s marked path gives him a private refuge, kennel, and escape route.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-4","categoryId":"hound-lore-category-moor","title":"The Fictional Baskerville Country","body":"Baskerville Hall, Merripit House, Lafter Hall, and Grimpen are fictional. Their positions on the Dartmoor map are an editorial reconstruction of the novel’s relative directions, not claims about real sites.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-5","categoryId":"hound-lore-category-case","title":"Sir Charles’s Death","body":"Stapleton arranges Laura’s letter, releases the hound when Sir Charles waits at the gate, and relies on terror and heart disease to leave no conventional wound.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-6","categoryId":"hound-lore-category-case","title":"The Attempt on Sir Henry","body":"Stapleton first steals a worn boot for scent, later releases the hound as Sir Henry walks from Merripit House, and loses control of the plan when Holmes shoots the animal.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-7","categoryId":"hound-lore-category-method","title":"Holmes’s Hidden Investigation","body":"Holmes remains on Dartmoor in a stone hut, using Cartwright for supplies. The concealment lets him study Stapleton without alerting the suspect, though it also keeps Watson and the reader partially uninformed.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-8","categoryId":"hound-lore-category-method","title":"The Material Hound","body":"The “demon” is a large dog trained as a weapon. Phosphorus creates the fiery appearance; stolen clothing provides scent; the moor and family story amplify fear.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-9","categoryId":"hound-lore-category-method","title":"Documents as Evidence","body":"The case is carried through a manuscript, newspaper account, warning note, telegram, Watson’s reports, diary extracts, and the burned L.L. letter. Each document has a different author and degree of reliability.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-10","categoryId":"hound-lore-category-sources","title":"Text Source","body":"Chapter order and factual checking follow the public-domain Project Gutenberg edition of The Hound of the Baskervilles (ebook 2852). Summaries here are newly written and do not reproduce the novel’s prose.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-11","categoryId":"hound-lore-category-sources","title":"Sidney Paget Illustrations","body":"Character and item images link to Sidney Paget’s original Strand and early book illustrations held on Wikimedia Commons. Individual files retain the licensing information on their Commons pages.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-lore-12","categoryId":"hound-lore-category-sources","title":"Map Sources","body":"The Britain locator, 1890 London map, historical Ordnance Survey Dartmoor drawing, and period house plan are linked from Wikimedia Commons. The house plan provides navigable editorial space rather than a canonical Baskerville Hall blueprint.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null}],"factions":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-investigators","name":"The Investigators","description":"Holmes, Watson, Lestrade, Mortimer, and their practical assistants.","color":"#526f80","coverImageId":null,"tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-baskervilles","name":"The Baskerville Family","description":"The old landed family whose inheritance and legend motivate the case.","color":"#8a5e4d","coverImageId":null,"tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-merripit","name":"The Merripit Household","description":"Stapleton’s false domestic arrangement with Beryl and the hidden hound.","color":"#68764f","coverImageId":null,"tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-hall","name":"Baskerville Hall Household","description":"Sir Henry and the Barrymores within the ancestral estate.","color":"#706670","coverImageId":null,"tags":[]},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-law","name":"Law and Custody","description":"Police, prison guards, and the legal structures surrounding Selden and Frankland.","color":"#596b75","coverImageId":null,"tags":[]}],"factionMemberships":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-1","factionId":"hound-faction-investigators","characterId":"hound-char-holmes","role":"Lead detective","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-2","factionId":"hound-faction-investigators","characterId":"hound-char-watson","role":"Field investigator","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-3","factionId":"hound-faction-investigators","characterId":"hound-char-mortimer","role":"Client and medical witness","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-4","factionId":"hound-faction-investigators","characterId":"hound-char-lestrade","role":"Police support","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-5","factionId":"hound-faction-investigators","characterId":"hound-char-cartwright","role":"Courier and scout","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-6","factionId":"hound-faction-baskervilles","characterId":"hound-char-sir-charles","role":"Late baronet","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-7","factionId":"hound-faction-baskervilles","characterId":"hound-char-sir-henry","role":"Heir and baronet","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-8","factionId":"hound-faction-baskervilles","characterId":"hound-char-hugo","role":"Ancestor","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-9","factionId":"hound-faction-baskervilles","characterId":"hound-char-stapleton","role":"Concealed heir","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-10","factionId":"hound-faction-merripit","characterId":"hound-char-stapleton","role":"Master of the conspiracy","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-11","factionId":"hound-faction-merripit","characterId":"hound-char-beryl","role":"Coerced wife","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-12","factionId":"hound-faction-hall","characterId":"hound-char-sir-henry","role":"Master","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-13","factionId":"hound-faction-hall","characterId":"hound-char-barrymore","role":"Butler","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-14","factionId":"hound-faction-hall","characterId":"hound-char-mrs-barrymore","role":"Housekeeper","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-15","factionId":"hound-faction-law","characterId":"hound-char-lestrade","role":"Inspector","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-16","factionId":"hound-faction-law","characterId":"hound-char-selden","role":"Fugitive","startEventId":null,"endEventId":null,"notes":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-membership-17","factionId":"hound-faction-law","characterId":"hound-char-frankland","role":"Litigant","startEventId":null,"endEventId":null,"notes":""}],"factionRelationships":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-rel-1","factionAId":"hound-faction-investigators","factionBId":"hound-faction-merripit","stance":"hostile","notes":"The investigators work to expose and stop Stapleton’s conspiracy."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-rel-2","factionAId":"hound-faction-hall","factionBId":"hound-faction-merripit","stance":"hostile","notes":"Merripit’s hospitality conceals a plan against the Hall’s master."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-rel-3","factionAId":"hound-faction-investigators","factionBId":"hound-faction-hall","stance":"allied","notes":"The investigation exists to protect Sir Henry and clarify Sir Charles’s death."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-faction-rel-4","factionAId":"hound-faction-law","factionBId":"hound-faction-hall","stance":"neutral","notes":"The prison search and Frankland’s lawsuits complicate, but do not define, the household mystery."}],"knowledgeFacts":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-tracks","title":"A gigantic hound left tracks near Sir Charles","description":"Mortimer privately observed animal footprints omitted from the inquest.","tags":[],"readerLearnsAtEventId":"hound-event-6","originEventId":"hound-event-6"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-warning","title":"The warning was assembled from the Times","description":"The anonymous London warning used printed words and a handwritten “moor.”","tags":[],"readerLearnsAtEventId":"hound-event-13","originEventId":"hound-event-13"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-scent","title":"The thief wanted a worn boot","description":"The exchange of a new boot for an old one shows that scent, not footwear, is the object.","tags":[],"readerLearnsAtEventId":"hound-event-16","originEventId":"hound-event-16"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-barrymore-innocent","title":"Barrymore’s secret concerns Selden","description":"The candle and deception protect Mrs Barrymore’s fugitive brother rather than a murderer of Baskervilles.","tags":[],"readerLearnsAtEventId":"hound-event-38","originEventId":"hound-event-38"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-ll","title":"Laura Lyons wrote the appointment letter","description":"The initials L.L. belong to Laura, who asked Sir Charles to meet her at the gate.","tags":[],"readerLearnsAtEventId":"hound-event-45","originEventId":"hound-event-45"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-hidden-holmes","title":"Holmes is the man on the tor","description":"Holmes has secretly conducted a parallel investigation from a stone hut.","tags":[],"readerLearnsAtEventId":"hound-event-48","originEventId":"hound-event-48"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-wife","title":"Beryl is Stapleton’s wife","description":"The supposed siblings are married; the deception makes Sir Henry’s courtship useful to Stapleton.","tags":[],"readerLearnsAtEventId":"hound-event-49","originEventId":"hound-event-49"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-selden-scent","title":"Selden died because he wore Sir Henry’s clothes","description":"The hound follows Sir Henry’s scent on the suit and drives Selden over the cliff.","tags":[],"readerLearnsAtEventId":"hound-event-51","originEventId":"hound-event-51"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-heir","title":"Stapleton is a Baskerville heir","description":"The Hugo portrait reveals a family resemblance later confirmed by records.","tags":[],"readerLearnsAtEventId":"hound-event-53","originEventId":"hound-event-53"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-hound-material","title":"The hound is a trained dog painted with phosphorus","description":"The supernatural appearance is manufactured from an animal, scent training, and a luminous chemical.","tags":[],"readerLearnsAtEventId":"hound-event-59","originEventId":"hound-event-59"},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-fact-stapleton-fate","title":"Stapleton likely died in the mire","description":"His old boot is recovered beyond the marked path, but his body is not found.","tags":[],"readerLearnsAtEventId":"hound-event-61","originEventId":"hound-event-61"}],"knowledgeReveals":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-1","factId":"hound-fact-tracks","characterId":"hound-char-holmes","eventId":"hound-event-6","note":"Mortimer’s account gives Holmes the suppressed physical clue."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-2","factId":"hound-fact-tracks","characterId":"hound-char-watson","eventId":"hound-event-6","note":"Watson hears Mortimer’s suppressed physical clue."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-3","factId":"hound-fact-warning","characterId":"hound-char-holmes","eventId":"hound-event-13","note":"Holmes identifies the newspaper type and disguised handwriting."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-4","factId":"hound-fact-scent","characterId":"hound-char-holmes","eventId":"hound-event-16","note":"Holmes recognises that a worn object has greater evidentiary value to the thief."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-5","factId":"hound-fact-barrymore-innocent","characterId":"hound-char-watson","eventId":"hound-event-38","note":"The Barrymores disclose the meaning of their light."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-6","factId":"hound-fact-barrymore-innocent","characterId":"hound-char-sir-henry","eventId":"hound-event-38","note":"Sir Henry learns why his servants deceived him."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-7","factId":"hound-fact-ll","characterId":"hound-char-watson","eventId":"hound-event-45","note":"Laura confirms the appointment and that she was induced not to attend."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-8","factId":"hound-fact-hidden-holmes","characterId":"hound-char-watson","eventId":"hound-event-48","note":"Watson discovers the watcher’s identity."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-9","factId":"hound-fact-wife","characterId":"hound-char-watson","eventId":"hound-event-49","note":"Holmes supplies the decisive correction to the Stapletons’ public identity."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-10","factId":"hound-fact-selden-scent","characterId":"hound-char-holmes","eventId":"hound-event-51","note":"The exchanged clothing explains the hound’s mistaken pursuit."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-11","factId":"hound-fact-selden-scent","characterId":"hound-char-watson","eventId":"hound-event-51","note":"Watson connects Selden’s borrowed clothes to Sir Henry’s scent."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-12","factId":"hound-fact-heir","characterId":"hound-char-holmes","eventId":"hound-event-53","note":"The family face supplies Holmes with Stapleton’s motive and ancestry."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-13","factId":"hound-fact-heir","characterId":"hound-char-watson","eventId":"hound-event-53","note":"Watson sees the resemblance when Holmes masks the portrait’s hair and hat."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-14","factId":"hound-fact-hound-material","characterId":"hound-char-holmes","eventId":"hound-event-59","note":"The dead animal and chemical residue confirm the material mechanism."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-15","factId":"hound-fact-hound-material","characterId":"hound-char-watson","eventId":"hound-event-59","note":"Watson witnesses and examines the real hound."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-16","factId":"hound-fact-hound-material","characterId":"hound-char-lestrade","eventId":"hound-event-59","note":"Lestrade witnesses the attack and its physical explanation."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-17","factId":"hound-fact-hound-material","characterId":"hound-char-sir-henry","eventId":"hound-event-59","note":"Sir Henry directly confronts the weapon behind the curse."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-18","factId":"hound-fact-stapleton-fate","characterId":"hound-char-holmes","eventId":"hound-event-61","note":"The recovered boot and broken trail support the inference that Stapleton sank."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-19","factId":"hound-fact-stapleton-fate","characterId":"hound-char-watson","eventId":"hound-event-61","note":"Watson shares the final search and inference."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-reveal-20","factId":"hound-fact-stapleton-fate","characterId":"hound-char-beryl","eventId":"hound-event-61","note":"Beryl guides the search along the only safe route."}],"characterGoals":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-1","characterId":"hound-char-holmes","startEventId":"hound-event-10","endEventId":"hound-event-66","type":"want","text":"Expose the mechanism and protect Sir Henry without alerting the adversary."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-2","characterId":"hound-char-watson","startEventId":"hound-event-21","endEventId":"hound-event-59","type":"want","text":"Protect Sir Henry and supply Holmes with accurate observations."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-3","characterId":"hound-char-sir-henry","startEventId":"hound-event-12","endEventId":"hound-event-66","type":"want","text":"Claim his inheritance and build a future at Baskerville Hall."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-4","characterId":"hound-char-sir-henry","startEventId":"hound-event-13","endEventId":"hound-event-59","type":"fear","text":"Refuse to be ruled by the family curse while surviving its apparent return."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-5","characterId":"hound-char-stapleton","startEventId":"hound-event-5","endEventId":"hound-event-59","type":"want","text":"Remove Sir Charles and Sir Henry so he can claim the Baskerville fortune."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-6","characterId":"hound-char-stapleton","startEventId":"hound-event-15","endEventId":"hound-event-61","type":"fear","text":"Keep his identity, marriage, hound, and island refuge undiscovered."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-7","characterId":"hound-char-beryl","startEventId":"hound-event-13","endEventId":"hound-event-60","type":"want","text":"Prevent Sir Henry’s murder without provoking Stapleton’s violence."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-8","characterId":"hound-char-barrymore","startEventId":"hound-event-25","endEventId":"hound-event-41","type":"want","text":"Help Selden escape without destroying the Barrymores’ position."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-9","characterId":"hound-char-laura","startEventId":"hound-event-45","endEventId":"hound-event-63","type":"want","text":"Secure independence from her father and understand Stapleton’s deception."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-goal-10","characterId":"hound-char-selden","startEventId":"hound-event-23","endEventId":"hound-event-51","type":"want","text":"Reach safety and flee the country."}],"sceneTexts":[],"plotThreads":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-curse","name":"The Baskerville Curse","color":"#79534f","description":"A family legend is weaponised as the explanation for two attempted murders."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-investigation","name":"Holmes and Watson’s Investigation","color":"#536d7a","description":"Observation, correspondence, disguise, and deduction turn Gothic terror into a solvable crime."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-inheritance","name":"The Baskerville Inheritance","color":"#9a744f","description":"Sir Henry’s succession makes him both the estate’s hope and Stapleton’s target."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-stapleton","name":"Stapleton’s Conspiracy","color":"#5c6f4e","description":"Stapleton hides his identity, marriage, hound, and manipulation behind naturalist respectability."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-beryl","name":"Beryl’s Resistance","color":"#8b6674","description":"Beryl tries to protect Sir Henry while living under coercion."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-selden","name":"Selden on the Moor","color":"#665b54","description":"The escaped convict creates a plausible danger and becomes an unintended victim."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-barrymores","name":"The Barrymores’ Secret","color":"#6e6870","description":"The servants’ aid to Selden makes innocent conduct look criminal."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-laura","name":"Laura Lyons and the Letter","color":"#8c6c78","description":"A vulnerable woman’s letter becomes the concealed appointment behind Sir Charles’s death."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-hidden-holmes","name":"The Man on the Tor","color":"#4f6573","description":"Holmes conducts a parallel inquiry while Watson believes him to be in London."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-thread-hound","name":"The Real Hound","color":"#694d48","description":"Footprints, cries, scent, and phosphorus gradually replace superstition with material evidence."}],"motifs":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-reason-superstition","name":"Reason and Superstition","color":"#6c7182","description":"Every supernatural sign has a material cause, yet fear remains physically dangerous."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-moor","name":"The Moor","color":"#6d765c","description":"Fog, tors, mire, and open distance conceal watchers and erase certainty."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-footprints","name":"Footprints and Tracks","color":"#7d6855","description":"Human and animal traces connect the hotel thefts, Sir Charles’s death, and the hound."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-light","name":"Lights in Darkness","color":"#9d7a48","description":"Candles, windows, lanterns, and the hound’s glow communicate or deceive."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-documents","name":"Documents and Reports","color":"#617688","description":"Manuscript, newspaper, letters, telegrams, reports, and diaries ration knowledge."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-disguise","name":"Names and Disguises","color":"#765f72","description":"False kinship, false names, a beard, and hidden observation destabilise identity."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-inheritance","name":"Blood and Inheritance","color":"#8b534f","description":"Family resemblance and succession bind Hugo, Sir Henry, and Stapleton."},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-motif-captivity","name":"Captivity and Escape","color":"#675f58","description":"Beryl, Selden, the hound, and the mire’s victims occupy different forms of confinement."}],"continuitySuppressions":[],"writingLogs":[],"sceneRevisions":[]}