At":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-2","characterAId":"hound-char-holmes","characterBId":"hound-char-sir-henry","label":"Investigator and client","strength":"strong","sentiment":"positive","description":"Holmes protects Sir Henry while using him as the necessary centre of the trap.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-3","characterAId":"hound-char-watson","characterBId":"hound-char-sir-henry","label":"Protector and friend","strength":"strong","sentiment":"positive","description":"Watson accompanies Sir Henry and repeatedly shares his danger.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-4","characterAId":"hound-char-sir-henry","characterBId":"hound-char-beryl","label":"Courtship under threat","strength":"strong","sentiment":"positive","description":"Their attraction becomes dangerous because Stapleton presents Beryl as his sister.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-5","characterAId":"hound-char-stapleton","characterBId":"hound-char-beryl","label":"Coercive marriage","strength":"strong","sentiment":"negative","description":"Stapleton controls, threatens, and binds his wife when she resists the murders.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-6","characterAId":"hound-char-stapleton","characterBId":"hound-char-sir-henry","label":"Hidden rival heirs","strength":"strong","sentiment":"negative","description":"Stapleton must kill Sir Henry to clear his path to the Baskerville estate.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-7","characterAId":"hound-char-stapleton","characterBId":"hound-char-sir-charles","label":"Murderer and victim","strength":"strong","sentiment":"negative","description":"Stapleton uses the legend and hound to frighten Sir Charles to death.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-8","characterAId":"hound-char-stapleton","characterBId":"hound-char-laura","label":"Deceptive courtship","strength":"strong","sentiment":"negative","description":"Stapleton promises marriage and manipulates Laura into writing the fatal letter.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-9","characterAId":"hound-char-barrymore","characterBId":"hound-char-mrs-barrymore","label":"Married allies","strength":"strong","sentiment":"positive","description":"They jointly protect Selden and endure suspicion together.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-10","characterAId":"hound-char-mrs-barrymore","characterBId":"hound-char-selden","label":"Siblings","strength":"strong","sentiment":"positive","description":"Mrs Barrymore risks her home to feed and equip her fugitive brother.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-11","characterAId":"hound-char-mortimer","characterBId":"hound-char-sir-charles","label":"Physician and friend","strength":"strong","sentiment":"positive","description":"Mortimer knows Sir Charles’s fears and guards the evidence others dismiss.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-12","characterAId":"hound-char-mortimer","characterBId":"hound-char-sir-henry","label":"Adviser and heir","strength":"medium","sentiment":"positive","description":"Mortimer brings Sir Henry into the case and hopes he will restore the estate.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-13","characterAId":"hound-char-frankland","characterBId":"hound-char-laura","label":"Estranged father and daughter","strength":"weak","sentiment":"negative","description":"Frankland’s refusal to support Laura leaves her financially vulnerable.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-14","characterAId":"hound-char-holmes","characterBId":"hound-char-stapleton","label":"Detective and adversary","strength":"strong","sentiment":"negative","description":"Each hides his movements while testing the other’s knowledge.","isBidirectional":true,"startEventId":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-relationship-15","characterAId":"hound-char-hugo","characterBId":"hound-char-yeoman-daughter","label":"Captor and captive","strength":"strong","sentiment":"negative","description":"Hugo’s violence begins the legend later exploited by Stapleton.","isBidirectional":true,"startEventId":null}],"relationshipSnapshots":[],"timelines":[{"id":"hound-timeline-main","worldId":"hound-world","name":"The Hound of the Baskervilles — Master Chronology","description":"A single reading-order timeline. Retrospective testimony is flagged as flashback material and pinned to its reconstructed date.","color":"#5c7080","dayOffset":0,"createdAt":1785585600000}],"chapters":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-01","timelineId":"hound-timeline-main","number":1,"title":"Mr. Sherlock Holmes","synopsis":"Mortimer’s forgotten stick lets Holmes and Watson compare methods before their visitor returns.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-02","timelineId":"hound-timeline-main","number":2,"title":"The Curse of the Baskervilles","synopsis":"Mortimer reads the legend of Hugo and the report of Sir Charles’s unexplained death.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-03","timelineId":"hound-timeline-main","number":3,"title":"The Problem","synopsis":"Holmes tests the evidence and accepts the task of protecting the new heir.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-04","timelineId":"hound-timeline-main","number":4,"title":"Sir Henry Baskerville","synopsis":"Sir Henry arrives in London, receives a warning, loses boots, and is followed.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-05","timelineId":"hound-timeline-main","number":5,"title":"Three Broken Threads","synopsis":"The London leads fail, but Holmes quietly prepares a wider investigation.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-06","timelineId":"hound-timeline-main","number":6,"title":"Baskerville Hall","synopsis":"Watson accompanies Sir Henry to Devon and enters the troubled ancestral house.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-07","timelineId":"hound-timeline-main","number":7,"title":"The Stapletons of Merripit House","synopsis":"Watson meets Stapleton and Beryl beside the dangerous Grimpen Mire.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-08","timelineId":"hound-timeline-main","number":8,"title":"First Report of Dr. Watson","synopsis":"Watson reports the moor’s suspects, tensions, and concealed movements.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-09","timelineId":"hound-timeline-main","number":9,"title":"The Light upon the Moor","synopsis":"Sir Henry courts Beryl while Watson uncovers the Barrymores’ signal to Selden.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-10","timelineId":"hound-timeline-main","number":10,"title":"Extract from the Diary of Dr. Watson","synopsis":"Barrymore explains the signal and reveals Sir Charles’s link to the initials L.L.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-11","timelineId":"hound-timeline-main","number":11,"title":"The Man on the Tor","synopsis":"Laura Lyons’s account and Frankland’s telescope lead Watson to Holmes’s hidden hut.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-12","timelineId":"hound-timeline-main","number":12,"title":"Death on the Moor","synopsis":"Holmes and Watson find Selden dead in Sir Henry’s clothes and confront Stapleton’s composure.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-13","timelineId":"hound-timeline-main","number":13,"title":"Fixing the Nets","synopsis":"Holmes identifies the Baskerville resemblance and arranges the final trap.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-chapter-14","timelineId":"hound-timeline-main","number":14,"title":"The Hound of the Baskervilles","synopsis":"The investigators confront the hound, rescue Beryl, and search the mire.","notes":"","wordGoal":null},{"worldId":"hound-world","createdAt":1785585600000,"upd