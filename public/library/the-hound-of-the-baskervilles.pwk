{"version":16,"type":"worldbreaker-export","exportedAt":1785585600000,"world":{"id":"hound-world","name":"The Hound of the Baskervilles","description":"Sherlock Holmes and Dr Watson investigate the death of Sir Charles Baskerville and the threat against his heir, moving from London evidence to a Dartmoor landscape shaped by inheritance, coercion, concealed identities, and a legendary hound.","coverImageId":"hound-image-cover","theme":"theme-noir","readingMode":true,"createdAt":1785585600000,"updatedAt":1785585600000,"continuityStaleThreshold":5,"calendar":{"startYear":1889,"yearSuffix":" (editorial reconstruction)","months":[{"name":"January","days":31},{"name":"February","days":28},{"name":"March","days":31},{"name":"April","days":30},{"name":"May","days":31},{"name":"June","days":30},{"name":"July","days":31},{"name":"August","days":31},{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]},"wordTarget":null},"mapLayers":[{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-map-britain","parentMapId":null,"name":"Britain, 1889","description":"The investigation moves between London and the Devonshire moor country.","imageId":"hound-image-map-britain","imageWidth":960,"imageHeight":1483,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-map-london","parentMapId":"hound-map-britain","name":"Victorian London","description":"Baker Street, Northumberland Hotel, stations, and the streets where Sir Henry is watched.","imageId":"hound-image-map-london","imageWidth":1280,"imageHeight":981,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"hound-world","createdAt":1785585600000,"updatedAt":1785585600000,"id":"hound-map-dartmoor","parentMapId":"hound-map-britain","name":"Dartmoor and the B