  "characterGoals": [
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-goal-1",
      "characterId": "three-musketeers-char-dartagnan",
      "type": "want",
      "text": "Earn a place among the King’s Musketeers without abandoning his friends.",
      "startEventId": "three-musketeers-event-001",
      "endEventId": "three-musketeers-event-068"
    },
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-goal-2",
      "characterId": "three-musketeers-char-dartagnan",
      "type": "need",
      "text": "Protect Constance and learn to distinguish courage from reckless pride.",
      "startEventId": "three-musketeers-event-009",
      "endEventId": "three-musketeers-event-063"
    },
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-goal-3",
      "characterId": "three-musketeers-char-athos",
      "type": "need",
