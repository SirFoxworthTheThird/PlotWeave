    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-faction-relationship-invest-house",
      "factionAId": "moonstone-faction-investigators",
      "factionBId": "moonstone-faction-verinder-household",
      "stance": "protective",
      "notes": "Investigation protects the family only by exposing secrets the household wants contained."
    },
