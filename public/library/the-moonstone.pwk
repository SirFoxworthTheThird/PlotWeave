      "worldId": "moonstone-world",
      "name": "Victorian Society and Detection",
      "color": "#695f53",
      "sortOrder": 2
    },
    {
      "id": "moonstone-lore-category-themes",
      "worldId": "moonstone-world",
      "name": "Ideas and Motifs",
      "color": "#66576f",
      "sortOrder": 3
    }
  ],
  "lorePages": [
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-1",
      "categoryId": "moonstone-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The structure follows the public-domain Project Gutenberg text, preserving its prologue, eight documentary narratives, and epilogue. Linked character, item, and location art comes from the 1868 Harper’s Weekly engravings catalogued by the Victorian Web. Historical maps are linked from Wikimedia Commons; the Yorkshire layer uses T. Langdale’s 1822 map supplied by the North Yorkshire County Record Office archive shop.",
      "tags": [],
      "coverImageId": "moonstone-image-cover",
      "linkedEntityIds": [
        "moonstone-world"
      ],
      "visibleFromEventId": "moonstone-event-001"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-2",
      "categoryId": "moonstone-lore-category-sources",
      "title": "Representative Verinder House Plan",
      "body": "The novel describes rooms and routes but supplies no canonical floor plan. The house layer therefore uses a public-domain eighteenth-century country-house plan as a clearly identified spatial aid rather than claiming an authentic Verinder design.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-17",
      "linkedEntityIds": [
        "moonstone-map-estate"
      ],
      "visibleFromEventId": "moonstone-event-014"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-3",
      "categoryId": "moonstone-lore-category-history",
      "title": "The Storming of Seringapatam",
      "body": "British forces captured Tipu Sultan’s island capital in 1799. Collins makes this act of conquest and plunder the origin of the English mystery rather than a detachable exotic legend.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-1",
      "linkedEntityIds": [
        "moonstone-map-seringapatam",
        "moonstone-loc-moonstone-armoury"
      ],
      "visibleFromEventId": "moonstone-event-001"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-4",
      "categoryId": "moonstone-lore-category-history",
      "title": "Kathiawar, Somnauth, and Sacred Return",
      "body": "The epilogue follows Murthwaite through western India to a pilgrimage near Somnauth, where the stone returns to ritual custody beyond the investigators’ reach.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-74",
      "linkedEntityIds": [
        "moonstone-map-kathiawar",
        "moonstone-loc-moon-shrine"
      ],
      "visibleFromEventId": "moonstone-event-073"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-5",
      "categoryId": "moonstone-lore-category-society",
      "title": "The Multi-Narrator Case File",
      "body": "The novel assembles a family paper, household memoir, evangelical diary, legal account, personal narrative, medical journal, detective report, letters, and epilogue statements. No voice is neutral, but their overlaps make correction possible.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-66",
      "linkedEntityIds": [
        "moonstone-world"
      ],
      "visibleFromEventId": "moonstone-event-005"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-6",
      "categoryId": "moonstone-lore-category-society",
      "title": "Victorian Credit and Reputation",
      "body": "Godfrey’s public philanthropy coexists with trust obligations and private debt. The bank pledge turns the diamond into collateral, while respectability delays suspicion.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-51",
      "linkedEntityIds": [
        "moonstone-char-godfrey",
        "moonstone-char-luker",
        "moonstone-item-bank-receipt"
      ],
      "visibleFromEventId": "moonstone-event-039"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-7",
      "categoryId": "moonstone-lore-category-society",
      "title": "Opium, Consent, and Experiment",
      "body": "Candy’s secret dose causes the forgotten action; Jennings’s later experiment repeats conditions with Franklin’s informed cooperation and careful observation. The contrast is ethical as well as medical.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-63",
      "linkedEntityIds": [
        "moonstone-char-ezra",
        "moonstone-char-candy",
        "moonstone-item-laudanum"
      ],
      "visibleFromEventId": "moonstone-event-055"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-8",
      "categoryId": "moonstone-lore-category-themes",
      "title": "Evidence Corrects Character Judgment",
      "body": "Servant status, criminal history, charity, foreignness, disability, and reputation repeatedly bias judgment. Paint, cloth, notes, dates, and observed action force the case to be revised.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-34",
      "linkedEntityIds": [
        "moonstone-char-cuff",
        "moonstone-item-nightgown"
      ],
      "visibleFromEventId": "moonstone-event-018"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-9",
      "categoryId": "moonstone-lore-category-themes",
      "title": "The Shivering Sand",
      "body": "The quicksand is both landscape and moral image: a surface that changes with the tide, conceals what enters it, and briefly returns evidence to patient timing.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-5",
      "linkedEntityIds": [
        "moonstone-loc-shivering-sand",
        "moonstone-item-tin-case"
      ],
      "visibleFromEventId": "moonstone-event-009"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-lore-page-10",
      "categoryId": "moonstone-lore-category-themes",
      "title": "Guardianship versus Ownership",
      "body": "English law treats the Moonstone as legacy, property, collateral, and evidence. The guardians treat it as a sacred presence held through an obligation older than individual possession.",
      "tags": [],
      "coverImageId": "moonstone-image-jewett-20",
      "linkedEntityIds": [
        "moonstone-faction-guardians",
        "moonstone-item-moonstone"
      ],
      "visibleFromEventId": "moonstone-event-012"
    }
  ],
