      "updatedAt": 1786464000000,
      "id": "moonstone-reveal-4",
      "factId": "moonstone-fact-rosanna-motive",
      "characterId": "moonstone-char-franklin",
      "eventId": "moonstone-event-047",
      "note": "Rosanna’s letter makes her motive explicit."
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-reveal-5",
      "factId": "moonstone-fact-rachel-saw",
      "characterId": "moonstone-char-franklin",
      "eventId": "moonstone-event-049",
      "note": "Rachel finally states what she witnessed."
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
