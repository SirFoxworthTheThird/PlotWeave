  "timelines": [
    {
      "id": "moonstone-timeline-main",
      "worldId": "moonstone-world",
      "name": "The Moonstone, 1799–1850",
      "description": "One chronological timeline from the Seringapatam prologue through the English investigation and the Kathiawar epilogue. Retrospective documents are marked as flashbacks rather than separated into artificial timelines.",
      "color": "#8a7138",
      "dayOffset": 0,
      "createdAt": 1786464000000
    }
  ],
  "chapters": [
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-chapter-001",
      "timelineId": "moonstone-timeline-main",
      "number": 1,
      "title": "Prologue — The Storming of Seringapatam (1799)",
      "synopsis": "British forces cross the Cauvery and force the north-western breach, opening the fortress to battle and plunder. The assault crosses the Cauvery and forces an entry through the north-western defences of the island fortress. Despite orders against looting, the palace precinct fills with soldiers searching rooms and carrying away valuables. During the fall of Seringapatam, an officer finds Herncastle over a dying guardian with the sacred diamond in his dagger.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-chapter-002",
      "timelineId": "moonstone-timeline-main",
      "number": 2,
      "title": "First Period — The Loss of the Diamond: Chapter 1",
      "synopsis": "The family account resumes in 1848 at Lady Verinder’s northern estate, where an old colonial theft is about to become a domestic legacy. The steward introduces the country house, its staff, and Rachel’s approaching eighteenth birthday. Decades later, Betteredge is asked to set down the events surrounding Rachel’s eighteenth birthday and the lost diamond.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-chapter-003",
      "timelineId": "moonstone-timeline-main",
      "number": 3,
      "title": "First Period — The Loss of the Diamond: Chapter 2",
      "synopsis": "Penelope reports travelling performers using ink and a boy’s trance to ask who holds the English diamond.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-chapter-004",
      "timelineId": "moonstone-timeline-main",
      "number": 4,
      "title": "First Period — The Loss of the Diamond: Chapter 3",
      "synopsis": "Betteredge finds Rosanna alone above the quicksand and learns how strongly the bleak bay answers her private despair.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-chapter-005",
      "timelineId": "moonstone-timeline-main",
      "number": 5,
      "title": "First Period — The Loss of the Diamond: Chapter 4",
      "synopsis": "Franklin arrives with foreign habits, family charm, and a private responsibility for Herncastle’s legacy.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-chapter-006",
      "timelineId": "moonstone-timeline-main",
      "number": 6,
      "title": "First Period — The Loss of the Diamond: Chapter 5",
      "synopsis": "Franklin and Betteredge examine the clauses that make Rachel heir to the Moonstone and preserve it whole if Herncastle dies naturally.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
