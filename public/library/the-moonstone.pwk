  "knowledgeFacts": [
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-sacred",
      "title": "The Moonstone is a sacred object",
      "description": "Three hereditary guardians pursue the diamond because it belongs to the moon deity, not merely because it is valuable.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-001",
      "originEventId": "moonstone-event-001"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-rachel-saw",
      "title": "Rachel saw Franklin take the diamond",
      "description": "Her hostility and silence protect the man she believes she witnessed committing the theft.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-049",
      "originEventId": "moonstone-event-049"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-nightgown",
      "title": "The stained nightgown belongs to Franklin",
      "description": "Rosanna found his named garment and hid it beneath the Shivering Sand.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-046",
      "originEventId": "moonstone-event-046"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-rosanna-motive",
      "title": "Rosanna concealed evidence out of love",
      "description": "Her letter explains that protection of Franklin, not possession of the diamond, governed her actions.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-047",
      "originEventId": "moonstone-event-047"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-opium",
      "title": "Candy secretly dosed Franklin with opium",
      "description": "The dose, exhaustion, and anxiety produce an automatic action Franklin cannot later remember.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-055",
      "originEventId": "moonstone-event-055"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-experiment",
      "title": "The theft can be medically reconstructed",
      "description": "Repeating the conditions causes Franklin to carry the mock diamond along the same route.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-055",
      "originEventId": "moonstone-event-055"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-pledge",
      "title": "The diamond was pledged to Luker",
      "description": "A one-year bank arrangement hides the stone while securing Godfrey’s debt.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-059",
      "originEventId": "moonstone-event-059"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-godfrey",
      "title": "Godfrey received the diamond from Franklin",
      "description": "He found the drugged Franklin with the stone and consciously used it as collateral.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-059",
      "originEventId": "moonstone-event-059"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-guardians-recover",
      "title": "The guardians recover the stone in London",
      "description": "Godfrey’s disguised attempt to retrieve it ends with his death and the diamond’s disappearance.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-059",
      "originEventId": "moonstone-event-059"
    },
    {
      "worldId": "moonstone-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "moonstone-fact-restored",
      "title": "The Moonstone is restored near Somnauth",
      "description": "Murthwaite sees it shining once more in the deity’s forehead.",
      "tags": [],
      "readerLearnsAtEventId": "moonstone-event-073",
      "originEventId": "moonstone-event-073"
    }
  ],
