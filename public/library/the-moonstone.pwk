  "world": {
    "id": "moonstone-world",
    "name": "The Moonstone",
    "description": "Wilkie Collins’s mystery follows a sacred yellow diamond from its violent seizure at Seringapatam to Rachel Verinder’s eighteenth birthday, where it vanishes from a locked cabinet. A chain of partial narrators, material clues, concealed love, financial pressure, and medical experiment gradually separates what was seen from what was intended—and asks whether English possession ever made the stone English property.",
    "coverImageId": "moonstone-image-cover",
    "theme": "theme-mystery",
    "readingMode": true,
