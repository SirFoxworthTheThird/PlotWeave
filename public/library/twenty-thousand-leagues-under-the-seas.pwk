  "lorePages": [
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-1",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The chapter structure and chronology follow the public-domain Project Gutenberg text. Linked character, item, and location artwork comes chiefly from the 1870–1871 Hetzel illustrations by Alphonse de Neuville and Édouard Riou. The maps combine a complete equirectangular world overview with the original-edition route charts.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-cover",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-world"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-001"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-2",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-technology",
      "title": "How the Nautilus Is Arranged",
      "body": "Verne gives a seventy-metre double hull. From bow toward the centre lie an air reservoir, Aronnax’s cabin, Nemo’s cabin, the salon, library, and dining room; aft of the central stair are guest space, galley, stores, crew quarters, and the engine room. The linked plan is an interpretive reconstruction based on those measurements.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-nemo-plans",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-map-nautilus",
        "twenty-thousand-leagues-under-the-seas-item-nautilus-plans"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-023"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-3",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-technology",
      "title": "Electricity beneath the Sea",
      "body": "Sodium-based batteries power light, heat, pumps, navigation, rifles, cooking, and propulsion. Verne combines real nineteenth-century electrical experimentation with fictional performance far beyond contemporary machines.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-plate-26",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-item-electric-rifle"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-022"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-4",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-science",
      "title": "The Title Measures Distance, Not Depth",
      "body": "The twenty thousand leagues describe the length of the route travelled under the seas. The Nautilus does descend to extraordinary depths, but it does not travel twenty thousand leagues vertically.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-map-route-one",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-map-world"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-026"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-5",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-science",
      "title": "Classification and Wonder",
      "body": "Aronnax and Conseil repeatedly name orders, genera, and species. The classifications organize the voyage, yet the strongest encounters—Nautilus, Atlantis, polar seas, giant squid—also expose the limits of inherited categories.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-plate-36",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-char-aronnax",
        "twenty-thousand-leagues-under-the-seas-char-conseil"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-025"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-6",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-history",
      "title": "Nemo and Oppressed Peoples",
      "body": "Nemo denies nationality but identifies with people subjected to imperial power. His rescue of the Indian diver, aid to Cretan resistance, treasure transfers, and hatred of a warship show political commitment without fully revealing his past in this novel.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-plate-81",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-char-nemo"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-052"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-7",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-history",
      "title": "The Coral Cemetery",
      "body": "Nemo’s claim that neither sharks nor men can reach the grave defines the seabed as sanctuary. It also shows that the Nautilus company has a continuing communal life, losses, and rituals beyond what its captives are permitted to see.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-plate-62",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-faction-nautilus"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-046"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-8",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-reading",
      "title": "Aronnax as an Unreliable Captive",
      "body": "Aronnax reports carefully, but scientific desire repeatedly delays his commitment to escape. Ned’s insistence on liberty exposes how wonder and privilege distort the narrator’s judgement.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-plate-24",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-char-aronnax",
        "twenty-thousand-leagues-under-the-seas-char-ned"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-033"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-9",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-reading",
      "title": "The Novel’s Colonial Frame",
      "body": "The narration uses nineteenth-century European assumptions and outdated language when describing peoples and places. The Gueboroar conflict is best read with attention to whose land is entered, whose food is taken, and whose defence the travellers label as danger.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-plate-57",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-char-papuan-chief"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-041"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-10",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-history",
      "title": "Vigo Bay and the Spanish Treasure Fleet",
      "body": "Nemo recovers bullion from ships lost during the 1702 Battle of Vigo Bay. The episode turns imperial treasure into a hidden fund for causes opposed to later empires.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-plate-86",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-item-gold-chest"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-062"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-11",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-science",
      "title": "The Polar Route Is Fictional",
      "body": "The open sea at the South Pole and navigable passage beneath the Antarctic barrier belong to Verne’s speculative geography, not to the confirmed polar conditions of his period or ours.",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-south-pole",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-map-world"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-073"
    },
    {
      "worldId": "twenty-thousand-leagues-under-the-seas-world",
      "createdAt": 1786147200000,
      "updatedAt": 1786147200000,
      "id": "twenty-thousand-leagues-under-the-seas-lore-page-12",
      "categoryId": "twenty-thousand-leagues-under-the-seas-lore-category-reading",
      "title": "Nemo’s Ending Remains Open",
      "body": "The narrator escapes without learning whether the Nautilus survives the Lofoten maelstrom. The final question is therefore both physical and moral: what judgement should be made of a liberator, rescuer, jailer, and destroyer?",
      "tags": [],
      "coverImageId": "twenty-thousand-leagues-under-the-seas-image-nemo-organ",
      "linkedEntityIds": [
        "twenty-thousand-leagues-under-the-seas-char-nemo"
      ],
      "visibleFromEventId": "twenty-thousand-leagues-under-the-seas-event-092"
    }
  ],
