      "name": "Mr Joker",
      "aliases": [],
      "description": "The clown of the china country, cracked in a hundred places from standing on his head once too often.",
      "portraitImageId": null,
      "color": "#c08a6a",
      "tags": [],
      "isAlive": true,
      "birthDate": null
    }
  ],
  "items": [
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-silver-shoes",
      "name": "The Silver Shoes",
      "description": "The Wicked Witch of the East’s pointed silver shoes, which fit Dorothy exactly and carry a charm nobody in the East ever understood.",
      "iconType": "clothing",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-golden-cap",
      "name": "The Golden Cap",
      "description": "A cap circled with diamonds and rubies whose lining holds the words that summon the Winged Monkeys — three times to an owner, and no more.",
      "iconType": "artifact",
      "imageId": "oz-image-item-golden-cap",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-green-spectacles",
      "name": "The Green Spectacles",
      "description": "Locked green glasses issued at the city gate, worn night and day by everyone inside the walls.",
      "iconType": "clothing",
      "imageId": "oz-image-item-green-spectacles",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-silk-heart",
      "name": "The Silk Heart",
      "description": "A heart of silk stuffed with sawdust, fitted into a tin chest through a square cut in it and soldered over.",
      "iconType": "artifact",
      "imageId": "oz-image-item-silk-heart",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-bran-brains",
      "name": "The Bran-New Brains",
      "description": "A measure of bran mixed with pins and needles, packed into a straw head and held in place with more straw.",
      "iconType": "artifact",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-courage-drink",
      "name": "The Green Bottle of Courage",
      "description": "A square green bottle poured into a carved green-gold dish, on the argument that courage is only courage once swallowed.",
      "iconType": "consumable",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-balloon",
      "name": "The Silk Balloon",
      "description": "Strips of light, dark and emerald green silk sewn into a bag over twenty feet long, glued airtight and hung with a clothes basket.",
      "iconType": "vehicle",
      "imageId": "oz-image-item-balloon",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-slate",
      "name": "The Witch of the North’s Slate",
      "description": "A witch’s cap that becomes a slate when it is balanced on her nose and counted over, and writes its answer in chalk.",
      "iconType": "artifact",
      "imageId": "oz-image-item-slate",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-oil-can",
      "name": "The Oil-Can",
      "description": "The can that keeps the Tin Woodman moving, carried in Dorothy’s basket after a year of rust taught him what happens without it.",
      "iconType": "tool",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-axe",
      "name": "The Woodman’s Axe",
      "description": "The axe that cost the Woodman his body piece by piece and that now clears trees, bridges, wildcats and wolves out of the party’s way.",
      "iconType": "weapon",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-basket",
      "name": "Dorothy’s Basket",
      "description": "The covered basket she leaves Kansas with, which carries bread, then nuts, then fruit, then the oil-can.",
      "iconType": "container",
      "imageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-item-whistle",
      "name": "The Mouse Queen’s Whistle",
      "description": "A little whistle given in thanks, worn round the neck, and worth a thousand mice whenever it is blown.",
      "iconType": "tool",
      "imageId": null,
      "tags": []
    }
  ],
  "characterSnapshots": [
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-001-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-storm-warning",
      "sortKey": 10000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-farmhouse",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Stands in the doorway with Toto in her arms, watching grass bow in waves from two directions at once.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-001-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-storm-warning",
      "sortKey": 10001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-farmhouse",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Squirms in her arms, unsettled by a wind that is coming from the north and the south together.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-001-uncle-henry",
      "characterId": "oz-character-uncle-henry",
      "eventId": "oz-event-storm-warning",
      "sortKey": 10002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-farmhouse",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Gets up off the doorstep, names the cyclone aloud and goes for the animals rather than the cellar.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-001-aunt-em",
      "characterId": "oz-character-aunt-em",
      "eventId": "oz-event-storm-warning",
      "sortKey": 10003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-farmhouse",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Drops the dishes she is washing and screams at Dorothy to run for the trap door.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-002-uncle-henry",
      "characterId": "oz-character-uncle-henry",
      "eventId": "oz-event-henry-to-the-stock",
      "sortKey": 20000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-barnyard",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Reaches the sheds where the cows and horses are kept, and so is nowhere near the floor that is about to lift.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-003-aunt-em",
      "characterId": "oz-character-aunt-em",
      "eventId": "oz-event-into-the-cellar",
      "sortKey": 30000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-cellar",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Badly frightened, she throws the trap door open and climbs down without waiting to see whether Dorothy is behind her.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-004-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-house-in-the-air",
      "sortKey": 40000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-farmhouse",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Loses her footing halfway to the trap door, sits down hard on the floor, and rides out the hours until she falls asleep on her bed.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-004-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-house-in-the-air",
      "sortKey": 40001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-farmhouse",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Barks around the tipping room, falls through the open trap door, and is hauled back in by one ear.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-005-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-house-comes-down",
      "sortKey": 50000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Runs to the door and stops in it, looking at a country that is the exact opposite of the one she left.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-005-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-house-comes-down",
      "sortKey": 50001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Puts a cold nose in her face to wake her, then keeps to her heels through the doorway.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-006-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-council-munchkins",
      "sortKey": 60000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Protests that she has never killed anything, and is shown the evidence sticking out from under her own house.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-006-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-council-munchkins",
      "sortKey": 60001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Keeps close and does not even growl while a real witch is standing there.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-006-witch-north",
      "characterId": "oz-character-witch-north",
      "eventId": "oz-event-council-munchkins",
      "sortKey": 60002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Bows to her as a noble sorceress, explains which of the four witches were wicked, and laughs when the dead one dries up in the sun.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-007-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-silver-shoes-given",
      "sortKey": 70000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Carries the shoes indoors and sets them on the table, with no idea what they are for.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-007-witch-north",
      "characterId": "oz-character-witch-north",
      "eventId": "oz-event-silver-shoes-given",
      "sortKey": 70001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Shakes the dust out of the dead witch’s shoes and hands them over as the new owner’s property.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-007-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-silver-shoes-given",
      "sortKey": 70002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Barks after the empty air where the Munchkins have gone off through the trees.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-008-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-kiss-and-road",
      "sortKey": 80000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Cries at being told she must live here, and is given a mark on her forehead and a road to follow instead of a way home.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-008-witch-north",
      "characterId": "oz-character-witch-north",
      "eventId": "oz-event-kiss-and-road",
      "sortKey": 80001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Refuses to come along, leaves the kiss no one will dare injure, names the road of yellow brick, and spins away on her left heel.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-009-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-setting-out",
      "sortKey": 90000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Locks the door, pockets the key, and finds among several roads the one that is paved with yellow brick.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-009-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-setting-out",
      "sortKey": 90001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-landing-site",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Trots along soberly behind her, the only piece of Kansas she still has.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-010-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-boq-supper",
      "sortKey": 100000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-boq-house",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Eats a hearty supper, is waited on by her host, and cannot talk anybody out of thinking her a sorceress.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-010-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-boq-supper",
      "sortKey": 100001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-boq-house",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is a complete novelty to people who have never seen a dog, and lets a Munchkin baby pull his tail.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-010-boq",
      "characterId": "oz-character-boq",
      "eventId": "oz-event-boq-supper",
      "sortKey": 100002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-boq-house",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Feeds her, gives her a blue-sheeted bed, and warns that the road gets rough and dangerous long before the Emerald City.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-011-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-scarecrow-lifted",
      "sortKey": 110000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-cornfield",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Lifts a surprisingly light man off his stake and agrees that Oz can hardly leave him worse off than he is.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-011-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-scarecrow-lifted",
      "sortKey": 110001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-cornfield",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Explains that he is two days old, knows nothing, and wants brains badly enough to walk to a city for them.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-011-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-scarecrow-lifted",
      "sortKey": 110002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-cornfield",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Runs round the pole barking, and afterwards growls at the straw in case it is full of rats.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-012-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-scarecrow-story",
      "sortKey": 120000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-forest-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Argues that gray Kansas beats a beautiful country because it is hers, and gets nowhere with a listener made of straw.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-012-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-scarecrow-story",
      "sortKey": 120001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-forest-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Recounts being painted, propped up and out-argued by a crow, and names a lighted match as the only thing he fears.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-012-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-scarecrow-story",
      "sortKey": 120002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-forest-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Keeps out from underfoot as the walking gets worse over broken brick.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-013-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-forest-cottage",
      "sortKey": 130000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-woodman-cottage",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Feels her way along by holding an arm that cannot get tired, and sleeps on dried leaves in the corner.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-013-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-forest-cottage",
      "sortKey": 130001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-woodman-cottage",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Sees perfectly well in the dark, leads her to the cottage, and stands in the other corner until morning.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-013-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-forest-cottage",
      "sortKey": 130002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-woodman-cottage",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Curls up beside her, able to see in the dark as well as anyone else in the room.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-014-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-oiling-the-woodman",
      "sortKey": 140000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-woodman-cottage",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Fetches the oil-can from the cottage and works along the joints in the order he asks for them.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-014-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-oiling-the-woodman",
      "sortKey": 140001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-woodman-cottage",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Takes hold of the tin head and works it gently from side to side until the neck turns on its own.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-014-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-oiling-the-woodman",
      "sortKey": 140002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-woodman-cottage",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Gets his jaw and then his arms back, lowers the axe he has been holding up for a year, and asks whether Oz could manage a heart.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-014-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-oiling-the-woodman",
      "sortKey": 140003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-woodman-cottage",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Snaps at the tin legs and hurts his teeth on them.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-015-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-woodmans-story",
      "sortKey": 150000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-forest-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Tells how the Witch of the East enchanted his axe to stop a marriage, and says he would rather have the heart than the brains.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-015-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-woodmans-story",
      "sortKey": 150001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-forest-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Holds out for brains on the grounds that a fool would not know what to do with a heart.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-015-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-woodmans-story",
      "sortKey": 150002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-forest-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Cannot decide which of them is right, and is more worried that the bread is nearly gone.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-015-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-woodmans-story",
      "sortKey": 150003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-forest-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Trots ahead through the trees while the argument goes on behind him.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-016-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-lion-springs",
      "sortKey": 160000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-lion-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Slaps the Lion on the nose for going at Toto and calls him a coward to his face.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-016-lion",
      "characterId": "oz-character-lion",
      "eventId": "oz-event-lion-springs",
      "sortKey": 160001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-lion-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Admits to the charge at once, weeps about it, and asks whether Oz could let him stop being afraid.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-016-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-lion-springs",
      "sortKey": 160002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-lion-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is sent spinning to the edge of the road by one blow and picked up and patted back into shape.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-016-tin-woodman",
