      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Tells her the Silver Shoes will carry her anywhere in three steps, and that they always could have.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
