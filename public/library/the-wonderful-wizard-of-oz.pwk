      "sortKey": 170002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-lion-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Asks a question, gets no answer, and cannot understand the signs she is being made at.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-017-lion",
