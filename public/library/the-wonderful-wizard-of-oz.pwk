  "lorePages": [
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-four-countries",
      "categoryId": "oz-lore-category-country",
      "title": "The Four Countries and Their Colours",
      "body": "Oz is divided into four countries around a green city at the exact centre. The East belongs to the Munchkins and is blue; the West to the Winkies and is yellow; the South to the Quadlings and is red; the North is the home of the good witch who meets Dorothy. Each country keeps its colour in its fences, houses, clothes and crops, so a traveller always knows which quarter they are standing in.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-council-munchkins"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-desert",
      "categoryId": "oz-lore-category-country",
      "title": "The Deadly Desert",
      "body": "A desert surrounds Oz on all four sides and nobody crosses it. It is the reason a girl who wants to go home cannot simply walk, the reason the Winged Monkeys refuse a direct order, and the reason the only two people known to have arrived here came through the air.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-council-munchkins"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-witches",
      "categoryId": "oz-lore-category-magic",
      "title": "Four Witches and One Wizard",
      "body": "There were four witches in Oz: the North and South good, the East and West wicked. Their power is uneven — the Witch of the North says plainly that she was not strong enough to free the Munchkins herself. The Wizard in the Emerald City is spoken of as more powerful than all of them together, though nobody consulted has ever seen him.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-council-munchkins"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-golden-cap",
      "categoryId": "oz-lore-category-magic",
      "title": "The Charm of the Golden Cap",
      "body": "Whoever owns the Golden Cap may command the Winged Monkeys three times, and no more. The charm is written inside the lining and worked by standing on the left foot, then the right, then both, saying the words in order. Ownership passes with the Cap itself, and the count belongs to the owner, not to the Cap.",
      "tags": [],
      "coverImageId": "oz-image-item-golden-cap",
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-monkeys-carry"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-spectacles",
      "categoryId": "oz-lore-category-magic",
      "title": "The Green Spectacles",
      "body": "Every visitor to the Emerald City is fitted at the gate with green spectacles, locked on with golden bands. The Guardian of the Gates keeps the only key and the rule is said to date from the building of the city.",
      "tags": [],
      "coverImageId": "oz-image-item-green-spectacles",
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-at-the-gate"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-silver-shoes",
      "categoryId": "oz-lore-category-magic",
      "title": "The Silver Shoes",
      "body": "The Wicked Witch of the East was proud of these shoes and the Munchkins knew there was a charm on them without ever learning what it was. They fit Dorothy exactly, cannot be worn out by walking, and are feared by at least one witch who understands what they can do.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-silver-shoes-given"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-chronology",
      "categoryId": "oz-lore-category-sources",
      "title": "How This Chronology Was Reconstructed",
      "body": "The novel dates nothing and names no season, so the calendar in this world is editorial. Day one is fixed at 1 August only so that ripe corn and blooming poppies sit in a plausible month; the year is arbitrary. Every interval between scenes, however, is the book’s own: the nights on the road, the three days and four nights the tinsmiths work, the three days of waiting after the Witch dies, the three days of sewing silk, and the several days lost in the yellow fields are all counted from the text. Read the day numbers as elapsed time, not as dates.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-storm-warning"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-text-source",
      "categoryId": "oz-lore-category-sources",
      "title": "The Text Behind This World",
      "body": "The manuscript follows the complete public-domain text of L. Frank Baum’s novel in Project Gutenberg eBook #55, including Baum’s own Introduction. Every narrative paragraph from Chapters I–XXIV is assigned once in source order; Gutenberg packaging and illustration placeholders are excluded. Summaries, event divisions, chronology, maps and state notes are editorial.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-storm-warning"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-pictures",
      "categoryId": "oz-lore-category-sources",
      "title": "The Pictures in This World",
      "body": "Every portrait, item and place picture is one of W. W. Denslow’s illustrations for the 1900 first edition, which are in the public domain. The files come from Wikimedia Commons, were checked one by one against the entity they are attached to, and are shipped with the book rather than linked to another site. A few entities are deliberately left without a picture where no illustration of them exists: the Wicked Witch of the East, who is dead before the story opens, is one.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-storm-warning"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-lore-maps",
      "categoryId": "oz-lore-category-sources",
      "title": "The Maps in This World",
      "body": "Baum published no map of Oz with the 1900 edition, so every layer here is an interpretation. Six of the seven — the Land of Oz, the Emerald City, the Palace, the Yellow Castle, the China Country and Glinda’s Castle — are AI-generated maps supplied by this world’s author; the Kansas layer was drawn for this example from what the text states. The six carry names and country the 1900 book does not: the Land of Oz puts the poppy field and the china country where the sequels put them rather than where Dorothy meets them on the road, and its border figures follow the 1939 film’s designs; the palace plans name Princess Ozma and the Book of Records, which arrive in later books; the city is given four gates where the book gives it one; and the china country is given a capital, Porcelainia, that the text never mentions. Markers are pinned to the feature each painting names, so the journey doubles back west of the Emerald City between the river and the poppies; the chapter order, not the line on the map, is the record of where the party went. No layer carries a scale, so nothing here should be read as a distance.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "oz-event-house-comes-down"
    }
  ],
  "factions": [
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-munchkins",
      "name": "The Munchkins",
      "description": "The blue people of the East, freed from the Wicked Witch of the East by a falling farmhouse.",
      "color": "#5f7fa8",
      "coverImageId": "oz-image-faction-munchkins",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-winkies",
      "name": "The Winkies",
      "description": "The yellow people of the West, enslaved by the Witch through the Golden Cap and freed by a bucket of water.",
      "color": "#c9a94a",
      "coverImageId": "oz-image-faction-winkies",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-quadlings",
      "name": "The Quadlings",
      "description": "The red people of the South, short, chubby and good-natured, who keep their roads paved and their bridges strong.",
      "color": "#c4646c",
      "coverImageId": "oz-image-faction-quadlings",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-winged-monkeys",
      "name": "The Winged Monkeys",
      "description": "A free forest people bound by an old sentence to obey the owner of the Golden Cap three times over.",
      "color": "#7a6250",
      "coverImageId": "oz-image-faction-winged-monkeys",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-field-mice",
      "name": "The Field Mice",
      "description": "Thousands of mice under one queen, who pay a debt with string, a truck and directions.",
      "color": "#9c8c74",
      "coverImageId": "oz-image-faction-field-mice",
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-hammer-heads",
      "name": "The Hammer-Heads",
      "description": "An armless people who own a hill and defend it with their heads, and let nobody over it on foot.",
      "color": "#a99274",
      "coverImageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-china-people",
      "name": "The China People",
      "description": "Milkmaids, princesses, clowns and livestock, all of painted china, all breakable, all content where they are.",
      "color": "#c9a0b0",
      "coverImageId": null,
      "tags": []
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-forest-beasts",
      "name": "The Beasts of the Great Forest",
      "description": "Tigers, elephants, bears and wolves who hold meetings, and who will crown anyone who removes their monster.",
      "color": "#8a9a63",
      "coverImageId": "oz-image-faction-forest-beasts",
      "tags": []
    }
  ],
