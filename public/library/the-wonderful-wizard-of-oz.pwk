      "currentMapLayerId": "oz-map-glinda-castle",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is taken up solemnly in her arms for the last step of the journey.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-085-dorothy",
