      "currentLocationMarkerId": "oz-location-ruby-throne-room",
      "currentMapLayerId": "oz-map-glinda-castle",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Cries through four goodbyes, takes up her dog, knocks the heels together three times and asks to be taken home.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-084-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-heels-clicked",
      "sortKey": 840002,
