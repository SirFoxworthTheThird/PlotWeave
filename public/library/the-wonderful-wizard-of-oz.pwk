      "currentMapLayerId": "oz-map-glinda-castle",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Asks for the old forest over the hill where the beasts have made him king.",
      "travelModeId": null
    },
    {
