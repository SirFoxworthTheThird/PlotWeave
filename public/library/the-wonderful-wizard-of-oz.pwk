      "characterBId": "oz-character-tin-woodman",
      "label": "brains and heart",
      "strength": "strong",
      "sentiment": "positive",
      "description": "They argue about which is worth more from the day they meet and never once fail to save each other.",
      "isBidirectional": true,
      "startEventId": "oz-event-oiling-the-woodman"
    },
    {
      "worldId": "wizard-of-oz-world",
