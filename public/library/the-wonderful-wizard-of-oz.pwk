      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-prairie",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Jumps out of her arms and runs for the barn, barking furiously.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
