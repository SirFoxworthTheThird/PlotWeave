      "eventId": "oz-event-poppy-sleep",
      "sortKey": 240001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-poppy-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is asleep in the poppies before his mistress is, and is put into her lap to be carried.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-024-lion",
      "characterId": "oz-character-lion",
      "eventId": "oz-event-poppy-sleep",
      "sortKey": 240002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-poppy-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Runs for the edge of the field, does not make it, and falls asleep a short distance from clean grass.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-024-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-poppy-sleep",
      "sortKey": 240003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-poppy-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is unaffected by the scent and organises the carrying.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-024-tin-woodman",
