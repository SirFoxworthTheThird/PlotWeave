      "currentLocationMarkerId": "oz-location-kalidah-gulf",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Goes over the trunk first with Toto in her arms and screams when the roar comes from behind her.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-020-lion",
