  "loreCategories": [
    {
      "id": "oz-lore-category-country",
      "worldId": "wizard-of-oz-world",
      "name": "The Country of Oz",
      "color": "#5f8f6a",
      "sortOrder": 0
    },
    {
      "id": "oz-lore-category-magic",
      "worldId": "wizard-of-oz-world",
      "name": "Magic and Its Rules",
      "color": "#8a6fa8",
      "sortOrder": 1
    },
    {
      "id": "oz-lore-category-sources",
