      "currentLocationMarkerId": "oz-location-kalidah-gulf",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Chops the end of the tree away and drops both Kalidahs onto the rocks.",
      "travelModeId": null
    },
