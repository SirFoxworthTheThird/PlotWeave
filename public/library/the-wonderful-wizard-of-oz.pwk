      "eventId": "oz-event-beetle-and-jaws",
      "sortKey": 170001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-lion-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Gets the oil-can out of the basket and frees the jaw before anyone else has worked out what is wrong.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
