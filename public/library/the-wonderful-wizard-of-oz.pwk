      "sortKey": 190000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-first-gulf",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Rides across clinging to the mane with Toto in her arms, and is over before she has time to think about it.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-019-lion",
