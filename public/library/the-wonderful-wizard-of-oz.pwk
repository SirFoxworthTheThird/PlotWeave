      "sortKey": 190001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-first-gulf",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Says he is terribly afraid of falling and then carries all three of them over, one at a time.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-019-scarecrow",
