      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Sits up on the broad Kansas prairie, sees a new farmhouse where the old one stood, and finds the Silver Shoes gone.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
