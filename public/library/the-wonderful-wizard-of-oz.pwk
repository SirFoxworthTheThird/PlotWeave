      "id": "oz-snapshot-056-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-behind-the-screen",
      "sortKey": 560000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Demands the promise be kept and finds herself looking at the whole of the Great Oz at once.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-056-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-behind-the-screen",
      "sortKey": 560001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is caught in the open by a falling screen, begs not to be struck, and admits to being a humbug.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-056-lion",
      "characterId": "oz-character-lion",
      "eventId": "oz-event-behind-the-screen",
      "sortKey": 560002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Roars to frighten the Wizard and knocks over the screen by accident.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-056-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-behind-the-screen",
      "sortKey": 560003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Calls him a humbug to his face, which he accepts with something like relief.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-056-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-behind-the-screen",
      "sortKey": 560004,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Comes at the little man with the axe up before anyone has explained anything.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-056-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-behind-the-screen",
      "sortKey": 560005,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Jumps away from the roar and tips over the screen that hid everything.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-057-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-the-humbug-explains",
      "sortKey": 570000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-back-chamber",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Shows the properties one by one, explains ventriloquism, and admits the emeralds are ordinary stone behind green glass.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-057-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-the-humbug-explains",
      "sortKey": 570001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-back-chamber",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Tells him he is a very bad man and is corrected: a very good man, and a very bad wizard.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-057-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-the-humbug-explains",
      "sortKey": 570002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-back-chamber",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is told that experience is the only thing that brings knowledge, and wants brains anyway.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-057-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-the-humbug-explains",
      "sortKey": 570003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-back-chamber",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is told he is lucky to have no heart, and asks for one regardless.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-057-lion",
      "characterId": "oz-character-lion",
      "eventId": "oz-event-the-humbug-explains",
      "sortKey": 570004,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-back-chamber",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is told that true courage is being afraid and going on, which is no comfort at all.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-057-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-the-humbug-explains",
      "sortKey": 570005,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-back-chamber",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Pricks up his ears at a mew that has no cat behind it.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-058-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-brains",
      "sortKey": 580000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Has his head unfastened, refilled and put back on, and walks out feeling wise and bulging at the top.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-058-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-brains",
      "sortKey": 580001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Mixes bran with pins and needles, packs it in, and tells him he cannot supply instructions for using it.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-059-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-heart",
      "sortKey": 590000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Feels nothing while the hole is cut, and is delighted with a heart he is assured is a kind one.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-059-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-heart",
      "sortKey": 590001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Cuts the chest open with tinsmith’s shears, fits the heart, and apologises for the patch.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-060-lion",
      "characterId": "oz-character-lion",
      "eventId": "oz-event-courage",
      "sortKey": 600000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Sniffs at the dish, dislikes it, drinks the lot, and declares himself full of courage.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-060-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-courage",
      "sortKey": 600001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Serves it in a carved green-gold dish and privately admits he cannot see how he could be anything but a humbug.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-061-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-balloon-plan",
      "sortKey": 610000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Hears that he cannot find Kansas but can cross the desert, and that he means to come with her.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-061-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-balloon-plan",
      "sortKey": 610001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Proposes hot air instead of gas, admits he is tired of being a humbug, and says he would rather be in a circus.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-062-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-sewing-the-silk",
      "sortKey": 620000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Sews strip to strip for three days while the shape of a way home grows on the floor.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-062-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-sewing-the-silk",
      "sortKey": 620001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Cuts the silk, paints the inside with glue, and sends for a clothes basket to hang underneath.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-063-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-balloon-launched",
      "sortKey": 630000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-launching-ground",
      "currentMapLayerId": "oz-map-emerald-city",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Runs back for Toto, is a few steps short when the ropes part, and screams at a basket that cannot come back.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-063-oz",
      "characterId": "oz-character-oz",
      "eventId": "oz-event-balloon-launched",
      "sortKey": 630001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-launching-ground",
      "currentMapLayerId": "oz-map-emerald-city",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Announces a visit to a brother wizard in the clouds, leaves the Scarecrow to rule, and is carried off out of everyone’s sight for good.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-063-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-balloon-launched",
      "sortKey": 630002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-launching-ground",
      "currentMapLayerId": "oz-map-emerald-city",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Runs into the crowd to bark at a kitten, and costs her the balloon.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-063-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-balloon-launched",
      "sortKey": 630003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-launching-ground",
      "currentMapLayerId": "oz-map-emerald-city",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is named ruler of the Emerald City in front of the entire population.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-063-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-balloon-launched",
      "sortKey": 630004,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-launching-ground",
      "currentMapLayerId": "oz-map-emerald-city",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Chops the wood for the fire that fills the balloon.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-063-lion",
      "characterId": "oz-character-lion",
      "eventId": "oz-event-balloon-launched",
      "sortKey": 630005,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-launching-ground",
      "currentMapLayerId": "oz-map-emerald-city",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Watches the one certain way home leave without her.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-063-soldier",
      "characterId": "oz-character-soldier",
      "eventId": "oz-event-balloon-launched",
      "sortKey": 630006,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-launching-ground",
      "currentMapLayerId": "oz-map-emerald-city",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Fetches the clothes basket that is tied under the balloon.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-064-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-scarecrow-rules",
      "sortKey": 640000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Sits in the big throne and observes that a short while ago he was on a pole in a cornfield.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-064-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-scarecrow-rules",
      "sortKey": 640001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is well pleased with his new heart and says it was the only thing he ever wanted.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-064-lion",
      "characterId": "oz-character-lion",
      "eventId": "oz-event-scarecrow-rules",
      "sortKey": 640002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is content simply knowing he is as brave as any beast alive.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-064-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-scarecrow-rules",
      "sortKey": 640003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Says plainly that she does not want to live here, which spoils the arithmetic.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-064-toto",
      "characterId": "oz-character-toto",
      "eventId": "oz-event-scarecrow-rules",
      "sortKey": 640004,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is the reason she is still in Oz and does not know it.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-065-monkey-king",
      "characterId": "oz-character-monkey-king",
      "eventId": "oz-event-monkeys-refuse",
      "sortKey": 650000,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Bows, hears the request, and refuses it — his people belong to Oz and cannot cross the desert.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-065-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-monkeys-refuse",
      "sortKey": 650001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Spends a wish on nothing and says so bitterly.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-065-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-monkeys-refuse",
      "sortKey": 650002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Suggested the plan and has to think again.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-065-tin-woodman",
      "characterId": "oz-character-tin-woodman",
      "eventId": "oz-event-monkeys-refuse",
      "sortKey": 650003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-throne-room",
      "currentMapLayerId": "oz-map-palace",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Calls the failure too bad and means it.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-065-lion",
      "characterId": "oz-character-lion",
