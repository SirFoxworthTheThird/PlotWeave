      "stance": "neutral",
      "notes": "Two of the four countries of Oz, each keeping to its own colour and its own end of the land."
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-relationship-hammer-heads-quadlings",
      "factionAId": "oz-faction-hammer-heads",
