      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Comes out to water the cabbages, folds the girl into her arms, and asks where in the world she has come from.",
      "travelModeId": null
    },
