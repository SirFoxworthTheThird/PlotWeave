      "sortKey": 170003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-lion-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Walks at her side with stately strides and is as puzzled as she is.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-017-toto",
