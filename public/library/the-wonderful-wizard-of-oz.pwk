  "knowledgeFacts": [
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-witch-east-dead",
      "title": "The Wicked Witch of the East is dead under the farmhouse",
      "description": "The cyclone drops a Kansas house on the owner of the Munchkin country, which frees them and starts everything else.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-council-munchkins",
      "originEventId": "oz-event-council-munchkins"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-shoes-charm",
      "title": "The Silver Shoes carry a charm",
      "description": "The Munchkins know there is something in the shoes and admit they never learned what.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-silver-shoes-given",
      "originEventId": "oz-event-silver-shoes-given"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-kiss-protects",
      "title": "The Witch of the North’s kiss protects Dorothy",
      "description": "A mark on the forehead that nothing in Oz will dare injure, including the Winged Monkeys and the Witch of the West.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-kiss-and-road",
      "originEventId": "oz-event-kiss-and-road"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-oz-price",
      "title": "Oz will not help anyone until the Wicked Witch of the West is dead",
      "description": "The same price is set for all four petitioners, in four different shapes, on four consecutive days.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-dorothy-and-the-head",
      "originEventId": "oz-event-dorothy-and-the-head"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-cap-charm",
      "title": "The Golden Cap commands the Winged Monkeys three times",
      "description": "The words are written in the lining; the Witch of the West spends her last summons before Dorothy ever sees it.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-golden-cap-summons",
      "originEventId": "oz-event-golden-cap-summons"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-witch-water",
      "title": "Water destroys the Wicked Witch of the West",
      "description": "She never touches water and never lets it touch her, and one thrown bucket ends her.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-shoe-and-water",
      "originEventId": "oz-event-shoe-and-water"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-oz-humbug",
      "title": "Oz is a humbug",
      "description": "A ventriloquist and balloonist from Omaha, with no magic at all, behind a paper head and a screen.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-behind-the-screen",
      "originEventId": "oz-event-behind-the-screen"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-city-not-green",
      "title": "The Emerald City is no greener than anywhere else",
      "description": "The spectacles do the work; the city is beautiful, but the colour belongs to the glass.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-the-humbug-explains",
      "originEventId": "oz-event-the-humbug-explains"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-monkeys-cannot-leave",
      "title": "The Winged Monkeys cannot cross the desert",
      "description": "They belong to Oz alone, which spends a wish and closes the second way home.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-monkeys-refuse",
      "originEventId": "oz-event-monkeys-refuse"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-fact-shoes-could-always",
      "title": "The Silver Shoes could have taken her home on the first day",
      "description": "Three steps to anywhere in the world, and nobody who knew it met her until the last chapter.",
      "tags": [],
      "readerLearnsAtEventId": "oz-event-heels-clicked",
      "originEventId": "oz-event-heels-clicked"
    }
  ],
