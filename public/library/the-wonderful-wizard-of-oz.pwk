      "currentLocationMarkerId": "oz-location-kalidah-gulf",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Turns and roars at two animals he knows can tear him in half, which stops them for exactly as long as it takes to count them.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-020-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-kalidahs",
      "sortKey": 200002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kalidah-gulf",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Works out that the bridge can be cut from their own side and tells the Woodman where to swing.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
