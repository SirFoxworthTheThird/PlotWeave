      "currentMapLayerId": "oz-map-glinda-castle",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Says he would have lived a coward and no beast would have had a good word for him.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
