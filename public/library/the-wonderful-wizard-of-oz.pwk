      "currentLocationMarkerId": "oz-location-night-camp",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Eats the last bread with Toto and sleeps warm under the leaves someone piles over her.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-018-scarecrow",
