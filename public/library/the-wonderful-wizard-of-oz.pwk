      "id": "oz-relationship-dorothy-toto",
      "characterAId": "oz-character-dorothy",
      "characterBId": "oz-character-toto",
      "label": "girl and dog",
      "strength": "bond",
      "sentiment": "positive",
      "description": "The one piece of Kansas she has with her, and twice the reason she loses her way out of Oz.",
      "isBidirectional": true,
      "startEventId": "oz-event-storm-warning"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-relationship-dorothy-scarecrow",
      "characterAId": "oz-character-dorothy",
      "characterBId": "oz-character-scarecrow",
      "label": "rescuer and companion",
      "strength": "bond",
      "sentiment": "positive",
      "description": "She lifts him off a pole; he does the thinking for the party from then on and refuses to leave her until she is gone.",
      "isBidirectional": true,
      "startEventId": "oz-event-scarecrow-lifted"
    },
    {
