      "currentMapLayerId": "oz-map-glinda-castle",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Hands over the Cap willingly, having no further use for it, and tells the whole story to get an answer.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
