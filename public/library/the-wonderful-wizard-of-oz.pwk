      "currentLocationMarkerId": "oz-location-mice-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Designs the whole rescue — string, truck, harness — while insisting he has nothing to think with.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-026-tin-woodman",
