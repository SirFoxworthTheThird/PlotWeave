      "eventId": "oz-event-aunt-em-again",
      "sortKey": 860001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-kansas-new-house",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Says the Land of Oz, presents the dog as proof, and is glad to be at home again.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
