      "eventId": "oz-event-wildcat",
      "sortKey": 250004,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-mice-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Wakes, sees a crowd of mice, and jumps into the middle of them out of pure Kansas habit.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-026-scarecrow",
