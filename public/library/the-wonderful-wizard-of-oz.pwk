      "eventId": "oz-event-night-camp",
      "sortKey": 180003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-night-camp",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Goes off into the forest for his own supper and never says what it was.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
