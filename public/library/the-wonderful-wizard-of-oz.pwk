      "currentLocationMarkerId": "oz-location-river-crossing",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Weighs the risk aloud, flies out over the water anyway, and carries a stuffed man back to the bank by one arm.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-023-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-stork-rescue",
      "sortKey": 230001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-river-crossing",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Explains that he is stuffed with straw and will be no weight at all to carry.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-023-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-stork-rescue",
      "sortKey": 230002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-river-crossing",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Hugs everyone including the Lion, and promises to do the Stork a kindness if he ever gets any brains.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-023-tin-woodman",
