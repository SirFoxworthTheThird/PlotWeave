      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Asks to be carried back to the Emerald City, whose people like him.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
