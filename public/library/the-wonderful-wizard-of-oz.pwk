      "eventId": "oz-event-wildcat",
      "sortKey": 250001,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-mice-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Stops short, thanks him, and points out that the mouse he has saved rules all the field mice there are.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-025-scarecrow",
      "characterId": "oz-character-scarecrow",
      "eventId": "oz-event-wildcat",
      "sortKey": 250002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-mice-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Stands beside the sleeping girl and thinks of the one thing the mice could be asked for.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-025-dorothy",
      "characterId": "oz-character-dorothy",
      "eventId": "oz-event-wildcat",
      "sortKey": 250003,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-mice-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Lies asleep on the grass where she was set down, and misses the whole thing.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-025-toto",
