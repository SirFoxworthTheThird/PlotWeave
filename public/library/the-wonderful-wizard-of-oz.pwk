      "eventId": "oz-event-first-ditch",
      "sortKey": 190002,
      "isAlive": true,
      "currentLocationMarkerId": "oz-location-first-gulf",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Volunteers to go first on the grounds that he is the only one a fall would not damage.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-019-tin-woodman",
