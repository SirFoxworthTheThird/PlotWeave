      "currentLocationMarkerId": "oz-location-poppy-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Cannot keep her eyes open, goes down among the flowers, and is carried out on a chair made of two pairs of hands.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
