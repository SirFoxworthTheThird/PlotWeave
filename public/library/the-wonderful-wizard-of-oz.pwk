  "timelines": [
    {
      "id": "oz-timeline-main",
      "worldId": "wizard-of-oz-world",
      "name": "Dorothy’s Journey",
      "description": "One chronology from the Kansas cyclone to the Kansas prairie, in the order the book tells it.",
      "color": "#6f88b4",
      "dayOffset": 0,
      "createdAt": 1788393600000
    }
  ],
  "chapters": [
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-01",
      "timelineId": "oz-timeline-main",
      "number": 1,
      "title": "The Cyclone",
      "summary": "A gray Kansas farm, a sky that turns grayer, and a house lifted whole out of the middle of a whirlwind.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-02",
      "timelineId": "oz-timeline-main",
      "number": 2,
      "title": "The Council with the Munchkins",
      "summary": "Dorothy lands on a witch, is thanked for it by three Munchkins and a fourth witch, and is pointed down a yellow road.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-03",
      "timelineId": "oz-timeline-main",
      "number": 3,
      "title": "How Dorothy Saved the Scarecrow",
      "summary": "A night at a rich Munchkin’s house, and a stuffed man taken down off his pole in exchange for a walk to the city.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-04",
      "timelineId": "oz-timeline-main",
      "number": 4,
      "title": "The Road Through the Forest",
      "summary": "The bricks break up, the farms thin out, and the road runs in under trees that shut out the light.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-05",
      "timelineId": "oz-timeline-main",
      "number": 5,
      "title": "The Rescue of the Tin Woodman",
      "summary": "A groan in the trees turns out to be a man of tin who has been standing rusted for a year, and who wants a heart.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-06",
      "timelineId": "oz-timeline-main",
      "number": 6,
      "title": "The Cowardly Lion",
      "summary": "A lion springs into the road, is slapped on the nose for it, and joins the party to ask for courage.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-07",
      "timelineId": "oz-timeline-main",
      "number": 7,
      "title": "The Journey to the Great Oz",
      "summary": "Two ditches cut the road, and getting over the second one costs two Kalidahs their lives.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-08",
      "timelineId": "oz-timeline-main",
      "number": 8,
      "title": "The Deadly Poppy Field",
      "summary": "A river carries the party off course, strands the Scarecrow on a pole, and lays flesh and blood down among the poppies.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-09",
      "timelineId": "oz-timeline-main",
      "number": 9,
      "title": "The Queen of the Field Mice",
      "summary": "A wildcat is stopped mid-chase, and the mouse whose life that saves brings thousands of her people to haul a lion out of the flowers.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-10",
      "timelineId": "oz-timeline-main",
      "number": 10,
      "title": "The Guardian of the Gate",
      "summary": "A green farmhouse, a green wall, and a green man who locks a pair of spectacles onto every face that comes through the gate.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-11",
      "timelineId": "oz-timeline-main",
      "number": 11,
      "title": "The Wonderful City of Oz",
      "summary": "Four visitors are admitted to the Throne Room one at a time, and each is met by a different Oz with the same price.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-12",
      "timelineId": "oz-timeline-main",
      "number": 12,
      "title": "The Search for the Wicked Witch",
      "summary": "Wolves, crows, bees and Winkies fail; the Golden Cap does not; and a bucket of water ends the Witch of the West.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-13",
      "timelineId": "oz-timeline-main",
      "number": 13,
      "title": "The Rescue",
      "summary": "The Winkies are freed, the Woodman is beaten back into shape, the Scarecrow is restuffed, and the Golden Cap changes hands.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-chapter-14",
      "timelineId": "oz-timeline-main",
      "number": 14,
      "title": "The Winged Monkeys",
      "summary": "Lost in the yellow fields, Dorothy learns what the Cap is for, and the Monkey King explains why his band must obey it.",
      "status": "final",
      "targetWordCount": null,
      "wordGoal": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
