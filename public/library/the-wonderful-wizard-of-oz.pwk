      "currentLocationMarkerId": "oz-location-ruby-throne-room",
      "currentMapLayerId": "oz-map-glinda-castle",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Says he would have stayed in a cornfield all his life if she had known sooner.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-084-tin-woodman",
