      "currentLocationMarkerId": "oz-location-kansas-new-house",
      "currentMapLayerId": "oz-map-kansas",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Comes out to water the cabbages, folds the girl into her arms, and asks where in the world she has come from.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-086-dorothy",
