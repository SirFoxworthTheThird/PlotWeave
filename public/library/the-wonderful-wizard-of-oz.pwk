      "currentMapLayerId": "oz-map-glinda-castle",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Sits by her while the bargain is made.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-084-glinda",
      "characterId": "oz-character-glinda",
