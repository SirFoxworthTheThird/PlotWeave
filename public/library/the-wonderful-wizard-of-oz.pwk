      "currentLocationMarkerId": "oz-location-mice-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Is ready to walk the moment the Lion can.",
