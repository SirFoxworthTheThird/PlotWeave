      "currentLocationMarkerId": "oz-location-mice-field",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Rolls off the truck alive, laughs at having been undone by flowers and rescued by mice, and asks what happens next.",
