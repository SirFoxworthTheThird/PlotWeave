  "factionRelationships": [
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-relationship-winkies-witch",
      "factionAId": "oz-faction-winkies",
      "factionBId": "oz-faction-winged-monkeys",
      "stance": "hostile",
      "notes": "The Winkies were made slaves by the Winged Monkeys acting under the Golden Cap."
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-faction-relationship-munchkins-quadlings",
