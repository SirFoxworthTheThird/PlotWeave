      "currentLocationMarkerId": "oz-location-lion-road",
      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Weeps over a beetle he stepped on, rusts his jaws shut, and afterwards walks watching the road for ants.",
      "travelModeId": null
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-snapshot-017-scarecrow",
