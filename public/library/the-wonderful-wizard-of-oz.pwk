      "isBidirectional": true,
      "startEventId": "oz-event-lion-springs"
    },
    {
      "worldId": "wizard-of-oz-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "oz-relationship-scarecrow-woodman",
