      "currentMapLayerId": "oz-map-oz",
      "inventoryItemIds": [],
      "inventoryNotes": "",
      "statusNotes": "Learns from the farmer that nobody living has ever seen Oz face to face.",
      "travelModeId": null
    },
    {
