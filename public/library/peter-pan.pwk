  "lorePages": [
    {
      "worldId": "peter-pan-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "peter-pan-lore-geography",
      "categoryId": "peter-pan-lore-category-neverland",
      "title": "The Island Made True",
      "body": "Neverland responds to children’s imagination rather than ordinary geography. The reading map fixes recurring sites for continuity while preserving the novel’s dreamlike distances.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "peter-pan-event-island-sighted"
    },
    {
      "worldId": "peter-pan-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "peter-pan-lore-fairy-rule",
      "categoryId": "peter-pan-lore-category-fairies",
      "title": "Fairy Life and Belief",
      "body": "Fairies are small enough to contain one dominant feeling at a time. Their survival is linked to children’s belief, made explicit when Tinker Bell drinks poison.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "peter-pan-event-tink-home"
    },
    {
      "worldId": "peter-pan-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "peter-pan-lore-flight-rule",
      "categoryId": "peter-pan-lore-category-fairies",
      "title": "How Flight Works",
      "body": "Peter’s example, happy thoughts, and fairy dust make human flight possible; fatigue and inattention remain dangerous once the journey begins.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "peter-pan-event-learning-flight"
    },
    {
      "worldId": "peter-pan-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "peter-pan-lore-forgetting",
      "categoryId": "peter-pan-lore-category-time",
      "title": "Neverland Forgetting",
      "body": "Time does not hold Peter as it holds Wendy. His memory drops people and promises, allowing adventures to repeat while other lives accumulate consequences.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "peter-pan-event-peter-memory"
    },
    {
      "worldId": "peter-pan-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "peter-pan-lore-editorial-calendar",
      "categoryId": "peter-pan-lore-category-time",
      "title": "Editorial Calendar",
      "body": "The novel leaves much of Neverland’s duration deliberately vague. Event dates use a transparent editorial chronology: consecutive London nights, several weeks on the island, one year to the first spring visit, and approximate twenty-year generational jumps.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "peter-pan-event-darling-beginnings"
    },
    {
      "worldId": "peter-pan-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "peter-pan-lore-sources",
      "categoryId": "peter-pan-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "Structure follows the 1911 public-domain Peter and Wendy text at Project Gutenberg. F. D. Bedford’s public-domain plates illustrate places and objects. Portraits and six navigable fantasy maps are original PlotWeave assets made specifically for this example; maps are interpretive rather than canonical.",
      "tags": [],
      "coverImageId": "peter-pan-image-bedford-i005",
      "linkedEntityIds": [],
      "visibleFromEventId": "peter-pan-event-darling-beginnings"
    }
  ],
