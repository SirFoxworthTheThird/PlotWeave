ople.","portraitImageId":"tt-linked-art-eowyn","color":"#e5e7eb","tags":["rohan","royalty"],"isAlive":true,"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-char-theoden","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Théoden","aliases":["King of the Mark"],"description":"King restored by Gandalf who leads Rohan against Saruman.","portraitImageId":"tt-linked-art-theoden","color":"#b45309","tags":["rohan","king"],"isAlive":true,"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-char-grima-wormtongue","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Gríma Wormtongue","aliases":["Wormtongue"],"description":"Saruman's corrupt agent in Théoden's court.","portraitImageId":"tt-linked-art-grima","color":"#4b5563","tags":["rohan","isengard","antagonist"],"isAlive":true,"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-char-treebeard","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Treebeard","aliases":["Fangorn"],"description":"Ancient Ent who leads the march on Isengard.","portraitImageId":"tt-linked-art-treebeard","color":"#166534","tags":["ent","fangorn"],"isAlive":true,"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-char-quickbeam","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Quickbeam","aliases":["Bregalad"],"description":"Hasty Ent who befriends Merry and Pippin.","portraitImageId":"tt-linked-art-quickbeam","color":"#22c55e","tags":["ent","fangorn"],"isAlive":true,"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-char-shadowfax","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Shadowfax","aliases":[],"description":"Great horse who freely bears Gandalf.","portraitImageId":"tt-linked-art-shadowfax","color":"#d1d5db","tags":["horse","rohan"],"isAlive":true,"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-char-erkenbrand","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Erkenbrand","aliases":[],"description":"Westfold lord who arrives at Helm's Deep.","portraitImageId":"tt-linked-art-erkenbrand","color":"#dc2626","tags":["rohan"