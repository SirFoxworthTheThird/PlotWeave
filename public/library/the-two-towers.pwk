e":"Oliphaunt","aliases":["Mûmak"],"description":"Enormous war-beast seen by Sam.","portraitImageId":"tt-linked-art-oliphaunt","color":"#78716c","tags":["creature","harad"],"isAlive":true,"createdAt":1784551000000,"updatedAt":1784551000000}],"items":[{"id":"0EvCkqjFL_EIU5BbJ4SJ1","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Mithril Coat","description":"A lightweight but incredibly strong chainmail shirt made of pure Mithril. Given to Frodo by Bilbo.","iconType":"armor","tags":["Armor","Dwarven","Legendary"],"imageId":"Xx8qqygrlfH2bOb2WtJbq"},{"id":"1p4UWZljfyVvjFR2k3qaC","imageId":"PJqXIVGq6vcQzWVCdLszO","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Narsil (Broken)","description":"The legendary sword of Elendil, broken during the battle with Sauron.","iconType":"weapon","tags":["Weapon","Sword","Relic"]},{"id":"LXvRUd-xpyjyN-lHkVMs5","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Lembas","description":"Elven waybread. Extremely nutritious; one wafer can sustain a traveler for a day of hard labor.","iconType":"consumable","tags":["Food","Elven"],"imageId":"RempBtM67b3oPB5LjS3iT"},{"id":"P1vQTecPw23NSjgZ01EkY","imageId":"pSyNi0fM0dZWP7DaFXwFJ","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The One Ring","description":"One ring to rule them all","iconType":"","tags":[]},{"id":"Z8xNo8r3psRTcJ5AvJvRC","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Hithlain Rope","description":"Light, strong, grey-silvery rope made by the Elves of Lórien.","iconType":"tool","tags":["Tool","Elven"],"imageId":"2c2IZUej4xucgTiJquKAT"},{"id":"_1IvoPnXUKAImhbDwFU6R","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Nenya","description":"The Ring of Water, one of the Three Elven Rings of Power. It is made of Mithril and set with a stone of adamant. Wielded by Galadriel to protect and preserve Lothlórien.","iconType":"ring","tags":["Ring of Power","Elven","Legendary"],"imageId":"F7leEzYUJZGAZ_llvFrRA"},{"id":"bfAAVTXpFsNuM1g2vXw_U","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Elfstone","description":"A great green stone set in a silver eagle brooch, given to Aragorn as a token of hope.","iconType":"artifact","tags":["Jewelry","Elven"],"imageId":"ESJJ2e-gntLnHwN1tuShv"},{"id":"dMLC2wMtDuJRGDxTuNYrk","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Galadriel's Hair","description":"Three strands of golden hair from the Lady of the Wood, given to Gimli at his request.","iconType":"artifact","tags":["Relic","Gift"],"imageId":"R29kjt-rvJl5O0iMn8OvE"},{"id":"eiOIekJje8b0TbGpWGylC","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Phial of Galadriel","description":"A crystal phial containing the light of Eärendil's star caught in the waters of Galadriel's fountain.","iconType":"artifact","tags":["Magic","Light"],"imageId":"TguXzQmGEnSXMLo9aDVo0"},{"id":"fwtofkht8ZK2vdcyNnlfE","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Sting","description":"An ancient Elven dagger that glows blue in the presence of Orcs. Given to Frodo by Bilbo.","iconType":"weapon","tags":["Weapon","Dagger","Elven"],"imageId":"AraZQiI15mcD889uM8di1"},{"id":"hSZsuTBU-kPisRoriD5Fw","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Mirror of Galadriel","description":"A silver basin on a low pedestal, filled with water from a nearby stream. It shows visions of the past, present, and possible futures.","iconType":"artifact","tags":["Magic","Artifact"],"imageId":"Bl6mlcxlVj1qOLBc6tDN9"},{"id":"n3b-xE3nm7Y7awDFs6gn_","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Bow of the Galadhrim","description":"A stout bow strung with Elf-hair, longer and stronger than those of Mirkwood.","iconType":"weapon","tags":["Weapon","Bow","Elven"],"imageId":"QQprlD2qK_KdHpbEpvo94"},{"id":"oq_0d9s3_dCztavkxX_Ls","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Elven Cloak","description":"A grey-green cloak fastened with a leaf-brooch of Lórien that helps camouflage the wearer from unfriendly eyes.","iconType":"armor","tags":["Clothing","Elven","Stealth"],"imageId":"VJVjZozOl61R_FyEU59YX"},{"id":"sfw13T58FQSxR-haRNaP2","imageId":"_pnC-8ibe0QAHH_BxA_9a","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Gandalf's Letter","description":"A delayed letter from Gandalf urging Frodo to leave the Shire quickly and confirming Strider's true identity.","iconType":"document","tags":["Document","Letter"]},{"id":"ttuM42s36CAHfB45OlBMP","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Andúril","description":"The Flame of the West. Forged in Rivendell from the shards of Narsil for Aragorn.","iconType":"weapon","tags":["Weapon","Sword","Legendary"],"imageId":"wlhgQhuUREKoRPIKyh10f"},{"id":"txLrjQDfT34wH0gd3RYWE","imageId":"iK0DM-EzrlY-IwWc1AgAQ","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Barrow-blades","description":"Ancient daggers forged by the Men of Westernesse.","iconType":"weapon","tags":["Weapon","Dagger"]},{"id":"yU2pZBiXkzp12ZiR-vQEp","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Morgul-blade","description":"A poisoned magical dagger wielded by the Nazgûl. A piece of the blade breaks off in the victim to pull them into the wraith world.","iconType":"weapon","tags":["Weapon","Cursed"],"imageId":"hIw0P-EiFfNk-DetxBU0P"},{"id":"ymA2xixhSAyjNm4eOCRYb","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Athelas","description":"Also known as Kingsfoil, a healing herb brought to Middle-earth by the Men of Westernesse. Strider uses it to combat the effects of the Morgul-wound.","iconType":"consumable","tags":["Herb","Healing"],"imageId":"6plHt-wywLL6cGzV-ldr0"},{"id":"tt-item-horn-boromir","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Horn of Gondor","description":"Boromir's cloven great horn.","iconType":"artifact","imageId":"tt-linked-art-hornGondor","tags":["gondor","boromir"],"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-item-palantir","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Palantír of Orthanc","description":"Seeing-stone cast from Orthanc and used by Pippin.","iconType":"artifact","imageId":"tt-linked-art-palantir","tags":["isengard"],"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-item-herugrim","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Herugrim","descri