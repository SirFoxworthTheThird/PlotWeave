d":null,"factionId":null},{"id":"bDfYCHRkFrFAHhvdhwJ6P","worldId":"mOlU8GWK_NGtK-STFFtqC","mapLayerId":"GnhVvhk2E-aE6PXavQdbE","name":"Mordor","vertices":[{"x":1069.6917999449477,"y":456.5291067891728},{"x":1087.8272084487392,"y":171.33115391522486},{"x":1323.290217219278,"y":177.8737555452842},{"x":1459.1571301083388,"y":273.07044853390505},{"x":1453.2110945333252,"y":460.40428842282233}],"fillColor":"#e879f9","opacity":0.35,"createdAt":1784550029705,"updatedAt":1784550029705,"linkedMapLayerId":null,"factionId":null}],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"8Za9VVMPOsH5sfrg846fg","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Previously — The Fellowship of the Ring","color":"#f59e0b","sortOrder":5},{"id":"M9i7S9G2qVFsaPloPmcbi","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Magic and Artifacts","color":"#d97706","sortOrder":3},{"id":"PjcULVUewgtAym3MWfGLk","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Creatures and Enemies","color":"#dc2626","sortOrder":4},{"id":"f__CEuNIn_vXKKnpwfSv3","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"History and the Rings","color":"#7c3aed","sortOrder":0},{"id":"guZLHsHRN2MN5rd2TwRuf","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Places of Middle-earth","color":"#059669","sortOrder":2},{"id":"n4-7-u6RkXJhiLoG-i0sn","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Peoples and Powers","color":"#2563eb","sortOrder":1},{"id":"tt-lore-cat-current","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Two Towers — War and Journey","color":"#ea580c","sortOrder":6}],"lorePages":[{"id":"5FQYcx_jeb4B38L1meeg9","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"f__CEuNIn_vXKKnpwfSv3","title":"The Fall of Khazad-dûm","body":"Moria was the greatest Dwarf-realm before Durin's Bane drove its people out; Balin's later colony also perished.","tags":["moria","dwarves"],"coverImageId":null,"linkedEntityIds":["QozrCLRO9xfdXwbjEmmJL","fXyXShLva9IWH3IoSLGyB"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"6QUsyM08lfRSYcBioLXHY","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"guZLHsHRN2MN5rd2TwRuf","title":"Isengard and Orthanc","body":"Saruman occupies the tower of Orthanc, where he imprisons Gandalf after revealing his treachery.","tags":["isengard","orthanc"],"coverImageId":null,"linkedEntityIds":["yhXu3wmFD4C-VVgmJl4gi","n0eRXLOH0tLya9d30L-mt","kLQ9TiNBdeAWrkOgoq_Vw"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"6Zlnsu707vaoS808ltqtc","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 19 — The Mirror of Galadriel","body":"The Fellowship rests in the timeless realm of Lothlórien for many days. Galadriel brings Frodo and Sam to her secret enclosed garden to look into the Mirror of Galadriel. Sam is horrified by visions of the Shire being destroyed, while Frodo sees the terrifying Eye of Sauron. Galadriel reveals that she is a Ring-bearer, possessing Nenya, the Ring of Water. Frodo offers her the One Ring, but she refuses the ultimate temptation, accepting that her time is ending and she will diminish into the West.\n\n- **Rest in Lothlórien** — The Fellowship rests in Caras Galadhon for many days. Time seems to pass differently in the Golden Wood. They listen to the Elves sing laments for Gandalf, finding healing for their bodies but deep sorrow in their hearts.\n- **Looking into the Mirror** — Galadriel leads Frodo and Sam away from the others to her secret garden. She fills a silver basin with stream water and invites them to look. Sam sees men destroying the Shire, while Frodo looks deeper and sees the terrifying Eye of Sauron searching for him.\n- **The Temptation of Galadriel** — Galadriel reveals Nenya, her Ring of Power. Overwhelmed by the burden of his quest, Frodo offers her the One Ring. Galadriel is deeply tempted, appearing as a terrifyingly beautiful queen, but ultimately refuses, choosing to diminish and remain herself.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029723},{"id":"6nRteehGajdHw5qQ_axbO","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 17 — The Bridge of Khazad-dûm","body":"The Fellowship discovers the tomb of Balin in the Chamber of Mazarbul. They are ambushed by Orcs and a Cave-troll. Frodo is stabbed by an Orc-chieftain but miraculously survives. Fleeing toward the East-gate, they are pursued by a Balrog, Durin's Bane. At the Bridge of Khazad-dûm, Gandalf stands his ground, shattering the bridge to save the others. He is dragged into the abyss by the Balrog's whip. The remaining eight members escape Moria into the Dimrill Dale, grief-stricken.\n\n- **The Chamber of Mazarbul** — The Fellowship enters a lit chamber and discovers the tomb of Balin. Gandalf reads from a battered book chronicling the Dwarves' doomed attempt to retake Moria, ending with the chilling words: 'They are coming.'\n- **Ambush!** — Drums echo from the deep. The chamber is attacked by a horde of Orcs and a massive Cave-troll. A fierce battle ensues. Frodo is speared by a huge Orc-chieftain, throwing him against the wall, but he survives thanks to his hidden mithril coat. They fight their way out the eastern door.\n- **Flight to the Bridge** — The company flees down endless stairs toward the East-gate, pursued by Orcs. A terrifying new presence enters the fray, a creature of shadow and flame that shatters Gandalf's holding spell on a door. They race to the narrow Bridge of Khazad-dûm over a bottomless chasm.\n- **The Bridge of Khazad-dûm** — Gandalf orders the others across the bridge and stands alone against the Balrog. He breaks the bridge with his staff, sending the demon into the abyss. However, the Balrog's whip lashes out, catching Gandalf's knees and dragging him down into the dark. 'Fly, you fools!' he cries before falling.\n- **Escape to Dimrill Dale** — With Gandalf gone, Aragorn takes command, leading the weeping Fellowship out through the East-gate and into the daylight of Dimrill Dale. They fall to the ground, overcome with grief for their fallen leader.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029721},{"id":"7j0NGpXFYmLsFzoU6oB34","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"f__CEuNIn_vXKKnpwfSv3","title":"The Last Alliance","body":"Elendil and Gil-galad overthrew Sauron at the end of the Second Age, dying in the victory before Isildur claimed the Ring.","tags":["last-alliance","sauron"],"coverImageId":null,"linkedEntityIds":["l8D-LSQ00Ur6U30y7Jd7X","Ca6h5Mi5AkAMkwVDNkT2Y","QRFhfSrTIquPTB7M8xkZi","CHPJsdi_fs7rASN_A2X-a"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"8f9DTNxSmZSRVrVqGWoJn","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"guZLHsHRN2MN5rd2TwRuf","title":"Bree and the Prancing Pony","body":"Crossroads settlement where hobbits and Men live together and Frodo first meets Aragorn.","tags":["bree"],"coverImageId":null,"linkedEntityIds":["AzYFLEZk-dNs0ZCR1FT6j","3ZlHhxc5lhpJfOLSdvEqE"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"8jvD0bLQ-kY-0jBv-uNin","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 18 — Lothlórien","body":"The grieving Fellowship escapes the pursuit of Moria's Orcs and crosses the river Nimrodel into the golden wood of Lothlórien. They are intercepted by Haldir, an Elven march-warden. Due to the deep mistrust between Elves and Dwarves, Gimli is required to be blindfolded, prompting Aragorn to require the entire company to be blindfolded in solidarity. They are led to Caras Galadhon, the city of trees, where they meet Lord Celeborn and Lady Galadriel. The Lady tests the resolve of the Company, and they find a temporary, timeless haven to rest.\n\n- **Crossing the Nimrodel** — Fleeing the Orcs of Moria, Aragorn leads the weary Fellowship to the borders of Lothlórien. They cross the icy river Nimrodel, finding temporary safety under the eaves of the golden wood, though their grief for Gandalf remains heavy.\n- **Intercepted by Haldir** — While resting in the trees (flets), the company is discovered by Haldir and the march-wardens of Lórien. Haldir welcomes Legolas and Aragorn, but views Gimli with deep suspicion. He agrees to guide them, but insists Gimli must be blindfolded when they enter the inner woods.\n- **The Blindfolded March** — Gimli angrily refuses to be the only one blindfolded. To keep the peace and show solidarity, Aragorn decrees that the entire Fellowship, including Legolas, will walk blindfolded. They march through the golden woods until news arrives from Galadriel that they may walk freely.\n- **Caras Galadhon and the Testing** — The company arrives at Caras Galadhon, the city of trees. They are brought before Lord Celeborn and Lady Galadriel. Celeborn is angered to hear that Dwarves awakened Durin's Bane, but Galadriel rebukes him and speaks kindly to Gimli. She then holds the gaze of each member of the Fellowship, silently testing their hearts and desires.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029722},{"id":"BSV3KigBRoN9HmnSgUzgN","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 7 — In the House of Tom Bombadil","body":"The Hobbits spend two nights resting in the enchanting home of Tom Bombadil and Goldberry. Tom entertains them with deep stories of the Old Forest and Middle-earth's history, demonstrating a complete immunity to the One Ring's power. Refreshed, the Hobbits set out for the Barrow-downs.\n\n- **Welcome by Goldberry** — The Hobbits arrive at the house and are greeted by the beautiful Goldberry, the River-daughter. The atmosphere in the house is peaceful and completely dispels their lingering fear of the Old Forest.\n- **Stories of the Old World** — During their stay, Tom tells the Hobbits vast, sprawling stories of the Old Forest's anger, the ancient kings, and the dark barrows. His words transport them, making them feel the immense age of the world.\n- **Master of the Ring** — Tom asks to see the Ring. When he puts it on, he does not vanish. He then makes the Ring disappear with a flick of his wrist and returns it to Frodo. Suspicious, Frodo puts it on to check, turning invisible to his friends, but Tom can still see him clearly.\n- **Departure for the Downs** — After a second restful night, the Hobbits prepare to leave. Tom teaches them a rhyme to summon him if they fall into danger and warns them to keep to the green grass as they head toward the Barrow-downs.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029711},{"id":"Cpp3VtiaKRP7SaQaW88P3","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 16 — A Journey in the Dark","body":"Turned back by the snow on Caradhras, the Fellowship decides to take the dark and secret path through the Mines of Moria. After fighting off a pack of Wargs, they reach the Doors of Durin. Gandalf struggles to find the password but eventually opens the doors. Bill the Pony is sent away. As they enter, the Watcher in the Water attacks Frodo and destroys the doors behind them, trapping the Fellowship in the dark, ruined halls of Khazad-dûm. They journey through the dark and arrive at the Twenty-first Hall.\n\n- **The Warg Attack** — After retreating from Caradhras, the Fellowship is ambushed in the night by a pack of Wargs. They successfully defend themselves, with Gandalf using fire magic and Legolas his bow, solidifying their decision to take the secret path through Moria.\n- **The Doors of Durin** — The company arrives at the stagnant pool before the West-gate of Moria. Gandalf finds the hidden Doors of Durin but struggles to decipher the password. After much frustration, he realizes the riddle is simple and speaks the word 'Mellon' (friend), opening the doors.\n- **The Watcher in the Water** — As they prepare to enter, Gandalf unloads Bill the Pony and sends him away. Suddenly, many-tentacled arms erupt from the stagnant pool, grabbing Frodo. Sam slashes a tentacle, and the company scrambles inside Moria. The Watcher rips down the trees outside, collapsing the doors and trapping them.\n- **Journey to the Twenty-first Hall** — Trapped, the Fellowship marches in darkness for days through the ruined, silent halls of Khazad-dûm, guided only by the faint light of Gandalf's staff. Pippin drops a stone down a well, causing ominous echoes. They eventually arrive at the vast Twenty-first Hall to rest.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029720},{"id":"DdGjvfIHsI63n70TXTB5X","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"guZLHsHRN2MN5rd2TwRuf","title":"Moria","body":"The Fellowship enters the abandoned Dwarf-realm through the Doors of Durin and escapes by the East-gate after Gandalf's fall.","tags":["moria"],"coverImageId":null,"linkedEntityIds":["6DLBEODxLpnmceiGbKauR","SyLOPfJMeeMQ9MAxstVgB","MgYXCMmGirvhVCeqMT3xq"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"H83ACk_4-uuczhQw6_-Rb","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"n4-7-u6RkXJhiLoG-i0sn","title":"The Dwarves of Erebor and Moria","body":"Gimli and Glóin represent Erebor, while the ruins of Moria expose the cost of lost Dwarven kingdoms.","tags":["dwarves","moria"],"coverImageId":null,"linkedEntityIds":["Nv5uBLAaZswrplrghjM1L","0Heg1WYt4TU59QLmPwIGs"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"L2eAgjjjgL37H1MzszRhs","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 9 — At the Sign of the Prancing Pony","body":"The Hobbits arrive in the village of Bree and secure rooms at The Prancing Pony inn. In the common room, Frodo accidentally slips the Ring onto his finger and vanishes, causing an uproar. This catches the attention of a mysterious Ranger known as Strider, who asks to speak with Frodo privately.\n\n- **Arrival in Bree** — The tired Hobbits arrive at the gates of Bree in the dark. After a brief encounter with the gatekeeper, they make their way to The Prancing Pony and secure rooms under the name 'Underhill' to hide Frodo's identity.\n- **The Common Room** — Frodo, Sam, and Pippin go down to the common room for drinks, while Merry goes out for a walk. Pippin begins to tell a story about Bilbo's disappearance, threatening to reveal Frodo's true identity to the listening crowd.\n- **The Vanishing Trick** — To distract the crowd from Pippin's story, Frodo jumps on a table to sing a song. He slips and falls, and the Ring somehow slides onto his finger. He vanishes instantly, causing a massive uproar and drawing intense scrutiny from the Ranger, Strider.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029713},{"id":"LmLcvWGNDJxO0MDwG-J6H","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 10 — Strider","body":"Strider speaks to the Hobbits in their parlor, offering his protection and guidance. Barliman Butterbur remembers to deliver a letter from Gandalf, which confirms Strider's true identity as Aragorn. Merry rushes in with news that Black Riders are in Bree. The group decides to accept Strider's help and prepares to depart secretly.\n\n- **Strider's Offer** — Strider slips into the Hobbits' parlor after the commotion in the common room. He demands his reward—that they take him along as their guide—and reveals he knows Frodo's true name and the danger pursuing them.\n- **Gandalf's Delayed Letter** — Barliman Butterbur bursts into the parlor, immensely apologetic. He finally remembers to deliver a letter left by Gandalf three months prior. The letter urges Frodo to flee the Shire and confirms that Strider is a friend whose true name is Aragorn.\n- **Merry's Warning** — Merry rushes into the parlor, breathless and shaken. He reports that he saw Black Riders in the dark streets of Bree, and that he was overcome by a sudden, unnatural terror before recovering.\n- **The Decoy Rooms** — Realizing the inn is no longer safe, Aragorn takes command. They arrange bolsters and pillows in their assigned beds to act as decoys, while the Hobbits and Aragorn lock themselves in the parlor to sleep on the floor.\n- **The Inn Is Raided** — Black Riders break into the hobbits' decoy rooms while Strider's precautions keep the travelers safe.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029714},{"id":"NdAQUtJUDpYRCKW-0PrOv","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"n4-7-u6RkXJhiLoG-i0sn","title":"The Istari","body":"Gandalf, Saruman, and Radagast are Wizards sent to contest Sauron through counsel rather than domination.","tags":["wizards","istari"],"coverImageId":null,"linkedEntityIds":["Z3WTGGdrOBdao2wIcdWy8","kLQ9TiNBdeAWrkOgoq_Vw","RP5mMRdvg-whoQIBD73_E"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"Ndo85xi1Y_9H_lAqhjQtC","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"PjcULVUewgtAym3MWfGLk","title":"Durin's Bane","body":"A Balrog of shadow and flame sleeps beneath Moria until confronting Gandalf at the bridge.","tags":["balrog","moria"],"coverImageId":null,"linkedEntityIds":["QozrCLRO9xfdXwbjEmmJL","Z3WTGGdrOBdao2wIcdWy8"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"OVuahP3QQhqqrFUtPv4lD","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 21 — The Great River","body":"The Fellowship travels down the River Anduin for many days, secretly shadowed by Gollum drifting on a log. Approaching the rapids of Sarn Gebir, they are ambushed by Orcs from the eastern shore, and Legolas shoots down a Nazgûl's winged steed in the dark. They navigate through the Argonath, the colossal Pillars of the Kings, and finally camp at the lawn of Parth Galen above the Falls of Rauros, where they must decide whether to head toward Minas Tirith or Mordor.\n\n- **A Shadow on the River** — The Fellowship travels down the Anduin. Sam and Frodo spot a log with eyes—Gollum—trailing them at night. Boromir grows increasingly restless and mutters to himself, staring intensely at Frodo.\n- **Ambush at Sarn Gebir** — Nearing the rapids of Sarn Gebir at night, the company is ambushed by Orc-arrows from the eastern shore. A dark shape passes over the stars, striking fear into their hearts. Legolas fires his new bow, striking a Nazgûl's fell beast and sending it plummeting.\n- **The Argonath** — After portaging the boats past the rapids, they row between the immense, awe-inspiring Pillars of the Kings—the Argonath. Aragorn stands tall, feeling the pride and burden of his ancestors.\n- **Camp at Parth Galen** — The river journey ends as they reach the calm waters before the Falls of Rauros. They set up camp at the lawn of Parth Galen under the shadow of Amon Hen. The time has come to choose their path: east to Mordor or west to Minas Tirith.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029725},{"id":"OsDg4aHKiXkANUibZpaz8","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 2 — The Shadow of the Past","body":"Seventeen years pass. Gandalf returns and reveals to Frodo that his ring is the One Ring forged by the Dark Lord Sauron. Samwise Gamgee is caught eavesdropping and is chosen by Gandalf to accompany Frodo on his journey to take the Ring away from the Shire.\n\n- **Seventeen Years Pass** — Seventeen years pass quietly in the Shire. Frodo Baggins reaches his fiftieth year, preserving his youth much like Bilbo did. Rumors of a growing darkness in the East slowly reach the borders of the Shire, though Frodo remains mostly undisturbed.\n- **The Test of Fire** — Gandalf the Grey suddenly returns to Bag End after a long absence. Bearing grave suspicions, he asks Frodo to hand over the ring and casts it into the hearth fire. After a moment, he retrieves it bare-handed, revealing glowing Elvish letters that confirm it is the One Ring.\n- **The Tale of the Ring** — Gandalf explains the terrifying history of the One Ring, from its creation by Sauron to its discovery by Sméagol. He reveals that Gollum left the mountains and was captured and tortured in Mordor, where he surrendered two vital words: 'Shire' and 'Baggins'.\n- **Déagol Finds the Ring** — Gandalf recounts how Déagol found the Ring and Sméagol murdered him to possess it.\n- **A Companion Chosen** — Realizing the Shire is no longer safe, Frodo resolves to leave. Suddenly, Gandalf catches Samwise Gamgee eavesdropping beneath the open window. Instead of a harsh punishment, Gandalf orders the terrified but eager Sam to accompany Frodo on his perilous journey.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029706},{"id":"Q3DJ9kx4mK4OwB5QXjdCJ","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"f__CEuNIn_vXKKnpwfSv3","title":"The White Council","body":"The Wise opposed Sauron's return, but Saruman used his authority and ring-lore for his own designs.","tags":["white-council","wizards"],"coverImageId":null,"linkedEntityIds":["Z3WTGGdrOBdao2wIcdWy8","kLQ9TiNBdeAWrkOgoq_Vw","Mg5v7EaBZ-BduiqN9mglE","A3Mss2GV_4rKTRZcxOItF"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"QHNzdGtMZQVn9UO_vhYNR","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"guZLHsHRN2MN5rd2TwRuf","title":"The Lower Anduin and Amon Hen","body":"The Company's river journey passes Sarn Gebir and the Argonath before ending at Parth Galen and Amon Hen.","tags":["anduin","amon-hen"],"coverImageId":null,"linkedEntityIds":["UJ5kyKnLNhFSRQTOlgkgW","1-RKZPWQIDaZjx9X8Ca5e","DRWIrDpffsEPjOX7JHIgm"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"UqKujIt7PSDbC7pl4fZuu","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"f__CEuNIn_vXKKnpwfSv3","title":"The Rings of Power","body":"Sauron made the One Ring to dominate the other Rings of Power. Three Elven Rings remain beyond his direct touch but are bound to the One.","tags":["rings","second-age"],"coverImageId":null,"linkedEntityIds":["P1vQTecPw23NSjgZ01EkY","_1IvoPnXUKAImhbDwFU6R"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"VIAvSgwClZHv3bSfTYQpU","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"M9i7S9G2qVFsaPloPmcbi","title":"Morgul Blades and Wraithing","body":"A fragment of a Morgul-blade works toward the victim's heart and can transform them into a wraith.","tags":["morgul","nazgul"],"coverImageId":null,"linkedEntityIds":["yU2pZBiXkzp12ZiR-vQEp","fdlgA1T4W1ApzalSCjK99"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"VUH6z65kskDma63AL3r28","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 1 — A Long-expected Party","body":"Bilbo Baggins celebrates his eleventy-first birthday with a magnificent party and suddenly vanishes using his magic ring. After a tense confrontation with Gandalf, Bilbo leaves the Shire, leaving the Ring and Bag End to Frodo.\n\n- **The Birthday Party** — Bilbo Baggins hosts an extravagant eleventy-first birthday party for himself and a coming-of-age party for Frodo. Gandalf the Grey provides a magnificent display of fireworks, dazzling the guests from all over the Shire.\n- **Bilbo's Farewell Speech** — During his speech after the grand dinner, Bilbo bids a fond and somewhat confusing farewell to his guests. He unexpectedly slips his magic ring onto his finger and vanishes entirely, plunging the party into chaos.\n- **Confrontation at Bag End** — Bilbo returns to Bag End to pack his things. Gandalf is waiting for him and confronts him about his behavior and his strange attachment to the Ring. After a moment of hostility, Bilbo relents, drops the Ring on the floor in an envelope, and departs into the night.\n- **Master of Bag End** — Frodo inherits Bag End and Bilbo's remaining possessions, including the mysterious Ring. Gandalf warns Frodo to keep the Ring secret and safe before departing the Shire. The next day, Frodo deals with the aftermath of the party and fends off greedy relatives like Lobelia Sackville-Baggins.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"VoJrL3DQpV8uRsFD4_2Fo","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"M9i7S9G2qVFsaPloPmcbi","title":"The One Ring","body":"The ruling Ring grants invisibility by drawing mortals into the unseen world, corrupts desire, and can be destroyed only in Orodruin.","tags":["ring","sauron"],"coverImageId":null,"linkedEntityIds":["P1vQTecPw23NSjgZ01EkY","CHPJsdi_fs7rASN_A2X-a","vxoxTk2Mvm4tJHSZMOCXu"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"XFzV2S4dGWdVOLl19SzNh","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"guZLHsHRN2MN5rd2TwRuf","title":"Rivendell","body":"Elrond's hidden refuge heals Frodo and becomes the place where the quest and Fellowship are established.","tags":["rivendell"],"coverImageId":null,"linkedEntityIds":["cV390rDKOsTUrRjwemp-L","XPLP69kpgKMCcdE2pKr0W"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"XUnlsDkCXkSlL74ebtP9i","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"PjcULVUewgtAym3MWfGLk","title":"The Nazgûl","body":"Nine enslaved Ringwraiths serve Sauron, led by the Witch-king, and hunt the Ring through fear and the unseen world.","tags":["nazgul","sauron"],"coverImageId":null,"linkedEntityIds":["mLO9rn6KFAvmCZVImXmbc","fdlgA1T4W1ApzalSCjK99"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"YTERagNQOtR4SHODQhWP2","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"M9i7S9G2qVFsaPloPmcbi","title":"The Three Elven Rings","body":"The Three preserve and defend Elven realms. Galadriel bears Nenya, but their power depends on the fate of the One.","tags":["rings","elves"],"coverImageId":null,"linkedEntityIds":["_1IvoPnXUKAImhbDwFU6R","Mg5v7EaBZ-BduiqN9mglE","A3Mss2GV_4rKTRZcxOItF"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"aN2EFPIf4rkAWKcBchJho","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 4 — A Short Cut to Mushrooms","body":"Frodo, Sam, and Pippin cut across the country to avoid the roads and the pursuing Black Riders. They navigate the Marish and encounter Farmer Maggot. Despite Frodo's childhood fears of him, Maggot proves to be a stout ally, feeding them and driving them safely in his wagon to the Bucklebury Ferry, where they reunite with Merry Brandybuck.\n\n- **Leaving the Road** — To avoid the pursuit of the Black Riders, Frodo decides they must leave the main road and cut straight across the country. They trudge through rough terrain and thick woods toward the Marish.\n- **The Rider on the Hill** — Looking back, the Hobbits spot a Black Rider silhouetted against the sky on the very hill they had just descended. They hurry deeper into the lowlands to escape his sight.\n- **Encounter at Bamfurlong** — The group arrives at Bamfurlong, the farm of Farmer Maggot. Despite Frodo's terror from a childhood incident involving stolen mushrooms and Maggot's dogs, Maggot proves friendly. He reveals a Black Rider recently questioned him, and he invites the weary Hobbits in for supper.\n- **Ride to the Ferry** — To protect them, Farmer Maggot hides the Hobbits in his wagon under a tarp and drives them through the fog to the Bucklebury Ferry. There, they safely reunite with Merry Brandybuck.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029708},{"id":"dFKOh8YrF3aWgCSU2fdq4","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"PjcULVUewgtAym3MWfGLk","title":"The Watcher in the Water","body":"Tentacled creature in the pool outside Moria that attacks Frodo and seals the western entrance.","tags":["watcher","moria"],"coverImageId":null,"linkedEntityIds":["5Bi3EF6h5aPimU1sa386A"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"eYGolgQmmhqOBcIhJMcEP","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"M9i7S9G2qVFsaPloPmcbi","title":"Mithril","body":"Rare silver metal of Moria, lighter and stronger than steel; Bilbo's hidden coat saves Frodo from a spear thrust.","tags":["mithril","moria"],"coverImageId":null,"linkedEntityIds":["0EvCkqjFL_EIU5BbJ4SJ1","vxoxTk2Mvm4tJHSZMOCXu"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"elj8n7Jwp0ov4HenIA96d","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"guZLHsHRN2MN5rd2TwRuf","title":"Lothlórien","body":"Galadriel and Celeborn's Golden Wood offers the Company rest, testing, counsel, and gifts.","tags":["lothlorien"],"coverImageId":null,"linkedEntityIds":["eLg53ao-A0G-kZWUDg2km","i60IKM5k4f_2Ag5hZEDKU","Mg5v7EaBZ-BduiqN9mglE"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"hvOxz-cMIcaTiiGb6hCYi","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 3 — Three is Company","body":"Frodo, Sam, and Pippin set out from Bag End without Gandalf. They are stalked on the road by a mysterious Black Rider but are saved by a chance meeting with a company of High Elves led by Gildor Inglorion.\n\n- **Departure from Bag End** — After selling Bag End, Frodo waits anxiously for Gandalf. When the wizard fails to appear by autumn, Frodo, Sam, and Pippin slip away in the evening, leaving the Shire quietly on foot.\n- **The Sniffing Rider** — While walking along the road, the Hobbits hear the sound of hooves. They hide in the roots of a large tree just as a mysterious figure on a black horse stops nearby. The figure sniffs the air, searching for the Ring, filling Frodo with a sudden urge to put it on.\n- **A Chance Meeting** — The Black Rider approaches again as evening falls. Just as Frodo is about to succumb to the Ring's temptation, the clear singing of High Elves echoes through the woods. The Rider flees, and the Hobbits meet Gildor Inglorion and his company.\n- **Counsel at Woodhall** — The Elves bring the Hobbits to their camp above Woodhall. They provide food and drink. Gildor speaks privately with Frodo, identifying the Black Riders as servants of the Enemy and advising Frodo to flee the Shire immediately without waiting for Gandalf.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029707},{"id":"jJK4hJHBOPE25180AUR53","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"n4-7-u6RkXJhiLoG-i0sn","title":"The Eldar in Middle-earth","body":"Rivendell and Lothlórien preserve realms of the High Elves, though their age in Middle-earth is ending.","tags":["elves","eldar"],"coverImageId":null,"linkedEntityIds":["A3Mss2GV_4rKTRZcxOItF","Mg5v7EaBZ-BduiqN9mglE","YlUL4I0y3d9z1xCGFeKA9"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"mMEsF4FCvNTjmk2l9s7dN","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 11 — A Knife in the Dark","body":"Strider leads the Hobbits out of Bree and through the treacherous Midgewater Marshes to avoid the roads. They arrive at Weathertop, where they discover signs of Gandalf. That night, their camp is ambushed by five Nazgûl. Frodo puts on the Ring and is stabbed by the Witch-king with a Morgul-blade before Strider drives the wraiths away with fire.\n\n- **Through the Midgewater Marshes** — After purchasing Bill the pony to carry their supplies, Strider leads the group off the East Road and into the miserable, insect-infested Midgewater Marshes to lose their pursuers.\n- **The Riders Strike Crickhollow** — At the same time, Ringwraiths assault the empty house at Crickhollow and Fredegar Bolger raises the alarm.\n- **Signs on Weathertop** — The company arrives at Amon Sûl (Weathertop). They find a ruined ring of stones, signs of a recent fire, and a stone scratched with the elf-rune 'G', indicating Gandalf had been there days before.\n- **Ambush by the Nazgûl** — That night, the camp is attacked by five Black Riders. Overcome by the Ring's compulsion, Frodo slips it on, pulling himself into the wraith world. The Witch-king stabs Frodo in the shoulder with a poisoned Morgul-blade.\n- **Driven Away with Fire** — Strider leaps from the darkness with flaming brands, driving the shrieking wraiths away from the camp. Frodo removes the Ring, collapsing back into the physical world, grievously wounded.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029715},{"id":"nO6igVSYsRtfRDvYLdV24","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 13 — Many Meetings","body":"Frodo awakens in Rivendell, having been healed by Elrond. He reunites with Gandalf, Sam, Merry, and Pippin. At a great feast, he sees the beautiful Arwen Evenstar and is joyfully reunited with his uncle, Bilbo Baggins. The group rests and prepares for the upcoming Council of Elrond.\n\n- **Waking in Rivendell** — Frodo wakes up in a comfortable bed in the Last Homely House. Gandalf is sitting beside him, explaining that Elrond has successfully treated his wound, although a splinter of the Morgul-blade nearly reached his heart.\n- **Reunion with Friends** — Sam, Merry, and Pippin rush into Frodo's room, overjoyed to see him awake and recovering. Sam is particularly relieved, having barely left Frodo's side while he was unconscious.\n- **The Feast of Elrond** — A great feast is held in the Hall of Fire. Frodo sits with Elrond and Glorfindel, and sees the breathtaking Arwen Evenstar for the first time. The hall is filled with songs and tales of the Elves.\n- **Reunion with Bilbo** — After the feast, Frodo finds Bilbo Baggins sitting quietly in a corner. They joyfully catch up on the years apart. When Bilbo asks to see the Ring, a brief, horrifying shadow passes over him, but he quickly recovers, apologizing to Frodo.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029717},{"id":"nghwnDK9S6ybpYKoiSDhR","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 14 — The Council of Elrond","body":"Representatives of Elves, Dwarves, and Men gather at Rivendell to discuss the growing threat of Sauron and the fate of the One Ring. Gandalf recounts the treason of Saruman. Boromir argues to use the Ring for Gondor, but Elrond decrees it must be destroyed in Mount Doom. Frodo Baggins volunteers to take the Ring, and Sam insists on accompanying him.\n\n- **Gathering of the Council** — Elrond summons a secret council of the Free Peoples. Glóin and Gimli speak of Sauron's overtures to the Dwarves. Legolas brings news that Gollum has escaped Mirkwood. Boromir tells of the desperate war in Gondor and a prophetic dream that led him to Rivendell.\n- **The Tale of the Ring** — Elrond recounts the history of the Last Alliance and Isildur taking the Ring. Bilbo tells the story of finding it. Frodo recounts his journey from the Shire. Aragorn reveals his true identity and shows the shards of Narsil, challenging Boromir's doubts.\n- **The Last Alliance and Isildur's Claim** — Elrond recounts the overthrow of Sauron, the deaths of Gil-galad and Elendil, and Isildur's refusal to destroy the Ring.\n- **Gandalf's Tale and Saruman's Treason** — Gandalf explains how he confirmed the Ring's identity by reading Isildur's scroll in Minas Tirith. He then shocks the Council by revealing the treason of Saruman the White, his imprisonment in Orthanc, and his daring escape with the help of Gwaihir the Eagle.\n- **Radagast Brings a Warning** — Gandalf recounts meeting Radagast, who carries Saruman's summons and news that the Nazgûl are abroad.\n- **Gwaihir Rescues Gandalf** — Gwaihir lifts Gandalf from the pinnacle of Orthanc, allowing him to escape Saruman.\n- **The Doom of the Ring** — Boromir urges the Council to use the Ring to defend Gondor, but Elrond and Gandalf reject the idea, explaining it will only corrupt its wielder. They conclude the Ring must be taken to Mount Doom and destroyed. Amidst a heavy silence, Frodo volunteers for the quest. Sam, hiding in the corner, insists on going with him.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029718},{"id":"pHflUcr256HzzLsZglmUk","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 15 — The Ring Goes South","body":"The Fellowship of the Ring is chosen by Elrond: nine walkers to oppose the Nine Riders. Narsil is reforged and renamed Andúril. Before they depart, Bilbo privately gifts Frodo his Elven sword, Sting, and a coat of Mithril mail. The Company journeys south through the deserted land of Hollin. They attempt to cross the Misty Mountains via the Redhorn Pass but are defeated by a fierce, unnatural snowstorm.\n\n- **The Company is Chosen** — Elrond officially forms the Fellowship of the Ring: Frodo, Sam, Merry, Pippin, Gandalf, Aragorn, Boromir, Legolas, and Gimli. Narsil is reforged for Aragorn and renamed Andúril.\n- **Bilbo's Gifts** — Before the Fellowship departs, Bilbo Baggins pulls Frodo aside in his room. He gifts Frodo his ancient Elven dagger, Sting, and a remarkably light, incredibly strong chainmail coat made of Mithril.\n- **Through Hollin** — The Fellowship departs Rivendell in secret, traveling south for many days through the empty lands of Eregion (Hollin). The region is eerily quiet, save for flocks of crebain (crows) from Dunland acting as spies for Saruman.\n- **The Snows of Caradhras** — Attempting to cross the Misty Mountains via the Redhorn Pass, the Fellowship is caught in a fierce, unnatural blizzard on the slopes of Caradhras. Gandalf is forced to use magic to light a fire to save them from freezing. Defeated by the mountain, they are forced to turn back.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029719},{"id":"pe8lHcUBiqYtppBHOzJgc","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"n4-7-u6RkXJhiLoG-i0sn","title":"Hobbits of the Shire","body":"Hobbits are a small, peaceable people whose courage and resilience are underestimated by the great powers.","tags":["hobbits","shire"],"coverImageId":null,"linkedEntityIds":["vxoxTk2Mvm4tJHSZMOCXu","VCDCameqQaT-sfOP09l1p","mks1f6d9jtJKgn-csutke","BOCiaYjh9hVnLn2r_kloN"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"pxMCrdlaoaSmb07W4V3yD","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 5 — A Conspiracy Unmasked","body":"The Hobbits arrive safely at Frodo's new house at Crickhollow in Buckland. Frodo intends to leave his friends behind and sneak away, but Merry and Pippin reveal they already know about the Ring and his quest. Along with Sam and Fredegar (Fatty) Bolger, they have formed a 'conspiracy' to help him. Fatty stays behind as a decoy while the others prepare to brave the Old Forest.\n\n- **Safe Haven in Crickhollow** — The Hobbits arrive safely at the newly prepared house in Crickhollow, greeted by Fredegar 'Fatty' Bolger. They enjoy a hot bath and a hearty supper, temporarily feeling safe behind the High Hay of Buckland.\n- **The Conspiracy Revealed** — Frodo struggles to find a way to tell his friends he must leave them. To his profound shock, Merry and Pippin reveal they already know about the Ring and his plan to flee. They confess that Sam has been acting as their chief investigator and spy.\n- **The Decoy Plan** — Moved by their unyielding loyalty, Frodo accepts Merry and Pippin as his companions. To avoid the roads where the Black Riders are waiting, they decide to set out early the next morning through the dreaded Old Forest. Fatty Bolger agrees to stay behind in Crickhollow to maintain the illusion that Frodo still lives there.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029709},{"id":"qL-xQ6RlVQ4MJ26C5JZcL","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"guZLHsHRN2MN5rd2TwRuf","title":"The Shire","body":"Protected homeland of the hobbits, largely ignorant of the wider war until the Ringwraiths cross its borders.","tags":["shire"],"coverImageId":null,"linkedEntityIds":["0x9W7NdpW1u5YkcAdfXlJ","2KpeTL21Ja0PstxZd7oIF"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"sLnFzzwinfLcbCcMo-f7I","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"n4-7-u6RkXJhiLoG-i0sn","title":"The Dúnedain and the Rangers","body":"The northern Rangers preserve the lineage and duties of the lost kingdom of Arnor while guarding lands that seldom recognize them.","tags":["dunedain","rangers"],"coverImageId":null,"linkedEntityIds":["RnRmv_hrpbiIqdniLW5D6","QRFhfSrTIquPTB7M8xkZi","l8D-LSQ00Ur6U30y7Jd7X"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"t10qC9seWZwZYSw0t1Hii","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 8 — Fog on the Barrow-downs","body":"The Hobbits leave Tom Bombadil's house but get lost in a thick fog on the Barrow-downs. They are captured by a Barrow-wight and trapped inside a barrow. Frodo resists the Wight's spell and calls for Tom Bombadil, who arrives, banishes the creature, and rescues them. Tom outfits the Hobbits with ancient daggers (Barrow-blades) from the wight's hoard.\n\n- **Lost in the Fog** — After leaving Tom Bombadil's house, the Hobbits make good progress across the hills. However, around midday, a thick, unnerving fog descends upon the Barrow-downs, causing them to lose their way and become separated.\n- **Captured by the Wight** — While searching for his friends in the blinding fog, Frodo is suddenly ambushed by a tall, dark figure with icy hands—a Barrow-wight. He is dragged unconscious into a dark barrow.\n- **Awakening in the Barrow** — Frodo awakens inside the barrow to find his friends dressed in white rags and covered in pale gold, laid out as if dead. An arm begins crawling toward them with a sword. Summoning his courage, Frodo strikes the arm with a small sword he finds nearby and cries out for Tom Bombadil.\n- **Rescue and the Barrow-blades** — Tom Bombadil bursts into the barrow, banishing the Wight into the darkness. He awakens the other Hobbits and breaks the barrow's spells. Before they leave, Tom selects ancient, finely wrought daggers from the hoard for each Hobbit.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029712},{"id":"tNrAbdPDpF7HogiRqVz5C","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 12 — Flight to the Ford","body":"With Frodo gravely wounded by the Morgul-blade, Strider uses Athelas to slow the poison, and leads the company toward Rivendell. They pass through the Trollshaws, encountering the stone trolls from Bilbo's past. As Frodo's condition worsens, they meet the Elf-lord Glorfindel. The Nazgûl ambush them near the Ford of Bruinen. Frodo escapes across the river on Glorfindel's horse just as a magical flood sweeps the Ringwraiths away.\n\n- **Healing with Athelas** — After the Nazgûl are driven off Weathertop, Strider examines Frodo's wound. He finds the hilt of the Morgul-blade, which dissolves in the morning light. Strider uses the herb Athelas (Kingsfoil) to wash the wound, temporarily slowing the spread of the dark poison, though Frodo remains gravely ill.\n- **Through the Trollshaws** — The company pushes hard toward Rivendell, placing Frodo on Bill the pony. They travel for many days through the rugged Trollshaws. Along the way, they come across the three stone trolls from Bilbo's adventure long ago, providing a brief moment of levity amidst the growing dread.\n- **Meeting Glorfindel** — As Frodo's condition rapidly deteriorates and he begins to slip fully into the wraith-world, they are met by Glorfindel, an Elf-lord sent from Rivendell to find them. Glorfindel places Frodo on his white horse, Asfaloth, and urges them to hurry to the Ford of Bruinen.\n- **Ambush at the Ford** — Just as they approach the Ford of Bruinen, the Nazgûl ambush them from both sides. Glorfindel commands his horse to bear Frodo across the river. Frodo crosses, turns to defy the Riders, and is nearly overcome before a magical flood, summoned by Elrond and shaped by Gandalf, sweeps down the river, destroying the Nazgûl's horses and washing the wraiths away.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029716},{"id":"utsi4iesf0rHWtMtF93h4","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"f__CEuNIn_vXKKnpwfSv3","title":"Isildur's Bane","body":"Isildur refused to destroy the Ring, which later betrayed him near the Gladden Fields and vanished for centuries.","tags":["isildur","ring"],"coverImageId":null,"linkedEntityIds":["QRFhfSrTIquPTB7M8xkZi","P1vQTecPw23NSjgZ01EkY","DOvmiXhF-hrDIAlLp2cMT"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"v5rv3WMzHQj9cOxSlg21q","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 20 — Farewell to Lórien","body":"The time comes for the Fellowship to depart Lothlórien. Celeborn provides them with boats to travel south down the River Anduin. The Elves supply them with Lembas bread, hithlain rope, and camouflaging Elven cloaks. As they depart, Galadriel presents individual gifts to each member of the company, including a star-glass for Frodo and three strands of her own hair for Gimli, a request that astonishes the Elves. The Fellowship sets off down the Great River.\n\n- **Outfitting the Fellowship** — Preparing for their departure, the Elves of Lórien provide the Fellowship with boats, nutritious Lembas bread, and grey-green Elven cloaks that offer camouflage. Sam is particularly pleased to receive a coil of strong hithlain rope.\n- **The Gifts of Galadriel** — At the junction of the Silverlode and the Anduin, Galadriel and Celeborn bid farewell to the company in a swan-shaped boat. Galadriel presents deeply personal and powerful gifts to each member, saving her most astonishing gift—three strands of her hair—for Gimli, and the Phial of Eärendil's light for Frodo.\n- **Setting Off Down the Great River** — The Fellowship departs in three boats, drifting south on the Great River Anduin. As they leave, Legolas and Gimli sit in the same boat, signifying their new, profound friendship, while Frodo feels the increasing isolation of his quest.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029724},{"id":"xHwKlWYIcXKEh9TLZQHcM","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"M9i7S9G2qVFsaPloPmcbi","title":"Athelas","body":"Kingsfoil carries healing virtue in the hands of one with the proper knowledge and lineage.","tags":["healing","dunedain"],"coverImageId":null,"linkedEntityIds":["ymA2xixhSAyjNm4eOCRYb","RnRmv_hrpbiIqdniLW5D6"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029705},{"id":"y51IbTSwOxmMDP8dqUvpd","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 6 — The Old Forest","body":"The Hobbits enter the Old Forest to avoid the main roads. They become lost and are lulled to sleep by Old Man Willow, who traps Merry and Pippin inside his trunk. They are rescued by Tom Bombadil, a mysterious entity who commands the willow to release them and invites the Hobbits to his house.\n\n- **Into the Old Forest** — Early in the morning, Frodo, Sam, Merry, and Pippin leave Crickhollow, passing through the High Hay into the dreaded Old Forest. The atmosphere is oppressive and the trees seem to deliberately shift to block their path.\n- **Trapped by Old Man Willow** — Driven by an unnatural sleepiness, the Hobbits rest near the Withywindle river beside a massive willow tree. Old Man Willow uses a spell to trap Merry and Pippin inside his trunk and nearly drowns Frodo in the river.\n- **Enter Tom Bombadil** — As Sam desperately tries to free his friends, a strange, merry man in blue and yellow approaches, singing nonsense songs. Tom Bombadil easily commands Old Man Willow to release the Hobbits and invites them to his home for the night.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029710},{"id":"yF_V9ueij48isGAoaM11X","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"8Za9VVMPOsH5sfrg846fg","title":"Ch. 22 — The Breaking of the Fellowship","body":"At Parth Galen, Frodo asks for time alone to decide their path. Boromir follows him and, corrupted by the Ring's influence, attempts to take it by force. Frodo puts on the Ring and escapes to the Seat of Seeing on Amon Hen. Boromir returns to the camp, ashamed, and the rest of the company scatters in panic to find Frodo. Realizing Frodo intends to go to Mordor alone, Sam intercepts him at the boats. The two set off across the river toward the Emyn Muil, breaking the Fellowship.\n\n- **The Choice** — At the camp at Parth Galen, Aragorn tells Frodo that the time has come to choose their path: Minas Tirith or Mordor. Frodo asks for an hour alone to decide and walks up the slopes of Amon Hen.\n- **Boromir's Madness** — Boromir secretly follows Frodo. He argues that the Ring should be used to save Gondor, not thrown away. Overcome by the Ring's corrupting influence, he tries to take it by force. Frodo slips the Ring on and vanishes, leaving a suddenly repentant Boromir weeping.\n- **The Seat of Seeing** — Invisible, Frodo climbs to the top of Amon Hen and sits in the ancient Seat of Seeing. He sees the vast armies of Sauron gathering everywhere. He also feels the Eye of Sauron searching for him. A second, unseen voice (Gandalf's) urges him to take off the Ring, which he does just in time.\n- **The Fellowship Scatters** — Boromir returns to the camp, ashamed, and admits Frodo ran away from him, though he lies about why. Realizing Frodo is in danger, the rest of the company panics and scatters blindly into the woods to find him. Sam, realizing Frodo intends to leave them all behind and take a boat, runs for the river.\n- **Departure for Mordor** — Frodo sneaks down to the boats, intending to cross the river to the Emyn Muil alone. Sam catches him in the act, nearly drowning himself to stop Frodo from leaving. Frodo relents, and the two Hobbits set off across the Anduin together, officially breaking the Fellowship.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784550029705,"updatedAt":1784550029726},{"id":"tt-lore-breaking","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Departure of Boromir","body":"Boromir's death confirms the breaking of the Company. Aragorn chooses rescue over following the Ring-bearer.","tags":["fellowship","boromir"],"coverImageId":null,"linkedEntityIds":["9Q7AnvFgkatNIa-8rb6CB","RnRmv_hrpbiIqdniLW5D6","tt-item-horn-boromir"],"visibleFromEventId":"tt-ev-1-boromir-s-last-stand","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-rohirrim","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Rohirrim","body":"The horse-lords of Rohan defend the Mark under Théoden and commanders such as Éomer and Erkenbrand.","tags":["rohan","culture"],"coverImageId":null,"linkedEntityIds":["tt-char-theoden","tt-char-eomer","tt-char-erkenbrand"],"visibleFromEventId":"tt-ev-2-the-riders-surround-the-hunters","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-meduseld","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Meduseld and Edoras","body":"The Golden Hall is Théoden's seat in Edoras and the center of Rohan's restored government.","tags":["rohan","place"],"coverImageId":null,"linkedEntityIds":["Rw-yuB8JFczhT54PPH8dn","mVxv9nRH5Vtj9vyFJHYBu","tt-char-theoden"],"visibleFromEventId":"tt-ev-6-at-the-doors-of-meduseld","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-fangorn","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Fangorn and the Ents","body":"Fangorn is an ancient forest guarded by shepherds of trees whose long patience ends when Saruman threatens their charges.","tags":["fangorn","ents"],"coverImageId":null,"linkedEntityIds":["tt-loc-fangorn-root","tt-char-treebeard","tt-char-quickbeam"],"visibleFromEventId":"tt-ev-4-meeting-treebeard","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-entmoot","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Entmoot","body":"The Ents deliberate in their own slow fashion before deciding that war against Isengard is necessary.","tags":["ents","council"],"coverImageId":null,"linkedEntityIds":["tt-loc-entmoot","tt-char-treebeard"],"visibleFromEventId":"tt-ev-4-the-entmoot","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-gandalf-white","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Gandalf the White","body":"After death in the struggle with Durin's Bane, Gandalf is sent back with greater authority to finish his task.","tags":["gandalf","wizard"],"coverImageId":null,"linkedEntityIds":["Z3WTGGdrOBdao2wIcdWy8","QozrCLRO9xfdXwbjEmmJL"],"visibleFromEventId":"tt-ev-5-the-white-wizard-appears","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-rohan-war","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The War for Rohan","body":"Saruman seeks to destroy Théoden's realm through treachery, Uruk-hai, and open invasion.","tags":["rohan","isengard"],"coverImageId":null,"linkedEntityIds":["tt-char-theoden","kLQ9TiNBdeAWrkOgoq_Vw","tt-char-grima-wormtongue"],"visibleFromEventId":"tt-ev-6-wormtongue-exposed","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-helms-deep","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Helm's Deep and the Hornburg","body":"The refuge in the Deep becomes the decisive defensive position where Rohan breaks Saruman's main army.","tags":["rohan","battle"],"coverImageId":null,"linkedEntityIds":["kdCAuNrIr9dVLA6ePTEDy","ykNVcxb-BbVonNR419EG2","PEoNup3aMGEoxOGm6_jWF"],"visibleFromEventId":"tt-ev-7-saruman-s-army-arrives","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-huorns","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Huorns","body":"Tree-like beings march from Fangorn, destroy fleeing Orcs, and later return to the forest.","tags":["fangorn","creature"],"coverImageId":null,"linkedEntityIds":["tt-char-treebeard"],"visibleFromEventId":"tt-ev-8-through-the-huorn-wood","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-isengard-fall","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Destruction of Isengard","body":"The Ents tear down the ring wall and divert the Isen, drowning Saruman's furnaces while leaving Orthanc standing.","tags":["isengard","ents"],"coverImageId":null,"linkedEntityIds":["tt-loc-ring-isengard","n0eRXLOH0tLya9d30L-mt","tt-char-treebeard"],"visibleFromEventId":"tt-ev-9-isengard-is-flooded","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-saruman-voice","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Voice of Saruman","body":"Saruman can use speech to distort judgment and memory, but Gandalf's authority finally strips him of rank.","tags":["saruman","magic"],"coverImageId":null,"linkedEntityIds":["kLQ9TiNBdeAWrkOgoq_Vw","Z3WTGGdrOBdao2wIcdWy8"],"visibleFromEventId":"tt-ev-10-the-voice-tests-theoden","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-palantiri","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Palantíri","body":"Seeing-stones communicate across distance but expose an unprepared user to stronger minds using other stones.","tags":["palantir","artifact"],"coverImageId":null,"linkedEntityIds":["tt-item-palantir","CHPJsdi_fs7rASN_A2X-a","BOCiaYjh9hVnLn2r_kloN"],"visibleFromEventId":"tt-ev-11-pippin-steals-the-palantir","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-emyn","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Emyn Muil","body":"Broken hills east of the Anduin delay Frodo and Sam until they capture Gollum and obtain a guide.","tags":["mordor-road","place"],"coverImageId":null,"linkedEntityIds":["tt-loc-emyn-muil","vxoxTk2Mvm4tJHSZMOCXu","VCDCameqQaT-sfOP09l1p"],"visibleFromEventId":"tt-ev-12-lost-in-emyn-muil","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-gollum-oath","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Gollum's Oath","body":"Gollum swears by the object he calls Precious. The oath restrains him but also binds his fate more tightly to the Ring.","tags":["gollum","ring"],"coverImageId":null,"linkedEntityIds":["dufKZjP0q2cJ9uyM3nehG","P1vQTecPw23NSjgZ01EkY"],"visibleFromEventId":"tt-ev-12-the-oath-on-the-precious","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-marshes","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Dead Marshes","body":"Battlefields from the ancient war have become haunted pools where corpse-lights lure travelers from the safe path.","tags":["marshes","history"],"coverImageId":null,"linkedEntityIds":["tt-loc-dead-marshes"],"visibleFromEventId":"tt-ev-13-faces-in-the-water","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-morannon","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Morannon","body":"Mordor's Black Gate is continuously guarded and reinforced, making it impossible for the hobbits to enter unseen.","tags":["mordor","fortress"],"coverImageId":null,"linkedEntityIds":["t7W1ul1-BCEEPzY7kgpS0"],"visibleFromEventId":"tt-ev-14-the-morannon","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-ithilien","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Ithilien","body":"Wooded Gondorian land between the Anduin and the Mountains of Shadow, beautiful despite occupation and war.","tags":["gondor","place"],"coverImageId":null,"linkedEntityIds":["tt-loc-ithilien-glade","lApbg_J7UK9uN2LfVIIni"],"visibleFromEventId":"tt-ev-15-the-green-land-of-ithilien","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-rangers-ithilien","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"The Rangers of Ithilien","body":"Faramir's hidden company conducts ambushes and intelligence operations behind enemy movement routes.","tags":["gondor","rangers"],"coverImageId":null,"linkedEntityIds":["tt-char-faramir","tt-char-mablung","tt-char-damrod","tt-char-anborn"],"visibleFromEventId":"tt-ev-15-rangers-ambush-the-haradrim","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-haradrim","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Haradrim and Mûmakil","body":"Men from Harad march to Sauron's war with enormous war-beasts called mûmakil.","tags":["harad","war"],"coverImageId":null,"linkedEntityIds":["tt-char-southron-captain","tt-char-oliphaunt"],"visibleFromEventId":"tt-ev-15-sam-sees-an-oliphaunt","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-faramir","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Faramir's Quality","body":"Faramir values truth and restraint over glory, refusing even the opportunity to take the Ring.","tags":["faramir","gondor"],"coverImageId":null,"linkedEntityIds":["tt-char-faramir","9Q7AnvFgkatNIa-8rb6CB"],"visibleFromEventId":"tt-ev-16-faramir-rejects-temptation","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-minas-morgul","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Minas Morgul","body":"The former Gondorian city has become the Witch-king's fortress and launches an army toward war.","tags":["mordor","nazgul"],"coverImageId":null,"linkedEntityIds":["OMehdxeRa3y34kG9T7bqK","fdlgA1T4W1ApzalSCjK99"],"visibleFromEventId":"tt-ev-19-the-morgul-host-departs","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-cirith","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Cirith Ungol","body":"A secret high pass enters Mordor above Minas Morgul, guarded by Shelob's tunnels and an Orc tower.","tags":["mordor","pass"],"coverImageId":null,"linkedEntityIds":["tt-loc-stairs-cirith","tt-loc-torech-ungol","tt-loc-tower-cirith"],"visibleFromEventId":"tt-ev-19-toward-the-tunnel","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-shelob","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Shelob","body":"Ancient offspring of Ungoliant who hunts independently in the pass and accepts victims delivered by Gollum.","tags":["shelob","creature"],"coverImageId":null,"linkedEntityIds":["tt-char-shelob","dufKZjP0q2cJ9uyM3nehG"],"visibleFromEventId":"tt-ev-20-shelob-stings-frodo","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-sam-ringbearer","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Sam as Ring-bearer","body":"Believing Frodo dead, Sam takes the Ring in order to keep the quest alive.","tags":["sam","ring"],"coverImageId":null,"linkedEntityIds":["VCDCameqQaT-sfOP09l1p","P1vQTecPw23NSjgZ01EkY"],"visibleFromEventId":"tt-ev-21-sam-takes-the-ring","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-lore-frodo-captured","worldId":"mOlU8GWK_NGtK-STFFtqC","categoryId":"tt-lore-cat-current","title":"Frodo Captured Alive","body":"Shelob's poison causes paralysis rather than death, and the Orcs carry Frodo into their tower.","tags":["frodo","cirith-ungol"],"coverImageId":null,"linkedEntityIds":["vxoxTk2Mvm4tJHSZMOCXu","tt-char-shagrat","tt-char-gorbag"],"visibleFromEventId":"tt-ev-21-alive-but-taken","createdAt":1784551000000,"updatedAt":1784551000000}],"factions":[{"id":"06hQPzBiJNsRe0OYAb72_","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Wise","description":"Elven leaders and Wizards who coordinate resistance to Sauron.","color":"#7c3aed","coverImageId":null,"tags":["white-council","wise"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"25Pq3g3MFqSRzRrQKaZtV","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Lothlórien","description":"Galadriel, Celeborn, and the Galadhrim of the Golden Wood.","color":"#d97706","coverImageId":null,"tags":["elves","realm"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"LNDLfg21aoIjcOFYsbJlx","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Rangers of the North","description":"Dúnedain guardians of Eriador led by Aragorn.","color":"#475569","coverImageId":null,"tags":["dunedain","rangers"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"PIPTFnMpnnN4riW6Otwab","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Fellowship of the Ring","description":"Nine walkers chosen to carry and protect the Ring-bearer.","color":"#2563eb","coverImageId":null,"tags":["alliance","quest"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"VfZLsua1VlxQxSgM1YBII","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Isengard","description":"Saruman's private power centered on Orthanc.","color":"#e5e7eb","coverImageId":null,"tags":["saruman","enemy"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"hZpY2LnP6Dl-RzMMWxdMr","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Nine","description":"Ringwraith servants who hunt the Ring-bearer.","color":"#374151","coverImageId":null,"tags":["nazgul","enemy"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"k-Grkp86caxCj-gSAAYv2","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Hobbit Conspiracy","description":"Sam, Merry, Pippin, and Fredegar's secret effort to help Frodo leave the Shire.","color":"#65a30d","coverImageId":null,"tags":["hobbits","shire"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"k-R4Qxgi9R4ekXVudkdbn","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Rivendell","description":"Elrond's household, counsellors, and allies.","color":"#0f766e","coverImageId":null,"tags":["elves","refuge"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"p54PyJf9OxVS7OwoBpZlU","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Mordor","description":"Sauron and the forces directed from Barad-dûr.","color":"#111827","coverImageId":null,"tags":["enemy","sauron"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"rBo33_Q1oS1SBi17SPEcB","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Dwarves of Erebor","description":"The Dwarven kingdom represented by Glóin and Gimli.","color":"#b45309","coverImageId":null,"tags":["dwarves"],"createdAt":1784550029705,"updatedAt":1784550029705},{"id":"tt-faction-rohan","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Rohan","description":"Théoden's horse-lords and defenders of the Mark.","color":"#b45309","coverImageId":null,"tags":["rohan","kingdom"],"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-faction-ents","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Ents of Fangorn","description":"Tree shepherds who march against Isengard.","color":"#166534","coverImageId":null,"tags":["ents","fangorn"],"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-faction-urukhai","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Uruk-hai of Isengard","description":"Saruman's disciplined Orc soldiers.","color":"#111827","coverImageId":null,"tags":["isengard","orcs"],"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-faction-ithilien","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Rangers of Ithilien","description":"Faramir's hidden Gondorian company.","color":"#0f766e","coverImageId":null,"tags":["gondor","rangers"],"createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-faction-harad","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Haradrim Host","description":"Southron forces marching to reinforce Mordor.","color":"#991b1b","coverImageId":null,"tags":["harad","enemy"],"created