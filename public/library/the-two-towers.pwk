GWK_NGtK-STFFtqC","name":"Merry and Pippin","color":"#65a30d","description":"The captured hobbits escape, befriend the Ents, and witness Isengard's fall.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-ents","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Ents against Isengard","color":"#166534","description":"Treebeard and the Ents awaken to Saruman's destruction and march to war.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-white","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Gandalf the White","color":"#e5e7eb","description":"Gandalf returns transformed and completes Saruman's overthrow.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-rohan","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The War for Rohan","color":"#b45309","description":"Théoden is restored and Rohan survives the battle at Helm's Deep.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-saruman","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Fall of Saruman","color":"#64748b","description":"Saruman loses his army, fortress, authority, and palantír.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-palantir","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Palantír","color":"#7c3aed","description":"The Orthanc-stone passes from Saruman's tower to Pippin and then Aragorn.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-ring","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Road to Mordor","color":"#dc2626","description":"Frodo and Sam continue the Ring quest through Emyn Muil, the Marshes, and Ithilien.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-gollum","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Sméagol and Gollum","color":"#84cc16","description":"Gollum's divided loyalty shifts from sworn guidance toward betrayal.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-faramir","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"Faramir's Choice","color":"#0f766e","description":"Faramir discovers the Ring but refuses to repeat Boromir's failure.","createdAt":1784551000000,"updatedAt":1784551000000},{"id":"tt-thread-shelob","worldId":"mOlU8GWK_NGtK-STFFtqC","name":"The Trap at Cirith Ungol","color":"#111827","description":"Gollum delivers the hobbits to Shelob, leaving Frodo captured and Sam bearing the Ring.","createdAt":1784551000000,"updatedAt":1784551000000}],"continuitySuppressions":[]}