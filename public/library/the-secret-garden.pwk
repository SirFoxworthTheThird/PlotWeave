  "timelines": [
    {
      "id": "secret-garden-timeline-main",
      "worldId": "secret-garden-world",
      "name": "Mary’s Year at Misselthwaite",
      "description": "One continuous chronology from India through the garden’s summer restoration.",
      "color": "#728064",
      "dayOffset": 0,
      "createdAt": 1786924800000
    }
  ],
  "chapters": [
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-01",
      "timelineId": "secret-garden-timeline-main",
      "number": 1,
      "title": "There Is No One Left",
      "summary": "Cholera empties Mary’s Indian household, leaving the neglected child suddenly without parents or servants.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-02",
      "timelineId": "secret-garden-timeline-main",
      "number": 2,
      "title": "Mistress Mary Quite Contrary",
      "summary": "At a clergyman’s bungalow and then under Mrs Medlock’s charge, Mary learns she will be sent to a reclusive uncle in Yorkshire.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-03",
      "timelineId": "secret-garden-timeline-main",
      "number": 3,
      "title": "Across the Moor",
      "summary": "A train and night carriage carry Mary across the wind-beaten moor to immense, dark Misselthwaite Manor.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-04",
      "timelineId": "secret-garden-timeline-main",
      "number": 4,
      "title": "Martha",
      "summary": "Martha’s frankness, stories of Dickon, and description of the locked garden begin to redirect Mary’s attention outward.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-05",
      "timelineId": "secret-garden-timeline-main",
      "number": 5,
      "title": "The Cry in the Corridor",
      "summary": "Fresh air, the robin, and Ben Weatherstaff stir Mary’s interest while a distant cry suggests the house keeps another secret.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-06",
      "timelineId": "secret-garden-timeline-main",
      "number": 6,
      "title": "There Was Someone Crying—There Was!",
      "summary": "Rain drives Mary through forbidden corridors until Mrs Medlock abruptly ends her search for the crying voice.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-07",
      "timelineId": "secret-garden-timeline-main",
      "number": 7,
      "title": "The Key in the Garden",
      "summary": "After Martha brings a skipping rope, Mary finds an old key in earth disturbed beside the garden wall.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-08",
      "timelineId": "secret-garden-timeline-main",
      "number": 8,
      "title": "The Robin Who Showed the Way",
      "summary": "The robin exposes the hidden door beneath ivy, and Mary enters the abandoned garden alone.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-09",
      "timelineId": "secret-garden-timeline-main",
      "number": 9,
      "title": "The Strangest House Anyone Ever Lived In",
      "summary": "Mary clears weeds, asks Martha for tools and seeds, and begins treating the hidden garden as living work.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-10",
      "timelineId": "secret-garden-timeline-main",
      "number": 10,
      "title": "Dickon",
      "summary": "Dickon arrives with creatures and tools; his knowledge and trust turn Mary’s secret into a friendship.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-11",
      "timelineId": "secret-garden-timeline-main",
      "number": 11,
      "title": "The Nest of the Missel Thrush",
      "summary": "Mary and Dickon work carefully around new shoots and decide the garden must remain protected like a nest.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-12",
      "timelineId": "secret-garden-timeline-main",
      "number": 12,
      "title": "Might I Have a Bit of Earth?",
      "summary": "Mary asks her uncle for earth to cultivate; Archibald grants freedom in the grounds and then leaves again.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-13",
      "timelineId": "secret-garden-timeline-main",
      "number": 13,
      "title": "I Am Colin",
      "summary": "Following the cry at night, Mary discovers Colin and learns the manor hides a second lonely, commanding child.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-14",
      "timelineId": "secret-garden-timeline-main",
      "number": 14,
      "title": "A Young Rajah",
      "summary": "Mary returns to Colin, speaks honestly about illness and the garden, and resists the habits of obedience surrounding him.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-15",
      "timelineId": "secret-garden-timeline-main",
      "number": 15,
      "title": "Nest Building",
      "summary": "Dickon’s letter and the robin’s nesting deepen Mary and Colin’s desire to bring him—and eventually Colin—into the secret.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-16",
      "timelineId": "secret-garden-timeline-main",
      "number": 16,
      "title": "I Won’t! Said Mary",
      "summary": "Colin demands Mary’s attendance; she refuses, and their quarrel exposes how alike their neglected tempers are.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-17",
      "timelineId": "secret-garden-timeline-main",
      "number": 17,
      "title": "A Tantrum",
      "summary": "Mary confronts Colin’s night terror, examines the feared lump on his back, and breaks the cycle of panic.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-18",
      "timelineId": "secret-garden-timeline-main",
      "number": 18,
      "title": "Tha’ Munnot Waste No Time",
      "summary": "Dickon visits Colin with his animals; Mary finally reveals that the garden is real and promises to take Colin there.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-19",
      "timelineId": "secret-garden-timeline-main",
      "number": 19,
      "title": "It Has Come!",
      "summary": "Dr Craven finds Colin altered by hope, while preparations begin for a carefully concealed excursion outdoors.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-20",
      "timelineId": "secret-garden-timeline-main",
      "number": 20,
      "title": "I Shall Live Forever—and Ever—and Ever!",
      "summary": "Colin enters the secret garden and turns his first day among growing things into a vow to live.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-21",
      "timelineId": "secret-garden-timeline-main",
      "number": 21,
      "title": "Ben Weatherstaff",
      "summary": "Ben discovers the children over the wall; Colin stands to answer his disbelief and recruits him into the secret.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-22",
      "timelineId": "secret-garden-timeline-main",
      "number": 22,
      "title": "When the Sun Went Down",
      "summary": "Colin walks between Mary and Dickon, and the garden becomes the stage for strength practiced away from watching adults.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-23",
      "timelineId": "secret-garden-timeline-main",
      "number": 23,
      "title": "Magic",
      "summary": "The children name growth, will, and companionship “Magic,” then begin a daily ritual of confident experiment.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-24",
      "timelineId": "secret-garden-timeline-main",
      "number": 24,
      "title": "Let Them Laugh",
      "summary": "Colin hides his gains at meals while Mrs Sowerby’s visit brings adult tenderness into the children’s secret world.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-25",
      "timelineId": "secret-garden-timeline-main",
      "number": 25,
      "title": "The Curtain",
      "summary": "Colin draws back his mother’s portrait and claims continuity with her rather than the fatal future he feared.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-26",
      "timelineId": "secret-garden-timeline-main",
      "number": 26,
      "title": "It’s Mother!",
      "summary": "Susan writes to Archibald; in Italy he responds to memory, dream, and the invitation to return to the garden.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "secret-garden-world",
      "createdAt": 1786924800000,
      "updatedAt": 1786924800000,
      "id": "secret-garden-chapter-27",
      "timelineId": "secret-garden-timeline-main",
      "number": 27,
      "title": "In the Garden",
      "summary": "Archibald returns, finds Colin walking, and crosses the lawn beside his son as the household witnesses restoration.",
      "status": "final",
      "targetWordCount": null
    }
  ],
