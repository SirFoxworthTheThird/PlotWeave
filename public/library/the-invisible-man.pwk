    {
      "worldId": "invisible-man-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "invisible-man-lore-optics",
      "categoryId": "invisible-man-lore-category-science",
      "title": "The Optics of Invisibility",
      "body": "Griffin describes reducing the refractive difference between living tissue and air so light passes through the body instead of defining its surfaces.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "invisible-man-event-principles"
    },
    {
      "worldId": "invisible-man-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "invisible-man-lore-bodily-cost",
      "categoryId": "invisible-man-lore-category-science",
      "title": "The Body Still Has Needs",
      "body": "Invisibility does not remove hunger, fatigue, injury, temperature, footprints, breath, blood, or contact with dirt and weather.",
