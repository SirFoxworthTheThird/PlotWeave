      "timelineId": "moby-dick-timeline-voyage",
      "number": 42,
      "title": "The Whiteness of the Whale",
      "summary": "The narrator examines how whiteness can signify holiness, emptiness, and terror at once.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
