      "timelineId": "moby-dick-timeline-voyage",
      "number": 49,
      "title": "The Hyena",
      "summary": "Back aboard, Ishmael confronts the voyage's casual proximity to death and adds Queequeg to his will.",
      "status": "final",
      "targetWordCount": null
    },
