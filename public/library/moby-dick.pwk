      "timelineId": "moby-dick-timeline-voyage",
      "number": 46,
      "title": "Surmises",
      "summary": "Ahab preserves the appearance of ordinary whaling so the crew will continue to support his true objective.",
      "status": "final",
      "targetWordCount": null
    },
