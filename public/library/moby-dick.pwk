      "endEventId": "moby-dick-event-135"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-goal-starbuck-home",
      "characterId": "moby-dick-character-starbuck",
      "type": "want",
      "text": "Complete the voyage and return to his wife and child without surrendering conscience.",
      "startEventId": "moby-dick-event-026",
      "endEventId": "moby-dick-event-135"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-goal-pip-belong",
      "characterId": "moby-dick-character-pip",
