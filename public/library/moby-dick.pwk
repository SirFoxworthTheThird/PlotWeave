  "timelines": [
    {
      "id": "moby-dick-timeline-voyage",
      "worldId": "moby-dick-world",
      "name": "The Voyage of the Pequod",
      "description": "One continuous chronology from Ishmael’s departure through the voyage and the Epilogue.",
      "color": "#5a7180",
      "dayOffset": 0,
      "createdAt": 1788480000000
    }
  ],
  "chapters": [
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-001",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 1,
      "title": "Loomings",
      "summary": "Ishmael answers a recurring need for the sea by setting out for a whaling port rather than remaining ashore.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-002",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 2,
      "title": "The Carpet-Bag",
      "summary": "A late arrival in New Bedford leaves Ishmael searching for inexpensive lodging before the Nantucket packet sails.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-003",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 3,
      "title": "The Spouter-Inn",
      "summary": "At Peter Coffin's inn, Ishmael studies strange maritime relics and reluctantly agrees to share a bed with an absent harpooneer.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-004",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 4,
      "title": "The Counterpane",
      "summary": "Ishmael wakes beside Queequeg, and alarm gives way to the first practical accommodations of trust.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-005",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 5,
      "title": "Breakfast",
      "summary": "The inn's intimidating sailors eat in silence while Queequeg's composure unsettles Ishmael's assumptions.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-006",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 6,
      "title": "The Street",
      "summary": "New Bedford's whaling wealth, polyglot crowds, and harsh winter reveal how completely the town faces the sea.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-007",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 7,
      "title": "The Chapel",
      "summary": "Ishmael and Queequeg enter the Whaleman's Chapel, where memorial tablets make the cost of the trade immediate.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-008",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 8,
      "title": "The Pulpit",
      "summary": "Father Mapple climbs a rope ladder into a pulpit shaped like a ship's bow and isolates himself above the congregation.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-009",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 9,
      "title": "The Sermon",
      "summary": "Mapple retells Jonah's flight and return as a demand to speak difficult truth without seeking comfort.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-010",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 10,
      "title": "A Bosom Friend",
      "summary": "Ishmael abandons inherited prejudice and accepts Queequeg's friendship as the two share tobacco and vows.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-011",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 11,
      "title": "Nightgown",
      "summary": "A warm room and frank conversation deepen the new companions' intimacy before their journey.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-012",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 12,
      "title": "Biographical",
      "summary": "Queequeg recounts his royal origin, departure from Rokovoko, and determination to learn the wider world's ways.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-013",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 13,
      "title": "Wheelbarrow",
      "summary": "Queequeg answers ridicule with restraint, then saves a mocking passenger when the packet is struck by a squall.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-014",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 14,
      "title": "Nantucket",
      "summary": "The companions reach the sandy island whose ships and sailors range across the world's oceans.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-015",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 15,
      "title": "Chowder",
      "summary": "At the Try Pots, clam and cod chowder restore the travelers before they seek a berth.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-016",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 16,
      "title": "The Ship",
      "summary": "Ishmael inspects the Pequod and bargains with Peleg and Bildad for his lay in the voyage.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-017",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 17,
      "title": "The Ramadan",
      "summary": "Queequeg's prolonged religious observance alarms Ishmael, who waits until the ritual ends without forcing entry.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-018",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 18,
      "title": "His Mark",
      "summary": "Peleg and Bildad test Queequeg's skill and accept his mark on the ship's articles.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-019",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 19,
      "title": "The Prophet",
      "summary": "Elijah delivers an obscure warning about Ahab and the fate awaiting those who sail with him.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-020",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 20,
      "title": "All Astir",
      "summary": "The Pequod takes on provisions while mysterious men and contradictory rumors sharpen Ishmael's unease.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-021",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 21,
      "title": "Going Aboard",
      "summary": "Before dawn Ishmael and Queequeg board and glimpse shadowy sailors slipping aboard ahead of them.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-022",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 22,
      "title": "Merry Christmas",
      "summary": "The Pequod leaves Nantucket on Christmas Day as Peleg and Bildad relinquish command to the officers.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-023",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 23,
      "title": "The Lee Shore",
      "summary": "Ishmael remembers Bulkington as a man who chooses the perilous open sea over the safety of a lee shore.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-024",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 24,
      "title": "The Advocate",
      "summary": "Ishmael defends whaling as dangerous, global labor too easily dismissed by those who benefit from it.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-025",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 25,
      "title": "Postscript",
      "summary": "The narrator adds ceremonial evidence that whale oil reaches even the crowns and rituals of monarchs.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-026",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 26,
      "title": "Knights and Squires",
      "summary": "Starbuck, Stubb, and Flask emerge as three sharply different mates entrusted with the whale boats.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-027",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 27,
      "title": "Knights and Squires",
      "summary": "Queequeg, Tashtego, and Daggoo are introduced as the harpooneers paired with the three mates.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-028",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 28,
      "title": "Ahab",
      "summary": "After days below, Ahab finally stands on deck, marked by a scar and balanced on an ivory leg.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-029",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 29,
      "title": "Enter Ahab; to Him, Stubb",
      "summary": "Stubb's attempt to soften the captain's restless pacing earns a humiliating rebuke.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-030",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 30,
      "title": "The Pipe",
      "summary": "Ahab finds that the pipe offers no peace and throws it away, rejecting ordinary consolation.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-031",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 31,
      "title": "Queen Mab",
      "summary": "Stubb turns his encounter with Ahab into a comic dream, protecting his spirits through interpretation.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-032",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 32,
      "title": "Cetology",
      "summary": "Ishmael builds an openly provisional classification of whales and exposes the limits of tidy systems.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-033",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 33,
      "title": "The Specksnyder",
      "summary": "The old authority of harpooneers helps explain the private command Ahab exercises beyond formal rank.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-034",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 34,
      "title": "The Cabin-Table",
      "summary": "The officers' rigid dining order gives way to the harpooneers' noisy ease after the mates leave the cabin.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-035",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 35,
      "title": "The Mast-Head",
      "summary": "Ishmael recalls the dreamy dangers of lookout duty, where contemplation can dissolve practical attention.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-036",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 36,
      "title": "The Quarter-Deck",
      "summary": "Ahab nails a gold doubloon to the mast and binds the crew to his private hunt for the white whale.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-chapter-037",
      "timelineId": "moby-dick-timeline-voyage",
      "number": 37,
      "title": "Sunset",
      "summary": "Alone after the oath, Ahab names the suffering that has hardened his will against the world.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
