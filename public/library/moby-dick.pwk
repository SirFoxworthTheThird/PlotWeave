      "id": "moby-dick-faction-crew",
      "name": "Pequod’s Crew",
      "description": "A multinational company of sailors bound first by wages and labor, then by Ahab’s oath.",
      "color": "#66725e",
      "coverImageId": "moby-dick-image-faction-crew",
      "tags": []
