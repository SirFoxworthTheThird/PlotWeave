  "knowledgeFacts": [
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-fact-friends",
      "title": "Ishmael and Queequeg have chosen one another as family",
      "description": "Their friendship replaces Ishmael’s first fear with reciprocal loyalty.",
      "tags": [],
      "readerLearnsAtEventId": "moby-dick-event-010",
      "originEventId": "moby-dick-event-010"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-fact-ahab-hunt",
      "title": "Ahab intends to hunt Moby Dick rather than merely complete a whaling voyage",
      "description": "The doubloon and oath reveal the private purpose hidden from the signed crew.",
      "tags": [],
      "readerLearnsAtEventId": "moby-dick-event-036",
      "originEventId": "moby-dick-event-036"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-fact-fedallah-aboard",
      "title": "Fedallah and a hidden boat crew have sailed aboard the Pequod",
      "description": "The first lowering exposes Ahab’s concealed preparations.",
      "tags": [],
      "readerLearnsAtEventId": "moby-dick-event-048",
      "originEventId": "moby-dick-event-048"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-fact-pip-changed",
      "title": "Pip’s abandonment at sea has permanently altered his mind",
      "description": "The crew recovers him physically but cannot restore his former relation to the world.",
      "tags": [],
      "readerLearnsAtEventId": "moby-dick-event-093",
      "originEventId": "moby-dick-event-093"
    },
    {
