      "timelineId": "moby-dick-timeline-voyage",
      "number": 39,
      "title": "First Night-Watch",
      "summary": "Stubb answers dread with song and laughter while the ship's new purpose settles over the watch.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
