      "timelineId": "moby-dick-timeline-voyage",
      "number": 50,
      "title": "Ahab's Boat and Crew. Fedallah.",
      "summary": "Ahab's secret preparations and Fedallah's uncanny influence take visible form in the fourth boat.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
