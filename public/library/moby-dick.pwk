  "plotThreads": [
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-thread-friendship",
      "name": "Ishmael and Queequeg",
      "color": "#7b6a4c",
      "description": "Prejudice gives way to a friendship that survives separation, illness, and death through the coffin that saves Ishmael."
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-thread-obsession",
      "name": "Ahab’s Hunt",
      "color": "#6f3940",
      "description": "Ahab converts a commercial voyage and an entire crew into instruments of revenge against Moby Dick."
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-thread-conscience",
      "name": "Starbuck’s Conscience",
      "color": "#687657",
      "description": "Starbuck repeatedly sees the moral danger yet cannot find an action equal to his judgment."
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-thread-labor",
      "name": "The Work of Whaling",
      "color": "#586f7d",
      "description": "Hunts, cutting-in, rendering, storage, and navigation reveal the skilled collective labor beneath the voyage."
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-thread-knowledge",
      "name": "Knowing the Whale",
      "color": "#766550",
      "description": "Ishmael tests classifications, pictures, anatomy, law, myth, and direct witness without pretending the whale is exhausted by them."
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-thread-omens",
      "name": "Omens and Prophecy",
      "color": "#6f5b78",
      "description": "Warnings, dreams, electrical fire, lost instruments, and Fedallah’s prophecy accumulate around Ahab’s chosen course."
    }
  ],
