      "timelineId": "moby-dick-timeline-voyage",
      "number": 38,
      "title": "Dusk",
      "summary": "Starbuck recognizes the voyage's blasphemous danger but cannot yet oppose the captain who commands it.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
