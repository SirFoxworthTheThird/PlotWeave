      "timelineId": "moby-dick-timeline-voyage",
      "number": 41,
      "title": "Moby Dick",
      "summary": "Ishmael explains Ahab's maiming and the way the captain has made one whale the agent of every hidden evil.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
