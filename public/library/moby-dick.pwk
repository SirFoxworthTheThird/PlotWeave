      "timelineId": "moby-dick-timeline-voyage",
      "number": 44,
      "title": "The Chart",
      "summary": "Ahab studies years of whale sightings and currents to predict where Moby Dick may surface.",
      "status": "final",
      "targetWordCount": null
    },
