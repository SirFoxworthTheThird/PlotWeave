      "timelineId": "moby-dick-timeline-voyage",
      "number": 40,
      "title": "Midnight, Forecastle",
      "summary": "The multinational crew sings, boasts, quarrels, and dances before a squall drives them back to work.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
