  "loreCategories": [
    {
      "id": "moby-dick-lore-category-source",
      "worldId": "moby-dick-world",
      "name": "Edition and Chronology",
      "color": "#667789",
      "sortOrder": 0
    },
    {
      "id": "moby-dick-lore-category-whaling",
      "worldId": "moby-dick-world",
      "name": "Whaling World",
      "color": "#77664c",
      "sortOrder": 1
    },
    {
      "id": "moby-dick-lore-category-interpretation",
      "worldId": "moby-dick-world",
      "name": "Ideas and Symbols",
      "color": "#6f5f75",
      "sortOrder": 2
    }
  ],
  "lorePages": [
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-lore-1",
      "categoryId": "moby-dick-lore-category-source",
      "title": "Complete Source and Editorial Calendar",
      "body": "The structure follows the complete Project Gutenberg edition #2701: 135 author-titled chapters and the Epilogue. The voyage’s exact dates are often unstated, so the calendar begins with Ishmael’s winter departure and uses an explicitly editorial sequence of elapsed days to preserve order rather than claiming historical precision.",
      "tags": [],
      "coverImageId": "moby-dick-image-character-ishmael",
      "linkedEntityIds": [],
      "visibleFromEventId": "moby-dick-event-001"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-lore-2",
      "categoryId": "moby-dick-lore-category-source",
      "title": "Visual Provenance",
      "body": "The world cover, regional chart, voyage chart, Pequod plans, and character portraits are original generated illustrations created for this example in a mature engraved nineteenth-century style. They are repository-hosted and visually reviewed; maps and entity artwork serve separate purposes.",
      "tags": [],
      "coverImageId": "moby-dick-image-world",
      "linkedEntityIds": [],
      "visibleFromEventId": "moby-dick-event-001"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-lore-3",
      "categoryId": "moby-dick-lore-category-whaling",
      "title": "The Lay System",
      "body": "Instead of ordinary wages, a whaler receives a fractional share called a lay. Rank, experience, and bargaining determine how much of a successful voyage each sailor may claim.",
      "tags": [],
      "coverImageId": "moby-dick-image-character-ishmael",
      "linkedEntityIds": [],
      "visibleFromEventId": "moby-dick-event-016"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-lore-4",
      "categoryId": "moby-dick-lore-category-whaling",
      "title": "A Gam at Sea",
      "body": "A gam is a social meeting between whaleships, allowing captains and crews to exchange letters, news, sightings, and stories during voyages that may last years.",
      "tags": [],
      "coverImageId": "moby-dick-image-character-ishmael",
      "linkedEntityIds": [],
      "visibleFromEventId": "moby-dick-event-053"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-lore-5",
      "categoryId": "moby-dick-lore-category-whaling",
      "title": "Trying Out",
      "body": "Cut blubber is minced and boiled in brick furnaces called try-works. The resulting oil is cooled into casks and stored below, turning the ship into a mobile processing works.",
      "tags": [],
      "coverImageId": "moby-dick-image-character-ishmael",
      "linkedEntityIds": [],
      "visibleFromEventId": "moby-dick-event-067"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-lore-6",
      "categoryId": "moby-dick-lore-category-interpretation",
      "title": "One Whale, Many Readings",
      "body": "The example preserves the book’s distinction between Moby Dick as a living sperm whale and the meanings Ahab, Ishmael, and others project onto him. No single interpretation is presented as the animal’s secret essence.",
      "tags": [],
      "coverImageId": "moby-dick-image-character-ishmael",
      "linkedEntityIds": [],
      "visibleFromEventId": "moby-dick-event-041"
    }
  ],
  "factions": [
