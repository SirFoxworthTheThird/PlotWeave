  "characterGoals": [
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-goal-ishmael-sea",
      "characterId": "moby-dick-character-ishmael",
      "type": "want",
      "text": "Escape the confinement of shore life through a whaling voyage.",
      "startEventId": "moby-dick-event-001",
      "endEventId": "moby-dick-event-022"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-goal-ishmael-understand",
      "characterId": "moby-dick-character-ishmael",
      "type": "need",
      "text": "Witness the voyage without forcing the whale or the world into one final meaning.",
      "startEventId": "moby-dick-event-023",
      "endEventId": "moby-dick-event-136"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-goal-queequeg-sail",
      "characterId": "moby-dick-character-queequeg",
      "type": "want",
      "text": "Practice his skill honorably beside the friend he has chosen.",
      "startEventId": "moby-dick-event-013",
      "endEventId": "moby-dick-event-135"
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-goal-ahab-revenge",
      "characterId": "moby-dick-character-ahab",
      "type": "want",
      "text": "Find and strike Moby Dick regardless of commercial duty or human cost.",
