      "timelineId": "moby-dick-timeline-voyage",
      "number": 51,
      "title": "The Spirit-Spout",
      "summary": "A distant midnight spout repeatedly lures the Pequod onward while Ahab keeps solitary watch.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "moby-dick-world",
      "createdAt": 1788480000000,
