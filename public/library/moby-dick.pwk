      "createdAt": 1788480000000,
      "updatedAt": 1788480000000,
      "id": "moby-dick-faction-owners",
      "name": "Pequod’s Owners",
      "description": "Nantucket investors who fit and finance the voyage through fractional lays and delegated command.",
