775595000000}, {"id": "lotr-char-harry-goatleaf", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Harry Goatleaf", "aliases": [], "description": "Gatekeeper of Bree who secretly assists the enemy.", "portraitImageId": null, "color": "#713f12", "tags": ["bree", "antagonist"], "isAlive": true, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-char-isildur", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Isildur", "aliases": [], "description": "Heir of Elendil who cut the Ring from Sauron's hand and refused to destroy it.", "portraitImageId": null, "color": "#1d4ed8", "tags": ["historical", "dunedain"], "isAlive": false, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-char-radagast-the-brown", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Radagast the Brown", "aliases": ["Aiwendil"], "description": "Wizard deceived into bringing Gandalf Saruman's summons and arranging aid from the Eagles.", "portraitImageId": null, "color": "#92400e", "tags": ["wizard"], "isAlive": true, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-char-saruman-the-white", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Saruman the White", "aliases": ["Curun\u00edr"], "description": "Head of the White Council whose attempt to recruit and imprison Gandalf reveals his treason.", "portraitImageId": null, "color": "#e5e7eb", "tags": ["wizard", "antagonist"], "isAlive": true, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "ouYAUjn2Tk2wlv3NQwsSX", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Bilbo Baggins", "aliases": [], "description": "Original bearer of the One Ring", "portraitImageId": "FxBnVNlUS72huju8Rruso", "tags": [], "isAlive": true, "createdAt": 1775082744492, "updatedAt": 1775083637425, "relationshipIds": ["rel_bf", "rel_bg", "rel_bl"], "color": null}, {"id": "rPOFbCqkPNTgsoIN8_tX6", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Gandalf the Grey", "aliases": [], "description": "Gandalf the Grey is a wise, compassionate, and powerful Maiar spirit (Istari wizard) sent to Middle-earth to guide its peoples against Sauron.\nAppearing as an elderly man with a grey beard, pointy hat, and staff, he acts as a mentor, \"Grey Wanderer,\" and fiery combatant, fostering hope rather than relying solely on magical power.", "portraitImageId": "utBmPle9EMGDF1MN6BuD2", "tags": [], "isAlive": false, "createdAt": 1775083195321, "updatedAt": 1775083326500, "relationshipIds": ["rel_bg"], "color": null}, {"id": "yCsufFPoyoKIj5aOKzvYu", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Frodo Baggins", "aliases": [], "description": "Frodo Baggins is a Hobbit of the Shire and the primary protagonist of J.R.R.\nTolkien\u2019s The Lord of the Rings. As the Ring-bearer, he shows immense courage, resilience, and compassion, tasked with carrying the One Ring to Mordor to destroy it.\nHe is portrayed as wise, kind-hearted, and thoughtful, though he is heavily burdened and physically/emotionally scarred by the journey.", "portraitImageId": "plMi9iOxFgsM2PNGu5wlK", "tags": [], "isAlive": true, "createdAt": 1775083048541, "updatedAt": 1775083520423, "relationshipIds": ["rel_bf", "rel_fs", "kaZwtj9r0hnHEWa411gOL", "rel_frodo_pippin", "rel_frodo_blackrider", "rel_frodo_gildor", "rel_frodo_merry", "rel_frodo_maggot", "rel_frodo_fatty", "rel_frodo_tom", "rel_frodo_willow", "rel_frodo_strider", "rel_frodo_barliman"], "color": null}], "items": [{"id": "fvZm5b3dn4KEyHShSofda", "imageId": "ykuGV8vJZQkmrB1m2_lGQ", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "The One Ring", "description": "One ring to rule them all", "iconType": "", "tags": []}, {"id": "item_anduril", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "And\u00faril", "description": "The Flame of the West. Forged in Rivendell from the shards of Narsil for Aragorn.", "iconType": "weapon", "tags": ["Weapon", "Sword", "Legendary"], "imageId": "JbYUPF6bwaN1lQvGvBIQP"}, {"id": "item_athelas", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Athelas", "description": "Also known as Kingsfoil, a healing herb brought to Middle-earth by the Men of Westernesse. Strider uses it to combat the effects of the Morgul-wound.", "iconType": "consumable", "tags": ["Herb", "Healing"], "imageId": "rVKYAwXF9I5u0515BweOd"}, {"id": "item_barrow_blades", "imageId": "FLUtlSCAjx0Z7lpooYK5j", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Barrow-blades", "description": "Ancient daggers forged by the Men of Westernesse.", "iconType": "weapon", "tags": ["Weapon", "Dagger"]}, {"id": "item_bow_galadhrim", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Bow of the Galadhrim", "description": "A stout bow strung with Elf-hair, longer and stronger than those of Mirkwood.", "iconType": "weapon", "tags": ["Weapon", "Bow", "Elven"], "imageId": "w_UYl6tvnlxK8CHLXwvp4"}, {"id": "item_elessar", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "The Elfstone", "description": "A great green stone set in a silver eagle brooch, given to Aragorn as a token of hope.", "iconType": "artifact", "tags": ["Jewelry", "Elven"], "imageId": "P1Rwg9Cgk0IAYxH-jm8PJ"}, {"id": "item_elven_cloaks", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Elven Cloak", "description": "A grey-green cloak fastened with a leaf-brooch of L\u00f3rien that helps camouflage the wearer from unfriendly eyes.", "iconType": "armor", "tags": ["Clothing", "Elven", "Stealth"], "imageId": "7TBanZlcWIyttjeGRiAYh"}, {"id": "item_elven_rope", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Hithlain Rope", "description": "Light, strong, grey-silvery rope made by the Elves of L\u00f3rien.", "iconType": "tool", "tags": ["Tool", "Elven"], "imageId": "-8NmjfktBL7DYGDGh09dp"}, {"id": "item_galadriel_hair", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Galadriel's Hair", "description": "Three strands of golden hair from the Lady of the Wood, given to Gimli at his request.", "iconType": "artifact", "tags": ["Relic", "Gift"], "imageId": "3bgpvOYipJIvS73dDpJpD"}, {"id": "item_gandalf_letter", "imageId": "zcOuPCim2AdgD9SrAm4yy", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Gandalf's Letter", "description": "A delayed letter from Gandalf urging Frodo to leave the Shire quickly and confirming Strider's true identity.", "iconType": "document", "tags": ["Document", "Letter"]}, {"id": "item_lembas", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Lembas", "description": "Elven waybread. Extremely nutritious; one wafer can sustain a traveler for a day of hard labor.", "iconType": "consumable", "tags": ["Food", "Elven"], "imageId": "WvHckGrBAchJ65_g4ObVA"}, {"id": "item_mirror_galadriel", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "The Mirror of Galadriel", "description": "A silver basin on a low pedestal, filled with water from a nearby stream. It shows visions of the past, present, and possible futures.", "iconType": "artifact", "tags": ["Magic", "Artifact"], "imageId": "UWaCKGC4KN7VQc8t_FVec"}, {"id": "item_mithril_shirt", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Mithril Coat", "description": "A lightweight but incredibly strong chainmail shirt made of pure Mithril. Given to Frodo by Bilbo.", "iconType": "armor", "tags": ["Armor", "Dwarven", "Legendary"], "imageId": "wA5wJpJQ7kWPA2y4GwHDu"}, {"id": "item_morgul_blade", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Morgul-blade", "description": "A poisoned magical dagger wielded by the Nazg\u00fbl. A piece of the blade breaks off in the victim to pull them into the wraith world.", "iconType": "weapon", "tags": ["Weapon", "Cursed"], "imageId": "D2_v_tiib4flXNFTZnnMr"}, {"id": "item_narsil", "imageId": "nscbbpOsj5vA3aZ4nmPIo", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Narsil (Broken)", "description": "The legendary sword of Elendil, broken during the battle with Sauron.", "iconType": "weapon", "tags": ["Weapon", "Sword", "Relic"]}, {"id": "item_nenya", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Nenya", "description": "The Ring of Water, one of the Three Elven Rings of Power. It is made of Mithril and set with a stone of adamant. Wielded by Galadriel to protect and preserve Lothl\u00f3rien.", "iconType": "ring", "tags": ["Ring of Power", "Elven", "Legendary"], "imageId": "bbHqZSGJ_HIgjWmSN20aK"}, {"id": "item_phial_galadriel", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Phial of Galadriel", "description": "A crystal phial containing the light of E\u00e4rendil's star caught in the waters of Galadriel's fountain.", "iconType": "artifact", "tags": ["Magic", "Light"], "imageId": "GtFn_k_8ECJ1xEVirx_wg"}, {"id": "item_sting", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Sting", "description": "An ancient Elven dagger that glows blue in the presence of Orcs. Given to Frodo by Bilbo.", "iconType": "weapon", "tags": ["Weapon", "Dagger", "Elven"], "imageId": "aR0olOyPg1U6YTh3OJ1_I"}], "characterSnapshots": [{"id": "lotr-snap-01c607ab-c4b2-4d29-9e8c-8ef621f8a84a-char_merry_brandybuck", "worldId": "aX-7torL9Na4l4UvyLWIP", "characterId": "char_merry_brandybuck", "eventId": "01c607ab-c4b2-4d29-9e8c-8ef621f8a84a", "isAlive": true, "currentLocationMarkerId": "ec6ANR4WUn44tdrcYLN-Y", "currentMapLayerId": "npYTzHFWQrkkDB4W_dUdY", "inventoryItemIds": [], "inventoryNotes": "", "statusNotes": "Into the Old Forest", "travelModeId": null, "sortKey": 6, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-snap-01c607ab-c4b2-4d29-9e8c-8ef621f8a84a-char_pippin_took", "worldId": "aX-7torL9Na4l4UvyLWIP", "characterId": "char_pippin_took", "eventId": "01c607ab-c4b2-4d29-9e8c-8ef621f8a84a", "isAlive": true, "currentLocationMarkerId": "ec6ANR4WUn44tdrcYLN-Y", "currentMapLayerId": "npYTzHFWQrkkDB4W_dUdY", "inventoryItemIds": [], "inventoryNotes": "", "statusNotes": "Into the Old Forest", "travelModeId": null, "sortKey": 6, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-snap-01c607ab-c4b2-4d29-9e8c-8ef621f8a84a-char_sam_gamgee", "worldId": "aX-7torL9Na4l4UvyLWIP", "characterId": "char_sam_gamgee", "eventId": "01c607ab-c4b2-4d29-9e8c-8ef621f8a84a", "isAlive": true, "currentLocationMarkerId": "ec6ANR4WUn44tdrcYLN-Y", "curren