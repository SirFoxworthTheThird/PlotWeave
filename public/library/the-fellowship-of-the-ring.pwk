"aX-7torL9Na4l4UvyLWIP", "name": "Tom Bombadil", "portraitImageId": "Um_gSChkqRXCvjboE21dG", "aliases": ["Iarwain Ben-adar"], "description": "A merry, mysterious, and immensely powerful being residing in the Old Forest.", "tags": ["Unknown"], "relationshipIds": ["rel_frodo_tom"], "isAlive": true, "createdAt": 1741000000000, "updatedAt": 1775102277963, "color": null}, {"id": "char_watcher", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "The Watcher in the Water", "aliases": ["The Watcher"], "description": "A mysterious, many-tentacled creature lurking in the stagnant pool before the West-gate of Moria.", "tags": ["Monster", "Enemy"], "isAlive": true, "relationshipIds": [], "portraitImageId": "MA4OtrG5WAR_tCXnuqiLU", "updatedAt": 1775159205391, "color": null, "createdAt": 1700000000000}, {"id": "char_witch_king", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "The Witch-king of Angmar", "aliases": ["Lord of the Nazg\u00fbl", "Black Captain"], "description": "The leader of the Ringwraiths and Sauron's most powerful servant.", "tags": ["Nazg\u00fbl", "Enemy"], "isAlive": true, "relationshipIds": ["rel_frodo_witchking"], "portraitImageId": "7A2vfM5_liTMdrWNCwOsP", "updatedAt": 1775155213786, "color": null, "createdAt": 1700000000000}, {"id": "lotr-char-bill-ferny", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Bill Ferny", "aliases": [], "description": "Hostile Bree-man who collaborates with the enemy's agents and sells the pony Bill.", "portraitImageId": null, "color": "#78350f", "tags": ["bree", "antagonist"], "isAlive": true, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-char-deagol", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "D\u00e9agol", "aliases": [], "description": "Stoor hobbit who found the Ring in the Anduin and was murdered by Sm\u00e9agol.", "portraitImageId": null, "color": "#78716c", "tags": ["historical", "hobbit"], "isAlive": false, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-char-elendil", "worldId": "aX-7to