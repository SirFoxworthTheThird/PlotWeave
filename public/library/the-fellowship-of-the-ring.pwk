mpanion", "sortKey": 59.032, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-33", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-legolas-gimli", "eventId": "6d9a42f1-c8b5-41a3-97e2-1a48f2d5b6c9", "isActive": true, "sentiment": "complex", "strength": "moderate", "label": "Mistrust Growing toward Friendship", "description": "Mistrust Growing toward Friendship", "sortKey": 59.033, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-34", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-celeborn-galadriel", "eventId": "3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d", "isActive": true, "sentiment": "positive", "strength": "bond", "label": "Lord and Lady of L\u00f3rien", "description": "Lord and Lady of L\u00f3rien", "sortKey": 75.034, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-35", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-gimli-galadriel", "eventId": "3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d", "isActive": true, "sentiment": "positive", "strength": "strong", "label": "Reverence and Grace", "description": "Reverence and Grace", "sortKey": 75.035, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-36", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-galadriel", "eventId": "3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d", "isActive": true, "sentiment": "positive", "strength": "strong", "label": "Fellow Ring-bearers", "description": "Fellow Ring-bearers", "sortKey": 75.036, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-37", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-sam-bill", "eventId": "d824ba95-1f9e-4a6c-83b7-7e92c41f8a61", "isActive": true, "sentiment": "positive", "strength": "strong", "label": "Caretaker and Pony", "description": "Caretaker and Pony", "sortKey": 39.037, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-38", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-willow", "eventId": "b103e689-5b4e-4f51-b847-f027c626bc61", "isActive": true, "sentiment": "negative", "strength": "strong", "label": "Victim and Captor", "description": "Victim and Captor", "sortKey": 21.038, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-39", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-wight", "eventId": "7b8f9e20-31c5-4d82-8b4e-99a3c1f2b651", "isActive": true, "sentiment": "negative", "strength": "strong", "label": "Victim and Captor", "description": "Victim and Captor", "sortKey": 28.039, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-4", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-merry", "eventId": "e8ec1641-52ea-493f-a63e-1087e6be9593", "isActive": true, "sentiment": "positive", "strength": "strong", "label": "Cousins and Companions", "description": "Cousins and Companions", "sortKey": 16.004, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-40", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-watcher", "eventId": "e7c2a1df-3450-4f51-b8d9-2a91e5e03b71", "isActive": true, "sentiment": "negative", "strength": "strong", "label": "Victim and Attacker", "description": "Victim and Attacker", "sortKey": 65.04, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-41", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-gollum-deagol", "eventId": "lotr-ev-deagol", "isActive": true, "sentiment": "negative", "strength": "strong", "label": "Murderer and Victim", "description": "Murderer and Victim", "sortKey": 7.041, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-42", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-bill-ferny-aragorn", "eventId": "5146c2f3-18d4-482a-a92c-61d0f5e18231", "isActive": true, "sentiment": "negative", "strength": "moderate", "label": "Enemy Agent and Ranger", "description": "Enemy Agent and Ranger", "sortKey": 32.042, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-5", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-pippin", "eventId": "f5b66d74-c3a9-40e8-963a-eb8b2f934441", "isActive": true, "sentiment": "positive", "strength": "strong", "label": "Cousins and Companions", "description": "Cousins and Companions", "sortKey": 9.005, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-6", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-merry-pippin", "eventId": "e0000000-0000-4000-8000-000000000001", "isActive": true, "sentiment": "positive", "strength": "bond", "label": "Closest Friends", "description": "Closest Friends", "sortKey": 17.006, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-7", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-fatty", "eventId": "e0000000-0000-4000-8000-000000000001", "isActive": true, "sentiment": "positive", "strength": "moderate", "label": "Friends and Co-conspirators", "description": "Friends and Co-conspirators", "sortKey": 17.007, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-8", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-maggot", "eventId": "b3f0bbcb-38c6-4b47-b87d-8ebdf4ea61bb", "isActive": true, "sentiment": "positive", "strength": "moderate", "label": "Reconciled Neighbors", "description": "Reconciled Neighbors", "sortKey": 15.008, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-relsnap-9", "worldId": "aX-7torL9Na4l4UvyLWIP", "relationshipId": "lotr-rel-frodo-gildor", "eventId": "b96a9c14-72b1-4b15-9c59-866d9f8e4344", "isActive": true, "sentiment": "positive", "strength": "moderate", "label": "Traveler and Protector", "description": "Traveler and Protector", "sortKey": 11.009, "createdAt": 1775595000000, "updatedAt": 1775595000000}], "timelines": [{"id": "rfgyP7eqm-EE7abwXQTWi", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "The War of the Ring", "description": "The main chronology from Bilbo's farewell in Third Age 3001 through the breaking of the Fellowship in February 3019.", "color": "#3f6212", "createdAt": 1775070199585}], "chapters": [{"id": "X7wR6L80n9R6k495gHov-", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 1, "title": "A Long-expected Party", "synopsis": "Bilbo Baggins celebrates his eleventy-first birthday with a magnificent party and suddenly vanishes using his magic ring. After a tense confrontation with Gandalf, Bilbo leaves the Shire, leaving the Ring and Bag End to Frodo.", "notes": "Book One", "createdAt": 1775592451995, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_10_strider", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 10, "title": "Strider", "synopsis": "Strider speaks to the Hobbits in their parlor, offering his protection and guidance. Barliman Butterbur remembers to deliver a letter from Gandalf, which confirms Strider's true identity as Aragorn. Merry rushes in with news that Black Riders are in Bree. The group decides to accept Strider's help and prepares to depart secretly.", "notes": "Book One", "createdAt": 1775594002123, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_11_knife_in_the_dark", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 11, "title": "A Knife in the Dark", "synopsis": "Strider leads the Hobbits out of Bree and through the treacherous Midgewater Marshes to avoid the roads. They arrive at Weathertop, where they discover signs of Gandalf. That night, their camp is ambushed by five Nazg\u00fbl. Frodo puts on the Ring and is stabbed by the Witch-king with a Morgul-blade before Strider drives the wraiths away with fire.", "notes": "Book One", "createdAt": 1775594116876, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_12_flight_to_the_ford", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 12, "title": "Flight to the Ford", "synopsis": "With Frodo gravely wounded by the Morgul-blade, Strider uses Athelas to slow the poison, and leads the company toward Rivendell. They pass through the Trollshaws, encountering the stone trolls from Bilbo's past. As Frodo's condition worsens, they meet the Elf-lord Glorfindel. The Nazg\u00fbl ambush them near the Ford of Bruinen. Frodo escapes across the river on Glorfindel's horse just as a magical flood sweeps the Ringwraiths away.", "notes": "Book One", "createdAt": 1775594295086, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_13_many_meetings", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 13, "title": "Many Meetings", "synopsis": "Frodo awakens in Rivendell, having been healed by Elrond. He reunites with Gandalf, Sam, Merry, and Pippin. At a great feast, he sees the beautiful Arwen Evenstar and is joyfully reunited with his uncle, Bilbo Baggins. The group rests and prepares for the upcoming Council of Elrond.", "notes": "Book Two", "createdAt": 1775594467753, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_14_council_of_elrond", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 14, "title": "The Council of Elrond", "synopsis": "Representatives of Elves, Dwarves, and Men gather at Rivendell to discuss the growing threat of Sauron and the fate of the One Ring. Gandalf recounts the treason of Saruman. Boromir argues to use the Ring for Gondor, but Elrond decrees it must be destroyed in Mount Doom. Frodo Baggins volunteers to take the Ring, and Sam insists on accompanying him.", "notes": "Book Two", "createdAt": 1775594574943, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_15_ring_goes_south", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 15, "title": "The Ring Goes South", "synopsis": "The Fellowship of the Ring is chosen by Elrond: nine walkers to oppose the Nine Riders. Narsil is reforged and renamed And\u00faril. Before they depart, Bilbo privately gifts Frodo his Elven sword, Sting, and a coat of Mithril mail. The Company journeys south through the deserted land of Hollin. They attempt to cross the Misty Mountains via the Redhorn Pass but are defeated by a fierce, unnatural snowstorm.", "notes": "Book Two", "createdAt": 1775594684908, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_16_journey_in_the_dark", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 16, "title": "A Journey in the Dark", "synopsis": "Turned back by the snow on Caradhras, the Fellowship decides to take the dark and secret path through the Mines of Moria. After fighting off a pack of Wargs, they reach the Doors of Durin. Gandalf struggles to find the password but eventually opens the doors. Bill the Pony is sent away. As they enter, the Watcher in the Water attacks Frodo and destroys the doors behind them, trapping the Fellowship in the dark, ruined halls of Khazad-d\u00fbm. They journey through the dark and arrive at the Twenty-first Hall.", "notes": "Book Two", "createdAt": 1775594807844, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_17_bridge_of_khazaddum", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 17, "title": "The Bridge of Khazad-d\u00fbm", "synopsis": "The Fellowship discovers the tomb of Balin in the Chamber of Mazarbul. They are ambushed by Orcs and a Cave-troll. Frodo is stabbed by an Orc-chieftain but miraculously survives. Fleeing toward the East-gate, they are pursued by a Balrog, Durin's Bane. At the Bridge of Khazad-d\u00fbm, Gandalf stands his ground, shattering the bridge to save the others. He is dragged into the abyss by the Balrog's whip. The remaining eight members escape Moria into the Dimrill Dale, grief-stricken.", "notes": "Book Two", "createdAt": 1775594957009, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_18_lothlorien", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 18, "title": "Lothl\u00f3rien", "synopsis": "The grieving Fellowship escapes the pursuit of Moria's Orcs and crosses the river Nimrodel into the golden wood of Lothl\u00f3rien. They are intercepted by Haldir, an Elven march-warden. Due to the deep mistrust between Elves and Dwarves, Gimli is required to be blindfolded, prompting Aragorn to require the entire company to be blindfolded in solidarity. They are led to Caras Galadhon, the city of trees, where they meet Lord Celeborn and Lady Galadriel. The Lady tests the resolve of the Company, and they find a temporary, timeless haven to rest.", "notes": "Book Two", "createdAt": 1775595503347, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_19_mirror_of_galadriel", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 19, "title": "The Mirror of Galadriel", "synopsis": "The Fellowship rests in the timeless realm of Lothl\u00f3rien for many days. Galadriel brings Frodo and Sam to her secret enclosed garden to look into the Mirror of Galadriel. Sam is horrified by visions of the Shire being destroyed, while Frodo sees the terrifying Eye of Sauron. Galadriel reveals that she is a Ring-bearer, possessing Nenya, the Ring of Water. Frodo offers her the One Ring, but she refuses the ultimate temptation, accepting that her time is ending and she will diminish into the West.", "notes": "Book Two", "createdAt": 1775595600000, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_20_farewell_to_lorien", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 20, "title": "Farewell to L\u00f3rien", "synopsis": "The time comes for the Fellowship to depart Lothl\u00f3rien. Celeborn provides them with boats to travel south down the River Anduin. The Elves supply them with Lembas bread, hithlain rope, and camouflaging Elven cloaks. As they depart, Galadriel presents individual gifts to each member of the company, including a star-glass for Frodo and three strands of her own hair for Gimli, a request that astonishes the Elves. The Fellowship sets off down the Great River.", "notes": "Book Two", "createdAt": 1775595800000, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_21_the_great_river", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 21, "title": "The Great River", "synopsis": "The Fellowship travels down the River Anduin for many days, secretly shadowed by Gollum drifting on a log. Approaching the rapids of Sarn Gebir, they are ambushed by Orcs from the eastern shore, and Legolas shoots down a Nazg\u00fbl's winged steed in the dark. They navigate through the Argonath, the colossal Pillars of the Kings, and finally camp at the lawn of Parth Galen above the Falls of Rauros, where they must decide whether to head toward Minas Tirith or Mordor.", "notes": "Book Two", "createdAt": 1775595980804, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_22_breaking_of_the_fellowship", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 22, "title": "The Breaking of the Fellowship", "synopsis": "At Parth Galen, Frodo asks for time alone to decide their path. Boromir follows him and, corrupted by the Ring's influence, attempts to take it by force. Frodo puts on the Ring and escapes to the Seat of Seeing on Amon Hen. Boromir returns to the camp, ashamed, and the rest of the company scatters in panic to find Frodo. Realizing Frodo intends to go to Mordor alone, Sam intercepts him at the boats. The two set off across the river toward the Emyn Muil, breaking the Fellowship.", "notes": "Book Two", "createdAt": 1775596142637, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_2_shadow_past", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 2, "title": "The Shadow of the Past", "synopsis": "Seventeen years pass. Gandalf returns and reveals to Frodo that his ring is the One Ring forged by the Dark Lord Sauron. Samwise Gamgee is caught eavesdropping and is chosen by Gandalf to accompany Frodo on his journey to take the Ring away from the Shire.", "notes": "Book One", "createdAt": 1775592697065, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_3_three_is_company", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 3, "title": "Three is Company", "synopsis": "Frodo, Sam, and Pippin set out from Bag End without Gandalf. They are stalked on the road by a mysterious Black Rider but are saved by a chance meeting with a company of High Elves led by Gildor Inglorion.", "notes": "Book One", "createdAt": 1775592885453, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_4_shortcut_to_mushrooms", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 4, "title": "A Short Cut to Mushrooms", "synopsis": "Frodo, Sam, and Pippin cut across the country to avoid the roads and the pursuing Black Riders. They navigate the Marish and encounter Farmer Maggot. Despite Frodo's childhood fears of him, Maggot proves to be a stout ally, feeding them and driving them safely in his wagon to the Bucklebury Ferry, where they reunite with Merry Brandybuck.", "notes": "Book One", "createdAt": 1776621571185, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_5_conspiracy_unmasked", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 5, "title": "A Conspiracy Unmasked", "synopsis": "The Hobbits arrive safely at Frodo's new house at Crickhollow in Buckland. Frodo intends to leave his friends behind and sneak away, but Merry and Pippin reveal they already know about the Ring and his quest. Along with Sam and Fredegar (Fatty) Bolger, they have formed a 'conspiracy' to help him. Fatty stays behind as a decoy while the others prepare to brave the Old Forest.", "notes": "Book One", "createdAt": 1776621757999, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_6_old_forest", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 6, "title": "The Old Forest", "synopsis": "The Hobbits enter the Old Forest to avoid the main roads. They become lost and are lulled to sleep by Old Man Willow, who traps Merry and Pippin inside his trunk. They are rescued by Tom Bombadil, a mysterious entity who commands the willow to release them and invites the Hobbits to his house.", "notes": "Book One", "createdAt": 1775593368766, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_7_in_the_house_of_tom_bombadil", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 7, "title": "In the House of Tom Bombadil", "synopsis": "The Hobbits spend two nights resting in the enchanting home of Tom Bombadil and Goldberry. Tom entertains them with deep stories of the Old Forest and Middle-earth's history, demonstrating a complete immunity to the One Ring's power. Refreshed, the Hobbits set out for the Barrow-downs.", "notes": "Book One", "createdAt": 1775593520435, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_8_fog_on_the_barrow_downs", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 8, "title": "Fog on the Barrow-downs", "synopsis": "The Hobbits leave Tom Bombadil's house but get lost in a thick fog on the Barrow-downs. They are captured by a Barrow-wight and trapped inside a barrow. Frodo resists the Wight's spell and calls for Tom Bombadil, who arrives, banishes the creature, and rescues them. Tom outfits the Hobbits with ancient daggers (Barrow-blades) from the wight's hoard.", "notes": "Book One", "createdAt": 1775593712151, "updatedAt": 1775595000000, "wordGoal": null}, {"id": "chap_9_prancing_pony", "worldId": "aX-7torL9Na4l4UvyLWIP", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "number": 9, "title": "At the Sign of the Prancing Pony", "synopsis": "The Hobbits arrive in the village of Bree and secure rooms at The Prancing Pony inn. In the common room, Frodo accidentally slips the Ring onto his finger and vanishes, causing an uproar. This catches the attention of a mysterious Ranger known as Strider, who asks to speak with Frodo privately.", "notes": "Book One", "createdAt": 1775593889760, "updatedAt": 1775595000000, "wordGoal": null}], "events": [{"id": "01c607ab-c4b2-4d29-9e8c-8ef621f8a84a", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_6_old_forest", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Into the Old Forest", "description": "Early in the morning, Frodo, Sam, Merry, and Pippin leave Crickhollow, passing through the High Hay into the dreaded Old Forest. The atmosphere is oppressive and the trees seem to deliberately shift to block their path.", "locationMarkerId": "ec6ANR4WUn44tdrcYLN-Y", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["travel", "danger", "the-old-forest"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775593368766, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "18f9a2f1-6785-4b32-8419-db24c5387b32", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "X7wR6L80n9R6k495gHov-", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Birthday Party", "description": "Bilbo Baggins hosts an extravagant eleventy-first birthday party for himself and a coming-of-age party for Frodo. Gandalf the Grey provides a magnificent display of fireworks, dazzling the guests from all over the Shire.", "locationMarkerId": "l32D8Q0fQdbcYqXMrIohu", "involvedCharacterIds": ["ouYAUjn2Tk2wlv3NQwsSX", "yCsufFPoyoKIj5aOKzvYu", "rPOFbCqkPNTgsoIN8_tX6", "char_lobelia_sb"], "involvedItemIds": [], "tags": ["celebration", "shire-life", "gandalf-fireworks"], "sortOrder": 0, "travelDays": 0, "createdAt": 1775592451995, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring"], "inWorldTime": null, "tension": 2, "structureBeat": "setup", "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "1d8ea4f9-2c7b-4196-85f2-9d3b7e6c5a41", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_12_flight_to_the_ford", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Healing with Athelas", "description": "After the Nazg\u00fbl are driven off Weathertop, Strider examines Frodo's wound. He finds the hilt of the Morgul-blade, which dissolves in the morning light. Strider uses the herb Athelas (Kingsfoil) to wash the wound, temporarily slowing the spread of the dark poison, though Frodo remains gravely ill.", "locationMarkerId": "moEdrJenBd7HxfU3oX4fl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider"], "involvedItemIds": ["item_athelas", "item_morgul_blade"], "tags": ["healing", "injury", "aftermath"], "sortOrder": 0, "travelDays": 0, "createdAt": 1775594295086, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "1e5b4b1a-0b5c-48c9-9a1b-3f4a2d5e6c71", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_2_shadow_past", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Seventeen Years Pass", "description": "Seventeen years pass quietly in the Shire. Frodo Baggins reaches his fiftieth year, preserving his youth much like Bilbo did. Rumors of a growing darkness in the East slowly reach the borders of the Shire, though Frodo remains mostly undisturbed.", "locationMarkerId": "BCSog_CHLzOQZN13Q7Pi3", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["peace", "passage-of-time"], "sortOrder": 0, "travelDays": 6046, "createdAt": 1775592697065, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-gollum"], "inWorldTime": null, "tension": 1, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "1e8c7b4a-3d2f-4519-9a0e-8b5c2d3f1a6e", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_21_the_great_river", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Argonath", "description": "After portaging the boats past the rapids, they row between the immense, awe-inspiring Pillars of the Kings\u2014the Argonath. Aragorn stands tall, feeling the pride and burden of his ancestors.", "locationMarkerId": "loc_argonath", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": [], "tags": ["history", "awe", "gondor"], "sortOrder": 2, "travelDays": 1, "createdAt": 1775595980804, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-aragorn", "lotr-thread-boromir"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "1f8e2a3c-5b4d-4c6e-9d7a-b1c5e4f2d8a9", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_22_breaking_of_the_fellowship", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Departure for Mordor", "description": "Frodo sneaks down to the boats, intending to cross the river to the Emyn Muil alone. Sam catches him in the act, nearly drowning himself to stop Frodo from leaving. Frodo relents, and the two Hobbits set off across the Anduin together, officially breaking the Fellowship.", "locationMarkerId": "loc_parth_galen", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_gollum"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_elven_cloaks"], "tags": ["departure", "friendship", "loyalty"], "sortOrder": 4, "travelDays": 0, "createdAt": 1775596142637, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-gollum"], "inWorldTime": null, "tension": 4, "structureBeat": "resolution", "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "2b6a9df5-1c39-44d9-813e-f823a07a1b49", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_16_journey_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Warg Attack", "description": "After retreating from Caradhras, the Fellowship is ambushed in the night by a pack of Wargs. They successfully defend themselves, with Gandalf using fire magic and Legolas his bow, solidifying their decision to take the secret path through Moria.", "locationMarkerId": "loc_hollin", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_bill_pony"], "involvedItemIds": ["item_bow_galadhrim"], "tags": ["combat", "wargs", "decision"], "sortOrder": 0, "travelDays": 2, "createdAt": 1775594807844, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "2c8e1a9d-5b4f-437a-9d8e-1f0c5b6a3d2e", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_19_mirror_of_galadriel", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Looking into the Mirror", "description": "Galadriel leads Frodo and Sam away from the others to her secret garden. She fills a silver basin with stream water and invites them to look. Sam sees men destroying the Shire, while Frodo looks deeper and sees the terrifying Eye of Sauron searching for him.", "locationMarkerId": "loc_galadriels_glade", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_galadriel"], "involvedItemIds": ["item_mirror_galadriel"], "tags": ["vision", "magic", "prophecy"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775595600000, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-lorien"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "2d8f9c14-25e2-411f-824d-61c0e393b161", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_4_shortcut_to_mushrooms", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Leaving the Road", "description": "To avoid the pursuit of the Black Riders, Frodo decides they must leave the main road and cut straight across the country. They trudge through rough terrain and thick woods toward the Marish.", "locationMarkerId": "mZ2AOteCjotruUEgjApqG", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["travel", "stealth"], "sortOrder": 0, "travelDays": 1, "createdAt": 1776621571185, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "2e01b4a3-7d84-48f5-9612-4c28f3a8b9e6", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "X7wR6L80n9R6k495gHov-", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Bilbo's Farewell Speech", "description": "During his speech after the grand dinner, Bilbo bids a fond and somewhat confusing farewell to his guests. He unexpectedly slips his magic ring onto his finger and vanishes entirely, plunging the party into chaos.", "locationMarkerId": "l32D8Q0fQdbcYqXMrIohu", "involvedCharacterIds": ["ouYAUjn2Tk2wlv3NQwsSX", "yCsufFPoyoKIj5aOKzvYu", "rPOFbCqkPNTgsoIN8_tX6", "char_lobelia_sb"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["magic", "farewell", "disappearance"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775592451995, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "2e8f71c4-5a9d-42b6-8c31-9f4d0a5b2e71", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_15_ring_goes_south", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Bilbo's Gifts", "description": "Before the Fellowship departs, Bilbo Baggins pulls Frodo aside in his room. He gifts Frodo his ancient Elven dagger, Sting, and a remarkably light, incredibly strong chainmail coat made of Mithril.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "ouYAUjn2Tk2wlv3NQwsSX"], "involvedItemIds": ["item_sting", "item_mithril_shirt"], "tags": ["gifts", "farewell", "armor"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775594684908, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "2f6c5c2b-1c6d-49d0-ab2c-405b3e6f7d82", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_2_shadow_past", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Test of Fire", "description": "Gandalf the Grey suddenly returns to Bag End after a long absence. Bearing grave suspicions, he asks Frodo to hand over the ring and casts it into the hearth fire. After a moment, he retrieves it bare-handed, revealing glowing Elvish letters that confirm it is the One Ring.", "locationMarkerId": "BCSog_CHLzOQZN13Q7Pi3", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "rPOFbCqkPNTgsoIN8_tX6"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["revelation", "magic", "the-one-ring"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775592697065, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-gollum"], "inWorldTime": null, "tension": 4, "structureBeat": "inciting-incident", "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "307d6d3c-2d7e-4ae1-bc3d-516c4f708e93", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_2_shadow_past", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Tale of the Ring", "description": "Gandalf explains the terrifying history of the One Ring, from its creation by Sauron to its discovery by Sm\u00e9agol. He reveals that Gollum left the mountains and was captured and tortured in Mordor, where he surrendered two vital words: 'Shire' and 'Baggins'.", "locationMarkerId": "BCSog_CHLzOQZN13Q7Pi3", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "rPOFbCqkPNTgsoIN8_tX6", "char_gollum", "char_sauron"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["lore", "history", "danger"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775592697065, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-gollum"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_18_lothlorien", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Caras Galadhon and the Testing", "description": "The company arrives at Caras Galadhon, the city of trees. They are brought before Lord Celeborn and Lady Galadriel. Celeborn is angered to hear that Dwarves awakened Durin's Bane, but Galadriel rebukes him and speaks kindly to Gimli. She then holds the gaze of each member of the Fellowship, silently testing their hearts and desires.", "locationMarkerId": "loc_caras_galadhon", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_celeborn", "char_galadriel"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["audience", "magic", "temptation"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775595503347, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "3a7d9f2b-1e6c-4850-a4b5-8c0d1e3f6a9b", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_20_farewell_to_lorien", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Setting Off Down the Great River", "description": "The Fellowship departs in three boats, drifting south on the Great River Anduin. As they leave, Legolas and Gimli sit in the same boat, signifying their new, profound friendship, while Frodo feels the increasing isolation of his quest.", "locationMarkerId": "lotr-loc-lower-anduin", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": [], "tags": ["travel", "river", "departure"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775595800000, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "3a8b72e5-c1d9-43f6-8210-5d49a3e6b7c2", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "X7wR6L80n9R6k495gHov-", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Master of Bag End", "description": "Frodo inherits Bag End and Bilbo's remaining possessions, including the mysterious Ring. Gandalf warns Frodo to keep the Ring secret and safe before departing the Shire. The next day, Frodo deals with the aftermath of the party and fends off greedy relatives like Lobelia Sackville-Baggins.", "locationMarkerId": "BCSog_CHLzOQZN13Q7Pi3", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "rPOFbCqkPNTgsoIN8_tX6", "char_lobelia_sb"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["inheritance", "warning", "aftermath"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775592451995, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "40b1574a-2fae-4f27-a169-2f21057e93dc", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_10_strider", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Decoy Rooms", "description": "Realizing the inn is no longer safe, Aragorn takes command. They arrange bolsters and pillows in their assigned beds to act as decoys, while the Hobbits and Aragorn lock themselves in the parlor to sleep on the floor.", "locationMarkerId": "8U_bY2J4d10RE9KgchIaN", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider"], "involvedItemIds": [], "tags": ["stealth", "tactics", "preparation"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775594002123, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "418e7e4d-3e8f-4bf2-cd4e-627d50819fa4", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_2_shadow_past", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "A Companion Chosen", "description": "Realizing the Shire is no longer safe, Frodo resolves to leave. Suddenly, Gandalf catches Samwise Gamgee eavesdropping beneath the open window. Instead of a harsh punishment, Gandalf orders the terrified but eager Sam to accompany Frodo on his perilous journey.", "locationMarkerId": "BCSog_CHLzOQZN13Q7Pi3", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "rPOFbCqkPNTgsoIN8_tX6", "char_sam_gamgee"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["quest", "eavesdropping", "companionship"], "sortOrder": 4, "travelDays": 0, "createdAt": 1775592697065, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-gollum"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "4f1a6d9b-2e8c-4b53-a719-5e0c8b3d2f1a", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_17_bridge_of_khazaddum", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Bridge of Khazad-d\u00fbm", "description": "Gandalf orders the others across the bridge and stands alone against the Balrog. He breaks the bridge with his staff, sending the demon into the abyss. However, the Balrog's whip lashes out, catching Gandalf's knees and dragging him down into the dark. 'Fly, you fools!' he cries before falling.", "locationMarkerId": "mGDD4iKxZd3oWrQY2WUuC", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_balrog"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_anduril"], "tags": ["sacrifice", "climax", "tragedy"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775594957009, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "4f26b1c3-c21e-4581-9b13-8a1923c5f7e4", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_13_many_meetings", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Reunion with Bilbo", "description": "After the feast, Frodo finds Bilbo Baggins sitting quietly in a corner. They joyfully catch up on the years apart. When Bilbo asks to see the Ring, a brief, horrifying shadow passes over him, but he quickly recovers, apologizing to Frodo.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "ouYAUjn2Tk2wlv3NQwsSX"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["reunion", "the-ring", "temptation"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775594467753, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "5146c2f3-18d4-482a-a92c-61d0f5e18231", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_9_prancing_pony", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Common Room", "description": "Frodo, Sam, and Pippin go down to the common room for drinks, while Merry goes out for a walk. Pippin begins to tell a story about Bilbo's disappearance, threatening to reveal Frodo's true identity to the listening crowd.", "locationMarkerId": "8U_bY2J4d10RE9KgchIaN", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "lotr-char-bill-ferny", "lotr-char-harry-goatleaf"], "involvedItemIds": [], "tags": ["tavern", "loose-lips"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775593889760, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship", "lotr-thread-aragorn"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "5a1b9e8c-3d2f-486a-b7c4-0e1f9d5a8c7b", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_19_mirror_of_galadriel", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Temptation of Galadriel", "description": "Galadriel reveals Nenya, her Ring of Power. Overwhelmed by the burden of his quest, Frodo offers her the One Ring. Galadriel is deeply tempted, appearing as a terrifyingly beautiful queen, but ultimately refuses, choosing to diminish and remain herself.", "locationMarkerId": "loc_galadriels_glade", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_galadriel"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_nenya"], "tags": ["temptation", "the-ring", "choice"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775595600000, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-lorien"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "5c4d8e1f-7a2b-4096-b3f5-1a8c2d9e6b74", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_15_ring_goes_south", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Snows of Caradhras", "description": "Attempting to cross the Misty Mountains via the Redhorn Pass, the Fellowship is caught in a fierce, unnatural blizzard on the slopes of Caradhras. Gandalf is forced to use magic to light a fire to save them from freezing. Defeated by the mountain, they are forced to turn back.", "locationMarkerId": "ol6guY9oTeYdWtXFrpdx0", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_bill_pony"], "involvedItemIds": [], "tags": ["weather", "defeat", "mountain"], "sortOrder": 3, "travelDays": 3, "createdAt": 1775594684908, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "5c8d7e9b-4a3f-4211-b8cd-1e7a5c9f3b20", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_21_the_great_river", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "A Shadow on the River", "description": "The Fellowship travels down the Anduin. Sam and Frodo spot a log with eyes\u2014Gollum\u2014trailing them at night. Boromir grows increasingly restless and mutters to himself, staring intensely at Frodo.", "locationMarkerId": "lotr-loc-lower-anduin", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_gollum"], "involvedItemIds": [], "tags": ["travel", "stealth", "tension"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775595980804, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-gollum"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "5f1e8b74-a62c-439d-b842-1e9a7c3b05d1", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_8_fog_on_the_barrow_downs", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Rescue and the Barrow-blades", "description": "Tom Bombadil bursts into the barrow, banishing the Wight into the darkness. He awakens the other Hobbits and breaks the barrow's spells. Before they leave, Tom selects ancient, finely wrought daggers from the hoard for each Hobbit.", "locationMarkerId": "2p1MwM9MW_wzli9bWH_Tl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_tom_bombadil", "char_barrow_wight"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_barrow_blades"], "tags": ["rescue", "loot", "tom-bombadil"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775593712151, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "6d9a42f1-c8b5-41a3-97e2-1a48f2d5b6c9", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_15_ring_goes_south", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Company is Chosen", "description": "Elrond officially forms the Fellowship of the Ring: Frodo, Sam, Merry, Pippin, Gandalf, Aragorn, Boromir, Legolas, and Gimli. Narsil is reforged for Aragorn and renamed And\u00faril.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["char_elrond", "yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": ["item_anduril"], "tags": ["fellowship", "planning", "reforging"], "sortOrder": 0, "travelDays": 61, "createdAt": 1775594684908, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-aragorn", "lotr-thread-boromir"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "761a29fa-3f11-42ab-b1ea-073b64cd11b8", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_13_many_meetings", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Reunion with Friends", "description": "Sam, Merry, and Pippin rush into Frodo's room, overjoyed to see him awake and recovering. Sam is particularly relieved, having barely left Frodo's side while he was unconscious.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck"], "involvedItemIds": [], "tags": ["friendship", "relief"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775594467753, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "761c94d2-8a3f-4e0b-9275-c8b1a4f3e6d9", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_11_knife_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Signs on Weathertop", "description": "The company arrives at Amon S\u00fbl (Weathertop). They find a ruined ring of stones, signs of a recent fire, and a stone scratched with the elf-rune 'G', indicating Gandalf had been there days before.", "locationMarkerId": "moEdrJenBd7HxfU3oX4fl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider"], "involvedItemIds": [], "tags": ["discovery", "ruins", "gandalf"], "sortOrder": 2, "travelDays": 5, "createdAt": 1775594116876, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "764b8d23-9f1c-4b52-a3c4-8e9f2d1b7a65", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_22_breaking_of_the_fellowship", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Choice", "description": "At the camp at Parth Galen, Aragorn tells Frodo that the time has come to choose their path: Minas Tirith or Mordor. Frodo asks for an hour alone to decide and walks up the slopes of Amon Hen.", "locationMarkerId": "loc_parth_galen", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": [], "tags": ["decision", "dread"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775596142637, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "76d1a938-1a52-4f9e-a892-d9c9e83f2a74", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_7_in_the_house_of_tom_bombadil", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Departure for the Downs", "description": "After a second restful night, the Hobbits prepare to leave. Tom teaches them a rhyme to summon him if they fall into danger and warns them to keep to the green grass as they head toward the Barrow-downs.", "locationMarkerId": "loc_bombadil_house", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_tom_bombadil", "char_goldberry"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["farewell", "warning", "departure"], "sortOrder": 3, "travelDays": 1, "createdAt": 1775593520435, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 1, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "7a6b5c4d-3e2f-41b9-8c7d-6e5f4a3b2c1d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_12_flight_to_the_ford", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Through the Trollshaws", "description": "The company pushes hard toward Rivendell, placing Frodo on Bill the pony. They travel for many days through the rugged Trollshaws. Along the way, they come across the three stone trolls from Bilbo's adventure long ago, providing a brief moment of levity amidst the growing dread.", "locationMarkerId": "loc_trollshaws", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_bill_pony"], "involvedItemIds": [], "tags": ["travel", "history", "hardship"], "sortOrder": 1, "travelDays": 6, "createdAt": 1775594295086, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "7b8f9e20-31c5-4d82-8b4e-99a3c1f2b651", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_8_fog_on_the_barrow_downs", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Captured by the Wight", "description": "While searching for his friends in the blinding fog, Frodo is suddenly ambushed by a tall, dark figure with icy hands\u2014a Barrow-wight. He is dragged unconscious into a dark barrow.", "locationMarkerId": "2p1MwM9MW_wzli9bWH_Tl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_barrow_wight"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["capture", "danger", "undead"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775593712151, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "7d6b5a4c-2e1f-4980-b3c7-0e9a8f2d1b5c", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_21_the_great_river", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Camp at Parth Galen", "description": "The river journey ends as they reach the calm waters before the Falls of Rauros. They set up camp at the lawn of Parth Galen under the shadow of Amon Hen. The time has come to choose their path: east to Mordor or west to Minas Tirith.", "locationMarkerId": "loc_parth_galen", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": [], "tags": ["camp", "decision", "tension"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775595980804, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "7da0a09e-0be1-4b13-a4f6-8c467a2a5124", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_10_strider", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Merry's Warning", "description": "Merry rushes into the parlor, breathless and shaken. He reports that he saw Black Riders in the dark streets of Bree, and that he was overcome by a sudden, unnatural terror before recovering.", "locationMarkerId": "8U_bY2J4d10RE9KgchIaN", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider"], "involvedItemIds": [], "tags": ["warning", "nazgul", "danger"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775594002123, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "7e9f12b8-3a6d-4f51-b844-0c9e7d2a5f1b", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_17_bridge_of_khazaddum", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Ambush!", "description": "Drums echo from the deep. The chamber is attacked by a horde of Orcs and a massive Cave-troll. A fierce battle ensues. Frodo is speared by a huge Orc-chieftain, throwing him against the wall, but he survives thanks to his hidden mithril coat. They fight their way out the eastern door.", "locationMarkerId": "QX-D2fnu0EA1BpGddM77T", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_cave_troll"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_sting", "item_mithril_shirt", "item_anduril", "item_bow_galadhrim", "item_barrow_blades"], "tags": ["combat", "injury", "escape"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775594957009, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "806a14e9-3d12-4c57-89fb-b2865c341e9d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_9_prancing_pony", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Arrival in Bree", "description": "The tired Hobbits arrive at the gates of Bree in the dark. After a brief encounter with the gatekeeper, they make their way to The Prancing Pony and secure rooms under the name 'Underhill' to hide Frodo's identity.", "locationMarkerId": "8U_bY2J4d10RE9KgchIaN", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_barliman"], "involvedItemIds": [], "tags": ["arrival", "pseudonym"], "sortOrder": 0, "travelDays": 0, "createdAt": 1775593889760, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "81f1b2b4-523c-48c5-9273-02f83d9e4692", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_3_three_is_company", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Counsel at Woodhall", "description": "The Elves bring the Hobbits to their camp above Woodhall. They provide food and drink. Gildor speaks privately with Frodo, identifying the Black Riders as servants of the Enemy and advising Frodo to flee the Shire immediately without waiting for Gandalf.", "locationMarkerId": "loc_woodhall", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_gildor"], "involvedItemIds": [], "tags": ["counsel", "lore", "warning"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775592885453, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "84a3c613-cf58-45e0-82a9-ffc9a440155b", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_4_shortcut_to_mushrooms", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Rider on the Hill", "description": "Looking back, the Hobbits spot a Black Rider silhouetted against the sky on the very hill they had just descended. They hurry deeper into the lowlands to escape his sight.", "locationMarkerId": "mZ2AOteCjotruUEgjApqG", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_black_rider_1"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["danger", "pursuit"], "sortOrder": 1, "travelDays": 0, "createdAt": 1776621571185, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "89053b1b-ebca-4547-abf6-a83d6a2f7c0d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_6_old_forest", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Enter Tom Bombadil", "description": "As Sam desperately tries to free his friends, a strange, merry man in blue and yellow approaches, singing nonsense songs. Tom Bombadil easily commands Old Man Willow to release the Hobbits and invites them to his home for the night.", "locationMarkerId": "loc_old_man_willow", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_old_man_willow", "char_tom_bombadil"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["rescue", "magic", "tom-bombadil"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775593368766, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "8d3b5c1a-2e47-4f81-a9c6-1b7d5e4a2c93", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_22_breaking_of_the_fellowship", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Fellowship Scatters", "description": "Boromir returns to the camp, ashamed, and admits Frodo ran away from him, though he lies about why. Realizing Frodo is in danger, the rest of the company panics and scatters blindly into the woods to find him. Sam, realizing Frodo intends to leave them all behind and take a boat, runs for the river.", "locationMarkerId": "loc_parth_galen", "involvedCharacterIds": ["char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": [], "tags": ["panic", "scattering", "loyalty"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775596142637, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "char_sam_gamgee"}, {"id": "8f3b2d1a-4c5e-4b9a-a8d2-7e1f6c0b9a3d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_19_mirror_of_galadriel", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Rest in Lothl\u00f3rien", "description": "The Fellowship rests in Caras Galadhon for many days. Time seems to pass differently in the Golden Wood. They listen to the Elves sing laments for Gandalf, finding healing for their bodies but deep sorrow in their hearts.", "locationMarkerId": "loc_caras_galadhon", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_galadriel"], "involvedItemIds": [], "tags": ["rest", "mourning", "healing"], "sortOrder": 0, "travelDays": 28, "createdAt": 1775595600000, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 1, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "9b1a5d4c-2e8f-4317-a6c9-f5d8e2b0a7c4", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_15_ring_goes_south", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Through Hollin", "description": "The Fellowship departs Rivendell in secret, traveling south for many days through the empty lands of Eregion (Hollin). The region is eerily quiet, save for flocks of crebain (crows) from Dunland acting as spies for Saruman.", "locationMarkerId": "loc_hollin", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_bill_pony"], "involvedItemIds": [], "tags": ["travel", "stealth", "spies"], "sortOrder": 2, "travelDays": 14, "createdAt": 1775594684908, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "9b2a1c4d-8e7f-4b06-a5d3-6e9f2a1b4c5d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_21_the_great_river", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Ambush at Sarn Gebir", "description": "Nearing the rapids of Sarn Gebir at night, the company is ambushed by Orc-arrows from the eastern shore. A dark shape passes over the stars, striking fear into their hearts. Legolas fires his new bow, striking a Nazg\u00fbl's fell beast and sending it plummeting.", "locationMarkerId": "loc_sarn_gebir", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_black_rider_1"], "involvedItemIds": ["item_bow_galadhrim"], "tags": ["ambush", "archery", "nazgul"], "sortOrder": 1, "travelDays": 7, "createdAt": 1775595980804, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "9d5c41a6-f3e2-45a7-b129-87c2f6d9a4b1", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "X7wR6L80n9R6k495gHov-", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Confrontation at Bag End", "description": "Bilbo returns to Bag End to pack his things. Gandalf is waiting for him and confronts him about his behavior and his strange attachment to the Ring. After a moment of hostility, Bilbo relents, drops the Ring on the floor in an envelope, and departs into the night.", "locationMarkerId": "BCSog_CHLzOQZN13Q7Pi3", "involvedCharacterIds": ["ouYAUjn2Tk2wlv3NQwsSX", "rPOFbCqkPNTgsoIN8_tX6"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_sting", "item_mithril_shirt"], "tags": ["confrontation", "departure", "ring-lore"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775592451995, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "ouYAUjn2Tk2wlv3NQwsSX"}, {"id": "9e8d7c6b-5a4f-43b2-1c0d-e9f8a7b6c5d4", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_12_flight_to_the_ford", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Meeting Glorfindel", "description": "As Frodo's condition rapidly deteriorates and he begins to slip fully into the wraith-world, they are met by Glorfindel, an Elf-lord sent from Rivendell to find them. Glorfindel places Frodo on his white horse, Asfaloth, and urges them to hurry to the Ford of Bruinen.", "locationMarkerId": "3c7uUO6RhgDr4CYTV7G3L", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_glorfindel"], "involvedItemIds": [], "tags": ["rescue", "elves", "urgency"], "sortOrder": 2, "travelDays": 12, "createdAt": 1775594295086, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "a2d5f81c-9b3e-476a-812f-3d6a9e0c4b5d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_17_bridge_of_khazaddum", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Flight to the Bridge", "description": "The company flees down endless stairs toward the East-gate, pursued by Orcs. A terrifying new presence enters the fray, a creature of shadow and flame that shatters Gandalf's holding spell on a door. They race to the narrow Bridge of Khazad-d\u00fbm over a bottomless chasm.", "locationMarkerId": "B-D7c4HRtgrbvEzaX-OPO", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_balrog"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["flight", "terror", "the-balrog"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775594957009, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "b103e689-5b4e-4f51-b847-f027c626bc61", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_6_old_forest", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Trapped by Old Man Willow", "description": "Driven by an unnatural sleepiness, the Hobbits rest near the Withywindle river beside a massive willow tree. Old Man Willow uses a spell to trap Merry and Pippin inside his trunk and nearly drowns Frodo in the river.", "locationMarkerId": "loc_old_man_willow", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_old_man_willow"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["magic", "trap", "despair"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775593368766, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "b1a8d4c9-7f2e-436a-8d5f-1c9e4a0b2d73", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_11_knife_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Driven Away with Fire", "description": "Strider leaps from the darkness with flaming brands, driving the shrieking wraiths away from the camp. Frodo removes the Ring, collapsing back into the physical world, grievously wounded.", "locationMarkerId": "moEdrJenBd7HxfU3oX4fl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_aragorn_strider", "char_witch_king", "char_black_rider_1"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["rescue", "fire", "retreat"], "sortOrder": 4, "travelDays": 0, "createdAt": 1775594116876, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "b3e945dc-cd5a-4952-b1fc-e9c5f2122d1e", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_7_in_the_house_of_tom_bombadil", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Stories of the Old World", "description": "During their stay, Tom tells the Hobbits vast, sprawling stories of the Old Forest's anger, the ancient kings, and the dark barrows. His words transport them, making them feel the immense age of the world.", "locationMarkerId": "loc_bombadil_house", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_tom_bombadil"], "involvedItemIds": [], "tags": ["lore", "history", "storytelling"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775593520435, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "b3f0bbcb-38c6-4b47-b87d-8ebdf4ea61bb", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_4_shortcut_to_mushrooms", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Encounter at Bamfurlong", "description": "The group arrives at Bamfurlong, the farm of Farmer Maggot. Despite Frodo's terror from a childhood incident involving stolen mushrooms and Maggot's dogs, Maggot proves friendly. He reveals a Black Rider recently questioned him, and he invites the weary Hobbits in for supper.", "locationMarkerId": "loc_bamfurlong", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_farmer_maggot"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["sanctuary", "ally"], "sortOrder": 2, "travelDays": 0, "createdAt": 1776621571185, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "b6c7d8e9-f0a1-42b3-c4d5-e6f7a8b9c0d1", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_14_council_of_elrond", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Doom of the Ring", "description": "Boromir urges the Council to use the Ring to defend Gondor, but Elrond and Gandalf reject the idea, explaining it will only corrupt its wielder. They conclude the Ring must be taken to Mount Doom and destroyed. Amidst a heavy silence, Frodo volunteers for the quest. Sam, hiding in the corner, insists on going with him.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["char_boromir", "rPOFbCqkPNTgsoIN8_tX6", "char_elrond", "yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "ouYAUjn2Tk2wlv3NQwsSX", "lotr-char-gloin", "lotr-char-erestor", "lotr-char-galdor-of-the-havens"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["decision", "quest", "sacrifice"], "sortOrder": 6, "travelDays": 0, "createdAt": 1775594574943, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 5, "structureBeat": "midpoint", "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "b8c4d29e-1f7a-4a65-9b33-8e2a1d5c7f0a", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_17_bridge_of_khazaddum", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Chamber of Mazarbul", "description": "The Fellowship enters a lit chamber and discovers the tomb of Balin. Gandalf reads from a battered book chronicling the Dwarves' doomed attempt to retake Moria, ending with the chilling words: 'They are coming.'", "locationMarkerId": "QX-D2fnu0EA1BpGddM77T", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": [], "tags": ["discovery", "lore", "dread"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775594957009, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "b96a9c14-72b1-4b15-9c59-866d9f8e4344", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_3_three_is_company", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "A Chance Meeting", "description": "The Black Rider approaches again as evening falls. Just as Frodo is about to succumb to the Ring's temptation, the clear singing of High Elves echoes through the woods. The Rider flees, and the Hobbits meet Gildor Inglorion and his company.", "locationMarkerId": "loc_woodhall", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_black_rider_1", "char_gildor"], "involvedItemIds": [], "tags": ["rescue", "elves"], "sortOrder": 2, "travelDays": 1, "createdAt": 1775592885453, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c1d2e3f4-a5b6-47c8-9d0e-f1a2b3c4d5e6", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_14_council_of_elrond", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Tale of the Ring", "description": "Elrond recounts the history of the Last Alliance and Isildur taking the Ring. Bilbo tells the story of finding it. Frodo recounts his journey from the Shire. Aragorn reveals his true identity and shows the shards of Narsil, challenging Boromir's doubts.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["char_elrond", "ouYAUjn2Tk2wlv3NQwsSX", "yCsufFPoyoKIj5aOKzvYu", "char_aragorn_strider", "char_boromir", "rPOFbCqkPNTgsoIN8_tX6", "lotr-char-gloin", "lotr-char-erestor", "lotr-char-galdor-of-the-havens"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_narsil"], "tags": ["history", "revelation", "the-ring"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775594574943, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c1d42be8-963d-4c81-b5ea-1b9da7223b2c", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_10_strider", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Strider's Offer", "description": "Strider slips into the Hobbits' parlor after the commotion in the common room. He demands his reward\u2014that they take him along as their guide\u2014and reveals he knows Frodo's true name and the danger pursuing them.", "locationMarkerId": "8U_bY2J4d10RE9KgchIaN", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_aragorn_strider"], "involvedItemIds": [], "tags": ["negotiation", "revelation", "tension"], "sortOrder": 0, "travelDays": 0, "createdAt": 1775594002123, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship", "lotr-thread-aragorn"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c1f7b03e-82d9-43c1-a20e-8f961a5db4b2", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_16_journey_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Journey to the Twenty-first Hall", "description": "Trapped, the Fellowship marches in darkness for days through the ruined, silent halls of Khazad-d\u00fbm, guided only by the faint light of Gandalf's staff. Pippin drops a stone down a well, causing ominous echoes. They eventually arrive at the vast Twenty-first Hall to rest.", "locationMarkerId": "T7NmU46ZIbWCiREzF9ZZA", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["darkness", "exploration", "tension"], "sortOrder": 3, "travelDays": 1, "createdAt": 1775594807844, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c1f7b876-13d8-4f24-9b52-7a892b1a8d1f", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_7_in_the_house_of_tom_bombadil", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Master of the Ring", "description": "Tom asks to see the Ring. When he puts it on, he does not vanish. He then makes the Ring disappear with a flick of his wrist and returns it to Frodo. Suspicious, Frodo puts it on to check, turning invisible to his friends, but Tom can still see him clearly.", "locationMarkerId": "loc_bombadil_house", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_tom_bombadil"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["the-ring", "immunity", "magic"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775593520435, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c1f82d39-e4a7-4b61-9c82-1f5d6a7b3c48", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_22_breaking_of_the_fellowship", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Boromir's Madness", "description": "Boromir secretly follows Frodo. He argues that the Ring should be used to save Gondor, not thrown away. Overcome by the Ring's corrupting influence, he tries to take it by force. Frodo slips the Ring on and vanishes, leaving a suddenly repentant Boromir weeping.", "locationMarkerId": "loc_amon_hen", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_boromir"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["betrayal", "temptation", "the-ring"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775596142637, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 5, "structureBeat": "climax", "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c7a8b3d1-9f2e-405c-a81d-6b5e4f3a2c1d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_18_lothlorien", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Crossing the Nimrodel", "description": "Fleeing the Orcs of Moria, Aragorn leads the weary Fellowship to the borders of Lothl\u00f3rien. They cross the icy river Nimrodel, finding temporary safety under the eaves of the golden wood, though their grief for Gandalf remains heavy.", "locationMarkerId": "EUBQWwx3rhjniXHyw-ci5", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": [], "tags": ["escape", "lothlorien", "grief"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775595503347, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c92a14e6-d73f-4e9b-a01c-62b58d34e97a", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_8_fog_on_the_barrow_downs", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Awakening in the Barrow", "description": "Frodo awakens inside the barrow to find his friends dressed in white rags and covered in pale gold, laid out as if dead. An arm begins crawling toward them with a sword. Summoning his courage, Frodo strikes the arm with a small sword he finds nearby and cries out for Tom Bombadil.", "locationMarkerId": "2p1MwM9MW_wzli9bWH_Tl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_barrow_wight"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["bravery", "magic", "the-ring"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775593712151, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c9b3e1a8-7f2d-45a6-91b4-2d8e0f5c1a7b", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_17_bridge_of_khazaddum", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Escape to Dimrill Dale", "description": "With Gandalf gone, Aragorn takes command, leading the weeping Fellowship out through the East-gate and into the daylight of Dimrill Dale. They fall to the ground, overcome with grief for their fallen leader.", "locationMarkerId": "loc_dimrill_dale", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["escape", "grief", "new-leadership"], "sortOrder": 4, "travelDays": 0, "createdAt": 1775594957009, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "c9e2b1d4-8f5a-4376-90a1-5d6b8c7e2f3a", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_20_farewell_to_lorien", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Gifts of Galadriel", "description": "At the junction of the Silverlode and the Anduin, Galadriel and Celeborn bid farewell to the company in a swan-shaped boat. Galadriel presents deeply personal and powerful gifts to each member, saving her most astonishing gift\u2014three strands of her hair\u2014for Gimli, and the Phial of E\u00e4rendil's light for Frodo.", "locationMarkerId": "lotr-loc-lower-anduin", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_celeborn", "char_galadriel"], "involvedItemIds": ["item_phial_galadriel", "item_galadriel_hair", "item_bow_galadhrim", "item_elessar"], "tags": ["gifts", "farewell", "magic"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775595800000, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "d824ba95-1f9e-4a6c-83b7-7e92c41f8a61", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_11_knife_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Through the Midgewater Marshes", "description": "After purchasing Bill the pony to carry their supplies, Strider leads the group off the East Road and into the miserable, insect-infested Midgewater Marshes to lose their pursuers.", "locationMarkerId": "loc_midgewater_marshes", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_bill_pony"], "involvedItemIds": [], "tags": ["travel", "hardship", "stealth"], "sortOrder": 0, "travelDays": 0, "createdAt": 1775594116876, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "d981c2f6-39a7-4f11-ba32-75d1f8a29b4e", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_9_prancing_pony", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Vanishing Trick", "description": "To distract the crowd from Pippin's story, Frodo jumps on a table to sing a song. He slips and falls, and the Ring somehow slides onto his finger. He vanishes instantly, causing a massive uproar and drawing intense scrutiny from the Ranger, Strider.", "locationMarkerId": "8U_bY2J4d10RE9KgchIaN", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_aragorn_strider", "char_barliman"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["accident", "magic", "exposure"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775593889760, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "d986b45a-c51d-4078-9e12-b2a1df0a996f", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_16_journey_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Doors of Durin", "description": "The company arrives at the stagnant pool before the West-gate of Moria. Gandalf finds the hidden Doors of Durin but struggles to decipher the password. After much frustration, he realizes the riddle is simple and speaks the word 'Mellon' (friend), opening the doors.", "locationMarkerId": "ApILFwz3YNrioxB-vkNnV", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_bill_pony"], "involvedItemIds": [], "tags": ["riddle", "magic", "entrance"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775594807844, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "d98e5b61-9c65-429a-b44c-11235b3e2133", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_3_three_is_company", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Sniffing Rider", "description": "While walking along the road, the Hobbits hear the sound of hooves. They hide in the roots of a large tree just as a mysterious figure on a black horse stops nearby. The figure sniffs the air, searching for the Ring, filling Frodo with a sudden urge to put it on.", "locationMarkerId": "vZ4ueRgxWN5cG1QnNrPgX", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_black_rider_1"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["stealth", "danger", "temptation"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775592885453, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e0000000-0000-4000-8000-000000000001", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_5_conspiracy_unmasked", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Safe Haven in Crickhollow", "description": "The Hobbits arrive safely at the newly prepared house in Crickhollow, greeted by Fredegar 'Fatty' Bolger. They enjoy a hot bath and a hearty supper, temporarily feeling safe behind the High Hay of Buckland.", "locationMarkerId": "ZyfHI9q4ypjSv2pJTM7_c", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_merry_brandybuck", "char_pippin_took", "char_fatty_bolger"], "involvedItemIds": [], "tags": ["sanctuary", "rest"], "sortOrder": 0, "travelDays": 1, "createdAt": 1776621757999, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e0000000-0000-4000-8000-000000000002", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_5_conspiracy_unmasked", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Conspiracy Revealed", "description": "Frodo struggles to find a way to tell his friends he must leave them. To his profound shock, Merry and Pippin reveal they already know about the Ring and his plan to flee. They confess that Sam has been acting as their chief investigator and spy.", "locationMarkerId": "ZyfHI9q4ypjSv2pJTM7_c", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_merry_brandybuck", "char_pippin_took", "char_fatty_bolger"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["revelation", "friendship"], "sortOrder": 1, "travelDays": 0, "createdAt": 1776621757999, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 3, "structureBeat": "lock-in", "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e0000000-0000-4000-8000-000000000003", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_5_conspiracy_unmasked", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Decoy Plan", "description": "Moved by their unyielding loyalty, Frodo accepts Merry and Pippin as his companions. To avoid the roads where the Black Riders are waiting, they decide to set out early the next morning through the dreaded Old Forest. Fatty Bolger agrees to stay behind in Crickhollow to maintain the illusion that Frodo still lives there.", "locationMarkerId": "ZyfHI9q4ypjSv2pJTM7_c", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_merry_brandybuck", "char_pippin_took", "char_fatty_bolger", "char_black_rider_1"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["planning", "decoy"], "sortOrder": 2, "travelDays": 0, "createdAt": 1776621757999, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e2a4b7d1-3c58-4f92-b6d1-8e7c9f3a4b26", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_22_breaking_of_the_fellowship", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Seat of Seeing", "description": "Invisible, Frodo climbs to the top of Amon Hen and sits in the ancient Seat of Seeing. He sees the vast armies of Sauron gathering everywhere. He also feels the Eye of Sauron searching for him. A second, unseen voice (Gandalf's) urges him to take off the Ring, which he does just in time.", "locationMarkerId": "loc_amon_hen", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sauron", "rPOFbCqkPNTgsoIN8_tX6"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["vision", "magic", "sauron"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775596142637, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e39f71c4-5d8a-4b2e-a61f-9c0e48b7d5a2", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_11_knife_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Ambush by the Nazg\u00fbl", "description": "That night, the camp is attacked by five Black Riders. Overcome by the Ring's compulsion, Frodo slips it on, pulling himself into the wraith world. The Witch-king stabs Frodo in the shoulder with a poisoned Morgul-blade.", "locationMarkerId": "moEdrJenBd7HxfU3oX4fl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_witch_king", "char_black_rider_1"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_morgul_blade", "item_barrow_blades"], "tags": ["ambush", "injury", "magic"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775594116876, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e42dfb91-1c39-4458-8613-2d93e87fcb1a", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_13_many_meetings", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Waking in Rivendell", "description": "Frodo wakes up in a comfortable bed in the Last Homely House. Gandalf is sitting beside him, explaining that Elrond has successfully treated his wound, although a splinter of the Morgul-blade nearly reached his heart.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "rPOFbCqkPNTgsoIN8_tX6", "char_elrond"], "involvedItemIds": [], "tags": ["healing", "reunion", "rivendell"], "sortOrder": 0, "travelDays": 4, "createdAt": 1775594467753, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 1, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e5f6a1b2-c3d4-48e9-0f1a-2b3c4d5e6f7a", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_14_council_of_elrond", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Gandalf's Tale and Saruman's Treason", "description": "Gandalf explains how he confirmed the Ring's identity by reading Isildur's scroll in Minas Tirith. He then shocks the Council by revealing the treason of Saruman the White, his imprisonment in Orthanc, and his daring escape with the help of Gwaihir the Eagle.", "locationMarkerId": "qYFPZfULA5M_Kj895l0GI", "involvedCharacterIds": ["rPOFbCqkPNTgsoIN8_tX6", "lotr-char-saruman-the-white"], "involvedItemIds": [], "tags": ["betrayal", "lore", "wizards"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775594574943, "updatedAt": 1775595000000, "isFlashback": true, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-saruman"], "inWorldTime": null, "tension": 4, "structureBeat": null, "status": "final", "povCharacterId": "rPOFbCqkPNTgsoIN8_tX6"}, {"id": "e6a2b851-92c4-4b5a-a3e7-11f9d45a982c", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_8_fog_on_the_barrow_downs", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Lost in the Fog", "description": "After leaving Tom Bombadil's house, the Hobbits make good progress across the hills. However, around midday, a thick, unnerving fog descends upon the Barrow-downs, causing them to lose their way and become separated.", "locationMarkerId": "2p1MwM9MW_wzli9bWH_Tl", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["travel", "lost", "fog"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775593712151, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e7c2a1df-3450-4f51-b8d9-2a91e5e03b71", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_16_journey_in_the_dark", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Watcher in the Water", "description": "As they prepare to enter, Gandalf unloads Bill the Pony and sends him away. Suddenly, many-tentacled arms erupt from the stagnant pool, grabbing Frodo. Sam slashes a tentacle, and the company scrambles inside Moria. The Watcher rips down the trees outside, collapsing the doors and trapping them.", "locationMarkerId": "ApILFwz3YNrioxB-vkNnV", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_watcher", "char_bill_pony"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda", "item_barrow_blades"], "tags": ["monster", "trap", "farewell"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775594807844, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-moria"], "inWorldTime": null, "tension": 5, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e8d6411f-c852-47a3-8be2-32b0f55cf5df", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_7_in_the_house_of_tom_bombadil", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Welcome by Goldberry", "description": "The Hobbits arrive at the house and are greeted by the beautiful Goldberry, the River-daughter. The atmosphere in the house is peaceful and completely dispels their lingering fear of the Old Forest.", "locationMarkerId": "loc_bombadil_house", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_tom_bombadil", "char_goldberry"], "involvedItemIds": [], "tags": ["hospitality", "peace", "magic"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775593520435, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 1, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e8ec1641-52ea-493f-a63e-1087e6be9593", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_4_shortcut_to_mushrooms", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Ride to the Ferry", "description": "To protect them, Farmer Maggot hides the Hobbits in his wagon under a tarp and drives them through the fog to the Bucklebury Ferry. There, they safely reunite with Merry Brandybuck.", "locationMarkerId": "loc_bucklebury_ferry", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_farmer_maggot", "char_merry_brandybuck"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["travel", "reunion"], "sortOrder": 3, "travelDays": 0, "createdAt": 1776621571185, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "e9d8f7c6-b5a4-4321-901b-cdef23456789", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_18_lothlorien", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Intercepted by Haldir", "description": "While resting in the trees (flets), the company is discovered by Haldir and the march-wardens of L\u00f3rien. Haldir welcomes Legolas and Aragorn, but views Gimli with deep suspicion. He agrees to guide them, but insists Gimli must be blindfolded when they enter the inner woods.", "locationMarkerId": "lotr-loc-lothlorien-forest", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_haldir"], "involvedItemIds": [], "tags": ["elves", "suspicion", "dwarves"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775595503347, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "f03b2a75-b91c-403a-a1d2-e56c123ea937", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_13_many_meetings", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Feast of Elrond", "description": "A great feast is held in the Hall of Fire. Frodo sits with Elrond and Glorfindel, and sees the breathtaking Arwen Evenstar for the first time. The hall is filled with songs and tales of the Elves.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_elrond", "char_glorfindel", "char_arwen", "char_aragorn_strider"], "involvedItemIds": [], "tags": ["feast", "elves", "beauty"], "sortOrder": 2, "travelDays": 0, "createdAt": 1775594467753, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-aragorn"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "f1c8a53e-2b74-419d-a60f-93d8b2e5c1a7", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_20_farewell_to_lorien", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Outfitting the Fellowship", "description": "Preparing for their departure, the Elves of L\u00f3rien provide the Fellowship with boats, nutritious Lembas bread, and grey-green Elven cloaks that offer camouflage. Sam is particularly pleased to receive a coil of strong hithlain rope.", "locationMarkerId": "lotr-loc-lothlorien-forest", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_celeborn", "char_galadriel"], "involvedItemIds": ["item_lembas", "item_elven_cloaks", "item_elven_rope"], "tags": ["preparation", "supplies", "elves"], "sortOrder": 0, "travelDays": 2, "createdAt": 1775595800000, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "f1e2d3c4-5b6a-4789-a01c-d2e3f4a5b6c7", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_18_lothlorien", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Blindfolded March", "description": "Gimli angrily refuses to be the only one blindfolded. To keep the peace and show solidarity, Aragorn decrees that the entire Fellowship, including Legolas, will walk blindfolded. They march through the golden woods until news arrives from Galadriel that they may walk freely.", "locationMarkerId": "lotr-loc-lothlorien-forest", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_boromir", "char_legolas", "char_gimli", "char_haldir"], "involvedItemIds": [], "tags": ["solidarity", "conflict", "journey"], "sortOrder": 2, "travelDays": 1, "createdAt": 1775595503347, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir", "lotr-thread-lorien"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "f1e2d3c4-b5a6-4798-8f0e-1d2c3b4a5968", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_12_flight_to_the_ford", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Ambush at the Ford", "description": "Just as they approach the Ford of Bruinen, the Nazg\u00fbl ambush them from both sides. Glorfindel commands his horse to bear Frodo across the river. Frodo crosses, turns to defy the Riders, and is nearly overcome before a magical flood, summoned by Elrond and shaped by Gandalf, sweeps down the river, destroying the Nazg\u00fbl's horses and washing the wraiths away.", "locationMarkerId": "3c7uUO6RhgDr4CYTV7G3L", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_merry_brandybuck", "char_aragorn_strider", "char_glorfindel", "char_witch_king", "char_black_rider_1"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["climax", "magic", "escape"], "sortOrder": 3, "travelDays": 0, "createdAt": 1775594295086, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship"], "inWorldTime": null, "tension": 5, "structureBeat": "first-plot-point", "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "f5b66d74-c3a9-40e8-963a-eb8b2f934441", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_3_three_is_company", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Departure from Bag End", "description": "After selling Bag End, Frodo waits anxiously for Gandalf. When the wizard fails to appear by autumn, Frodo, Sam, and Pippin slip away in the evening, leaving the Shire quietly on foot.", "locationMarkerId": "BCSog_CHLzOQZN13Q7Pi3", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took"], "involvedItemIds": ["fvZm5b3dn4KEyHShSofda"], "tags": ["departure", "journey-begins"], "sortOrder": 0, "travelDays": 164, "createdAt": 1775592885453, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "f8a91b2c-6d3e-4f5a-8b7c-9e0f1a2b3c4d", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_14_council_of_elrond", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Gathering of the Council", "description": "Elrond summons a secret council of the Free Peoples. Gl\u00f3in and Gimli speak of Sauron's overtures to the Dwarves. Legolas brings news that Gollum has escaped Mirkwood. Boromir tells of the desperate war in Gondor and a prophetic dream that led him to Rivendell.", "locationMarkerId": "FHoPN7_EpaKpblz2rIxyC", "involvedCharacterIds": ["char_elrond", "char_gimli", "char_legolas", "char_boromir", "yCsufFPoyoKIj5aOKzvYu", "ouYAUjn2Tk2wlv3NQwsSX", "rPOFbCqkPNTgsoIN8_tX6", "char_aragorn_strider", "lotr-char-gloin", "lotr-char-erestor", "lotr-char-galdor-of-the-havens"], "involvedItemIds": [], "tags": ["politics", "exposition", "news"], "sortOrder": 0, "travelDays": 1, "createdAt": 1775594574943, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-ring", "lotr-thread-fellowship", "lotr-thread-boromir"], "inWorldTime": null, "tension": 2, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "f9a72d3e-6184-47b2-9df8-013ac108ea49", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_10_strider", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "Gandalf's Delayed Letter", "description": "Barliman Butterbur bursts into the parlor, immensely apologetic. He finally remembers to deliver a letter left by Gandalf three months prior. The letter urges Frodo to flee the Shire and confirms that Strider is a friend whose true name is Aragorn.", "locationMarkerId": "8U_bY2J4d10RE9KgchIaN", "involvedCharacterIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_pippin_took", "char_aragorn_strider", "char_barliman"], "involvedItemIds": ["item_gandalf_letter"], "tags": ["message", "gandalf", "trust"], "sortOrder": 1, "travelDays": 0, "createdAt": 1775594002123, "updatedAt": 1775595000000, "isFlashback": false, "mentionedCharacterIds": [], "threadIds": ["lotr-thread-riders", "lotr-thread-fellowship", "lotr-thread-aragorn"], "inWorldTime": null, "tension": 3, "structureBeat": null, "status": "final", "povCharacterId": "yCsufFPoyoKIj5aOKzvYu"}, {"id": "lotr-ev-bree-raid", "worldId": "aX-7torL9Na4l4UvyLWIP", "chapterId": "chap_10_strider", "timelineId": "rfgyP7eqm-EE7abwXQTWi", "title": "The Inn Is Raided", "description": "Black Riders break into the hobbits' decoy rooms while Strider's precautions keep the travelers safe.", "locationMarkerId": "8U_bY2J4d10RE9Kg