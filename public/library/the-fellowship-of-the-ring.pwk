": "Member", "startEventId": null, "endEventId": null, "notes": "", "createdAt": 1775595000000, "updatedAt": 1775595000000}], "factionRelationships": [{"id": "lotr-fr-erebor-mordor", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-erebor", "factionBId": "lotr-faction-mordor", "stance": "hostile", "notes": "Sauron's emissaries threaten the Dwarves for news of the Ring.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-fellowship-lorien", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-fellowship", "factionBId": "lotr-faction-lorien", "stance": "allied", "notes": "L\u00f3rien shelters and equips the surviving Company.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-fellowship-mordor", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-fellowship", "factionBId": "lotr-faction-mordor", "stance": "hostile", "notes": "The quest exists to destroy Sauron's Ring.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-fellowship-nazgul", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-fellowship", "factionBId": "lotr-faction-nazgul", "stance": "hostile", "notes": "The Nine hunt the Ring-bearer.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-fellowship-rivendell", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-fellowship", "factionBId": "lotr-faction-rivendell", "stance": "allied", "notes": "Elrond establishes and equips the Company.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-mordor-isengard", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-mordor", "factionBId": "lotr-faction-isengard", "stance": "allied", "notes": "Saruman seeks cooperation while intending his own advantage.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-mordor-nazgul", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-mordor", "factionBId": "lotr-faction-nazgul", "stance": "allied", "notes": "The Nazg\u00fbl serve Sauron.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-rangers-mordor", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-rangers", "factionBId": "lotr-faction-mordor", "stance": "hostile", "notes": "The D\u00fanedain are ancient enemies of Sauron.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-wise-isengard", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-wise", "factionBId": "lotr-faction-isengard", "stance": "hostile", "notes": "Saruman's betrayal splits the Wise.", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-fr-wise-mordor", "worldId": "aX-7torL9Na4l4UvyLWIP", "factionAId": "lotr-faction-wise", "factionBId": "lotr-faction-mordor", "stance": "hostile", "notes": "The Wise oppose Sauron's return.", "createdAt": 1775595000000, "updatedAt": 1775595000000}], "knowledgeFacts": [{"id": "lotr-kf-aragorn", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Strider is Aragorn, Isildur's heir", "description": "Gandalf's letter and the broken sword confirm the Ranger's identity and lineage.", "tags": ["aragorn", "identity"], "readerLearnsAtEventId": "f9a72d3e-6184-47b2-9df8-013ac108ea49", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-boromir-desire", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Boromir desires the Ring", "description": "His growing fixation culminates in an attempt to take it from Frodo.", "tags": ["boromir", "ring"], "readerLearnsAtEventId": "c1f82d39-e4a7-4b61-9c82-1f5d6a7b3c48", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-company-broken", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "The Fellowship is broken", "description": "The Company scatters after Boromir's assault and Frodo's departure.", "tags": ["fellowship", "ending"], "readerLearnsAtEventId": "8d3b5c1a-2e47-4f81-a9c6-1b7d5e4a2c93", "originEventId": "8d3b5c1a-2e47-4f81-a9c6-1b7d5e4a2c93", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-conspiracy", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Merry and the others know about the Ring", "description": "Frodo's friends have watched his preparations and organized to accompany him.", "tags": ["hobbits", "secret"], "readerLearnsAtEventId": "e0000000-0000-4000-8000-000000000002", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-fellowship", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Nine walkers form the Fellowship", "description": "Elrond appoints nine companions to oppose the Nine Ringwraiths.", "tags": ["fellowship", "quest"], "readerLearnsAtEventId": "6d9a42f1-c8b5-41a3-97e2-1a48f2d5b6c9", "originEventId": "6d9a42f1-c8b5-41a3-97e2-1a48f2d5b6c9", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-frodo-alone", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Frodo decides to leave the Fellowship", "description": "Frodo concludes that the Ring's influence endangers his companions and tries to depart alone.", "tags": ["frodo", "choice"], "readerLearnsAtEventId": "764b8d23-9f1c-4b52-a3c4-8e9f2d1b7a65", "originEventId": "764b8d23-9f1c-4b52-a3c4-8e9f2d1b7a65", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-galadriel-refuses", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Galadriel refuses the One Ring", "description": "She withstands Frodo's offer and accepts that her power will diminish.", "tags": ["galadriel", "temptation"], "readerLearnsAtEventId": "5a1b9e8c-3d2f-486a-b7c4-0e1f9d5a8c7b", "originEventId": "5a1b9e8c-3d2f-486a-b7c4-0e1f9d5a8c7b", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-galadriel-ring", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Galadriel bears Nenya", "description": "Galadriel openly shows Frodo one of the Three Elven Rings.", "tags": ["galadriel", "rings"], "readerLearnsAtEventId": "5a1b9e8c-3d2f-486a-b7c4-0e1f9d5a8c7b", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-gandalf-falls", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Gandalf falls with the Balrog", "description": "Gandalf destroys the bridge but is pulled into the abyss.", "tags": ["gandalf", "moria"], "readerLearnsAtEventId": "4f1a6d9b-2e8c-4b53-a719-5e0c8b3d2f1a", "originEventId": "4f1a6d9b-2e8c-4b53-a719-5e0c8b3d2f1a", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-gollum-follows", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Gollum is following the Fellowship", "description": "A pair of eyes and a drifting shape reveal the hidden pursuer on the Anduin.", "tags": ["gollum", "pursuit"], "readerLearnsAtEventId": "5c8d7e9b-4a3f-4211-b8cd-1e7a5c9f3b20", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-gollum-words", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Gollum revealed Shire and Baggins", "description": "Under torture in Mordor, Gollum surrendered the clues that point toward Bilbo.", "tags": ["gollum", "secret"], "readerLearnsAtEventId": "307d6d3c-2d7e-4ae1-bc3d-516c4f708e93", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-isildur", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Isildur refused to destroy the Ring", "description": "After Sauron's defeat, Isildur claimed the Ring rather than casting it into the fire.", "tags": ["isildur", "history"], "readerLearnsAtEventId": "lotr-ev-last-alliance", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-mithril", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Frodo wears a mithril coat", "description": "Bilbo's hidden gift protects Frodo from a spear in Moria.", "tags": ["mithril", "secret"], "readerLearnsAtEventId": "7e9f12b8-3a6d-4f51-b844-0c9e7d2a5f1b", "originEventId": "2e8f71c4-5a9d-42b6-8c31-9f4d0a5b2e71", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-morgul", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "The Morgul wound is turning Frodo into a wraith", "description": "The blade fragment moves toward Frodo's heart and threatens permanent transformation.", "tags": ["morgul", "danger"], "readerLearnsAtEventId": "1d8ea4f9-2c7b-4196-85f2-9d3b7e6c5a41", "originEventId": "e39f71c4-5d8a-4b2e-a61f-9c0e48b7d5a2", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-riders", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "The Black Riders are Ringwraiths", "description": "The mounted pursuers are the Nine servants enslaved by Sauron's Rings.", "tags": ["nazgul", "identity"], "readerLearnsAtEventId": "307d6d3c-2d7e-4ae1-bc3d-516c4f708e93", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-ring-destroy", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "The Ring must be destroyed in Mount Doom", "description": "No lesser craft can safely unmake the One Ring.", "tags": ["ring", "quest"], "readerLearnsAtEventId": "b6c7d8e9-f0a1-42b3-c4d5-e6f7a8b9c0d1", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-ring-one", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Bilbo's ring is the One Ring", "description": "Gandalf's fire test confirms the ruling Ring made by Sauron.", "tags": ["ring", "identity"], "readerLearnsAtEventId": "2f6c5c2b-1c6d-49d0-ab2c-405b3e6f7d82", "originEventId": null, "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-kf-sam-follows", "worldId": "aX-7torL9Na4l4UvyLWIP", "title": "Sam understands Frodo's plan", "description": "Sam anticipates Frodo's departure and refuses to let him cross the river alone.", "tags": ["sam", "loyalty"], "readerLearnsAtEventId": "1f8e2a3c-5b4d-4c6e-9d7a-b1c5e4f2d8a9", "originEventId": "1f8e2a3c-5b4d-4c6e-9d7a-b1c5e4f2d8a9", "createdAt": 1775595000000, "updatedAt": 1775595000000}, 