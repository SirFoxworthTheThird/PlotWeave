 "coverImageId": null, "linkedEntityIds": ["char_aragorn_strider", "lotr-char-isildur", "lotr-char-elendil"], "visibleFromEventId": "f9a72d3e-6184-47b2-9df8-013ac108ea49", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-dwarves", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-peoples", "title": "The Dwarves of Erebor and Moria", "body": "Gimli and Gl\u00f3in represent Erebor, while the ruins of Moria expose the cost of lost Dwarven kingdoms.", "tags": ["dwarves", "moria"], "coverImageId": null, "linkedEntityIds": ["char_gimli", "lotr-char-gloin"], "visibleFromEventId": "f8a91b2c-6d3e-4f5a-8b7c-9e0f1a2b3c4d", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-elves", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-peoples", "title": "The Eldar in Middle-earth", "body": "Rivendell and Lothl\u00f3rien preserve realms of the High Elves, though their age in Middle-earth is ending.", "tags": ["elves", "eldar"], "coverImageId": null, "linkedEntityIds": ["char_elrond", "char_galadriel", "char_celeborn"], "visibleFromEventId": "f03b2a75-b91c-403a-a1d2-e56c123ea937", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-hobbits", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-peoples", "title": "Hobbits of the Shire", "body": "Hobbits are a small, peaceable people whose courage and resilience are underestimated by the great powers.", "tags": ["hobbits", "shire"], "coverImageId": null, "linkedEntityIds": ["yCsufFPoyoKIj5aOKzvYu", "char_sam_gamgee", "char_merry_brandybuck", "char_pippin_took"], "visibleFromEventId": "18f9a2f1-6785-4b32-8419-db24c5387b32", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-isengard", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-places", "title": "Isengard and Orthanc", "body": "Saruman occupies the tower of Orthanc, where he imprisons Gandalf after revealing his treachery.", "tags": ["isengard", "orthanc"], "coverImageId": null, "linkedEntityIds": ["yw3FBOjhaOmlLS4l-ZVMl", "qYFPZfULA5M_Kj895l0GI", "lotr-char-saruman-the-white"], "visibleFromEventId": "e5f6a1b2-c3d4-48e9-0f1a-2b3c4d5e6f7a", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-isildur", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-history", "title": "Isildur's Bane", "body": "Isildur refused to destroy the Ring, which later betrayed him near the Gladden Fields and vanished for centuries.", "tags": ["isildur", "ring"], "coverImageId": null, "linkedEntityIds": ["lotr-char-isildur", "fvZm5b3dn4KEyHShSofda", "xqKChWZwjEH6EaG3LVDvL"], "visibleFromEventId": "307d6d3c-2d7e-4ae1-bc3d-516c4f708e93", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-istari", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-peoples", "title": "The Istari", "body": "Gandalf, Saruman, and Radagast are Wizards sent to contest Sauron through counsel rather than domination.", "tags": ["wizards", "istari"], "coverImageId": null, "linkedEntityIds": ["rPOFbCqkPNTgsoIN8_tX6", "lotr-char-saruman-the-white", "lotr-char-radagast-the-brown"], "visibleFromEventId": "lotr-ev-radagast", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-khazad-dum", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-history", "title": "The Fall of Khazad-d\u00fbm", "body": "Moria was the greatest Dwarf-realm before Durin's Bane drove its people out; Balin's later colony also perished.", "tags": ["moria", "dwarves"], "coverImageId": null, "linkedEntityIds": ["char_balrog", "QX-D2fnu0EA1BpGddM77T"], "visibleFromEventId": "b8c4d29e-1f7a-4a65-9b33-8e2a1d5c7f0a", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-last-alliance", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-history", "title": "The Last Alliance", "body": "Elendil and Gil-galad overthrew Sauron at the end of the Second Age, dying in the victory before Isildur claimed the Ring.", "tags": ["last-alliance", "sauron"], "coverImageId": null, "linkedEntityIds": ["lotr-char-elendil", "lotr-char-gil-galad", "lotr-char-isildur", "char_sauron"], "visibleFromEventId": "lotr-ev-last-alliance", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-lorien", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-places", "title": "Lothl\u00f3rien", "body": "Galadriel and Celeborn's Golden Wood offers the Company rest, testing, counsel, and gifts.", "tags": ["lothlorien"], "coverImageId": null, "linkedEntityIds": ["loc_lothlorien", "loc_caras_galadhon", "char_galadriel"], "visibleFromEventId": "3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-mithril", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-magic", "title": "Mithril", "body": "Rare silver metal of Moria, lighter and stronger than steel; Bilbo's hidden coat saves Frodo from a spear thrust.", "tags": ["mithril", "moria"], "coverImageId": null, "linkedEntityIds": ["item_mithril_shirt", "yCsufFPoyoKIj5aOKzvYu"], "visibleFromEventId": "7e9f12b8-3a6d-4f51-b844-0c9e7d2a5f1b", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-morgul", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-magic", "title": "Morgul Blades and Wraithing", "body": "A fragment of a Morgul-blade works toward the victim's heart and can transform them into a wraith.", "tags": ["morgul", "nazgul"], "coverImageId": null, "linkedEntityIds": ["item_morgul_blade", "char_witch_king"], "visibleFromEventId": "1d8ea4f9-2c7b-4196-85f2-9d3b7e6c5a41", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-moria", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-places", "title": "Moria", "body": "The Fellowship enters the abandoned Dwarf-realm through the Doors of Durin and escapes by the East-gate after Gandalf's fall.", "tags": ["moria"], "coverImageId": null, "linkedEntityIds": ["-MkH774fIzyfJ28o5hEEJ", "ApILFwz3YNrioxB-vkNnV", "mGDD4iKxZd3oWrQY2WUuC"], "visibleFromEventId": "d986b45a-c51d-4078-9e12-b2a1df0a996f", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-nazgul", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-creatures", "title": "The Nazg\u00fbl", "body": "Nine enslaved Ringwraiths serve Sauron, led by the Witch-king, and hunt the Ring through fear and the unseen world.", "tags": ["nazgul", "sauron"], "coverImageId": null, "linkedEntityIds": ["char_black_rider_1", "char_witch_king"], "visibleFromEventId": "d98e5b61-9c65-429a-b44c-11235b3e2133", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-one-ring", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-magic", "title": "The One Ring", "body": "The ruling Ring grants invisibility by drawing mortals into the unseen world, corrupts desire, and can be destroyed only in Orodruin.", "tags": ["ring", "sauron"], "coverImageId": null, "linkedEntityIds": ["fvZm5b3dn4KEyHShSofda", "char_sauron", "yCsufFPoyoKIj5aOKzvYu"], "visibleFromEventId": "2f6c5c2b-1c6d-49d0-ab2c-405b3e6f7d82", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-rings", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-history", "title": "The Rings of Power", "body": "Sauron made the One Ring to dominate the other Rings of Power. Three Elven Rings remain beyond his direct touch but are bound to the One.", "tags": ["rings", "second-age"], "coverImageId": null, "linkedEntityIds": ["fvZm5b3dn4KEyHShSofda", "item_nenya"], "visibleFromEventId": "307d6d3c-2d7e-4ae1-bc3d-516c4f708e93", "createdAt": 1775595000000, "updatedAt": 1775595000000}, {"id": "lotr-lore-rivendell", "worldId": "aX-7torL9Na4l4UvyLWIP", "categoryId": "lotr-lore-cat-places", "title": "Rivendell", "body": "Elrond's hidden refuge heals Frodo and becomes 