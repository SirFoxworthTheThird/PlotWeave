": "Fredegar Bolger", "portraitImageId": "RnPVKD2rwyVUHmKx4Hinp", "aliases": ["Fatty"], "description": "A Hobbit of Buckland and close friend of Frodo.", "tags": ["Hobbit"], "relationshipIds": ["rel_frodo_fatty"], "isAlive": true, "createdAt": 1741000000000, "updatedAt": 1775101846025, "color": null}, {"id": "char_galadriel", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Galadriel", "aliases": ["Lady of the Wood", "Lady of Light"], "description": "The co-ruler of Lothl\u00f3rien, one of the greatest of the Elves remaining in Middle-earth. Bearer of Nenya, the Ring of Water.", "tags": ["Elf", "Lady", "Ring-bearer"], "isAlive": true, "relationshipIds": ["rel_celeborn_galadriel"], "portraitImageId": "3l_LjtzwVJJ5giIkwsa7-", "updatedAt": 1775160325915, "color": null, "createdAt": 1700000000000}, {"id": "char_gildor", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Gildor Inglorion", "portraitImageId": "5Bn5zVG_qFWW0kq0mnZxi", "aliases": ["Gildor"], "description": "An Elf of the House of Finrod.", "tags": ["Elf"], "relationshipIds": ["rel_frodo_gildor"], "isAlive": true, "createdAt": 1741000000000, "updatedAt": 1775101344607, "color": null}, {"id": "char_gimli", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Gimli", "aliases": ["Elf-friend"], "description": "A Dwarf of Erebor, son of Gl\u00f3in. A staunch warrior who traveled to Rivendell seeking news of Balin and to warn Bilbo of Sauron's spies.", "tags": ["Dwarf", "Warrior"], "isAlive": true, "relationshipIds": ["rel_legolas_gimli"], "portraitImageId": "hFuM2j7UKaXoDupE4HHLq", "updatedAt": 1775156931488, "color": null, "createdAt": 1700000000000}, {"id": "char_glorfindel", "worldId": "aX-7torL9Na4l4UvyLWIP", "name": "Glorfindel", "aliases": ["Elf-lord"], "description": "A powerful Elf-lord of Rivendell sent by Elrond to find and protect the Ring-bearer.", "tags": ["Elf", "Lord"], "isAlive": true, "relationshipIds": ["rel_strider_glorfindel"], "portraitImageId": "r_2Xi_O3oOYWg7v5ayJzs", "updatedAt": 1775155945300, "color": nu