  "lorePages": [
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-1",
      "categoryId": "iliad-lore-category-epic",
      "title": "The Poem’s Scope",
      "body": "The action covers only a short period in the tenth year of the Trojan War. The fall of Troy, the wooden horse, and Achilles’ own death lie outside the poem.",
      "tags": [],
      "coverImageId": "iliad-image-art-troad",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-001"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-2",
      "categoryId": "iliad-lore-category-epic",
      "title": "Wrath as Structure",
      "body": "Achilles’ anger begins as a dispute over honour, expands through Achaean suffering, changes object after Patroclus’ death, and finally loosens before Priam.",
      "tags": [],
      "coverImageId": "iliad-image-art-achilles",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-073"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-3",
      "categoryId": "iliad-lore-category-custom",
      "title": "Timē and Geras",
      "body": "Honour is publicly measured through esteem and material prizes. Agamemnon’s seizure of Briseis therefore declares that Achilles’ contribution can be subordinated without compensation.",
      "tags": [],
      "coverImageId": "iliad-image-art-objects",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-001"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-4",
      "categoryId": "iliad-lore-category-custom",
      "title": "Supplication",
      "body": "A suppliant grasps knees or chin and asks protection from a stronger person. Failed and successful supplications organize the movement from Chryses to Priam.",
      "tags": [],
      "coverImageId": "iliad-image-art-trojan-house",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-073"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-5",
      "categoryId": "iliad-lore-category-gods",
      "title": "Fate and Divine Action",
      "body": "The gods know, delay, accelerate, or shape events, but even Zeus does not simply abolish the deaths allotted to Sarpedon and Hector.",
      "tags": [],
      "coverImageId": "iliad-image-art-olympians",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-066"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-6",
      "categoryId": "iliad-lore-category-gods",
      "title": "The Divine Coalitions",
      "body": "Hera, Athena, and Poseidon favour the Achaeans; Apollo, Aphrodite, and Ares favour Troy. Zeus alternates enforcement and permission while guarding the larger sequence.",
      "tags": [],
      "coverImageId": "iliad-image-art-olympians",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-060"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-7",
      "categoryId": "iliad-lore-category-war",
      "title": "Aristeia",
      "body": "An aristeia is an extended sequence of exceptional battlefield achievement. Diomedes, Agamemnon, Patroclus, and Achilles each receive one with a distinct moral shape.",
      "tags": [],
      "coverImageId": "iliad-image-art-patroclus-battle",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-070"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-8",
      "categoryId": "iliad-lore-category-war",
      "title": "The Right to Burial",
      "body": "Possession of a body extends combat beyond death. Sarpedon is divinely removed, Patroclus is collectively defended, and Hector is abused until gods and mortals restore funeral order.",
      "tags": [],
      "coverImageId": "iliad-image-art-hector-family",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-073"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-9",
      "categoryId": "iliad-lore-category-sources",
      "title": "Textual Basis",
      "body": "Primary source: Homer, The Iliad, translated by Samuel Butler, Project Gutenberg eBook 2199 (https://www.gutenberg.org/ebooks/2199), a complete public-domain English edition divided into Books I–XXIV. The Internet Classics Archive table of contents (https://classics.mit.edu/Homer/iliad.html) was used as a second structural check. Every synopsis, title, description, and status note in this project is original structural writing rather than copied translation prose.",
      "tags": [],
      "coverImageId": "iliad-image-art-objects",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-001"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-10",
      "categoryId": "iliad-lore-category-sources",
      "title": "Editorial Titles and Chronology",
      "body": "The source numbers its divisions as Books I–XXIV; the descriptive book titles used here are editorial signposts, not Homeric headings. Event order follows the poem. PlotWeave dates and times are editorial navigation aids anchored to a notional sequence in the war’s tenth year because the epic supplies relative intervals but no complete modern calendar. Same-day spacing distinguishes successive beats and never claims historical clock precision.",
      "tags": [],
      "coverImageId": "iliad-image-art-troad",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-001"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-11",
      "categoryId": "iliad-lore-category-sources",
      "title": "Timeline and Event Granularity",
      "body": "The poem’s narrated action is represented as one continuous timeline because divine scenes, battlefield action, and activity inside Troy belong to the same advancing chronology rather than independent story clocks. The seventy-five modeled events divide the twenty-four books whenever the active place, directly participating cast, knowledge state, possession, or dramatic outcome materially changes. Speeches and catalogued combat are grouped only when they do not create a separate tracked state.",
      "tags": [],
      "coverImageId": "iliad-image-art-troad",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-001"
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-lore-12",
      "categoryId": "iliad-lore-category-sources",
      "title": "Artwork and Map Provenance",
      "body": "The cover, all character portraits, all item studies, all location scenes, and all three navigable maps are original AI-generated illustrations created for this PlotWeave example. They are interpretive reader reconstructions, not archaeological plans or official editions. No generated image is used as evidence for event chronology. The root Troad map expresses only broad story-relative position; the Troy and Achaean Camp layouts are schematic, and distances, street plans, tent positions, and gateway coordinates are editorial. Asset identities and prompts are recorded in scripts/iliad/asset-manifest.json.",
      "tags": [],
      "coverImageId": "iliad-image-art-troad",
      "linkedEntityIds": [],
      "visibleFromEventId": "iliad-event-001"
    }
  ],
