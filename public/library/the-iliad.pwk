  "characterGoals": [
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-1",
      "characterId": "iliad-char-achilles",
      "startEventId": "iliad-event-001",
      "endEventId": "iliad-event-075",
      "type": "need",
      "text": "Defend his honour without letting rage erase every human bond and limit."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-2",
      "characterId": "iliad-char-agamemnon",
      "startEventId": "iliad-event-001",
      "endEventId": "iliad-event-059",
      "type": "want",
      "text": "Preserve supreme command over a coalition of independent kings."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-3",
      "characterId": "iliad-char-hector",
      "startEventId": "iliad-event-009",
      "endEventId": "iliad-event-069",
      "type": "want",
      "text": "Keep Troy and its households alive by holding the field against the Achaeans."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-4",
      "characterId": "iliad-char-patroclus",
      "startEventId": "iliad-event-033",
      "endEventId": "iliad-event-050",
      "type": "want",
      "text": "Save the ships and the suffering army by acting through Achilles’ borrowed identity."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-5",
      "characterId": "iliad-char-priam",
      "startEventId": "iliad-event-009",
      "endEventId": "iliad-event-075",
      "type": "need",
      "text": "Remain king and father through cumulative loss, then recover Hector for burial."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-6",
      "characterId": "iliad-char-andromache",
      "startEventId": "iliad-event-018",
      "endEventId": "iliad-event-075",
      "type": "want",
      "text": "Keep Hector within the household and preserve a future for Astyanax."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-7",
      "characterId": "iliad-char-thetis",
      "startEventId": "iliad-event-001",
      "endEventId": "iliad-event-075",
      "type": "want",
      "text": "Secure honour and dignity for the short life she cannot lengthen."
    }
  ],
  "plotThreads": [
