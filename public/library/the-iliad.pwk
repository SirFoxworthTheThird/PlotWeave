      "number": 13,
      "title": "The Battle at the Ships",
      "synopsis": "Poseidon rallies the defenders while Zeus is distracted; Hector and Ajax contest the line before the fleet.",
      "notes": "Book 13 of the epic.",
      "wordGoal": null
    },
