      "timelineId": "iliad-timeline-wrath",
      "number": 10,
      "title": "The Night Raid",
      "synopsis": "Diomedes and Odysseus capture Dolon, learn the Trojan dispositions, and raid the newly arrived Thracians.",
      "notes": "Book 10 of the epic.",
      "wordGoal": null
    },
