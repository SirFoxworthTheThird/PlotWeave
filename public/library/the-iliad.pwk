      "id": "iliad-relationship-1",
      "characterAId": "iliad-char-achilles",
      "characterBId": "iliad-char-agamemnon",
      "label": "rival claimants to honour",
      "strength": 5,
      "sentiment": "negative",
      "description": "Their quarrel separates supreme command from supreme fighting ability and structures the entire poem.",
      "isBidirectional": true,
      "startEventId": "iliad-event-002"
    },
    {
      "worldId": "iliad-world",
