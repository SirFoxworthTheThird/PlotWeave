  "lorePages": [
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-lore-edition",
      "categoryId": "call-wild-lore-category-sources",
      "title": "Source Edition",
      "body": "Chapter order, headings, cast, and action were checked against Project Gutenberg ebook 215, The Call of the Wild by Jack London. All summaries and state notes here are original structural writing.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "call-wild-event-estate"
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-lore-calendar",
      "categoryId": "call-wild-lore-category-chronology",
      "title": "Calendar and Elapsed-Time Method",
      "body": "The novel names seasons, travel durations, distances, and intervals but supplies no complete dated calendar. Reading mode therefore uses an editorial day count beginning at Day 1; decimals order same-day events. Values identify estimates, not author-supported dates.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "call-wild-event-estate"
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-lore-geography",
      "categoryId": "call-wild-lore-category-trail",
      "title": "Geography and Map Method",
      "body": "California, Seattle, Dyea, Lake Bennett, Thirty Mile River, Dawson, and Skaguay are supported place names. Exact marker positions and the East Fork route are editorial approximations designed to show relative travel, not a surveyed itinerary.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "call-wild-event-snow"
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-lore-titles",
      "categoryId": "call-wild-lore-category-book",
      "title": "Chapter Titles",
      "body": "All seven chapter titles are London’s headings; no editorial chapter names replace them. Event titles are concise editorial signposts.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "call-wild-event-estate"
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-lore-art",
      "categoryId": "call-wild-lore-category-sources",
      "title": "Artwork and Map Provenance",
      "body": "The navigable maps, world cover, portraits, object studies, and place illustrations are original AI-generated raster artwork created for this PlotWeave example. They use a mature, period-inspired adventure-book style rather than photographs. Every entity has its own subject-specific composition, and maps remain visually and functionally distinct from entity artwork.",
      "tags": [],
      "coverImageId": "call-wild-image-world",
      "linkedEntityIds": [],
      "visibleFromEventId": "call-wild-event-estate"
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-lore-yeehat",
      "categoryId": "call-wild-lore-category-book",
      "title": "The Yeehat Episode",
      "body": "The final chapter uses a fictionalized Indigenous group through a 1903 outsider perspective. This example retains the plot role, avoids invented ethnography, and names only the unnamed war leader needed for event presence.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "call-wild-event-raid"
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-lore-omissions",
      "categoryId": "call-wild-lore-category-book",
      "title": "Intentional Feature Decisions",
      "body": "One timeline is sufficient because Buck’s story is linear. No map regions, floor groups, cross-timeline artifacts, annotations, manuscript text, or writing logs are added: none clarifies this narrative. Relationship snapshots record initial states; later changes are expressed only where the relationship itself materially begins or ends.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "call-wild-event-estate"
    }
  ],
  "factions": [
    {
