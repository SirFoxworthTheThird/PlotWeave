  "timelines": [
    {
      "id": "call-wild-timeline",
      "worldId": "call-wild-world",
      "name": "Buck’s Northland Chronology",
      "description": "A single linear timeline follows Buck; elapsed days are editorial estimates documented in Lore.",
      "color": "#6a7d72",
      "dayOffset": 0,
      "createdAt": 1788393600000
    }
  ],
  "chapters": [
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-chapter-01",
      "timelineId": "call-wild-timeline",
      "number": 1,
      "title": "Into the Primitive",
      "synopsis": "Buck is stolen from his California home, transported north, and initiated into the violence and cold of the dog trade.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-chapter-02",
      "timelineId": "call-wild-timeline",
      "number": 2,
      "title": "The Law of Club and Fang",
      "synopsis": "Buck learns camp survival, harness work, and the social law enforced by human clubs and canine teeth.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-chapter-03",
      "timelineId": "call-wild-timeline",
      "number": 3,
      "title": "The Dominant Primordial Beast",
      "synopsis": "Buck challenges Spitz through daily resistance and finally wins leadership in a decisive fight.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-chapter-04",
      "timelineId": "call-wild-timeline",
      "number": 4,
      "title": "Who Has Won to Mastership",
      "synopsis": "Buck forces recognition as lead dog and drives Perrault and François’s team to record speed.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-chapter-05",
      "timelineId": "call-wild-timeline",
      "number": 5,
      "title": "The Toil of Trace and Trail",
      "synopsis": "Mail service exhausts the team; Dave’s fatal decline and sale to unprepared owners expose the cost of relentless work.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-chapter-06",
      "timelineId": "call-wild-timeline",
      "number": 6,
      "title": "For the Love of a Man",
      "synopsis": "Thornton rescues Buck, earns his devotion, and sees that devotion tested in rescue, combat, and a famous wager.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
      "updatedAt": 1788393600000,
      "id": "call-wild-chapter-07",
      "timelineId": "call-wild-timeline",
      "number": 7,
      "title": "The Sounding of the Call",
