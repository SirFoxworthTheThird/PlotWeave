  "world": {
    "id": "alice-wonderland-world",
    "name": "Alice’s Adventures in Wonderland",
    "description": "Lewis Carroll’s dream fantasy follows Alice from a quiet riverbank into a world where bodies change scale, animals hold offices, language makes its own rules, tea never advances, and a royal court mistakes threat for reason. Alice’s curiosity gradually becomes the confidence to question the entire performance.",
