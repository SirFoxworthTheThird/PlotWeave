      "id": "alice-wonderland-chapter-01",
      "timelineId": "alice-wonderland-timeline-dream",
      "number": 1,
      "title": "Down the Rabbit-Hole",
      "summary": "Curiosity carries Alice from the riverbank through a slow fall and a hall where size prevents entry to a beautiful garden.",
      "status": "final",
      "tags": [],
      "povCharacterIds": [
        "alice-wonderland-character-alice"
      ]
    },
    {
      "worldId": "alice-wonderland-world",
