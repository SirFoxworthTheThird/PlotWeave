  "lorePages": [
    {
      "worldId": "alice-wonderland-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "alice-wonderland-lore-dream",
      "categoryId": "alice-wonderland-lore-category-wonderland",
      "title": "Dream Geography",
      "body": "Wonderland’s locations follow narrative association rather than stable distance. Doors return to earlier spaces, size changes rewrite scale, and the Queen’s grounds gather garden, shore, and court into one dream route.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "alice-wonderland-event-fall"
    },
    {
      "worldId": "alice-wonderland-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "alice-wonderland-lore-size",
      "categoryId": "alice-wonderland-lore-category-wonderland",
      "title": "The Rules of Size",
      "body": "Food and objects change Alice’s height consistently enough to become tools, but the social meaning of size changes with each encounter.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "alice-wonderland-event-drink"
    },
    {
      "worldId": "alice-wonderland-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "alice-wonderland-lore-manners",
      "categoryId": "alice-wonderland-lore-category-society",
      "title": "Lessons, Manners, and Rudeness",
      "body": "Alice carries recitations and formal politeness into a world where adults and officials use etiquette selectively.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "alice-wonderland-event-mouse-swim"
    },
    {
      "worldId": "alice-wonderland-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "alice-wonderland-lore-sentences",
      "categoryId": "alice-wonderland-lore-category-society",
      "title": "The Queen’s Sentences",
      "body": "The Queen announces executions constantly; the Gryphon claims that nobody is actually put to death, separating terror from enforcement.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "alice-wonderland-event-gryphon-guide"
    },
    {
      "worldId": "alice-wonderland-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "alice-wonderland-lore-verse",
      "categoryId": "alice-wonderland-lore-category-language",
      "title": "Altered Nursery Verse",
      "body": "Familiar poems, songs, and a nursery-rhyme trial return with words displaced by Wonderland’s identities and arguments.",
      "tags": [],
      "coverImageId": null,
      "linkedEntityIds": [],
      "visibleFromEventId": "alice-wonderland-event-father-william"
    },
    {
      "worldId": "alice-wonderland-world",
      "createdAt": 1787529600000,
      "updatedAt": 1787529600000,
      "id": "alice-wonderland-lore-sources",
      "categoryId": "alice-wonderland-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The manuscript follows the complete public-domain text of Lewis Carroll’s novel in Project Gutenberg eBook 11. Every narrative passage from Chapters I–XII is assigned once in source order; Gutenberg contents, decorative separators, terminal label, and packaging are excluded. Character art uses John Tenniel’s 1865 engravings and a Peter Newell illustration; the fantasy maps and item plates are original PlotWeave assets. Event divisions and dream chronology are editorial.",
      "tags": [],
      "coverImageId": "alice-wonderland-image-tenniel-01",
      "linkedEntityIds": [],
      "visibleFromEventId": "alice-wonderland-event-bank-rabbit"
    }
  ],
