      "id": "alice-wonderland-chapter-02",
      "timelineId": "alice-wonderland-timeline-dream",
      "number": 2,
      "title": "The Pool of Tears",
      "summary": "A fan, a flood of tears, and an offended Mouse turn Alice’s private confusion into a crowded swim.",
      "status": "final",
      "tags": [],
      "povCharacterIds": [
        "alice-wonderland-character-alice"
      ]
    },
    {
      "worldId": "alice-wonderland-world",
