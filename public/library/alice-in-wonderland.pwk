      "timelineId": "alice-wonderland-timeline-dream",
      "number": 4,
      "title": "The Rabbit Sends in a Little Bill",
      "summary": "Mistaken for a servant, Alice grows inside the Rabbit’s house, escapes as a tiny figure, and faces an enormous puppy.",
      "status": "final",
      "tags": [],
      "povCharacterIds": [
        "alice-wonderland-character-alice"
      ]
    },
    {
