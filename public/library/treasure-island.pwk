  "characterGoals": [
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-1",
      "characterId": "treasure-island-char-jim",
      "startEventId": "treasure-island-event-001",
      "endEventId": "treasure-island-event-071",
      "type": "want",
      "text": "Protect his family, understand the pirates’ secret, and return from the expedition on his own terms."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-2",
      "characterId": "treasure-island-char-jim",
      "startEventId": "treasure-island-event-023",
      "endEventId": "treasure-island-event-068",
      "type": "fear",
      "text": "Prevent Silver’s crew from killing the loyal party and taking the Hispaniola."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-3",
      "characterId": "treasure-island-char-silver",
      "startEventId": "treasure-island-event-016",
      "endEventId": "treasure-island-event-071",
      "type": "want",
      "text": "Secure wealth and freedom while remaining indispensable to whichever side controls his survival."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-4",
      "characterId": "treasure-island-char-silver",
      "startEventId": "treasure-island-event-056",
      "endEventId": "treasure-island-event-068",
      "type": "fear",
      "text": "Avoid deposition by his own men and execution by the lawful party."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-5",
      "characterId": "treasure-island-char-livesey",
      "startEventId": "treasure-island-event-013",
      "endEventId": "treasure-island-event-071",
      "type": "want",
      "text": "Bring the expedition through piracy, illness, and injury without abandoning medical or legal duty."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-6",
      "characterId": "treasure-island-char-trelawney",
      "startEventId": "treasure-island-event-013",
      "endEventId": "treasure-island-event-070",
      "type": "want",
      "text": "Finance and complete the recovery of Flint’s treasure."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-7",
      "characterId": "treasure-island-char-smollett",
      "startEventId": "treasure-island-event-018",
      "endEventId": "treasure-island-event-071",
      "type": "want",
      "text": "Preserve lawful command of the ship and protect the people entrusted to him."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-8",
      "characterId": "treasure-island-char-gunn",
      "startEventId": "treasure-island-event-031",
      "endEventId": "treasure-island-event-071",
      "type": "want",
      "text": "Trade his island secret for rescue, food, respectability, and a fair reward."
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-goal-9",
      "characterId": "treasure-island-char-merry",
      "startEventId": "treasure-island-event-056",
      "endEventId": "treasure-island-event-068",
      "type": "want",
      "text": "Replace Silver and take direct control of the treasure hunt."
    },
    {
