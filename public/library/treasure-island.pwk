  "lorePages": [
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-1",
      "categoryId": "treasure-island-lore-category-sources",
      "title": "Linked Artwork and Maps",
      "body": "The cover and principal illustrations are public-domain works by N. C. Wyeth and Walter Paget from historical editions of Treasure Island. The island chart reproduces Stevenson’s 1883 map; Bristol uses a public-domain harbour map, and the Hispaniola layer uses a historical schooner plan as an editorial spatial aid.",
      "tags": [],
      "coverImageId": "treasure-island-image-cover",
      "linkedEntityIds": [
        "treasure-island-world"
      ],
      "visibleFromEventId": "treasure-island-event-001"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-2",
      "categoryId": "treasure-island-lore-category-sources",
      "title": "Editorial Chronology",
      "body": "The novel does not identify a definitive calendar year for Jim’s adventure. The 1760 dates and intervals used here are an editorial reconstruction based on the order and approximate durations stated in the narrative; they are not presented as canonical dates.",
      "tags": [],
      "coverImageId": "treasure-island-image-map-atlantic",
      "linkedEntityIds": [
        "treasure-island-world"
      ],
      "visibleFromEventId": "treasure-island-event-001"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-3",
      "categoryId": "treasure-island-lore-category-piracy",
      "title": "The Black Spot",
      "body": "Flint’s former crew uses a circular paper token as a formal notice of judgment or removal. Its power depends entirely on shared pirate custom and the recipient’s fear of collective action.",
      "tags": [],
      "coverImageId": "treasure-island-image-black-spot",
      "linkedEntityIds": [
        "treasure-island-item-black-spot"
      ],
      "visibleFromEventId": "treasure-island-event-006"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-4",
      "categoryId": "treasure-island-lore-category-piracy",
      "title": "Shares and Pirate Articles",
      "body": "Silver’s followers think in negotiated shares, elected leadership, and collective accusation, even while violence repeatedly overrides their procedures.",
      "tags": [],
      "coverImageId": "treasure-island-image-mutiny",
      "linkedEntityIds": [
        "treasure-island-faction-mutineers"
      ],
      "visibleFromEventId": "treasure-island-event-023"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-5",
      "categoryId": "treasure-island-lore-category-seamanship",
      "title": "The Hispaniola",
      "body": "A schooner requires coordinated watches, sail handling, steering, anchoring, and knowledge of tide. Once discipline collapses, even possession of the ship does not guarantee control.",
      "tags": [],
      "coverImageId": "treasure-island-image-chapter-10",
      "linkedEntityIds": [
        "treasure-island-map-hispaniola"
      ],
      "visibleFromEventId": "treasure-island-event-020"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-6",
      "categoryId": "treasure-island-lore-category-seamanship",
      "title": "The Coracle",
      "body": "Gunn’s small hide-covered boat is light and concealable but turns readily and offers almost no protection from current or surf.",
      "tags": [],
      "coverImageId": "treasure-island-image-gunn",
      "linkedEntityIds": [
        "treasure-island-item-coracle"
      ],
      "visibleFromEventId": "treasure-island-event-046"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-7",
      "categoryId": "treasure-island-lore-category-places",
      "title": "The Island’s Unhealthy Ground",
      "body": "The low eastern anchorage combines heat, stagnant water, and marsh. The higher cave and spring-fed stockade offer safer positions.",
      "tags": [],
      "coverImageId": "treasure-island-image-map-island",
      "linkedEntityIds": [
        "treasure-island-map-island"
      ],
      "visibleFromEventId": "treasure-island-event-024"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-8",
      "categoryId": "treasure-island-lore-category-places",
      "title": "Bristol and Atlantic Trade",
      "body": "The expedition departs from a port capable of supplying a ship, arms, food, and a large pool of experienced sailors, honest and otherwise.",
      "tags": [],
      "coverImageId": "treasure-island-image-departure",
      "linkedEntityIds": [
        "treasure-island-map-bristol"
      ],
      "visibleFromEventId": "treasure-island-event-015"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-9",
      "categoryId": "treasure-island-lore-category-history",
      "title": "Captain Flint’s Last Voyage",
      "body": "Before the novel begins, Flint buries a vast cache on the island, kills the men who helped him, and leaves a map and remembered trail of terror.",
      "tags": [],
      "coverImageId": "treasure-island-image-treasure",
      "linkedEntityIds": [
        "treasure-island-char-flint",
        "treasure-island-item-treasure"
      ],
      "visibleFromEventId": "treasure-island-event-012"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-10",
      "categoryId": "treasure-island-lore-category-history",
      "title": "Ben Gunn’s Marooning",
      "body": "Gunn returns to the island with another crew, fails to find the treasure, and is abandoned with minimal supplies. Three solitary years reshape him into both comic survivor and strategic power.",
      "tags": [],
      "coverImageId": "treasure-island-image-gunn",
      "linkedEntityIds": [
        "treasure-island-char-gunn"
      ],
      "visibleFromEventId": "treasure-island-event-031"
    },
    {
      "worldId": "treasure-island-world",
      "createdAt": 1786057200000,
      "updatedAt": 1786057200000,
      "id": "treasure-island-lore-page-11",
      "categoryId": "treasure-island-lore-category-piracy",
      "title": "Songs, Parrots, and Memory",
      "body": "Fragments of pirate language outlive their original setting. Silver’s parrot and Gunn’s imitation of Flint turn repeated words into instruments of identity and fear.",
      "tags": [],
      "coverImageId": "treasure-island-image-parrot",
      "linkedEntityIds": [
        "treasure-island-char-parrot"
      ],
      "visibleFromEventId": "treasure-island-event-022"
    }
  ],
