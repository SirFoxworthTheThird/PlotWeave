      "id": "war-of-the-worlds-lore-2",
      "categoryId": "war-of-the-worlds-lore-category-martian",
      "title": "Martian Biology",
      "body": "The invaders are highly developed brains with tentacular limbs, dependent upon machines and direct feeding.",
      "tags": [],
      "coverImageId": "war-of-the-worlds-image-correa17",
