  "characterGoals": [
    {
      "worldId": "war-of-the-worlds-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "war-of-the-worlds-goal-1",
      "characterId": "war-of-the-worlds-char-narrator",
      "startEventId": "war-of-the-worlds-event-1-1",
      "endEventId": "war-of-the-worlds-event-27-2",
      "type": "need",
      "text": "Survive the invasion, find his wife, and make coherent testimony from catastrophe."
    },
    {
      "worldId": "war-of-the-worlds-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "war-of-the-worlds-goal-2",
      "characterId": "war-of-the-worlds-char-brother",
      "startEventId": "war-of-the-worlds-event-14-1",
      "endEventId": "war-of-the-worlds-event-18-2",
      "type": "want",
      "text": "Escape London and help the Elphinstone women reach the coast."
    },
    {
      "worldId": "war-of-the-worlds-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "war-of-the-worlds-goal-3",
      "characterId": "war-of-the-worlds-char-martians",
      "startEventId": "war-of-the-worlds-event-4-1",
      "endEventId": "war-of-the-worlds-event-25-2",
      "type": "want",
      "text": "Destroy resistance, secure human captives, and occupy Earth."
    },
    {
      "worldId": "war-of-the-worlds-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "war-of-the-worlds-goal-4",
      "characterId": "war-of-the-worlds-char-artilleryman",
      "startEventId": "war-of-the-worlds-event-11-1",
      "endEventId": "war-of-the-worlds-event-24-2",
      "type": "want",
      "text": "Survive military collapse and imagine an organised human resistance."
    },
    {
      "worldId": "war-of-the-worlds-world",
      "createdAt": 1786122000000,
