  "timelines": [
    {
      "id": "lost-world-timeline-main",
      "worldId": "lost-world-world",
      "name": "The Expedition, 1911–1912",
      "description": "A single chronology from Malone’s London commission through the expedition and its return.",
      "color": "#667665",
      "dayOffset": 0,
      "createdAt": 1786838400000
    }
  ],
  "chapters": [
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-01",
      "timelineId": "lost-world-timeline-main",
      "number": 1,
      "title": "There Are Heroisms All Round Us",
      "summary": "Malone asks Gladys to marry him and learns that the adventurous hero she imagines is not the ordinary man before her.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-02",
      "timelineId": "lost-world-timeline-main",
      "number": 2,
      "title": "Try Your Luck with Professor Challenger",
      "summary": "McArdle assigns Malone to interview the most dangerous scientific celebrity in London.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-03",
      "timelineId": "lost-world-timeline-main",
      "number": 3,
      "title": "He Is a Perfectly Impossible Person",
      "summary": "Malone wins entry to Challenger’s house through a false scientific pretext and is violently exposed.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-04",
      "timelineId": "lost-world-timeline-main",
      "number": 4,
      "title": "It’s Just the Very Biggest Thing in the World",
      "summary": "Challenger privately shows Malone the evidence behind his claim and challenges him to witness the public debate.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-05",
      "timelineId": "lost-world-timeline-main",
      "number": 5,
      "title": "Question!",
      "summary": "The Zoological Institute meeting erupts into disorder before an expedition committee is formed.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-06",
      "timelineId": "lost-world-timeline-main",
      "number": 6,
      "title": "I Was the Flail of the Lord",
      "summary": "Malone meets Roxton and learns why the explorer is feared and respected in South America.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-07",
      "timelineId": "lost-world-timeline-main",
      "number": 7,
      "title": "To-morrow We Disappear Into the Unknown",
      "summary": "The expedition reaches Manaos, opens its orders, and discovers that Challenger has come to lead it himself.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-08",
      "timelineId": "lost-world-timeline-main",
      "number": 8,
      "title": "The Outlying Pickets of the New World",
      "summary": "Canoes and portages carry the party beyond mapped waterways toward the hidden cliffs.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-09",
      "timelineId": "lost-world-timeline-main",
      "number": 9,
      "title": "Who Could Have Foreseen It?",
      "summary": "The explorers reach the plateau summit, but betrayal destroys their route back to the world below.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-chapter-10",
