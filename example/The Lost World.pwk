  "lorePages": [
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-lore-lost-worlds",
      "categoryId": "lost-world-lore-category-science",
      "title": "The Lost-World Idea",
      "body": "The plateau turns a blank space on the map into an evolutionary refuge, letting extinct and modern life occupy the same isolated landscape.",
      "tags": [],
      "coverImageId": "lost-world-image-strand-32",
      "linkedEntityIds": [],
      "visibleFromEventId": "lost-world-event-private-evidence"
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-lore-field-evidence",
      "categoryId": "lost-world-lore-category-science",
      "title": "What Counts as Proof",
      "body": "The story moves through a hierarchy of evidence: testimony, sketch, photograph, bone, shared observation, collected specimen, and finally a living animal.",
      "tags": [],
      "coverImageId": "lost-world-image-strand-42",
      "linkedEntityIds": [],
      "visibleFromEventId": "lost-world-event-private-evidence"
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-lore-amazon-frontier",
      "categoryId": "lost-world-lore-category-context",
      "title": "The Amazonian Frontier",
      "body": "The expedition crosses a fictionalized frontier shaped by river travel, extractive trade, Indigenous knowledge, and the violence of slavery and colonial intrusion.",
      "tags": [],
      "coverImageId": "lost-world-image-strand-19",
      "linkedEntityIds": [],
      "visibleFromEventId": "lost-world-event-roxton-rooms"
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-lore-plateau-society",
      "categoryId": "lost-world-lore-category-setting",
      "title": "Life on the Plateau",
      "body": "Maple White Land supports multiple ecosystems and two intelligent populations whose conflict shapes the explorers’ survival.",
      "tags": [],
      "coverImageId": "lost-world-image-strand-38",
      "linkedEntityIds": [],
      "visibleFromEventId": "lost-world-event-ape-capture"
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-lore-journalism",
      "categoryId": "lost-world-lore-category-context",
      "title": "Malone’s Dispatches",
      "body": "The narrative is framed as Malone’s reporting: observations intended for a newspaper gradually become a complete first-person record when communication is cut.",
      "tags": [],
      "coverImageId": "lost-world-image-strand-11",
      "linkedEntityIds": [],
      "visibleFromEventId": "lost-world-event-commission"
    },
    {
      "worldId": "lost-world-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "lost-world-lore-sources",
      "categoryId": "lost-world-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The chapter structure follows the 1912 novel. The two expedition charts and the linked monochrome scenes come from the original Strand-era illustrated edition; the broader maps provide historical geographic context.",
      "tags": [],
      "coverImageId": "lost-world-image-strand-1",
      "linkedEntityIds": [],
      "visibleFromEventId": "lost-world-event-proposal"
    }
  ],
