  "chapters": [
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-01",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 1,
      "title": "Paris: September, 1792",
      "synopsis": "Bibot recoils from an apparent outbreak of disease and allows an old woman’s cart to leave Paris; the passengers are the de Tournays and the driver is the disguised Pimpernel.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-02",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 2,
      "title": "Dover: “The Fisherman’s Rest”",
      "synopsis": "Sally and Mr Jellyband manage the busy Dover inn while talk of France, refugees, and English safety fills the coffee-room.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-03",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 3,
      "title": "The Refugees",
      "synopsis": "Lord Tony and Sir Andrew escort the rescued Comtesse, Suzanne, and the Vicomte into the Fisherman’s Rest after their Channel crossing.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-04",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 4,
      "title": "The League of the Scarlet Pimpernel",
      "synopsis": "Tony and Andrew explain that twenty Englishmen serve a leader whose identity is protected by oath, and whose emblem is the scarlet flower. Chauvelin’s agents overpower the League men and seize plans for the next rescue, giving the French agent a route to the fugitives but not the leader’s name.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-05",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 5,
      "title": "Marguerite",
      "synopsis": "Marguerite and Percy arrive at the inn, where the Comtesse’s hostility recalls Marguerite’s role in the fall of the St. Cyr family.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-06",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 6,
      "title": "An Exquisite of ’92",
      "synopsis": "Percy’s clothes, drawl, and apparently empty wit convince the company that he is incapable of serious political action.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-07",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 7,
      "title": "The Secret Orchard",
      "synopsis": "In the orchard, Marguerite and Armand reaffirm their devotion before he returns to France to assist the rescue of the Comte.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-08",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 8,
      "title": "The Accredited Agent",
      "synopsis": "Chauvelin invokes their revolutionary past and asks Marguerite to discover the identity of the Scarlet Pimpernel.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-09",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 9,
      "title": "The Outrage",
      "synopsis": "Chauvelin reveals the intercepted letter linking Armand to the League and makes the brother’s safety conditional on Marguerite’s cooperation.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-10",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 10,
      "title": "In the Opera Box",
      "synopsis": "At the opera, Chauvelin tightens his bargain: Marguerite must watch the League at Lord Grenville’s ball if Armand is to be spared.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-11",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 11,
      "title": "Lord Grenville’s Ball",
      "synopsis": "Diplomats, the Prince, the Blakeneys, and League members converge while Chauvelin watches for the unknown leader.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-12",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 12,
      "title": "The Scrap of Paper",
      "synopsis": "A discarded message marked with the flower gives Marguerite the time and place of the League leader’s meeting.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-13",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 13,
      "title": "Either—Or?",
      "synopsis": "Unable to find another way to save Armand, Marguerite gives Chauvelin the meeting information and accepts the cost without knowing whom she has betrayed.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-14",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 14,
      "title": "One O’Clock Precisely!",
      "synopsis": "Marguerite warns Sir Andrew that Chauvelin knows about the meeting, but the message cannot reach the leader in time. At one o’clock Chauvelin watches for the Pimpernel, while Percy appears to sleep through the danger in the supper room.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-15",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 15,
      "title": "Doubt",
      "synopsis": "The meeting yields no obvious leader, leaving Chauvelin suspicious and Marguerite uncertain whether her warning succeeded.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-16",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 16,
      "title": "Richmond",
      "synopsis": "Marguerite appeals to Percy for help with Armand and exposes the pain beneath their polished marriage; Percy listens without revealing his secret.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-17",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 17,
      "title": "Farewell",
      "synopsis": "Percy departs on the compromised rescue mission after a restrained farewell that Marguerite does not yet understand.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-18",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 18,
      "title": "The Mysterious Device",
      "synopsis": "Back in London, the flower emblem and Percy’s unexplained conduct force Marguerite to reconsider everything she believes about him.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-19",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 19,
      "title": "The Scarlet Pimpernel",
      "synopsis": "Suzanne’s news that the Pimpernel has gone to rescue the Comte completes Marguerite’s deduction: she has exposed her own husband to Chauvelin.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-20",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 20,
      "title": "The Friend",
      "synopsis": "Marguerite confesses her part in Chauvelin’s discovery and persuades Andrew to help her race to Percy rather than protect the secret from her.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-21",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 21,
      "title": "Suspense",
      "synopsis": "Marguerite and Andrew drive for Dover, measuring every delay against Chauvelin’s head start. At Dover, the storm and turning tide prevent an immediate crossing, leaving Marguerite and Andrew trapped in suspense.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-22",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 22,
      "title": "Calais",
      "synopsis": "When wind and tide permit, Marguerite and Andrew cross to France and arrive after a punishing delay. Andrew leads Marguerite to the squalid wayside inn outside Calais, where Percy was expected to leave word.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-23",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 23,
      "title": "Hope",
      "synopsis": "Clues at the Chat Gris suggest Percy has reached Calais and is still directing the rescue, renewing hope without removing the danger.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-24",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 24,
      "title": "The Death-Trap",
      "synopsis": "Chauvelin and Desgas arrive with armed support, turning the inn and road into a death-trap while Marguerite and Andrew conceal themselves.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-25",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 25,
      "title": "The Eagle and the Fox",
      "synopsis": "Percy enters openly under his own name and faces Chauvelin across the inn, apparently unaware that the agent believes the net has closed. Percy’s apparently foolish behaviour, including a well-timed disturbance, lets him escape the inn and keep Chauvelin focused on the wrong signs.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-26",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 26,
      "title": "The Jew",
      "synopsis": "Percy adopts another disguise and carries Chauvelin, Desgas, and the hidden Marguerite along the road toward the rendezvous he has already altered.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-27",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 27,
      "title": "On the Track",
      "synopsis": "Chauvelin’s party approaches Père Blanchard’s hut, convinced that Percy and the fugitives will enter the guarded trap.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-28",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 28,
      "title": "The Père Blanchard’s Hut",
      "synopsis": "The soldiers wait around the hut while Armand, the Comte, and the other fugitives depend on Percy’s promised signal and instructions.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-29",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 29,
      "title": "Trapped",
      "synopsis": "A concealed message sends the fugitives one by one down the cliff toward the hidden creek while Chauvelin’s men continue to watch the hut.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-30",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 30,
      "title": "The Schooner",
      "synopsis": "The fugitives reach the concealed landing, signal the boat, and are rowed out toward the Day Dream while the shore trap collapses.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-chapter-31",
      "timelineId": "scarlet-pimpernel-timeline-main",
      "number": 31,
      "title": "The Escape",
      "synopsis": "After outmanoeuvring the pursuit, Percy reaches Marguerite and learns that she crossed the Channel to warn him despite the danger. Percy, Marguerite, Armand, the Comte, and the League leave the French coast with the rescue complete and their trust altered by what each risked.",
      "notes": "",
      "wordGoal": null
    }
  ],
