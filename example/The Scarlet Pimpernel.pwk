  "lorePages": [
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-lore-terror",
      "categoryId": "scarlet-pimpernel-lore-category-history",
      "title": "Paris and the Revolutionary Terror",
      "body": "The novel opens in September 1792 amid revolutionary executions, guarded barriers, and the persecution of aristocratic families. Orczy heightens this historical setting into the immediate danger from which the League operates.",
      "tags": [],
      "coverImageId": "scarlet-pimpernel-image-paris-cart",
      "linkedEntityIds": [
        "scarlet-pimpernel-character-paris-gate",
        "scarlet-pimpernel-faction-republic"
      ],
      "visibleFromEventId": "scarlet-pimpernel-event-001"
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-lore-league-oath",
      "categoryId": "scarlet-pimpernel-lore-category-league",
      "title": "One to Command, Nineteen to Obey",
      "body": "The League consists of twenty Englishmen. Its members protect the leader’s identity by oath and rely on preparation, disguise, speed, and disciplined trust rather than open battle.",
      "tags": [],
      "coverImageId": "scarlet-pimpernel-image-league",
      "linkedEntityIds": [
        "scarlet-pimpernel-faction-league",
        "scarlet-pimpernel-character-andrew",
        "scarlet-pimpernel-character-tony"
      ],
      "visibleFromEventId": "scarlet-pimpernel-event-004"
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-lore-disguises",
      "categoryId": "scarlet-pimpernel-lore-category-league",
      "title": "Percy’s Operational Disguises",
      "body": "Percy’s disguises exploit expectation: guards dismiss the sick, political agents ignore servants, and fashionable society mistakes performed foolishness for incapacity.",
      "tags": [],
      "coverImageId": "scarlet-pimpernel-image-percy-rescue",
      "linkedEntityIds": [
        "scarlet-pimpernel-character-percy",
        "scarlet-pimpernel-thread-identity"
      ],
      "visibleFromEventId": "scarlet-pimpernel-event-021"
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-lore-chronology",
      "categoryId": "scarlet-pimpernel-lore-category-history",
      "title": "Editorial Chronology",
      "body": "The novel explicitly places the coastal rendezvous on 2 October 1792 and the opening in September. Earlier dates in the calendar are an editorial reconstruction of the narrated intervals, marked as such rather than presented as exact documentary dates.",
      "tags": [],
      "coverImageId": "scarlet-pimpernel-image-channel-map",
      "linkedEntityIds": [
        "scarlet-pimpernel-map-channel"
      ],
      "visibleFromEventId": "scarlet-pimpernel-event-001"
    },
    {
      "worldId": "scarlet-pimpernel-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "scarlet-pimpernel-lore-sources",
      "categoryId": "scarlet-pimpernel-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "Structure and factual sequence follow Baroness Orczy’s public-domain novel. Linked stage images come from a circa-1903 Scarlet Pimpernel production reproduced by Project Gutenberg Australia; maps are historical editorial aids and entity art is reviewed separately from navigable maps.",
      "tags": [],
      "coverImageId": "scarlet-pimpernel-image-cover",
      "linkedEntityIds": [],
      "visibleFromEventId": "scarlet-pimpernel-event-001"
    }
  ],
