"factionId":"frankenstein-faction-university","characterId":"frankenstein-char-waldman","role":"Professor","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-10","factionId":"frankenstein-faction-university","characterId":"frankenstein-char-victor","role":"Student","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-11","factionId":"frankenstein-faction-de-laceys","characterId":"frankenstein-char-de-lacey","role":"Patriarch","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-12","factionId":"frankenstein-faction-de-laceys","characterId":"frankenstein-char-felix","role":"Son","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-13","factionId":"frankenstein-faction-de-laceys","characterId":"frankenstein-char-agatha","role":"Daughter","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-14","factionId":"frankenstein-faction-de-laceys","characterId":"frankenstein-char-safie","role":"Companion","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-15","factionId":"frankenstein-faction-expedition","characterId":"frankenstein-char-walton","role":"Captain","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-16","factionId":"frankenstein-faction-expedition","characterId":"frankenstein-char-shipmaster","role":"Ship master","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-17","factionId":"frankenstein-faction-expedition","characterId":"frankenstein-char-crew","role":"Crew","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-18","factionId":"frankenstein-faction-authorities","characterId":"frankenstein-char-kirwin","role":"Irish magistrate","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-19","factionId":"frankenstein-faction-authorities","characterId":"frankenstein-char-magistrate","role":"Geneva magistrate","startEventId":null,"endEventId":null,"notes":""}],"factionRelationships":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-faction-rel-1","factionAId":"frankenstein-faction-frankensteins","factionBId":"frankenstein-faction-authorities","stance":"neutral","notes":"The family seeks justice, but courts cannot see the Creature behind the evidence."},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-faction-rel-2","factionAId":"frankenstein-faction-de-laceys","factionBId":"frankenstein-faction-authorities","stance":"hostile","notes":"Felix’s rescue leads to punishment and exile."}],"knowledgeFacts":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-animation","title":"Victor has discovered how to animate constructed life","description":"The discovery is known only to Victor until his narrative is preserved.","tags":[],"readerLearnsAtEventId":"frankenstein-event-25","originEventId":"frankenstein-event-25"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-creator","title":"Victor created the Creature","description":"The Creature learns the identity of his maker from laboratory pages.","tags":[],"readerLearnsAtEventId":"frankenstein-event-56","originEventId":"frankenstein-event-56"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-william","title":"The Creature murdered William","description":"Victor infers it at Salève; the Creature later confesses it.","tags":[],"readerLearnsAtEventId":"frankenstein-event-33","originEventId":"frankenstein-event-33"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-justine","title":"Justine was framed","description":"The Creature planted Caroline’s miniature on the sleeping Justine.","tags":[],"readerLearnsAtEventId":"frankenstein-event-60","originEventId":"frankenstein-event-60"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-innocence","title":"Justine is innocent","description":"Elizabeth and Victor know her character; Victor also knows another killer exists.","tags":[],"readerLearnsAtEventId":"frankenstein-event-35","originEventId":"frankenstein-event-35"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-speech","title":"The Creature can reason and speak","description":"Victor learns this only when the Creature confronts him on the glacier.","tags":[],"readerLearnsAtEventId":"frankenstein-event-42","originEventId":"frankenstein-event-42"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-books","title":"Books shaped the Creature’s moral identity","description":"The Creature interprets himself through three found works.","tags":[],"readerLearnsAtEventId":"frankenstein-event-55","originEventId":"frankenstein-event-55"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-companion","title":"Victor promised a companion","description":"The bargain is private between creator and creation.","tags":[],"readerLearnsAtEventId":"frankenstein-event-61","originEventId":"frankenstein-event-61"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-destroyed","title":"Victor destroyed the female creature","description":"The Creature witnesses the destruction through the window.","tags":[],"readerLearnsAtEventId":"frankenstein-event-71","originEventId":"frankenstein-event-71"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-threat","title":"The wedding-night threat targets Elizabeth","description":"Victor understands the wording only after Elizabeth is killed.","tags":[],"readerLearnsAtEventId":"frankenstein-event-80","originEventId":"frankenstein-event-80"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-clerval","title":"The Creature murdered Clerval","description":"Victor recognizes the pattern when shown Clerval’s body.","tags":[],"readerLearnsAtEventId":"frankenstein-event-75","originEventId":"frankenstein-event-75"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-fact-warning","title":"Victor’s story warns Walton against destructive ambition","description":"Walton must decide whether to sacrifice his crew to the polar goal.","tags":[],"readerLearnsAtEventId":"frankenstein-event-86","originEventId":"frankenstein-event-86"}],"knowledgeReveals":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-reveal-animation-victor","factId":"frankenstein-fact-animation","characterId":"frankenstein-char-victor","eventId":"frankenstein-event-25","note":"Learns or confirms this fact at the linked event."},{"