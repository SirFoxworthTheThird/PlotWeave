":414,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-frontispiece"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-cemetery","mapLayerId":"frankenstein-map-geneva","linkedMapLayerId":null,"name":"Geneva Cemetery","description":"A burial ground near Geneva, enclosed from the city and quiet beneath the surrounding Alpine landscape.","x":400,"y":244,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-abbey"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-city-gate","mapLayerId":"frankenstein-map-ingolstadt","linkedMapLayerId":null,"name":"Ingolstadt Gate","description":"The threshold between Ingolstadt’s enclosed streets and the roads leading into the Bavarian countryside.","x":820,"y":300,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-wanderer"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-university","mapLayerId":"frankenstein-map-ingolstadt","linkedMapLayerId":null,"name":"University of Ingolstadt","description":"The historic Bavarian university whose lecture rooms and professors represent contemporary natural philosophy, chemistry, and medicine.","x":620,"y":730,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-victorLab"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-victor-rooms","mapLayerId":"frankenstein-map-ingolstadt","linkedMapLayerId":null,"name":"Victor’s Rooms","description":"Private student lodgings in Ingolstadt, combining living quarters with books, instruments, and space for solitary study.","x":720,"y":610,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-victorLab"},{"worldId":"frankenstein-world","createdAt":17855280000