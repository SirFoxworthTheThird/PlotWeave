ontispiece"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-harbor","mapLayerId":"frankenstein-map-ireland","linkedMapLayerId":null,"name":"Irish Harbor","description":"A sheltered Irish landing place serving fishing boats and vessels travelling along the Atlantic coast.","x":650,"y":334,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-ireland"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-archangel","mapLayerId":"frankenstein-map-arctic","linkedMapLayerId":null,"name":"Archangel Harbor","description":"A northern Russian port on the White Sea, historically used by merchants, sailors, and Arctic expeditions.","x":1000,"y":382,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-stPetersburg"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-open-sea","mapLayerId":"frankenstein-map-arctic","linkedMapLayerId":null,"name":"Open Arctic Sea","description":"The high-latitude waters beyond the White Sea, where navigation depends on weather, visibility, and shifting ice.","x":670,"y":387,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-seaIce"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-walton-ship","mapLayerId":"frankenstein-map-arctic","linkedMapLayerId":null,"name":"Walton’s Icebound Ship","description":"Robert Walton’s expedition vessel, a compact wooden world of decks, cabins, crew quarters, and scientific equipment.","x":545,"y":532,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-sailing"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-sled-route","mapLayerId":"frankenstein-map-arctic","linkedMapLayerId":null,"name":"Northern Sled Route","description":"A reconstructed overland course across snow and sea ice, travelled by sledge where no permanent road exists.","x":690,"y":662,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-seaIce"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-ice-field","mapLayerId":"frankenstein-map-arctic","linkedMapLayerId":null,"name":"Breaking Ice Field","description":"A mobile Arctic expanse of pressure ridges, cracks, fog, and floes that can close around a vessel without warning.","x":450,"y":622,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-seaIce"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-ice-raft","mapLayerId":"frankenstein-map-arctic","linkedMapLayerId":null,"name":"Creature’s Ice Raft","description":"A detached fragment of sea ice carried through open Arctic water by wind and current.","x":370,"y":552,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-seaIce"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-hovel","mapLayerId":"frankenstein-map-cottage","linkedMapLayerId":null,"name":"Creature’s Hovel","description":"A concealed lean-to adjoining the cottage, cramped and unheated but offering a narrow view into the family’s shared room.","x":120,"y":233,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-cottage"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-de-lacey-room","mapLayerId":"frankenstein-map-cottage","linkedMapLayerId":null,"name":"De Lacey’s Room","description":"The cottage room associated with the elder De Lacey, furnished simply and shaped by conversation, music, and domestic routine.","x":700,"y":513,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-cottage"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-family-room","mapLayerId":"frankenstein-map-cottage","linkedMapLayerId":null,"name":"Family Room","description":"The De Laceys’ principal shared room, where work, meals, reading, music, and evening companionship take place.","x":535,"y":343,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-cottage"},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-loc-cottage-door","mapLayerId":"frankenstein-map-cottage","linkedMapLayerId":null,"name":"Cottage Door","description":"The cottage’s modest entrance, opening from the family’s interior onto the garden and surrounding countryside.","x":610,"y":173,"iconType":"landmark","tags":[],"factionId":null,"imageId":"frankenstein-location-image-forest"}],"characters":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-walton","name":"Robert Walton","aliases":["Captain Walton"],"description":"Polar explorer and the outer-frame letter writer.","portraitImageId":"frankenstein-image-char-walton","color":"#7aa6c2","tags":["explorer","narrator"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-margaret","name":"Margaret Saville","aliases":["Mrs Saville"],"description":"Walton’s sister and the recipient of his letters.","portraitImageId":"frankenstein-image-char-margaret","color":"#b78c9b","tags":["correspondent"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-victor","name":"Victor Frankenstein","aliases":[],"description":"Genevan student whose pursuit of forbidden knowledge creates the central tragedy.","portraitImageId":"frankenstein-image-char-victor","color":"#caa85e","tags":["creator","narrator"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-creature","name":"The Creature","aliases":["The daemon","The fiend"],"description":"Victor’s articulate, abandoned creation, driven from sympathy toward vengeance.","portraitImageId":"frankenstein-image-char-creature","color":"#87966f","tags":["creation","outcast"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-alphonse","name":"Alphonse Frankenstein","aliases":[],"description":"Victor’s father and head of the Frankenstein household.","portraitImageId":"frankenstein-image-char-alphonse","color":"#9a7758","tags":["family"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-caroline","name":"Caroline Frankenstein","aliases":["Caroline Beaufort"],"description":"Victor’s mother, whose compassion shapes the family before her early death.","portraitImageId":"frankenstein-image-char-caroline","color":"#c98e8e","tags":["family"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-elizabeth","name":"Elizabeth Lavenza","aliases":[],"description":"Victor’s beloved companion and eventual wife.","portraitImageId":"frankenstein-image-char-elizabeth","color":"#d7b46a","tags":["family"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-ernest","name":"Ernest Frankenstein","aliases":[],"description":"Victor’s surviving younger brother.","portraitImageId":"frankenstein-image-char-ernest","color":"#7796a8","tags":["family"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-william","name":"William Frankenstein","aliases":[],"description":"Victor’s youngest brother, murdered by the Creature.","portraitImageId":"frankenstein-image-char-william","color":"#d5c28a","tags":["family"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-clerval","name":"Henry Clerval","aliases":[],"description":"Victor’s loyal childhood friend and moral counterweight.","portraitImageId":"frankenstein-image-char-clerval","color":"#5f9c8b","tags":["friend"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-justine","name":"Justine Moritz","aliases":[],"description":"A trusted servant unjustly condemned for William’s murder.","portraitImageId":"frankenstein-image-char-justine","color":"#aaa2b2","tags":["family","accused"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-beaufort","name":"Beaufort","aliases":[],"description":"Caroline’s impoverished father and Alphonse’s old friend.","portraitImageId":"frankenstein-image-char-beaufort","color":"#8d7768","tags":["family-history"],"isAlive":false,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-krempe","name":"M. Krempe","aliases":[],"description":"A professor who dismisses Victor’s earlier studies.","portraitImageId":"frankenstein-image-char-krempe","color":"#847258","tags":["university"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-waldman","name":"M. Waldman","aliases":[],"description":"A persuasive chemistry professor who encourages Victor’s scientific ambition.","portraitImageId":"frankenstein-image-char-waldman","color":"#8aa0a7","tags":["university"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-de-lacey","name":"De Lacey","aliases":[],"description":"The blind patriarch of the exiled French family.","portraitImageId":"frankenstein-image-char-de-lacey","color":"#a88e6f","tags":["de-lacey"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-felix","name":"Felix De Lacey","aliases":[],"description":"De Lacey’s son, devoted to Safie but fearful of the Creature.","portraitImageId":"frankenstein-image-char-felix","color":"#8b754f","tags":["de-lacey"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-agatha","name":"Agatha De Lacey","aliases":[],"description":"De Lacey’s daughter, observed with affection by the Creature.","portraitImageId":"frankenstein-image-char-agatha","color":"#b98975","tags":["de-lacey"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-safie","name":"Safie","aliases":[],"description":"A young woman who escapes her father and joins Felix.","portraitImageId":"frankenstein-image-char-safie","color":"#bc8a61","tags":["de-lacey"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-merchant","name":"Safie’s Father","aliases":["The Turkish merchant"],"description":"A merchant whose imprisonment and broken promise cause the De Laceys’ exile.","portraitImageId":"frankenstein-image-char-merchant","color":"#78614e","tags":["merchant"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-kirwin","name":"Mr Kirwin","aliases":[],"description":"The humane Irish magistrate who oversees Victor’s case.","portraitImageId":"frankenstein-image-char-kirwin","color":"#728491","tags":["authority"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-shipmaster","name":"Walton’s Ship Master","aliases":[],"description":"The experienced officer who helps command Walton’s vessel.","portraitImageId":"frankenstein-image-char-shipmaster","color":"#667d91","tags":["expedition"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-crew","name":"Walton’s Crew","aliases":[],"description":"The sailors who demand a safe return when the ice threatens the ship.","portraitImageId":"frankenstein-image-char-crew","color":"#668aa0","tags":["expedition"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-magistrate","name":"Geneva Magistrate","aliases":[],"description":"The official who hears Victor’s accusation against the Creature.","portraitImageId":"frankenstein-image-char-magistrate","color":"#776e61","tags":["authority"],"isAlive":true,"birthDate":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-char-nurse","name":"Irish Nurse","aliases":[],"description":"The attendant who cares for Victor during his imprisonment and illness.","portraitImageId":"frankenstein-image-char-nurse","color":"#8fa6a0","tags":["caretaker"],"isAlive":true,"birthDate":null}],"items":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-walton-letters","name":"Walton’s Letters","description":"The Arctic correspondence addressed to Margaret Saville.","iconType":"envelope","imageId":"frankenstein-image-item-walton-letters","tags":["document"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-victor-notes","name":"Victor’s Notes","description":"The record from which Walton preserves Victor’s narrative.","iconType":"quill-ink","imageId":"frankenstein-image-item-victor-notes","tags":["document"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-chemistry","name":"Chemical Apparatus","description":"Instruments of Victor’s university experiments.","iconType":"chemical-drop","imageId":"frankenstein-image-item-chemistry","tags":["science"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-creation-tools","name":"Creation Instruments","description":"The tools used in the secret labor of animation.","iconType":"toolbox","imageId":"frankenstein-image-item-creation-tools","tags":["science"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-miniature","name":"Caroline’s Miniature","description":"A portrait taken from William and planted on Justine.","iconType":"portrait","imageId":"frankenstein-image-item-miniature","tags":["evidence"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-locket","name":"Justine’s Locket","description":"The pocket in which the incriminating miniature is found.","iconType":"lockpicks","imageId":"frankenstein-image-item-locket","tags":["evidence"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-paradise-lost","name":"Paradise Lost","description":"One of the Creature’s formative books.","iconType":"book-cover","imageId":"frankenstein-image-item-paradise-lost","tags":["book"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-plutarch","name":"Plutarch’s Lives","description":"The Creature’s source for civic virtue and history.","iconType":"book-cover","imageId":"frankenstein-image-item-plutarch","tags":["book"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-werter","name":"The Sorrows of Werter","description":"The Creature’s source for intense private feeling.","iconType":"book-cover","imageId":"frankenstein-image-item-werter","tags":["book"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-journal-pages","name":"Laboratory Journal Pages","description":"Victor’s account of assembling the Creature, read by the Creature himself.","iconType":"papers","imageId":"frankenstein-image-item-journal-pages","tags":["document"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-fire","name":"The Cottage Fire","description":"The warmth, danger, and knowledge first discovered by the Creature.","iconType":"campfire","imageId":"frankenstein-image-item-fire","tags":["symbol"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-female-remains","name":"Female Creature’s Remains","description":"The destroyed second body and the evidence Victor sinks at sea.","iconType":"broken-bone","imageId":"frankenstein-image-item-female-remains","tags":["remains"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-boat","name":"Victor’s Boat","description":"The small craft used to dispose of the remains and reach Ireland.","iconType":"sailboat","imageId":"frankenstein-image-item-boat","tags":["vehicle"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-pistol","name":"Wedding-Night Pistols","description":"Weapons Victor carries while expecting the Creature’s attack.","iconType":"pistol-gun","imageId":"frankenstein-image-item-pistol","tags":["weapon"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-dog-sled","name":"Dog Sled","description":"The vehicle used in the final northern pursuit.","iconType":"wolf-howl","imageId":"frankenstein-image-item-dog-sled","tags":["vehicle"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-wedding-ring","name":"Wedding Ring","description":"The symbol of Victor and Elizabeth’s brief marriage.","iconType":"ring","imageId":"frankenstein-image-item-wedding-ring","tags":["symbol"]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-item-ice-raft","name":"Ice Raft","description":"The fragment on which the Creature disappears into darkness.","iconType":"iceberg","imageId":"frankenstein-image-item-ice-raft","tags":["vehicle"]}],"characterSnapshots":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-snapshot-1-walton","characterId":"frankenstein-char-walton","eventId":"frankenstein-event-1","isAlive":true,"currentLocationMarkerId":"frankenstein-loc-st-petersburg","currentMapLayerId":"frankenstein-map-europe","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":1,"statusNotes":"Preparing with disciplined excitement for a hazardous northern expedition."},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-snapshot-1-margaret","characterId":"frankenstein-char-margaret","eventId":"frankenstein-event-1","isAlive":true,"currentLocationMarkerId":"frankenstein-loc-frankenstein-home","currentMapLayerId":"frankenstein-map-geneva","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":1,"statusNotes":"At home receiving her brother’s hopeful first account."},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-snapshot-2-walton","characterId":"frankenstein-char-walton","eventId":"frankens