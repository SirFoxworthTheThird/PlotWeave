angel","frankenstein-loc-open-sea","frankenstein-loc-sled-route","frankenstein-loc-ice-field","frankenstein-loc-walton-ship"],"color":"#8b5965","notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-route-4","mapLayerId":"frankenstein-map-geneva","name":"Geneva Tragedies","routeType":"road","waypoints":["frankenstein-loc-frankenstein-home","frankenstein-loc-plainpalais","frankenstein-loc-geneva-prison","frankenstein-loc-cemetery"],"color":"#8b5965","notes":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-route-5","mapLayerId":"frankenstein-map-geneva-region","name":"Lake Geneva Crossings","routeType":"sea_route","waypoints":["frankenstein-loc-geneva-city-portal","frankenstein-loc-belrive","frankenstein-loc-lake-geneva","frankenstein-loc-evian"],"color":"#8b5965","notes":""}],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"frankenstein-lore-category-science","worldId":"frankenstein-world","name":"Science and Education","color":"#9b7758","sortOrder":1},{"id":"frankenstein-lore-category-society","worldId":"frankenstein-world","name":"Society and Justice","color":"#7f6d83","sortOrder":2},{"id":"frankenstein-lore-category-places","worldId":"frankenstein-world","name":"Places and Travel","color":"#668c88","sortOrder":3},{"id":"frankenstein-lore-category-themes","worldId":"frankenstein-world","name":"Themes and Motifs","color":"#8d6571","sortOrder":4},{"id":"frankenstein-lore-category-sources","worldId":"frankenstein-world","name":"Sources and Editorial Notes","color":"#7b8795","sortOrder":5}],"lorePages":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-1","categoryId":"frankenstein-lore-category-science","title":"Natural Philosophy and Chemistry","body":"Victor moves from obsolete occult authorities toward modern chemistry, but carries forward the older dream of total mastery.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-2","categoryId":"frankenstein-lore-category-science","title":"Animation and Its Limits","body":"The novel never supplies a reproducible method. The decisive continuity fact is Victor’s secrecy and revulsion, not a technical recipe.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-3","categoryId":"frankenstein-lore-category-science","title":"The Creature’s Learning","body":"The Creature acquires language socially, then interprets himself through books and Victor’s laboratory record.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-4","categoryId":"frankenstein-lore-category-society","title":"Appearance and Judgment","body":"Villagers, Felix, and courts repeatedly act on what seems visible while missing motive, history, or truth.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-5","categoryId":"frankenstein-lore-category-society","title":"Genevan Justice","body":"Justine’s conviction demonstrates how moral character can be overwhelmed by coerced confession and planted evidence.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-6","categoryId":"frankenstein-lore-category-society","title":"The De Laceys’ Exile","body":"Felix’s rescue of Safie’s father costs the French family wealth, status, and country.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-7","categoryId":"frankenstein-lore-category-places","title":"Geneva and Lake Léman","body":"The Frankenstein family’s domestic center becomes inseparable from William’s and Elizabeth’s deaths.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-8","categoryId":"frankenstein-lore-category-places","title":"Ingolstadt","body":"Victor’s university city is the place where education becomes secrecy and creation.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-9","categoryId":"frankenstein-lore-category-places","title":"Mont Blanc and the Mer de Glace","body":"The glacier gives the Creature a stage on which to demand narrative and moral recognition.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-10","categoryId":"frankenstein-lore-category-places","title":"Britain, Orkney, and Ireland","body":"Victor’s research journey becomes a trail of isolation, broken promise, murder, and wrongful suspicion.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-11","categoryId":"frankenstein-lore-category-places","title":"The Arctic Frame","body":"The frozen sea joins Walton’s ambition to Victor’s pursuit and gives Walton a chance to choose differently.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-12","categoryId":"frankenstein-lore-category-themes","title":"Creator and Creation","body":"Neither Victor nor the Creature can escape the identity formed by the other; their pursuit becomes reciprocal.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-13","categoryId":"frankenstein-lore-category-themes","title":"Companionship","body":"Walton wants a friend, the Creature demands an equal, and Victor repeatedly withdraws from those who already love him.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-14","categoryId":"frankenstein-lore-category-sources","title":"Edition and Chapter Structure","body":"This example follows the 1831 text’s four letters and 24 numbered chapters in reading order, while retaining the nested chronology in Calendar dates.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-lore-15","categoryId":"frankenstein-lore-category-sources","title":"Map and Image Sources","body":"Maps are URL-linked Wikimedia Commons previews: Europe 1815, a Lake Geneva regional map, Geneva city, Ingolstadt 1816, Chamonix/Mont Blanc 1892, British Isles, a complete labeled Orkney archipelago map, Ireland 1815, Arctic 1894, and a public-domain cottage floor plan. The Orkney map was created by Wikivoyage contributor Paul and is available under CC BY-SA. The cover, Victor, and the Creature use public-domain 1831 engravings by Theodor von Holst. The supporting-character portraits use representative public-domain period paintings and engravings linked from Wikimedia Commons, selected to evoke the novel’s late-eighteenth-century world; their historical sitters are visual references for the fictional cast, not claimed identities. Item artwork uses Google Noto Color Emoji through Iconify. No image blobs are embedded in the example.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null}],"factions":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-faction-frankensteins","name":"Frankenstein Household","description":"The Genevan family and its trusted dependents.","color":"#a77b62","coverImageId":null,"tags":[]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-faction-university","name":"University of Ingolstadt","description":"The academic world that trains Victor in modern chemistry.","color":"#72889c","coverImageId":null,"tags":[]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-faction-de-laceys","name":"De Lacey Household","description":"The exiled family whose domestic affection educates the Creature.","color":"#9a8665","coverImageId":null,"tags":[]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-faction-expedition","name":"Walton Expedition","description":"The Arctic ship’s officers and crew.","color":"#60879b","coverImageId":null,"tags":[]},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-faction-authorities","name":"Civil Authorities","description":"Courts, magistrates, and local officials in Geneva and Ireland.","color":"#77706d","coverImageId":null,"tags":[]}],"factionMemberships":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-membership-1","factionId":"frankenstein-faction-frankensteins","characterId":"frankenstein-char-victor","role":"Son","startEventId":null,"endEventId":null,"notes":""},{"worldId":"frankenstein-world","createdAt":178