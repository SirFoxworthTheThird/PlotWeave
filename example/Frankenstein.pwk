{"version":18,"type":"full","exportedAt":1785528000000,"world":{"id":"frankenstein-world","name":"Frankenstein; or, The Modern Prometheus","description":"An ambitious young scientist gives life to a being assembled from the dead, then abandons his creation. Rejected by every human community, the Creature turns his longing for companionship into vengeance, binding creator and creation in a pursuit from Geneva to the Arctic.","coverImageId":"frankenstein-image-cover","theme":"theme-horror","createdAt":1785528000000,"updatedAt":1785528000000,"continuityStaleThreshold":5,"calendar":{"startYear":1770,"yearSuffix":" (editorial)","months":[{"name":"January","days":31},{"name":"February","days":28},{"name":"March","days":31},{"name":"April","days":30},{"name":"May","days":31},{"name":"June","days":30},{"name":"July","days":31},{"name":"August","days":31},{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]}},"mapLayers":[{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-map-europe","parentMapId":null,"name":"Europe, 1815","description":"The novel’s continental journeys, from Russia through Germany and Switzerland.","imageId":"frankenstein-image-map-europe","imageWidth":1280,"imageHeight":795,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-map-geneva-region","parentMapId":"frankenstein-map-europe","name":"Lake Geneva Region","description":"The full Lake Léman region linking Geneva, Lausanne, Évian, Belrive, and Mont Salève.","imageId":"frankenstein-image-map-geneva-region","imageWidth":474,"imageHeight":312,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-map-geneva","parentMapId":"frankenstein-map-geneva-region","name":"Geneva City","description":"The Frankenstein household, Plainpalais, cemetery, and court within Geneva.","imageId":"frankenstein-image-map-geneva","imageWidth":883,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-map-ingolstadt","parentMapId":"frankenstein-map-europe","name":"Ingolstadt, 1816 Plan","description":"University streets, Victor’s rooms, and the laboratory where he creates life.","imageId":"frankenstein-image-map-ingolstadt","imageWidth":1280,"imageHeight":1280,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-map-montblanc","parentMapId":"frankenstein-map-europe","name":"Chamonix and Mont Blanc","description":"The Alpine landscape where creator and creation confront one another.","imageId":"frankenstein-image-map-montblanc","imageWidth":960,"imageHeight":1377,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-map-britain","parentMapId":"frankenstein-map-europe","name":"The British Isles","description":"Victor and Clerval’s route through England and Scotland.","imageId":"frankenstein-image-map-britain","imageWidth":960,"imageHeight":1483,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"frankenstein-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"frankenstein-map-orkney","parentMapId":"frankenstein-map-britain","name":"Orkney Islands","description":"The complete Orkney archipelago, including the remote northern islands where Victor begins a second creature.","imageId":"