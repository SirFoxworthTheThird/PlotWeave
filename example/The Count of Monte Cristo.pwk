      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 23,
      "title": "The Island of Monte Cristo",
      "synopsis": "On a contraband voyage Dantès sees the island named in Faria’s manuscript and prepares a reason to remain behind. The smuggling vessel approaches the isolated island named in Faria’s directions.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
