      "number": 22,
      "title": "The Smugglers",
      "synopsis": "Dantès poses as a shipwrecked Maltese sailor and joins a smuggling crew after Jacopo saves him.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
