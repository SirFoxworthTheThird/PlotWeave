  "timelines": [
    {
      "id": "count-of-monte-cristo-timeline-main",
      "worldId": "count-of-monte-cristo-world",
      "name": "Edmond Dantès and the Count",
      "description": "The single reading timeline from the Pharaon’s arrival in 1815 through imprisonment, return, revenge, and the final departure in 1838. Recollected histories remain flagged within the chapters that narrate them.",
      "color": "#805746",
      "dayOffset": 0,
      "createdAt": 1786291200000
    }
  ],
  "chapters": [
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-001",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 1,
      "title": "Marseilles—The Arrival",
      "synopsis": "The Pharaon enters Marseille after Captain Leclère’s death, and Morrel recognizes Dantès’s command of ship and crew. The home port comes into view as the Pharaon rounds the islands and prepares to enter the harbour.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-002",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 2,
      "title": "Father and Son",
      "synopsis": "Dantès discovers that his father paid Caderousse’s debt and nearly starved during the voyage.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-003",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 3,
      "title": "The Catalans",
      "synopsis": "Edmond reaches the Catalans, where Mercédès welcomes him and firmly rejects Fernand’s claim upon her.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-004",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 4,
      "title": "Conspiracy",
      "synopsis": "Danglars turns Fernand’s jealousy and Caderousse’s drunken unease into an anonymous Bonapartist accusation.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-005",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 5,
      "title": "The Marriage Feast",
      "synopsis": "At La Réserve, Dantès is arrested in the middle of his joyful public betrothal feast. Before the officers arrive, Morrel announces the captaincy and the families celebrate the marriage to come.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-006",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 6,
      "title": "The Deputy Procureur du Roi",
      "synopsis": "News of a suspected Bonapartist interrupts Villefort’s royalist betrothal banquet and offers him a career-making case.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-007",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 7,
      "title": "The Examination",
      "synopsis": "Dantès answers every question honestly until Villefort sees that the letter is addressed to his own father, Noirtier. Villefort’s questioning establishes that Dantès neither knows the letter’s content nor understands Bonapartist politics.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-008",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 8,
      "title": "The Château d’If",
      "synopsis": "Dantès is carried at night past familiar lights and understands too late that the destination is Château d’If. The prison boat reaches the island marker outside Marseille before guards force Dantès up the landing stair.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-009",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 9,
      "title": "The Evening of the Betrothal",
      "synopsis": "Mercédès, Morrel, and Louis Dantès appeal for news while Villefort suppresses the case and Fernand remains close.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-010",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 10,
      "title": "The King’s Closet at the Tuileries",
      "synopsis": "Villefort reaches the Tuileries with news of Napoleon’s return and converts private self-protection into public advancement.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-011",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 11,
      "title": "The Corsican Ogre",
      "synopsis": "The royal court learns that the supposedly powerless exile is moving rapidly through France.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-012",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 12,
      "title": "Father and Son",
      "synopsis": "Noirtier arrives at his son’s rooms, reveals his role in a political killing, and alters his clothes before leaving.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-013",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 13,
      "title": "The Hundred Days",
      "synopsis": "Napoleon’s Hundred Days pass, Morrel petitions again, and Villefort’s annotations keep Dantès buried after the Bourbon return. The story returns to the Pharaon’s call at Elba, where Napoleon’s letter passed into Captain Leclère’s keeping before Dantès inherited the delivery.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-014",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 14,
      "title": "The Two Prisoners",
      "synopsis": "After years of isolation, Dantès turns toward starvation while the governor dismisses Faria as a mad claimant to treasure.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-015",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 15,
      "title": "Number 34 and Number 27",
      "synopsis": "Dantès hears digging behind his wall and commits himself to reaching the unknown prisoner.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-016",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 16,
      "title": "A Learned Italian",
      "synopsis": "The abbé examines Dantès’s story and identifies the motives of Danglars, Fernand, Caderousse, and Villefort.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-017",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 17,
      "title": "The Abbé’s Chamber",
      "synopsis": "Faria teaches Dantès languages, history, science, mathematics, manners, and the disciplines of observation.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
