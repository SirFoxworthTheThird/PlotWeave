  "lorePages": [
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-1",
      "categoryId": "count-of-monte-cristo-lore-category-sources",
      "title": "Text and Illustration Edition",
      "body": "This example follows the complete 117-chapter public-domain English text in Project Gutenberg ebook 1184. Its character, item, place, and world images are distinct engravings from the illustrated edition hosted with that text. Historical map layers are linked from Wikimedia Commons and the French regional heritage inventory.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-cover",
      "linkedEntityIds": [
        "count-of-monte-cristo-world"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-001"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-2",
      "categoryId": "count-of-monte-cristo-lore-category-history",
      "title": "The Hundred Days",
      "body": "The opening occurs as Napoleon leaves Elba and briefly returns to power in 1815. A letter that might be harmless under one regime becomes dangerous under another, allowing Villefort to convert political volatility into private concealment.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-0141m",
      "linkedEntityIds": [
        "count-of-monte-cristo-char-napoleon",
        "count-of-monte-cristo-char-louis-xviii"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-014"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-3",
      "categoryId": "count-of-monte-cristo-lore-category-history",
      "title": "Marseille and Mediterranean Commerce",
      "body": "The Pharaon belongs to a trading world connecting Smyrna, Trieste, Naples, Elba, Marseille, Livorno, and the wider Mediterranean. Ships carry news, letters, contraband, credit, and transformed identities faster than courts can correct injustice.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-0025m",
      "linkedEntityIds": [
        "count-of-monte-cristo-map-marseille"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-001"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-4",
      "categoryId": "count-of-monte-cristo-lore-category-history",
      "title": "Ali Pasha of Yanina",
      "body": "The Yanina plot draws on the fall of the historical Ali Pasha in 1822, reshaped by the novel into the concealed origin of Fernand’s title and Haydée’s enslavement.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-40074m",
      "linkedEntityIds": [
        "count-of-monte-cristo-char-haydee",
        "count-of-monte-cristo-char-ali-pasha"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-095"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-5",
      "categoryId": "count-of-monte-cristo-lore-category-society",
      "title": "Credit and Reputation",
      "body": "Danglars’s fortune depends on confidence, privileged information, and the honouring of drafts. The Count attacks reputation as a financial asset rather than stealing money directly.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-20333m",
      "linkedEntityIds": [
        "count-of-monte-cristo-faction-danglars-bank",
        "count-of-monte-cristo-item-five-million-draft"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-059"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-6",
      "categoryId": "count-of-monte-cristo-lore-category-society",
      "title": "The Optical Telegraph",
      "body": "France’s semaphore network carried coded official messages between stations. The Count’s bribe works because a single operator can introduce a false sign into a trusted chain.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-30183m",
      "linkedEntityIds": [
        "count-of-monte-cristo-item-telegraph-message",
        "count-of-monte-cristo-loc-telegraph"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-076"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-7",
      "categoryId": "count-of-monte-cristo-lore-category-society",
      "title": "Poison, Tolerance, and Antidote",
      "body": "The novel treats toxicology as knowledge whose moral character depends on dose and purpose. Noirtier’s tolerance, Héloïse’s murders, and Valentine’s simulated death all use variations of the same principle.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-30065m",
      "linkedEntityIds": [
        "count-of-monte-cristo-item-brucine",
        "count-of-monte-cristo-item-sleeping-draught"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-066"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-8",
      "categoryId": "count-of-monte-cristo-lore-category-themes",
      "title": "Providence and Judgment",
      "body": "The Count interprets survival and treasure as authorization to reward and punish. Édouard’s death reveals the error in treating consequences as perfectly containable and changes the final movement from vengeance to mercy.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-50189m",
      "linkedEntityIds": [
        "count-of-monte-cristo-char-edmond"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-139"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-9",
      "categoryId": "count-of-monte-cristo-lore-category-themes",
      "title": "Identity as Performance and Proof",
      "body": "Aliases can protect the vulnerable or empower criminals, while voice, memory, scars, documents, and testimony recover identity. The novel repeatedly asks which forms of recognition deserve belief.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-0155m",
      "linkedEntityIds": [
        "count-of-monte-cristo-char-edmond",
        "count-of-monte-cristo-char-andrea"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-016"
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-lore-page-10",
      "categoryId": "count-of-monte-cristo-lore-category-themes",
      "title": "Wait and Hope",
      "body": "Waiting first appears as helpless imprisonment and bereavement. By the ending it becomes chosen endurance: time in which knowledge, mercy, and love can alter what seems final.",
      "tags": [],
      "coverImageId": "count-of-monte-cristo-image-art-50275m",
      "linkedEntityIds": [
        "count-of-monte-cristo-item-maximilien-letter"
      ],
      "visibleFromEventId": "count-of-monte-cristo-event-148"
    }
  ],
