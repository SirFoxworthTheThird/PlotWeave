      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 18,
      "title": "The Treasure",
      "synopsis": "Faria shows Dantès the manuscript whose hidden ink directs them to the treasure of Cardinal Spada.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-019",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 19,
      "title": "The Third Attack",
      "synopsis": "A final seizure leaves Faria dying despite Dantès’s use of the remaining medicine.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-020",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 20,
      "title": "The Cemetery of the Château d’If",
      "synopsis": "After Faria dies, Dantès moves the body to his own cell and sews himself into the prison shroud. The guards sew weights into the shroud and carry the supposed corpse toward the ramparts.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
      "id": "count-of-monte-cristo-chapter-021",
      "timelineId": "count-of-monte-cristo-timeline-main",
      "number": 21,
      "title": "The Island of Tiboulen",
      "synopsis": "Thrown from the ramparts in a weighted sack, Dantès cuts free and reaches Tiboulen through the storm.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "count-of-monte-cristo-world",
      "createdAt": 1786291200000,
      "updatedAt": 1786291200000,
