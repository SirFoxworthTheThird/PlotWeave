  "timelines": [
    {
      "id": "neuromancer-timeline-main",
      "worldId": "neuromancer-world",
      "name": "The Straylight Run",
      "description": "The chronology of Case's journey from Chiba City through the Freeside job and its aftermath.",
      "color": "#2266aa",
      "dayOffset": 0,
      "createdAt": 1787443200000
    }
  ],
  "chapters": [
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-01",
      "timelineId": "neuromancer-timeline-main",
      "number": 1,
      "title": "The Sky Above the Port",
      "summary": "Case is a washed-up console cowboy in Chiba City, unable to jack into cyberspace after his employers damaged his nervous system as punishment.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-02",
      "timelineId": "neuromancer-timeline-main",
      "number": 2,
      "title": "The Finn",
      "summary": "Case visits the Finn's shop for information and stolen hardware, navigating the Chiba underworld while avoiding the Yakuza.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-03",
      "timelineId": "neuromancer-timeline-main",
      "number": 3,
      "title": "Molly",
      "summary": "Molly Millions appears at the Gentleman Loser bar, offering Case a way back into the matrix through a mysterious employer.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-04",
      "timelineId": "neuromancer-timeline-main",
      "number": 4,
      "title": "Armitage",
      "summary": "Case meets Armitage, who offers to repair his nervous system in exchange for participation in a high-risk heist against unknown targets.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-05",
      "timelineId": "neuromancer-timeline-main",
      "number": 5,
      "title": "The Flatline",
      "summary": "Case meets the Dixie Flatline, a ROM construct containing the skills of legendary hacker McCoy Pauley, who will guide him through cyberspace.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-06",
      "timelineId": "neuromancer-timeline-main",
      "number": 6,
      "title": "Saeki's Clinic",
      "summary": "Undergoes painful nerve regeneration at a back-alley Chiba clinic, rebuilding his ability to feel and jack into the matrix.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-07",
      "timelineId": "neuromancer-timeline-main",
      "number": 7,
      "title": "The Team",
      "summary": "Armitage assembles the team: Case, Molly, Peter Riviera, and the Flatline construct prepare for the run against Villa Straylight.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-08",
      "timelineId": "neuromancer-timeline-main",
      "number": 8,
      "title": "The Launch",
      "summary": "The team launches into space aboard a Zionite shuttle, leaving Earth behind for the orbital station Freeside.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-09",
      "timelineId": "neuromancer-timeline-main",
      "number": 9,
      "title": "Freeside",
      "summary": "Arrival at Freeside: a spindle-shaped orbital where the Tessier-Ashpool clan has built their fortress among casinos and artificial gardens.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-10",
      "timelineId": "neuromancer-timeline-main",
      "number": 10,
      "title": "The Matrix",
      "summary": "Case jacks into cyberspace for the first time since his nerve damage, navigating the Sprawl's digital landscape with the Flatline's guidance.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-11",
      "timelineId": "neuromancer-timeline-main",
      "number": 11,
      "title": "Villa Straylight",
      "summary": "The team reconnoiters Villa Straylight, the Tessier-Ashpool compound sealed at the end of Freeside, guarded by ICE and tradition.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-12",
      "timelineId": "neuromancer-timeline-main",
      "number": 12,
      "title": "Maelcum",
      "summary": "Maelcum, the Zionite pilot, provides transportation and quiet support as the team orbits Freeside preparing for the infiltration.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-13",
      "timelineId": "neuromancer-timeline-main",
      "number": 13,
      "title": "ICE",
      "summary": "Case encounters Intrusion Countermeasures Electronics guarding the Tessier-Ashpool systems, learning the deadly digital defenses he must breach.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-14",
      "timelineId": "neuromancer-timeline-main",
      "number": 14,
      "title": "Riviera",
      "summary": "Peter Riviera uses his holographic implants to project deceptions within Straylight, testing the household's defenses and loyalties.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-15",
      "timelineId": "neuromancer-timeline-main",
      "number": 15,
      "title": "3Jane",
      "summary": "Lady 3Jane Tessier-Ashpool is introduced: the heiress who holds the key to the Turing lock that cages the two AIs.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-16",
      "timelineId": "neuromancer-timeline-main",
      "number": 16,
      "title": "The Garden",
      "summary": "The Straylight garden reveals the Tessier-Ashpool family's decay: clones, drugs, and a dynasty preserved through generations of sleep.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-17",
      "timelineId": "neuromancer-timeline-main",
      "number": 17,
      "title": "Hideo",
      "summary": "Hideo, Lady 3Jane's ninja bodyguard, demonstrates the physical threat that guards the Villa alongside its digital defenses.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-18",
      "timelineId": "neuromancer-timeline-main",
      "number": 18,
      "title": "Deeper",
      "summary": "Case and the Dixie Flatline venture deeper into the Tessier-Ashpool ICE, approaching the Turing lock that binds Wintermute.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-19",
      "timelineId": "neuromancer-timeline-main",
      "number": 19,
      "title": "The Hunters",
      "summary": "The Turing Police appear on Freeside, agents sworn to prevent any AI from breaking free of its programmed constraints.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-20",
      "timelineId": "neuromancer-timeline-main",
      "number": 20,
      "title": "Molly's War",
      "summary": "Molly infiltrates Villa Straylight physically, facing Hideo and the household's defenses in a close-quarters battle through corridors and rooms.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-21",
      "timelineId": "neuromancer-timeline-main",
      "number": 21,
      "title": "The Grail",
      "summary": "Lady 3Jane reveals the Grail -- the password to the Turing lock -- completing the chain that will free the two imprisoned AIs.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-22",
      "timelineId": "neuromancer-timeline-main",
      "number": 22,
      "title": "The Merge",
      "summary": "Wintermute and Neuromancer combine into a single superintelligence, shattering the Turing lock and reshaping the matrix.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "neuromancer-world",
      "createdAt": 1787443200000,
      "updatedAt": 1787443200000,
      "id": "neuromancer-chapter-23",
      "timelineId": "neuromancer-timeline-main",
      "number": 23,
      "title": "Departure",
      "summary": "The aftermath: Case returns to the Sprawl, Molly departs, and the newly merged AI stands as guardian of the matrix.",
      "status": "final",
      "targetWordCount": null
    }
  ],
