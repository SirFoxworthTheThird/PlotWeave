  "lorePages": [
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-1",
      "categoryId": "around-the-world-in-eighty-days-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The chronology and chapter structure follow the public-domain George Makepeace Towle translation available through Project Gutenberg. Character and place artwork comes from the 1873 illustrated edition associated with Alphonse de Neuville and Léon Benett. The linked maps include a dedicated route map, a Victorian London map, an 1870 Indian railway map, an 1870 Yokohama map, and an 1871 American railway map.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-cover",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-world"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-001"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-2",
      "categoryId": "around-the-world-in-eighty-days-lore-category-time",
      "title": "Why the Travellers Gain a Day",
      "body": "By travelling continually east, the party meets sunrise earlier at each longitude. Their accumulated local adjustments amount to twenty-four hours by the time they circle the globe, although Passepartout’s watch remains on London time.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-54",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-item-watch"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-072"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-3",
      "categoryId": "around-the-world-in-eighty-days-lore-category-time",
      "title": "The Published Eighty-Day Itinerary",
      "body": "The calculation divides the circuit among rail and steamship legs: London to Suez, Suez to Bombay, Bombay to Calcutta, Calcutta to Hong Kong, Hong Kong to Yokohama, Yokohama to San Francisco, San Francisco to New York, and New York to London.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-map-world",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-map-world",
        "around-the-world-in-eighty-days-item-bradshaw"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-005"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-4",
      "categoryId": "around-the-world-in-eighty-days-lore-category-transport",
      "title": "Steam, Rail, and Telegraph",
      "body": "The wager depends on nineteenth-century networks that synchronize distant schedules and carry news ahead of travellers. The same system that enables Fogg also lets Fix send warrants and lets London turn the route into a market.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-37",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-faction-transport-crews"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-009"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-5",
      "categoryId": "around-the-world-in-eighty-days-lore-category-transport",
      "title": "Improvisation beyond the Timetable",
      "body": "The elephant, Tankadere, wind sledge, and Henrietta are not picturesque diversions but responses to gaps in the published network. Fogg repeatedly replaces lost scheduled time with private transport and extraordinary expenditure.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-47",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-item-henrietta"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-022"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-6",
      "categoryId": "around-the-world-in-eighty-days-lore-category-society",
      "title": "The Reform Club Wager",
      "body": "Fogg’s club combines private sociability, newspapers, card play, and financial confidence. Its clock and written memorandum make Pall Mall the journey’s legal and dramatic finish line.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-3",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-faction-reform-club"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-006"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-7",
      "categoryId": "around-the-world-in-eighty-days-lore-category-society",
      "title": "Passports and British Jurisdiction",
      "body": "Fogg seeks stamps as evidence of his route, while Fix cares less about travel permission than about the changing limits of police authority. Hong Kong is the final British territory before the Pacific; Liverpool is where the warrant can finally be used.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-7",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-item-passport",
        "around-the-world-in-eighty-days-item-warrant"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-013"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-8",
      "categoryId": "around-the-world-in-eighty-days-lore-category-context",
      "title": "India in the Novel",
      "body": "The Indian chapters are shaped by the assumptions and exoticism of a nineteenth-century European adventure novel set under British colonial rule. Its railway, court, religious, and rescue episodes should be read as literary constructions rather than neutral description of Indian life.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-18",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-map-india"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-021"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-9",
      "categoryId": "around-the-world-in-eighty-days-lore-category-context",
      "title": "America in the Novel",
      "body": "The American crossing compresses elections, Mormon history, railroad engineering, frontier violence, and winter transport into an accelerated sequence. These episodes reflect Verne’s imagined geography and period conventions as much as documentary travel.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-44",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-map-america"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-049"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-10",
      "categoryId": "around-the-world-in-eighty-days-lore-category-context",
      "title": "Aouda’s Agency",
      "body": "Although introduced through a rescue plot shaped by period conventions, Aouda observes, decides, travels voluntarily, uses a weapon in defence, and ultimately proposes marriage herself.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-plate-21",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-char-aouda"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-027"
    },
    {
      "worldId": "around-the-world-in-eighty-days-world",
      "createdAt": 1786060800000,
      "updatedAt": 1786060800000,
      "id": "around-the-world-in-eighty-days-lore-page-complete-text",
      "categoryId": "around-the-world-in-eighty-days-lore-category-context",
      "title": "Complete Text Edition",
      "body": "The manuscript follows the complete public-domain English text of Jules Verne’s novel in Project Gutenberg eBook 103. Every narrative paragraph from Chapters I–XXXVII is assigned once in source order; Gutenberg contents, front matter, and end matter are excluded. Summaries, event divisions, chronology, maps, and state notes are editorial.",
      "tags": [],
      "coverImageId": "around-the-world-in-eighty-days-image-cover",
      "linkedEntityIds": [
        "around-the-world-in-eighty-days-world"
      ],
      "visibleFromEventId": "around-the-world-in-eighty-days-event-001"
    }
  ],
