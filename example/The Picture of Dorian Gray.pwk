,"linkedMapLayerId":null,"name":"The Bristol Club","description":"A fashionable club used for dinners, messages, and Lord Henry’s social intelligence.","x":570,"y":585,"iconType":"glass-cocktail","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-fermor"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-alan-house","mapLayerId":"dorian-gray-map-london","linkedMapLayerId":null,"name":"Alan Campbell’s House","description":"The residence from which Dorian summons the reluctant chemist.","x":700,"y":510,"iconType":"flask-outline","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-alan"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-victoria-station","mapLayerId":"dorian-gray-map-london","linkedMapLayerId":null,"name":"Victoria Station","description":"Basil’s intended departure point for the Paris night train.","x":485,"y":405,"iconType":"train","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-basil-bag"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-soho-portal","mapLayerId":"dorian-gray-map-london","linkedMapLayerId":"dorian-gray-map-soho","name":"Soho and the Eastward Route","description":"A nocturnal route through Soho and the poorer eastern districts toward riverside streets and the docks.","x":555,"y":555,"iconType":"weather-fog","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-opium-pipe"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-vane-lodgings","mapLayerId":"dorian-gray-map-soho","linkedMapLayerId":null,"name":"Vane Family Lodgings","description":"The cramped home where Sibyl, James, and Mrs Vane discuss love, debt, and departure.","x":610,"y":585,"iconType":"home-city","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-mrs-vane"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-opium-den","mapLayerId":"dorian-gray-map-soho","linkedMapLayerId":null,"name":"Opium Den","description":"The foul riverside den where Dorian seeks forgetfulness and encounters Adrian.","x":730,"y":390,"iconType":"smoking-pipe","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-opium-pipe"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-dock-street","mapLayerId":"dorian-gray-map-soho","linkedMapLayerId":null,"name":"Dockside Street","description":"The dark street where James corners Dorian after hearing “Prince Charming.”","x":790,"y":330,"iconType":"pier","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-james"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-house-hall","mapLayerId":"dorian-gray-map-house","linkedMapLayerId":null,"name":"Entrance Hall","description":"The threshold crossed by guests, servants, frame-makers, and investigators.","x":430,"y":250,"iconType":"door","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-hubbard"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-house-library","mapLayerId":"dorian-gray-map-house","linkedMapLayerId":null,"name":"Library","description":"Dorian’s private room for letters, news, the yellow book, and tense conversations.","x":355,"y":470,"iconType":"bookshelf","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-yellow-book"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-house-drawing","mapLayerId":"dorian-gray-map-house","linkedMapLayerId":null,"name":"Drawing Room","description":"The polished social room where Dorian receives Basil and Lord Henry.","x":560,"y":430,"iconType":"sofa-outline","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-henry"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-house-dining","mapLayerId":"dorian-gray-map-house","linkedMapLayerId":null,"name":"Dining Room","description":"A formal room used before theatres, dinners, and late-night departures.","x":610,"y":520,"iconType":"silverware","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-agatha"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-house-garden","mapLayerId":"dorian-gray-map-house","linkedMapLayerId":null,"name":"Garden and Conservatory","description":"The scented garden edge where beauty masks the house’s corruption.","x":690,"y":700,"iconType":"greenhouse","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-orchids"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-attic-portal","mapLayerId":"dorian-gray-map-house","linkedMapLayerId":"dorian-gray-map-attic","name":"Staircase to the Schoolroom","description":"A little-used staircase leading to the locked former schoolroom in the upper part of the house.","x":760,"y":680,"iconType":"stairs","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-attic-key"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-attic-room","mapLayerId":"dorian-gray-map-attic","linkedMapLayerId":null,"name":"Locked Schoolroom","description":"The abandoned upper room in which Dorian hides the portrait.","x":500,"y":635,"iconType":"lock","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-purple-cover"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-portrait-wall","mapLayerId":"dorian-gray-map-attic","linkedMapLayerId":null,"name":"Portrait Wall","description":"The place where Basil’s canvas hangs behind its purple covering.","x":580,"y":660,"iconType":"image-frame","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-portrait"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-attic-screen","mapLayerId":"dorian-gray-map-attic","linkedMapLayerId":null,"name":"Embroidered Screen","description":"The screen used to obstruct the portrait during its removal and concealment.","x":420,"y":520,"iconType":"view-grid-outline","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-screen"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-attic-cabinet","mapLayerId":"dorian-gray-map-attic","linkedMapLayerId":null,"name":"Cabinet and Chest","description":"Storage for Dorian’s private objects, poisons, and the schoolroom’s remnants.","x":690,"y":470,"iconType":"cabinet","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-cabinet"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-attic-door","mapLayerId":"dorian-gray-map-attic","linkedMapLayerId":null,"name":"Locked Attic Door","description":"The barrier Dorian controls with the schoolroom key.","x":300,"y":650,"iconType":"door-closed-lock","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-attic-key"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-selby-hall","mapLayerId":"dorian-gray-map-selby","linkedMapLayerId":null,"name":"Selby Entrance Hall","description":"The arrival point for Dorian’s country-house guests.","x":640,"y":210,"iconType":"door","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-duchess"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-selby-drawing","mapLayerId":"dorian-gray-map-selby","linkedMapLayerId":null,"name":"Selby Drawing Room","description":"The room of society conversation between Dorian, Lord Henry, and the Duchess.","x":360,"y":455,"iconType":"sofa-outline","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-geoffrey"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-selby-conservatory","mapLayerId":"dorian-gray-map-selby","linkedMapLayerId":null,"name":"Selby Conservatory","description":"The orchid-filled room where Dorian sees James Vane at the window.","x":990,"y":320,"iconType":"greenhouse","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-orchids"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-selby-terrace","mapLayerId":"dorian-gray-map-selby","linkedMapLayerId":null,"name":"Garden Terrace","description":"The threshold between the country house and its wooded grounds.","x":980,"y":125,"iconType":"flower-outline","tags":[],"factionId":null,"imageId":"dorian-gray-image-char-james"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-loc-selby-shooting","mapLayerId":"dorian-gray-map-selby","linkedMapLayerId":null,"name":"Shooting Grounds","description":"The estate coverts where a hare and then James Vane are shot.","x":1130,"y":710,"iconType":"pine-tree","tags":[],"factionId":null,"imageId":"dorian-gray-image-item-revolver"}],"characters":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-dorian","name":"Dorian Gray","aliases":["Prince Charming"],"description":"A beautiful young gentleman whose wish leaves his portrait to bear the visible consequences of age and corruption.","portraitImageId":"dorian-gray-image-char-dorian","color":"#c7a96b","tags":["protagonist","aesthete"],"isAlive":false,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-basil","name":"Basil Hallward","aliases":[],"description":"A serious painter whose devotion to Dorian produces the supernatural portrait and ultimately draws him into Dorian’s secret.","portraitImageId":"dorian-gray-image-char-basil","color":"#6f775b","tags":["artist"],"isAlive":false,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-henry","name":"Lord Henry Wotton","aliases":["Harry"],"description":"A dazzling, paradox-loving aristocrat whose philosophy of sensation shapes Dorian’s self-conception.","portraitImageId":"dorian-gray-image-char-henry","color":"#755b79","tags":["influencer","aristocracy"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-sibyl","name":"Sibyl Vane","aliases":[],"description":"A gifted young actress who loves Dorian as Prince Charming and loses her art when love becomes real.","portraitImageId":"dorian-gray-image-char-sibyl","color":"#b67a8c","tags":["actress"],"isAlive":false,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-james","name":"James Vane","aliases":["Jim"],"description":"Sibyl’s protective sailor brother, driven for years by his oath to avenge her.","portraitImageId":"dorian-gray-image-char-james","color":"#536b78","tags":["sailor","avenger"],"isAlive":false,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-mrs-vane","name":"Mrs Vane","aliases":[],"description":"Sibyl and James’s theatrical, debt-burdened mother, preoccupied with the family’s prospects.","portraitImageId":"dorian-gray-image-char-mrs-vane","color":"#8d6b70","tags":["theatre"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-alan","name":"Alan Campbell","aliases":[],"description":"A scientist and former intimate of Dorian who is coerced into destroying Basil’s body.","portraitImageId":"dorian-gray-image-char-alan","color":"#547064","tags":["chemist"],"isAlive":false,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-agatha","name":"Lady Agatha","aliases":[],"description":"Lord Henry’s philanthropic aunt and hostess of a luncheon that introduces Dorian to a wider social circle.","portraitImageId":"dorian-gray-image-char-agatha","color":"#8f7b65","tags":["aristocracy","philanthropy"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-fermor","name":"Lord Fermor","aliases":["Uncle George"],"description":"Lord Henry’s worldly uncle, a storehouse of family scandal who explains Dorian’s ancestry.","portraitImageId":"dorian-gray-image-char-fermor","color":"#806b52","tags":["aristocracy"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-victoria","name":"Victoria Wotton","aliases":["Lady Henry"],"description":"Lord Henry’s wife, briefly encountered amid music and the fashionable epigrams of their marriage.","portraitImageId":"dorian-gray-image-char-victoria","color":"#937386","tags":["aristocracy"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-duchess","name":"Gladys, Duchess of Monmouth","aliases":[],"description":"A clever society beauty who flirts verbally with Dorian at Selby Royal.","portraitImageId":"dorian-gray-image-char-duchess","color":"#9a6e78","tags":["aristocracy"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-geoffrey","name":"Geoffrey Clouston","aliases":[],"description":"The Duchess of Monmouth’s brother and sportsman whose shot accidentally kills James Vane.","portraitImageId":"dorian-gray-image-char-geoffrey","color":"#6c7353","tags":["sportsman"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-adrian","name":"Adrian Singleton","aliases":[],"description":"A ruined young gentleman encountered in an opium den, evidence of Dorian’s destructive influence.","portraitImageId":"dorian-gray-image-char-adrian","color":"#645f69","tags":["fallen-circle"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-victor","name":"Victor","aliases":[],"description":"Dorian’s valet, watched suspiciously after the portrait is moved to the locked schoolroom.","portraitImageId":"dorian-gray-image-char-victor","color":"#756b60","tags":["servant"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-francis","name":"Francis","aliases":[],"description":"Dorian’s later servant, present during the anxious days at Selby Royal and the final night.","portraitImageId":"dorian-gray-image-char-francis","color":"#7c7063","tags":["servant"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-mrs-leaf","name":"Mrs Leaf","aliases":[],"description":"Dorian’s elderly housekeeper, keeper of household memory and the old schoolroom key.","portraitImageId":"dorian-gray-image-char-mrs-leaf","color":"#8a7668","tags":["servant"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-hetty","name":"Hetty Merton","aliases":[],"description":"A country girl whom Dorian leaves uncorrupted in a late attempt to prove he can reform.","portraitImageId":"dorian-gray-image-char-hetty","color":"#8c9270","tags":["country"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-isaacs","name":"Mr Isaacs","aliases":[],"description":"The Jewish theatre manager who employs Sibyl and holds the Vane family’s debts.","portraitImageId":"dorian-gray-image-char-isaacs","color":"#76644f","tags":["theatre"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-hubbard","name":"Mr Hubbard","aliases":[],"description":"The frame-maker who brings workmen to move the covered portrait into Dorian’s old schoolroom.","portraitImageId":"dorian-gray-image-char-hubbard","color":"#746858","tags":["craftsman"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-opium-woman","name":"The Opium-Den Woman","aliases":[],"description":"A ruined woman whose cry of “Prince Charming” gives James Vane the name he has hunted.","portraitImageId":"dorian-gray-image-char-opium-woman","color":"#755b62","tags":["east-end"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-narborough","name":"Lady Narborough","aliases":[],"description":"A witty society hostess whose dinner Dorian attends immediately after Basil’s murder.","portraitImageId":"dorian-gray-image-char-narborough","color":"#8f6671","tags":["aristocracy"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-brandon","name":"Lady Brandon","aliases":[],"description":"The hostess who introduces Basil to Dorian at a crowded social gathering.","portraitImageId":"dorian-gray-image-char-brandon","color":"#927767","tags":["aristocracy"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-burdon","name":"Sir Thomas Burdon","aliases":[],"description":"A Radical member of Parliament at Lady Agatha’s luncheon.","portraitImageId":"dorian-gray-image-char-burdon","color":"#686d78","tags":["politics"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-erskine","name":"Mr Erskine of Treadley","aliases":[],"description":"An elderly gentleman of letters who listens to Lord Henry’s provocations at luncheon.","portraitImageId":"dorian-gray-image-char-erskine","color":"#71705e","tags":["letters"],"isAlive":true,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-kelso","name":"Lord Kelso","aliases":[],"description":"Dorian’s harsh grandfather, recalled in the story of Margaret Devereux’s marriage.","portraitImageId":"dorian-gray-image-char-kelso","color":"#665b54","tags":["ancestry"],"isAlive":false,"birthDate":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-char-margaret","name":"Margaret Devereux","aliases":["Lady Margaret Devereux"],"description":"Dorian’s beautiful mother, remembered as defying Lord Kelso to marry a penniless officer.","portraitImageId":"dorian-gray-image-char-margaret","color":"#a2767b","tags":["ancestry"],"isAlive":false,"birthDate":null}],"items":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-portrait","name":"The Portrait of Dorian Gray","description":"Basil’s masterpiece, which ages and records Dorian’s cruelty while Dorian remains young.","iconType":"image-frame","imageId":"dorian-gray-image-item-portrait","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-brushes","name":"Basil’s Brushes and Palette","description":"The tools used to complete the portrait in Basil’s studio.","iconType":"palette","imageId":"dorian-gray-image-item-brushes","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-yellow-book","name":"The Yellow Book","description":"Lord Henry’s poisonous French novel, read and imitated by Dorian for years.","iconType":"book-open-variant","imageId":"dorian-gray-image-item-yellow-book","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-mirror","name":"Dorian’s Mirror","description":"A polished mirror in which Dorian compares his unchanged face with the portrait.","iconType":"mirror-rectangle","imageId":"dorian-gray-image-item-mirror","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-playbill","name":"Sibyl’s Playbill","description":"A theatre bill advertising Sibyl’s Shakespearean performances.","iconType":"theater","imageId":"dorian-gray-image-item-playbill","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-letter-sibyl","name":"Letter to Sibyl","description":"Dorian’s remorseful letter asking Sibyl’s forgiveness, written too late.","iconType":"email-seal","imageId":"dorian-gray-image-item-letter-sibyl","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-newspaper","name":"Newspaper Reports","description":"Reports of Sibyl’s death, Dorian’s scandals, Basil’s disappearance, and James’s shooting.","iconType":"newspaper-variant-outline","imageId":"dorian-gray-image-item-newspaper","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-attic-key","name":"Schoolroom Key","description":"The key to the locked room where Dorian hides the portrait.","iconType":"key-variant","imageId":"dorian-gray-image-item-attic-key","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-purple-cover","name":"Purple Satin Coverlet","description":"A rich funerary cloth used to conceal the changing portrait.","iconType":"texture-box","imageId":"dorian-gray-image-item-purple-cover","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-screen","name":"Embroidered Screen","description":"The studio screen and later household barrier used to obstruct sight of the portrait.","iconType":"view-grid-outline","imageId":"dorian-gray-image-item-screen","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-knife","name":"Knife","description":"The weapon Dorian uses first against Basil and finally against the portrait.","iconType":"knife","imageId":"dorian-gray-image-item-knife","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-blackmail-letter","name":"Blackmail Letter","description":"A written threat that forces Alan Campbell to obey Dorian.","iconType":"email-alert-outline","imageId":"dorian-gray-image-item-blackmail-letter","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-chemical-case","name":"Alan’s Chemical Apparatus","description":"A locked case and equipment used to destroy Basil’s remains.","iconType":"test-tube","imageId":"dorian-gray-image-item-chemical-case","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-basil-bag","name":"Basil’s Bag and Coat","description":"Effects left in Dorian’s house after Basil’s murder and later burned.","iconType":"bag-suitcase","imageId":"dorian-gray-image-item-basil-bag","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-revolver","name":"James Vane’s Revolver","description":"The weapon James carries while hunting the man he knows as Prince Charming.","iconType":"pistol","imageId":"dorian-gray-image-item-revolver","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-opium-pipe","name":"Opium Pipe","description":"The instrument of oblivion in the East End den Dorian visits after the murder.","iconType":"smoking-pipe","imageId":"dorian-gray-image-item-opium-pipe","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-orchids","name":"Selby Orchids","description":"Exotic flowers surrounding Dorian’s society performance at Selby Royal.","iconType":"flower-tulip-outline","imageId":"dorian-gray-image-item-orchids","tags":[]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-item-cabinet","name":"Locked Cabinet","description":"A cabinet containing curios, poisons, and private remnants of Dorian’s hidden life.","iconType":"dresser","imageId":"dorian-gray-image-item-cabinet","tags":[]}],"characterSnapshots":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-1-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-1","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-brandon-party","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":1,"statusNotes":"Startled by an attraction that changes his art."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-1-dorian","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-1","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-brandon-party","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":1,"statusNotes":"Newly introduced to the painter who will idealize him."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-1-brandon","characterId":"dorian-gray-char-brandon","eventId":"dorian-gray-event-1","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-brandon-party","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":1,"statusNotes":"Performs the social introduction that binds artist and sitter."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-2-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-2","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":["dorian-gray-item-brushes","dorian-gray-item-portrait"],"inventoryNotes":"","travelModeId":null,"sortKey":2,"statusNotes":"Protective of both the canvas and the private feeling behind it."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-2-henry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-2","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":2,"statusNotes":"Amused, curious, and determined to see the young sitter."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-3-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-3","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3,"statusNotes":"Emotionally exposed and afraid the painting reveals too much of himself."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-3-henry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-3","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":3,"statusNotes":"Listens skeptically while probing Basil’s secret attachment."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-4-dorian","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-4","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":["dorian-gray-item-portrait"],"inventoryNotes":"","travelModeId":null,"sortKey":4,"statusNotes":"Relaxed and unaware that the meeting will redirect his life."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-4-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-4","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4,"statusNotes":"Resigned and anxious as his two worlds meet."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-4-henry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-4","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":4,"statusNotes":"Alert to the opportunity to influence a beautiful, receptive listener."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-5-henry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-5","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":5,"statusNotes":"Deliberately arouses Dorian’s fear of time and appetite for sensation."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-5-dorian","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-5","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":["dorian-gray-item-portrait"],"inventoryNotes":"","travelModeId":null,"sortKey":5,"statusNotes":"Shaken into sudden self-consciousness about the brevity of youth."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-5-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-5","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":["dorian-gray-item-portrait","dorian-gray-item-brushes"],"inventoryNotes":"","travelModeId":null,"sortKey":5,"statusNotes":"Works uneasily while Henry’s words alter the meaning of the portrait."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-6-dorian","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-6","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":["dorian-gray-item-portrait"],"inventoryNotes":"","travelModeId":null,"sortKey":6,"statusNotes":"Desperate to preserve his beauty and willing to sacrifice anything for it."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-6-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-6","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6,"statusNotes":"Hurt that Dorian values youth above the friendship embodied in the work."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-6-henry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-6","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":6,"statusNotes":"Observes the emotional victory of his doctrine with fascination."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-7-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-7","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":["dorian-gray-item-portrait"],"inventoryNotes":"","travelModeId":null,"sortKey":7,"statusNotes":"Surrenders his greatest work to the person who inspired it."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-7-dorian","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-7","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":["dorian-gray-item-portrait"],"inventoryNotes":"","travelModeId":null,"sortKey":7,"statusNotes":"Claims the image as the beautiful double against which he will measure himself."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-8-dorian","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-8","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":8,"statusNotes":"Eager for the world Henry promises and already resistant to Basil’s restraint."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-8-henry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-8","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":8,"statusNotes":"Triumphant but outwardly casual as Dorian follows him."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-8-basil","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-8","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-basil-studio","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":8,"statusNotes":"Left behind, fearful that Henry will dominate Dorian."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-9-henry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-9","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-club","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":9,"statusNotes":"Treats Dorian’s history as useful material for understanding and influence."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-9-fermor","characterId":"dorian-gray-char-fermor","eventId":"dorian-gray-event-9","isAlive":true,"currentLocationMarkerId":"dorian-gray-loc-club","currentMapLayerId":"dorian-gray-map-london","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":9,"statusNotes":"Recalls old scandals with cynical precision."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-snapshot-10-henry","characterId":"dorian-gray-char-he