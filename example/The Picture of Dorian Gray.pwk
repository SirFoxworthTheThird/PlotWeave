ub","involvedCharacterIds":["dorian-gray-char-dorian","dorian-gray-char-henry"],"mentionedCharacterIds":[],"involvedItemIds":[],"tags":["chapter-15"],"threadIds":["dorian-gray-thread-murder","dorian-gray-thread-influence","dorian-gray-thread-double-life"],"motifIds":["dorian-gray-motif-theatre"],"sortOrder":1,"travelDays":0,"inWorldTime":6585,"tension":4,"structureBeat":"bad_guys_close_in","status":"final","povCharacterId":"dorian-gray-char-henry","isFlashback":false},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-event-60","chapterId":"dorian-gray-chapter-15","timelineId":"dorian-gray-timeline-main","title":"Dorian Opens the Locked Cabinet","description":"At home, Dorian takes a small box from his cabinet and prepares for an East End journey.","locationMarkerId":"dorian-gray-loc-attic-cabinet","involvedCharacterIds":["dorian-gray-char-dorian","dorian-gray-char-francis"],"mentionedCharacterIds":[],"involvedItemIds":["dorian-gray-item-cabinet","dorian-gray-item-opium-pipe"],"tags":["chapter-15"],"threadIds":["dorian-gray-thread-double-life","dorian-gray-thread-murder"],"motifIds":["dorian-gray-motif-doors"],"sortOrder":2,"travelDays":0,"inWorldTime":6585,"tension":4,"structureBeat":"bad_guys_close_in","status":"final","povCharacterId":"dorian-gray-char-dorian","isFlashback":false},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-event-61","chapterId":"dorian-gray-chapter-15","timelineId":"dorian-gray-timeline-main","title":"The Carriage Turns East","description":"Dorian orders a cab toward the river and the opium dens as London’s respectable streets disappear into fog.","locationMarkerId":"dorian-gray-loc-soho-portal","involvedCharacterIds":["dorian-gray-char-dorian"],"mentionedCharacterIds":[],"involvedItemIds":["dorian-gray-item-opium-pipe"],"tags":["chapter-15"],"threadIds":["dorian-gray-thread-double-life","dorian-gray-thread-murder"],"motifIds":["dorian-gray