{"version":7,"type":"world-export","exportedAt":1785528000000,"world":{"id":"dorian-gray-world","name":"The Picture of Dorian Gray","description":"A beautiful young man wishes that Basil Hallward’s portrait will age in his place. Under Lord Henry Wotton’s influence, Dorian pursues sensation while the hidden canvas records cruelty, scandal, murder, and time, until his attempt to destroy the evidence makes the truth visible.","coverImageId":"dorian-gray-image-cover","theme":"theme-horror","createdAt":1785528000000,"updatedAt":1785528000000,"continuityStaleThreshold":5,"calendar":{"startYear":1873,"yearSuffix":" (editorial reconstruction)","months":[{"name":"January","days":31},{"name":"February","days":28},{"name":"March","days":31},{"name":"April","days":30},{"name":"May","days":31},{"name":"June","days":30},{"name":"July","days":31},{"name":"August","days":31},{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]},"wordTarget":null},"mapLayers":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-map-britain","parentMapId":null,"name":"Britain in the Late Nineteenth Century","description":"The story’s movement between metropolitan London and Dorian’s fictional country estate, Selby Royal.","imageId":"dorian-gray-image-map-britain","imageWidth":960,"imageHeight":1483,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-map-london","parentMapId":"dorian-gray-map-britain","name":"Victorian London, c. 1890","description":"Mayfair drawing rooms, artists’ studios, theatres, clubs, railway stations, and the East End passages of Dorian’s double life.","imageId":"dorian-gray-image-map-london","imageWidth":1280,"imageHeight":981,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-map-soho","parentMapId":"dorian-gray-map-london","name":"Soho and the West Central District","description":"The poorer theatrical streets, shadowed approaches, and opium-bound route through Dorian’s nocturnal London.","imageId":"dorian-gray-image-map-soho","imageWidth":1280,"imageHeight":1051,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-map-house","parentMapId":"dorian-gray-map-london","name":"Dorian Gray’s London House","description":"A representative 1880 London house plan for Dorian’s library, drawing room, dining room, and the staircase to the locked upper floor.","imageId":"dorian-gray-image-map-house","imageWidth":960,"imageHeight":1013,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-map-attic","parentMapId":"dorian-gray-map-house","name":"Locked Schoolroom and Attic","description":"A historic upper-floor plan used for the abandoned schoolroom where the portrait, screen, and incriminating remnants are concealed.","imageId":"dorian-gray-image-map-attic","imageWidth":960,"imageHeight":1235,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-map-selby","parentMapId":"dorian-gray-map-britain","name":"Selby Royal and Grounds","description":"A grand country-house plan used for the drawing room, conservatory, terrace, and shooting-party approaches at Dorian’s estate.","imageId":"dorian-gray-image-map-selby","imageWidth":1280,"imageHeight":848,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":