rect/file/Wilde%20-%20Le%20portrait%20de%20Dorian%20Gray%20(trad.%20Jaloux)%2C%201928%20-%20image-203.jpg?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-knife","worldId":"dorian-gray-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Wilde%20-%20Le%20portrait%20de%20Dorian%20Gray%20(trad.%20Jaloux)%2C%201928%20-%20image-361.jpg?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-blackmail-letter","worldId":"dorian-gray-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Wilde%20-%20Le%20portrait%20de%20Dorian%20Gray%20(trad.%20Jaloux)%2C%201928%20-%20image-271.jpg?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-chemical-case","worldId":"dorian-gray-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Wilde%20-%20Le%20portrait%20de%20Dorian%20Gray%20(trad.%20Jaloux)%2C%201928%20-%20image-271.jpg?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-basil-bag","worldId":"dorian-gray-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Wilde%20-%20Le%20portrait%20de%20Dorian%20Gray%20(trad.%20Jaloux)%2C%201928%20-%20image-247.jpg?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-revolver","worldId":"dorian-gray-world","mimeType":"image/png","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Engraving%20Portrait%20of%20Dorian%20Gray%20by%20F.%20Sim%C3%A9on%201922.png?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-opium-pipe","worldId":"dorian-gray-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/The%20end%20of%20opium-smoking.jpg?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-orchids","worldId":"dorian-gray-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Wilde%20-%20Le%20portrait%20de%20Dorian%20Gray%20(trad.%20Jaloux)%2C%201928%20-%20image-319.jpg?width=960","createdAt":1785528000000},{"id":"dorian-gray-image-item-cabinet","worldId":"dorian-gray-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Wilde%20-%20Le%20portrait%20de%20Dorian%20Gray%20(trad.%20Jaloux)%2C%201928%20-%20image-217.jpg?width=960","createdAt":1785528000000}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-route-london-life","mapLayerId":"dorian-gray-map-london","name":"Dorian’s Public London","routeType":"carriage","waypoints":["dorian-gray-loc-basil-studio","dorian-gray-loc-agatha-house","dorian-gray-loc-henry-house","dorian-gray-loc-dorian-portal","dorian-gray-loc-club","dorian-gray-loc-theatre"],"color":"#8b6a78","notes":"The fashionable circuit linking art, influence, society, and Sibyl’s theatre."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-route-hidden-london","mapLayerId":"dorian-gray-map-london","name":"The Hidden London Route","routeType":"carriage","waypoints":["dorian-gray-loc-dorian-portal","dorian-gray-loc-soho-portal","dorian-gray-loc-victoria-station"],"color":"#53666f","notes":"The eastward route toward opium, pursuit, and attempts to escape evidence."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-route-house-secret","mapLayerId":"dorian-gray-map-house","name":"Route to the Portrait","routeType":"walk","waypoints":["dorian-gray-loc-house-hall","dorian-gray-loc-house-library","dorian-gray-loc-attic-portal"],"color":"#765368","notes":"The movement from respectable rooms to the locked upper floor."}],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"dorian-gray-lore-category-art","worldId":"dorian-gray-world","name":"Art and Aestheticism","color":"#9a744f","sortOrder":1},{"id":"dorian-gray-lore-category-identity","worldId":"dorian-gray-world","name":"Identity and the Double Life","color":"#74566c","sortOrder":2},{"id":"dorian-gray-lore-category-society","worldId":"dorian-gray-world","name":"Victorian Society and Reputation","color":"#7d6d5b","sortOrder":3},{"id":"dorian-gray-lore-category-objects","worldId":"dorian-gray-world","name":"Objects of Influence","color":"#a28745","sortOrder":4},{"id":"dorian-gray-lore-category-sources","worldId":"dorian-gray-world","name":"Edition, Calendar, and Sources","color":"#657580","sortOrder":5}],"lorePages":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-1","categoryId":"dorian-gray-lore-category-art","title":"The Portrait as Moral Record","body":"The portrait is both Basil’s highest artistic achievement and the material record of Dorian’s aging, cruelty, blood guilt, and self-deception. Its supernatural exchange is confirmed only after Dorian rejects Sibyl and sees the painted mouth change.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-2","categoryId":"dorian-gray-lore-category-art","title":"Basil’s Theory of Artistic Exposure","body":"Basil initially refuses exhibition because he believes the portrait discloses too much of his feeling for Dorian. The supernatural secret later reverses this fear: the work exposes the sitter rather than the painter.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-3","categoryId":"dorian-gray-lore-category-art","title":"Sibyl Vane and the End of Acting","body":"Sibyl’s art depends on believing theatrical passion. Real love makes imitation seem empty, so her emotional awakening destroys the talent Dorian mistakes for her identity.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-4","categoryId":"dorian-gray-lore-category-identity","title":"Dorian’s Unchanging Face","body":"Dorian’s body remains visibly young for nearly eighteen years. Society reads innocence from his face, James mistakes youth for an alibi, and the portrait stores the appearance time and conduct would otherwise produce.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-5","categoryId":"dorian-gray-lore-category-identity","title":"Prince Charming","body":"Sibyl’s name for Dorian survives her death. Because James knows no other name, the theatrical identity becomes both Dorian’s protection and the clue that allows vengeance to find him.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-6","categoryId":"dorian-gray-lore-category-identity","title":"The Locked Schoolroom","body":"Dorian’s former schoolroom joins childhood memory to adult concealment. The portrait, Basil’s body, chemical destruction, and the final reversal all occupy the room he alone can unlock.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-7","categoryId":"dorian-gray-lore-category-society","title":"Reputation Without Evidence","body":"Dorian’s acquaintances accumulate stories of ruined lives, but beauty, rank, and hospitality prevent rumour from becoming proof. Basil’s demand to see Dorian’s soul literalizes society’s impossible evidentiary standard.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-8","categoryId":"dorian-gray-lore-category-society","title":"The Vane Family and Economic Precarity","body":"Sibyl’s theatre work supports a household burdened by debt to Isaacs. James’s departure for Australia and Mrs Vane’s hope for a wealthy marriage contrast sharply with Dorian’s inherited freedom.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-9","categoryId":"dorian-gray-lore-category-objects","title":"The Yellow Book","body":"Lord Henry’s unnamed French novel becomes Dorian’s script for a life of cultivated sensation. Dorian acquires copies in different colours and interprets its protagonist as a prefiguration of himself.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-10","categoryId":"dorian-gray-lore-category-objects","title":"Mirrors, Keys, and Coverings","body":"The mirror enables comparison, the key controls access, and the purple coverlet hides the canvas. These objects do not erase truth; they regulate who can encounter it.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-11","categoryId":"dorian-gray-lore-category-sources","title":"Reading Order and Calendar","body":"The calendar is an editorial reconstruction for the expanded twenty-chapter 1891 version. It begins in 1873, preserves the early summer sequence, models Chapter XI as a long passage of nearly eighteen years, and ends around Dorian’s thirty-eighth birthday. Exact dates are not supplied by the novel.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-lore-12","categoryId":"dorian-gray-lore-category-sources","title":"Linked Historical Maps and Artwork","body":"The linked maps are public-domain historical maps or architectural plans used to represent fictional and unnamed settings. Character artwork links to public-domain book engravings and illustrations rather than photographs.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null}],"factions":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-aesthetic","name":"The Aesthetic Circle","description":"Basil, Lord Henry, and Dorian’s unstable network of art, influence, admiration, and rivalry.","color":"#785a72","coverImageId":null,"tags":["art"]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-vanes","name":"The Vane Household and Theatre","description":"Sibyl’s family and the precarious theatrical economy surrounding Mr Isaacs.","color":"#9a6273","coverImageId":null,"tags":["theatre"]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-society","name":"Fashionable London Society","description":"The titled hosts, clubs, dinners, and country-house guests who sustain reputation through performance.","color":"#8b755c","coverImageId":null,"tags":["society"]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-household","name":"Dorian Gray’s Household","description":"The servants and craftsmen who maintain Dorian’s respectable residence without access to its full secret.","color":"#70665b","coverImageId":null,"tags":["servants"]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-east-end","name":"The Fallen East End Circle","description":"People damaged by vice and reputation in Dorian’s nocturnal London.","color":"#59636b","coverImageId":null,"tags":["east-end"]},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-selby","name":"The Selby Royal Party","description":"Dorian’s country guests, assembled when private vengeance reaches the estate.","color":"#6e7657","coverImageId":null,"tags":["country-house"]}],"factionMemberships":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-1","factionId":"dorian-gray-faction-aesthetic","characterId":"dorian-gray-char-basil","role":"Painter","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-2","factionId":"dorian-gray-faction-aesthetic","characterId":"dorian-gray-char-henry","role":"Philosopher and influencer","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-3","factionId":"dorian-gray-faction-aesthetic","characterId":"dorian-gray-char-dorian","role":"Muse and experiment","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-4","factionId":"dorian-gray-faction-vanes","characterId":"dorian-gray-char-sibyl","role":"Actress","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-5","factionId":"dorian-gray-faction-vanes","characterId":"dorian-gray-char-james","role":"Protective brother","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-6","factionId":"dorian-gray-faction-vanes","characterId":"dorian-gray-char-mrs-vane","role":"Mother and former actress","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-7","factionId":"dorian-gray-faction-vanes","characterId":"dorian-gray-char-isaacs","role":"Manager and creditor","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-8","factionId":"dorian-gray-faction-society","characterId":"dorian-gray-char-henry","role":"Aristocratic wit","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-9","factionId":"dorian-gray-faction-society","characterId":"dorian-gray-char-agatha","role":"Hostess","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-10","factionId":"dorian-gray-faction-society","characterId":"dorian-gray-char-narborough","role":"Hostess","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-11","factionId":"dorian-gray-faction-society","characterId":"dorian-gray-char-brandon","role":"Hostess","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-12","factionId":"dorian-gray-faction-society","characterId":"dorian-gray-char-duchess","role":"Society beauty","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-13","factionId":"dorian-gray-faction-society","characterId":"dorian-gray-char-dorian","role":"Fashionable host","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-14","factionId":"dorian-gray-faction-household","characterId":"dorian-gray-char-victor","role":"Valet","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-15","factionId":"dorian-gray-faction-household","characterId":"dorian-gray-char-francis","role":"Servant","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-16","factionId":"dorian-gray-faction-household","characterId":"dorian-gray-char-mrs-leaf","role":"Housekeeper","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-17","factionId":"dorian-gray-faction-household","characterId":"dorian-gray-char-hubbard","role":"Contracted frame-maker","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-18","factionId":"dorian-gray-faction-east-end","characterId":"dorian-gray-char-adrian","role":"Ruined gentleman","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-19","factionId":"dorian-gray-faction-east-end","characterId":"dorian-gray-char-opium-woman","role":"Den habitué","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-20","factionId":"dorian-gray-faction-selby","characterId":"dorian-gray-char-dorian","role":"Host","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-21","factionId":"dorian-gray-faction-selby","characterId":"dorian-gray-char-henry","role":"Guest","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-22","factionId":"dorian-gray-faction-selby","characterId":"dorian-gray-char-duchess","role":"Guest","startEventId":null,"endEventId":null,"notes":""},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-membership-23","factionId":"dorian-gray-faction-selby","characterId":"dorian-gray-char-geoffrey","role":"Guest and sportsman","startEventId":null,"endEventId":null,"notes":""}],"factionRelationships":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-rel-1","factionAId":"dorian-gray-faction-aesthetic","factionBId":"dorian-gray-faction-society","stance":"allied","notes":"Artistic celebrity and aristocratic society continually reinforce one another."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-rel-2","factionAId":"dorian-gray-faction-vanes","factionBId":"dorian-gray-faction-society","stance":"hostile","notes":"Economic and class inequality makes Sibyl vulnerable to Dorian’s aesthetic consumption."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-rel-3","factionAId":"dorian-gray-faction-household","factionBId":"dorian-gray-faction-east-end","stance":"neutral","notes":"The household maintains the respectable exterior while the East End contains consequences kept outside it."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-faction-rel-4","factionAId":"dorian-gray-faction-selby","factionBId":"dorian-gray-faction-east-end","stance":"hostile","notes":"James carries the unresolved East End history into Dorian’s protected country-house world."}],"knowledgeFacts":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-basil-devotion","title":"Basil’s art is transformed by Dorian","description":"Basil’s attachment to Dorian is the private force behind the portrait.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-3","originEventId":"dorian-gray-event-3"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-dorian-ancestry","title":"Dorian inherits a violent family history","description":"Margaret Devereux defied Lord Kelso; her husband died violently and Dorian became Kelso’s heir.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-10","originEventId":"dorian-gray-event-10"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-wish-works","title":"The portrait receives Dorian’s moral change","description":"The wish becomes observable when cruelty appears on the painted mouth.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-28","originEventId":"dorian-gray-event-6"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-engagement","title":"Dorian is engaged to Sibyl","description":"Dorian announces that he intends to marry the actress he calls a genius.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-16","originEventId":"dorian-gray-event-15"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-james-oath","title":"James vows to avenge Sibyl","description":"James will kill the man known as Prince Charming if Sibyl is harmed.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-20","originEventId":"dorian-gray-event-20"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-sibyl-dead","title":"Sibyl Vane is dead","description":"Sibyl poisons herself after Dorian rejects her.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-31","originEventId":"dorian-gray-event-31"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-portrait-hidden","title":"The portrait is locked in the schoolroom","description":"Dorian alone controls access to the changing canvas.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-39","originEventId":"dorian-gray-event-39"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-portrait-truth","title":"The portrait visibly records Dorian’s corrupted soul","description":"Basil confirms that the monstrous canvas is the work he painted.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-49","originEventId":"dorian-gray-event-28"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-basil-murder","title":"Dorian murdered Basil","description":"Dorian kills Basil beside the portrait and locks the body upstairs.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-51","originEventId":"dorian-gray-event-51"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-body-erased","title":"Alan Campbell destroyed Basil’s remains","description":"Chemistry removes the physical body under blackmail.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-56","originEventId":"dorian-gray-event-56"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-prince-identity","title":"Prince Charming is Dorian Gray","description":"The opium-den woman’s testimony overcomes the false alibi of Dorian’s youth.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-66","originEventId":"dorian-gray-event-63"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-james-dead","title":"James Vane is dead","description":"Geoffrey’s accidental shot kills the pursuer at Selby Royal.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-74","originEventId":"dorian-gray-event-73"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-reform-fails","title":"The portrait records hypocrisy rather than reform","description":"Dorian’s treatment of Hetty was vanity, not moral change.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-80","originEventId":"dorian-gray-event-75"},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-fact-final-reversal","title":"Dorian’s true age returns to his body","description":"Destroying the portrait restores the canvas and exposes Dorian as the aged dead man.","tags":[],"readerLearnsAtEventId":"dorian-gray-event-83","originEventId":"dorian-gray-event-82"}],"knowledgeReveals":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-1","factId":"dorian-gray-fact-basil-devotion","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-3","note":"Learns or confirms this fact during “Basil Explains His Devotion”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-2","factId":"dorian-gray-fact-dorian-ancestry","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-10","note":"Learns or confirms this fact during “The Devereux Tragedy”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-3","factId":"dorian-gray-fact-wish-works","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-28","note":"Learns or confirms this fact during “Cruelty Appears on the Portrait”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-4","factId":"dorian-gray-fact-engagement","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-16","note":"Learns or confirms this fact during “The Engagement Announced”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-5","factId":"dorian-gray-fact-engagement","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-16","note":"Learns or confirms this fact during “The Engagement Announced”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-6","factId":"dorian-gray-fact-james-oath","characterId":"dorian-gray-char-sibyl","eventId":"dorian-gray-event-20","note":"Learns or confirms this fact during “The Avenger’s Oath”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-7","factId":"dorian-gray-fact-james-oath","characterId":"dorian-gray-char-mrs-vane","eventId":"dorian-gray-event-20","note":"Learns or confirms this fact during “The Avenger’s Oath”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-8","factId":"dorian-gray-fact-sibyl-dead","characterId":"dorian-gray-char-henry","eventId":"dorian-gray-event-31","note":"Learns or confirms this fact during “Lord Henry Reports Sibyl’s Death”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-9","factId":"dorian-gray-fact-sibyl-dead","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-31","note":"Learns or confirms this fact during “Lord Henry Reports Sibyl’s Death”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-10","factId":"dorian-gray-fact-sibyl-dead","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-33","note":"Learns or confirms this fact during “Basil Comes to Mourn”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-11","factId":"dorian-gray-fact-portrait-hidden","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-39","note":"Learns or confirms this fact during “The Portrait Is Locked Away”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-12","factId":"dorian-gray-fact-portrait-truth","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-28","note":"Learns or confirms this fact during “Cruelty Appears on the Portrait”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-13","factId":"dorian-gray-fact-portrait-truth","characterId":"dorian-gray-char-basil","eventId":"dorian-gray-event-49","note":"Learns or confirms this fact during “Basil Sees the Corrupted Portrait”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-14","factId":"dorian-gray-fact-basil-murder","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-51","note":"Learns or confirms this fact during “Dorian Murders Basil”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-15","factId":"dorian-gray-fact-body-erased","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-56","note":"Learns or confirms this fact during “Chemistry Erases Basil’s Body”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-16","factId":"dorian-gray-fact-body-erased","characterId":"dorian-gray-char-alan","eventId":"dorian-gray-event-56","note":"Learns or confirms this fact during “Chemistry Erases Basil’s Body”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-17","factId":"dorian-gray-fact-prince-identity","characterId":"dorian-gray-char-james","eventId":"dorian-gray-event-66","note":"Learns or confirms this fact during “The Woman Corrects James”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-18","factId":"dorian-gray-fact-james-dead","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-74","note":"Learns or confirms this fact during “The Dead Man Is James Vane”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-19","factId":"dorian-gray-fact-james-dead","characterId":"dorian-gray-char-geoffrey","eventId":"dorian-gray-event-74","note":"Learns or confirms this fact during “The Dead Man Is James Vane”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-20","factId":"dorian-gray-fact-reform-fails","characterId":"dorian-gray-char-dorian","eventId":"dorian-gray-event-80","note":"Learns or confirms this fact during “Hypocrisy Appears on the Portrait”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-21","factId":"dorian-gray-fact-final-reversal","characterId":"dorian-gray-char-francis","eventId":"dorian-gray-event-83","note":"Learns or confirms this fact during “The Portrait Is Restored”."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-reveal-22","factId":"dorian-gray-fact-final-reversal","characterId":"dorian-gray-char-victor","eventId":"dorian-gray-event-83","note":"Learns or confirms this fact during “The Portrait Is Restored”."}],"characterGoals":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-1","characterId":"dorian-gray-char-dorian","startEventId":"dorian-gray-event-4","endEventId":"dorian-gray-event-83","type":"want","text":"Preserve youth and beauty while experiencing life without visible consequence."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-2","characterId":"dorian-gray-char-dorian","startEventId":"dorian-gray-event-28","endEventId":"dorian-gray-event-83","type":"fear","text":"Prevent anyone from seeing the portrait or proving the life it records."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-3","characterId":"dorian-gray-char-dorian","startEventId":"dorian-gray-event-29","endEventId":"dorian-gray-event-83","type":"need","text":"Accept responsibility rather than treating remorse, beauty, and other people as aesthetic evidence."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-4","characterId":"dorian-gray-char-basil","startEventId":"dorian-gray-event-2","endEventId":"dorian-gray-event-51","type":"want","text":"Protect Dorian and preserve the moral truth he believes beauty should express."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-5","characterId":"dorian-gray-char-henry","startEventId":"dorian-gray-event-4","endEventId":null,"type":"want","text":"Observe how completely ideas and sensation can shape Dorian’s life."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-6","characterId":"dorian-gray-char-sibyl","startEventId":"dorian-gray-event-15","endEventId":"dorian-gray-event-27","type":"want","text":"Build a real life with the man she knows as Prince Charming."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-7","characterId":"dorian-gray-char-james","startEventId":"dorian-gray-event-18","endEventId":"dorian-gray-event-73","type":"want","text":"Protect Sibyl and avenge her by finding Prince Charming."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-8","characterId":"dorian-gray-char-alan","startEventId":"dorian-gray-event-53","endEventId":"dorian-gray-event-56","type":"fear","text":"Keep the private secret Dorian threatens to expose."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-9","characterId":"dorian-gray-char-basil","startEventId":"dorian-gray-event-33","endEventId":"dorian-gray-event-51","type":"fear","text":"Discover that the rumours about Dorian reveal genuine moral ruin."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-goal-10","characterId":"dorian-gray-char-dorian","startEventId":"dorian-gray-event-76","endEventId":"dorian-gray-event-80","type":"want","text":"Prove that sparing Hetty has begun a genuine reform."}],"sceneTexts":[],"plotThreads":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-portrait","name":"The Living Portrait","color":"#7d4d52","description":"The canvas receives age, cruelty, and guilt while Dorian’s face remains young."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-influence","name":"Lord Henry’s Influence","color":"#72577c","description":"Lord Henry’s epigrams and the yellow book teach Dorian to treat life as an aesthetic experiment."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-sibyl","name":"Sibyl Vane and the Cost of Art","color":"#a65f79","description":"Dorian loves Sibyl’s performances, rejects her when love destroys the illusion, and lives after her death."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-james","name":"James Vane’s Vengeance","color":"#516977","description":"James’s promise to kill Prince Charming survives eighteen years and follows Dorian from the docks to Selby."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-basil","name":"Basil’s Conscience","color":"#65705a","description":"Basil’s love, art, warnings, and demand to see Dorian’s soul lead to the attic."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-double-life","name":"The Double Life","color":"#5f5965","description":"Unaging beauty protects Dorian’s social identity while hidden rooms and East End nights accumulate corruption."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-scandal","name":"Rumour and Reputation","color":"#836c59","description":"Society suspects Dorian yet continues to receive him because his face appears innocent."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-murder","name":"Basil’s Murder and Disposal","color":"#823e40","description":"Murder creates a practical chain of concealment, coercion, chemical destruction, and incriminating remnants."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-reform","name":"The Failed Reform","color":"#75805c","description":"Dorian mistakes one spared victim for moral change, but the portrait records vanity and hypocrisy."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-ancestry","name":"Dorian’s Inheritance","color":"#8c6d67","description":"The beauty, violence, wealth, and secrecy of Dorian’s family history shape his freedom and isolation."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-art-life","name":"Art, Beauty, and Life","color":"#9a744f","description":"The novel tests whether art can be separated from the artist, spectator, and moral consequence."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-thread-time","name":"Youth Against Time","color":"#6c7885","description":"Dorian’s fixed appearance hides nearly eighteen years of change from every observer except the portrait."}],"motifs":[{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-flowers","name":"Flowers, Perfume, and Decay","color":"#8b6b82","description":"Sensuous flowers and fragrances accompany beauty while corruption remains concealed."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-mirrors","name":"Mirrors and Reflections","color":"#71808a","description":"Mirrors separate the face society sees from the truth stored in the portrait."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-theatre","name":"Theatre and Performance","color":"#9a5b66","description":"Acting, social wit, and manufactured innocence turn identity into performance."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-books","name":"Books and Influence","color":"#ad8b3f","description":"Texts preserve ideas and offer Dorian scripts for sensation, evasion, and self-interpretation."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-doors","name":"Locked Doors and Keys","color":"#65594e","description":"Control of doors and keys separates public rooms from the material evidence of guilt."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-fog","name":"Fog and Nocturnal London","color":"#68737a","description":"Fog erases boundaries between fashionable streets and the city’s hidden economies."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-music","name":"Music and the Cultivated Senses","color":"#6c6082","description":"Music accompanies seduction, collection, distraction, and the substitution of sensation for conscience."},{"worldId":"dorian-gray-world","createdAt":1785528000000,"updatedAt":1785528000000,"id":"dorian-gray-motif-hands","name":"Hands, Blood, and Material Evidence","color":"#87494c","description":"Hands create art, commit violence, handle evidence, and finally reveal Dorian’s true age."}],"continuitySuppressions":[],"writingLogs":[],"sceneRevisions":[]}