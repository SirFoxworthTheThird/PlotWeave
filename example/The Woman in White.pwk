      "timelineId": "woman-in-white-timeline-main",
      "number": 60,
      "title": "Conclusion I: Laura’s Identity Restored",
      "summary": "Fosco’s confession and the corrected chronology allow Laura’s name to be restored publicly at Limmeridge.",
      "status": "final",
      "targetWordCount": null
    },
    {
