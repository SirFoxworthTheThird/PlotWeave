  "characters": [
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-character-walter",
      "name": "Walter Hartright",
      "aliases": [],
      "description": "A young drawing master whose chance meeting with Anne Catherick draws him into the Fairlie family’s secret and makes him the case’s patient investigator.",
      "portraitImageId": "woman-in-white-image-polo-02",
      "color": "#596b72",
      "tags": [],
      "isAlive": true,
      "birthDate": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-character-laura",
      "name": "Laura Fairlie",
      "aliases": [
        "Lady Glyde"
      ],
      "description": "The gentle heiress of Limmeridge, bound by a promise to marry Sir Percival despite loving Walter and relying deeply on Marian.",
      "portraitImageId": "woman-in-white-image-polo-09",
      "color": "#596b72",
      "tags": [],
      "isAlive": true,
      "birthDate": null
    },
