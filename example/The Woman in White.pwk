  "lorePages": [
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-lore-testimony",
      "categoryId": "woman-in-white-lore-category-form",
      "title": "A Novel Made of Testimony",
      "body": "The story presents itself as a case assembled from narrators who record only what they witnessed or can document. Changes of voice do not create separate timelines; they add evidence to one chronology.",
      "tags": [],
      "coverImageId": "woman-in-white-image-polo-05",
      "linkedEntityIds": [
        "woman-in-white-character-walter",
        "woman-in-white-character-marian",
        "woman-in-white-character-gilmore"
      ],
      "visibleFromEventId": "woman-in-white-event-walter-1"
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-lore-coverture",
      "categoryId": "woman-in-white-lore-category-law",
      "title": "Marriage, Property, and Authority",
      "body": "Laura’s vulnerability is shaped by nineteenth-century marriage and property arrangements. The settlement negotiations make money, guardianship, and legal personhood part of the suspense.",
      "tags": [],
      "coverImageId": "woman-in-white-image-polo-15",
      "linkedEntityIds": [
        "woman-in-white-character-laura",
        "woman-in-white-thread-inheritance"
      ],
      "visibleFromEventId": "woman-in-white-event-gilmore-2"
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-lore-asylum-law",
      "categoryId": "woman-in-white-lore-category-law",
      "title": "Private Confinement and Identity",
      "body": "The asylum plot depends on institutional records and the credibility granted to male relatives over a distressed woman’s own account.",
      "tags": [],
      "coverImageId": "woman-in-white-image-polo-22",
      "linkedEntityIds": [
        "woman-in-white-location-asylum",
        "woman-in-white-thread-identity"
      ],
      "visibleFromEventId": "woman-in-white-event-walter-5"
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-lore-limmeridge",
      "categoryId": "woman-in-white-lore-category-setting",
      "title": "Limmeridge and Family Memory",
      "body": "Limmeridge joins house, village, school, and churchyard into a landscape shaped by Mrs Fairlie’s memory and the unequal childhoods of Laura and Anne.",
      "tags": [],
      "coverImageId": "woman-in-white-image-polo-29",
      "linkedEntityIds": [
        "woman-in-white-location-cumberland-gate",
        "woman-in-white-character-laura",
        "woman-in-white-character-anne"
      ],
      "visibleFromEventId": "woman-in-white-event-walter-8"
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-lore-blackwater",
      "categoryId": "woman-in-white-lore-category-setting",
      "title": "Blackwater Park",
      "body": "The neglected Hampshire estate reflects financial pressure and domestic control: rooms are closed, servants dismissed, and routes managed as the conspiracy advances.",
      "tags": [],
      "coverImageId": "woman-in-white-image-polo-38",
      "linkedEntityIds": [
        "woman-in-white-location-hampshire-gate",
        "woman-in-white-character-percival"
      ],
      "visibleFromEventId": "woman-in-white-event-blackwater-1"
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-lore-sources",
      "categoryId": "woman-in-white-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "Structure and chronology follow Wilkie Collins’s public-domain novel and a scholarly chronology. Linked illustrations come from the 1875 Polo edition and Thomas Eyre Macklin; map layers are historical editorial aids, not exact plans of fictional estates.",
      "tags": [],
      "coverImageId": "woman-in-white-image-polo-46",
      "linkedEntityIds": [],
      "visibleFromEventId": "woman-in-white-event-walter-1"
    }
  ],
