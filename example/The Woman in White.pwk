      "id": "woman-in-white-character-marian",
      "name": "Marian Halcombe",
      "aliases": [],
      "description": "Laura’s intelligent and resolute half-sister, whose diary, courage, and vigilance make her the strongest early opponent of the conspiracy.",
      "portraitImageId": "woman-in-white-image-polo-20",
      "color": "#596b72",
      "tags": [],
      "isAlive": true,
