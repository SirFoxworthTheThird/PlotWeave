      "id": "woman-in-white-chapter-01",
      "timelineId": "woman-in-white-timeline-main",
      "number": 1,
      "title": "First Epoch — Walter I: A Case Outside the Law",
      "summary": "Walter frames the following documents as testimony assembled for a wrong that ordinary legal process could not repair.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-02",
      "timelineId": "woman-in-white-timeline-main",
      "number": 2,
      "title": "Walter II: The Last Day of July",
      "summary": "On the last day of July 1849, Walter returns from Hampstead toward London after visiting his mother and sister.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-03",
      "timelineId": "woman-in-white-timeline-main",
      "number": 3,
      "title": "Walter III: Pesca’s Proposal",
      "summary": "Professor Pesca brings Walter an offer to teach drawing to two young women at Limmeridge House.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-04",
      "timelineId": "woman-in-white-timeline-main",
      "number": 4,
      "title": "Walter IV: The Woman on Finchley Road",
      "summary": "Walking home by moonlight, Walter meets a frightened woman in white and helps her find a cab into London.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-05",
      "timelineId": "woman-in-white-timeline-main",
      "number": 5,
      "title": "Walter V: Escape from the Asylum",
      "summary": "Men searching the road reveal that the woman Walter assisted has escaped from a private asylum.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-06",
      "timelineId": "woman-in-white-timeline-main",
      "number": 6,
      "title": "Walter VI: Arrival at Limmeridge",
      "summary": "Walter travels north and is welcomed at Limmeridge by Marian Halcombe.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-07",
      "timelineId": "woman-in-white-timeline-main",
      "number": 7,
      "title": "Walter VII: Mr Fairlie’s Drawings",
      "summary": "Frederick Fairlie interviews Walter amid his collections and carefully managed invalid comforts.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-08",
      "timelineId": "woman-in-white-timeline-main",
      "number": 8,
      "title": "Walter VIII: Laura and the Likeness",
      "summary": "Walter meets Laura and is startled by her resemblance to the woman he encountered outside London.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-09",
      "timelineId": "woman-in-white-timeline-main",
      "number": 9,
      "title": "Walter IX: Three Months at Limmeridge",
      "summary": "Lessons, walks, and shared days draw Walter and Laura together while Marian sees the attachment grow.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-10",
      "timelineId": "woman-in-white-timeline-main",
      "number": 10,
      "title": "Walter X: Laura’s Engagement",
      "summary": "Marian tells Walter that Laura is already promised to Sir Percival Glyde.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-11",
      "timelineId": "woman-in-white-timeline-main",
      "number": 11,
      "title": "Walter XI: Walter Must Leave",
      "summary": "Walter agrees that remaining at Limmeridge would deepen Laura’s distress and prepares to resign.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-12",
      "timelineId": "woman-in-white-timeline-main",
      "number": 12,
      "title": "Walter XII: The Warning Letter",
      "summary": "An anonymous letter warns Laura not to marry Sir Percival and associates him with cruelty and confinement.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-13",
      "timelineId": "woman-in-white-timeline-main",
      "number": 13,
      "title": "Walter XIII: Anne at the Churchyard",
      "summary": "Walter finds Anne Catherick beside Mrs Fairlie’s grave and confirms her bond with Limmeridge.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-14",
      "timelineId": "woman-in-white-timeline-main",
      "number": 14,
      "title": "Walter XIV: The Secret and the Farewell",
      "summary": "Anne cannot fully disclose Percival’s secret; Walter leaves Limmeridge after a final painful meeting with Laura.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-15",
      "timelineId": "woman-in-white-timeline-main",
      "number": 15,
      "title": "Walter XV: Gilmore Arrives",
      "summary": "Walter’s first narrative closes as Vincent Gilmore reaches Limmeridge to consider the marriage arrangements.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-16",
      "timelineId": "woman-in-white-timeline-main",
      "number": 16,
      "title": "Gilmore I: Sir Percival’s Explanation",
      "summary": "Percival answers questions about Anne by presenting himself as the responsible party who arranged her confinement.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-17",
      "timelineId": "woman-in-white-timeline-main",
      "number": 17,
      "title": "Gilmore II: The Settlement Begins",
      "summary": "Gilmore examines Laura’s property and the financial terms proposed for the marriage.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-18",
      "timelineId": "woman-in-white-timeline-main",
      "number": 18,
      "title": "Gilmore III: Laura Accepts the Marriage",
      "summary": "Laura refuses to break the promise made to her father, even after Gilmore explains the settlement’s danger.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-19",
      "timelineId": "woman-in-white-timeline-main",
      "number": 19,
      "title": "Gilmore IV: The Settlement Is Signed",
      "summary": "Fairlie declines to fight the terms, and the marriage settlement is completed over Gilmore’s objections.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-20",
      "timelineId": "woman-in-white-timeline-main",
      "number": 20,
      "title": "Marian I: November 8",
      "summary": "Marian begins her record of Laura’s final weeks before marriage and the household’s subdued preparations.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-21",
      "timelineId": "woman-in-white-timeline-main",
      "number": 21,
      "title": "Marian II: December 22",
      "summary": "Laura marries Sir Percival and leaves Limmeridge, while Marian prepares to join her after the wedding journey.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-22",
      "timelineId": "woman-in-white-timeline-main",
      "number": 22,
      "title": "Second Epoch — Marian I: Blackwater Park",
      "summary": "In June 1850 Marian records her arrival at Blackwater Park and the oppressive condition of Percival’s estate.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-23",
      "timelineId": "woman-in-white-timeline-main",
      "number": 23,
      "title": "Marian II: Count Fosco Observes",
      "summary": "Fosco fascinates and unsettles Marian while winning influence over Percival and the household.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-24",
      "timelineId": "woman-in-white-timeline-main",
      "number": 24,
      "title": "Marian III: Anne Appears Near the Park",
      "summary": "Signs that Anne Catherick is nearby revive the warning and Percival’s fear of exposure.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-25",
      "timelineId": "woman-in-white-timeline-main",
      "number": 25,
      "title": "Marian IV: Pressure for Laura’s Signature",
      "summary": "Percival attempts to make Laura sign a document without explaining its effect on her money.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-26",
      "timelineId": "woman-in-white-timeline-main",
      "number": 26,
      "title": "Marian V: A Message for Anne",
      "summary": "Marian and Laura arrange a cautious meeting with Anne near the lake.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-27",
      "timelineId": "woman-in-white-timeline-main",
      "number": 27,
      "title": "Marian VI: Anne’s Fear",
      "summary": "Anne reveals that Percival’s secret could ruin him, but illness and terror keep her explanation incomplete.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-28",
      "timelineId": "woman-in-white-timeline-main",
      "number": 28,
      "title": "Marian VII: The Household Is Divided",
      "summary": "Percival dismisses servants and isolates Laura while Fosco manages appearances and practical arrangements.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-29",
      "timelineId": "woman-in-white-timeline-main",
      "number": 29,
      "title": "Marian VIII: The Conversation at the Boathouse",
      "summary": "From the rain outside the library, Marian overhears Percival and Fosco planning to secure Laura’s fortune and exploit Anne’s resemblance.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-30",
      "timelineId": "woman-in-white-timeline-main",
      "number": 30,
      "title": "Marian IX: Fever",
      "summary": "The exposure leaves Marian dangerously ill, removing Laura’s strongest defender at the moment the plan advances.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-31",
      "timelineId": "woman-in-white-timeline-main",
      "number": 31,
      "title": "Marian X: The Diary Changes Hands",
      "summary": "Marian’s narrative breaks as Fosco reads and annotates the diary, proving how completely the conspirators control the house.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-32",
      "timelineId": "woman-in-white-timeline-main",
      "number": 32,
      "title": "Fairlie: The Summons from Blackwater",
      "summary": "Fairlie explains how Fosco’s correspondence persuaded him to receive Laura at Limmeridge while Marian was supposedly too ill to travel.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-33",
      "timelineId": "woman-in-white-timeline-main",
      "number": 33,
      "title": "Michelson I: The House Is Emptied",
      "summary": "Mrs Michelson records servants departing and Laura being told that Marian has already left Blackwater.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-34",
      "timelineId": "woman-in-white-timeline-main",
      "number": 34,
      "title": "Michelson II: Laura Leaves Blackwater",
      "summary": "Laura departs under Madame Fosco’s escort, while Marian is secretly moved after her.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-35",
      "timelineId": "woman-in-white-timeline-main",
      "number": 35,
      "title": "Hester Pinhorn: The Sick Woman",
      "summary": "Hester Pinhorn’s testimony places Anne, gravely ill, in Fosco’s London house before the death announced as Laura’s.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-36",
      "timelineId": "woman-in-white-timeline-main",
      "number": 36,
      "title": "Doctor Goodricke: The Medical Record",
      "summary": "Doctor Goodricke records the final illness and death of the woman presented to him as Lady Glyde.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-37",
      "timelineId": "woman-in-white-timeline-main",
      "number": 37,
      "title": "Jane Gould: Preparing the Burial",
      "summary": "Jane Gould’s evidence helps complete the official chain from the London death to the coffin sent north.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-38",
      "timelineId": "woman-in-white-timeline-main",
      "number": 38,
      "title": "The Tombstone at Limmeridge",
      "summary": "A formal record states that Laura, Lady Glyde, died on July 25, 1850, and was buried beside her mother.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-39",
      "timelineId": "woman-in-white-timeline-main",
      "number": 39,
      "title": "Walter: Return to England",
      "summary": "Walter lands at Liverpool on October 13 and learns that Laura is officially dead.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-40",
      "timelineId": "woman-in-white-timeline-main",
      "number": 40,
      "title": "Third Epoch — Walter I: Laura at Her Own Grave",
      "summary": "At Limmeridge Churchyard, Walter sees Marian with a living woman he recognizes as Laura beside Laura’s own tombstone.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-41",
      "timelineId": "woman-in-white-timeline-main",
      "number": 41,
      "title": "Walter II: Marian’s Account",
      "summary": "Marian explains how she found Laura confined under Anne Catherick’s name and removed her from the asylum.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-42",
      "timelineId": "woman-in-white-timeline-main",
      "number": 42,
      "title": "Walter III: The Conspiracy Takes Shape",
      "summary": "Walter combines Marian’s diary, the burial record, and Laura’s fragments of memory into a working theory of exchanged identities.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-43",
      "timelineId": "woman-in-white-timeline-main",
      "number": 43,
      "title": "Walter IV: The Law Refuses the Case",
      "summary": "Mr Kyrle explains that Laura’s appearance and private testimony cannot overcome the certificate, burial, and witnesses.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
