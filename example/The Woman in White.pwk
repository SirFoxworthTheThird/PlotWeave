      "timelineId": "woman-in-white-timeline-main",
      "number": 46,
      "title": "Walter VII: Anne’s Parentage",
      "summary": "Walter discovers that Anne and Laura shared a father, explaining their resemblance without making them interchangeable.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
