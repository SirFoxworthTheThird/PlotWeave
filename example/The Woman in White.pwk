      "timelineId": "woman-in-white-timeline-main",
      "number": 59,
      "title": "Fosco: The Confession",
      "summary": "Fosco writes how Anne died under Laura’s name and Laura was committed as Anne, fixing the dates and responsibilities.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
