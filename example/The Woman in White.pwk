      "timelineId": "woman-in-white-timeline-main",
      "number": 55,
      "title": "Walter IV: Watch on Fosco",
      "summary": "Walter watches Fosco’s St John’s Wood house and studies its visitors, routines, and vulnerabilities.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
