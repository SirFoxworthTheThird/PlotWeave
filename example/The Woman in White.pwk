      "timelineId": "woman-in-white-timeline-main",
      "number": 50,
      "title": "Walter XI: The Inquest",
      "summary": "The inquest confirms Percival’s accidental death but cannot replace the destroyed register as evidence in Laura’s case.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-51",
      "timelineId": "woman-in-white-timeline-main",
      "number": 51,
      "title": "Mrs Catherick: Her Written Account",
      "summary": "Mrs Catherick writes the history of Percival’s illegitimate birth, the forged marriage entry, and Anne’s accidental knowledge.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-52",
      "timelineId": "woman-in-white-timeline-main",
      "number": 52,
      "title": "Walter I: The Register’s Secret",
      "summary": "Walter verifies Mrs Catherick’s account and distinguishes Percival’s motive from Fosco’s execution of the identity exchange.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-53",
      "timelineId": "woman-in-white-timeline-main",
      "number": 53,
      "title": "Walter II: Home at Gower’s Walk",
      "summary": "Walter returns to Laura and Marian, preserving their concealed household while the final investigation continues.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
