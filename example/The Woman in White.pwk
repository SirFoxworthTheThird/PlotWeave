      "timelineId": "woman-in-white-timeline-main",
      "number": 45,
      "title": "Walter VI: Mrs Clements",
      "summary": "Mrs Clements tells Walter about Anne’s childhood, her devotion to Mrs Fairlie, and Mrs Catherick’s dealings with Percival.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
