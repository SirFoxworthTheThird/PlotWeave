      "id": "woman-in-white-chapter-56",
      "timelineId": "woman-in-white-timeline-main",
      "number": 56,
      "title": "Walter V: Pesca Recognises Fosco",
      "summary": "At the opera, Pesca sees Fosco and reacts with fear and recognition that contradicts the Count’s public identity.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
