      "id": "woman-in-white-chapter-54",
      "timelineId": "woman-in-white-timeline-main",
      "number": 54,
      "title": "Walter III: Marriage and Recovery",
      "summary": "Walter and Laura marry privately, choosing a shared life before public restoration of her name is complete.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
