      "id": "woman-in-white-character-anne",
      "name": "Anne Catherick",
      "aliases": [
        "The Woman in White"
      ],
      "description": "A vulnerable woman whose white clothes, resemblance to Laura, and knowledge of Sir Percival’s secret connect every part of the mystery.",
      "portraitImageId": "woman-in-white-image-polo-04",
