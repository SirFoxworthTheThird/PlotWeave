      "timelineId": "woman-in-white-timeline-main",
      "number": 58,
      "title": "Walter VII: Confronting Fosco",
      "summary": "Walter confronts Fosco at Forest Road and demands a complete written confession in exchange for time to leave England.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
