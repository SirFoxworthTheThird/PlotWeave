      "timelineId": "woman-in-white-timeline-main",
      "number": 57,
      "title": "Walter VI: The Brotherhood’s Mark",
      "summary": "Pesca explains the brotherhood’s discipline and gives Walter leverage more immediate than English legal proceedings.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
