      "timelineId": "woman-in-white-timeline-main",
      "number": 47,
      "title": "Walter VIII: Laura’s Memory",
      "summary": "In the safety of Gower’s Walk, Laura gradually recalls the London journey and the moment her identity was taken from her.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-48",
      "timelineId": "woman-in-white-timeline-main",
      "number": 48,
      "title": "Walter IX: Mrs Catherick at Welmingham",
      "summary": "Walter confronts Mrs Catherick and learns that Percival’s terror centres on the old parish register.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
      "id": "woman-in-white-chapter-49",
      "timelineId": "woman-in-white-timeline-main",
      "number": 49,
      "title": "Walter X: The Vestry Fire",
      "summary": "Percival breaks into the vestry to destroy the register, accidentally sets the building alight, and is trapped.",
      "status": "final",
      "targetWordCount": null
    },
    {
      "worldId": "woman-in-white-world",
      "createdAt": 1786838400000,
      "updatedAt": 1786838400000,
