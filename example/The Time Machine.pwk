  "world": {
    "id": "time-machine-world",
    "name": "The Time Machine",
    "description": "H. G. Wells’s novel follows an unnamed Victorian inventor from a sceptical Richmond dinner into the year 802,701, where the Eloi, Morlocks, ruined institutions, and a still more distant dying Earth turn technological triumph into an inquiry about class, evolution, mortality, and human tenderness.",
    "coverImageId": "time-machine-image-cover",
    "theme": "theme-scifi",
    "readingMode": true,
