      "id": "time-machine-relationship-1",
      "characterAId": "time-machine-char-traveller",
      "characterBId": "time-machine-char-narrator",
      "label": "Friend, host, and witness",
      "strength": "strong",
      "sentiment": "positive",
      "description": "The narrator listens more seriously than the other guests and preserves both the story and its unresolved evidence.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
