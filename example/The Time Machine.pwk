  "timelines": [
    {
      "id": "time-machine-timeline-frame",
      "worldId": "time-machine-world",
      "name": "The Richmond Frame",
      "description": "The two Thursday dinners, the testimony, the final departure, and the narrator’s three-year vigil.",
      "color": "#70676a",
      "dayOffset": 0,
      "createdAt": 1786122000000
    },
    {
      "id": "time-machine-timeline-journey",
      "worldId": "time-machine-world",
      "name": "The Journey Through Time",
      "description": "The traveller’s personal chronology from his laboratory departure through 802,701, the farther future, and his return.",
      "color": "#617789",
      "dayOffset": 0,
      "createdAt": 1786122000000
    }
  ],
  "chapters": [
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-01",
      "timelineId": "time-machine-timeline-frame",
      "number": 1,
      "title": "Introduction",
      "synopsis": "At a Thursday dinner in Richmond, the Time Traveller asks his guests to accept time as a fourth dimension.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-02",
      "timelineId": "time-machine-timeline-frame",
      "number": 2,
      "title": "The Machine",
      "synopsis": "A model disappears before the guests, and the inventor reveals the full machine in his laboratory.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-03",
      "timelineId": "time-machine-timeline-frame",
      "number": 3,
      "title": "The Time Traveller Returns",
      "synopsis": "At the next Thursday dinner, the inventor arrives late, injured and famished, and demands to tell his story uninterrupted.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-04",
      "timelineId": "time-machine-timeline-journey",
      "number": 4,
      "title": "Time Travelling",
      "synopsis": "He mounts the machine, tests a short jump, and accelerates from 1895 into the year 802,701.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-05",
      "timelineId": "time-machine-timeline-journey",
      "number": 5,
      "title": "In the Golden Age",
      "synopsis": "The Eloi welcome the traveller; he explores their communal life, food, architecture, and river valley.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-06",
      "timelineId": "time-machine-timeline-journey",
      "number": 6,
      "title": "The Sunset of Mankind",
      "synopsis": "His first theory of effortless human decline collapses when the Time Machine disappears.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-07",
      "timelineId": "time-machine-timeline-journey",
      "number": 7,
      "title": "A Sudden Shock",
      "synopsis": "The traveller searches the White Sphinx, discovers its pedestal is locked, and begins to notice the wells.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-08",
      "timelineId": "time-machine-timeline-journey",
      "number": 8,
      "title": "Explanation",
      "synopsis": "Surface and underground humanity become evidence of an ancient division between leisure and labour.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-09",
      "timelineId": "time-machine-timeline-journey",
      "number": 9,
      "title": "The Morlocks",
      "synopsis": "The traveller descends a well, sees the machinery below, and escapes the Morlocks by matchlight.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-10",
      "timelineId": "time-machine-timeline-journey",
      "number": 10,
      "title": "When Night Came",
      "synopsis": "With the moon waning, he and Weena begin the long journey toward the Palace of Green Porcelain.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-11",
      "timelineId": "time-machine-timeline-journey",
      "number": 11,
      "title": "The Palace of Green Porcelain",
      "synopsis": "In a ruined museum, the traveller gathers matches, camphor, and an iron bar for the return.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-12",
      "timelineId": "time-machine-timeline-journey",
      "number": 12,
      "title": "In the Darkness",
      "synopsis": "Morlocks surround the travellers in the moonless wood; a defensive fire becomes a forest blaze.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-13",
      "timelineId": "time-machine-timeline-journey",
      "number": 13,
      "title": "The Trap of the White Sphinx",
      "synopsis": "The opened pedestal offers the recovered machine but closes around the traveller as a trap.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-14",
      "timelineId": "time-machine-timeline-journey",
      "number": 14,
      "title": "The Further Vision",
      "synopsis": "Instead of stopping in 1895, the traveller sees a dying Earth millions of years farther ahead.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-15",
      "timelineId": "time-machine-timeline-journey",
      "number": 15,
      "title": "The Time Traveller’s Return",
      "synopsis": "He regains his laboratory and completes the account before the Richmond guests.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-16",
      "timelineId": "time-machine-timeline-frame",
      "number": 16,
      "title": "After the Story",
      "synopsis": "Most guests reject the tale; the narrator returns next day and witnesses the traveller’s final departure.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-chapter-17",
      "timelineId": "time-machine-timeline-frame",
      "number": 17,
      "title": "Epilogue",
      "synopsis": "Three years later, the narrator keeps Weena’s flowers and the possibility that humanity may retain gratitude and tenderness.",
      "notes": "",
      "wordGoal": null
    }
  ],
