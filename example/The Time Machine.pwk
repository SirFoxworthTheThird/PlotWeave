  "lorePages": [
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-1",
      "categoryId": "time-machine-lore-category-science",
      "title": "The Fourth Dimension",
      "body": "The opening argument treats time as a measurable dimension analogous to length, breadth, and thickness, then asks whether machinery could control motion along it.",
      "tags": [],
      "coverImageId": "time-machine-image-finlay-1",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-1"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-2",
      "categoryId": "time-machine-lore-category-science",
      "title": "The Machine’s Controls",
      "body": "A pair of levers governs departure and direction. Because the traveller removes the starting lever, recovering and refitting it becomes essential inside the White Sphinx.",
      "tags": [],
      "coverImageId": "time-machine-image-finlay-1",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-35"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-3",
      "categoryId": "time-machine-lore-category-future",
      "title": "The Year 802,701",
      "body": "The machine first stops in a warm Thames Valley transformed by long biological, architectural, and social change. The exact geography is recognisable only in broad features.",
      "tags": [],
      "coverImageId": "time-machine-image-finlay-2",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-10"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-4",
      "categoryId": "time-machine-lore-category-future",
      "title": "The Further Vision",
      "body": "Millions of years later, the traveller sees a red sun, altered sea, giant shore creatures, cold, and darkness. The sequence expands the novel beyond human history into planetary mortality.",
      "tags": [],
      "coverImageId": "time-machine-image-finlay-4",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-38"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-5",
      "categoryId": "time-machine-lore-category-society",
      "title": "Eloi and Morlocks",
      "body": "The traveller interprets the two peoples through Victorian class division, but revises his theory as evidence of machinery, fear, dependence, and predation accumulates. His account remains an inference, not an omniscient history.",
      "tags": [],
      "coverImageId": "time-machine-image-finlay-3",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-24"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-6",
      "categoryId": "time-machine-lore-category-society",
      "title": "The Palace of Green Porcelain",
      "body": "The palace resembles a museum whose collections have decayed into fragments. It represents knowledge preserved physically after its systems of meaning and use have failed.",
      "tags": [],
      "coverImageId": "time-machine-image-finlay-4",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-29"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-7",
      "categoryId": "time-machine-lore-category-sources",
      "title": "Text Source",
      "body": "Chapter order and factual checking follow the public-domain Project Gutenberg edition of The Time Machine, ebook 35. All summaries and notes here are newly written.",
      "tags": [],
      "coverImageId": "time-machine-image-title-page",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-1"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-8",
      "categoryId": "time-machine-lore-category-sources",
      "title": "Illustration Sources",
      "body": "The cover and future-world scenes use public-domain illustrations by Norman Saunders and Virgil Finlay. Because Wells leaves most Richmond guests physically undescribed, their distinct portraits are clearly editorial public-domain period artworks rather than canonical likenesses. Every story item likewise uses its own period object, botanical, or mechanical illustration. Images are linked from Wikimedia Commons.",
      "tags": [],
      "coverImageId": "time-machine-image-cover",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-1"
    },
    {
      "worldId": "time-machine-world",
      "createdAt": 1786122000000,
      "updatedAt": 1786122000000,
      "id": "time-machine-lore-9",
      "categoryId": "time-machine-lore-category-sources",
      "title": "Map Sources",
      "body": "The Richmond map is a 1915 environs map; the house uses a period Cambridge Cottage plan from Kew. Future markers are an editorial reconstruction based on relative movement in the novel, not canonical coordinates.",
      "tags": [],
      "coverImageId": "time-machine-image-map-richmond",
      "linkedEntityIds": [],
      "visibleFromEventId": "time-machine-event-1"
    }
  ],
