      "timelineId": "iliad-timeline-wrath",
      "number": 22,
      "title": "The Death of Hector",
      "synopsis": "Apollo preserves Troyâ€™s retreat; Athena deceives Hector, Achilles kills him, and the corpse is dragged away.",
      "notes": "Book 22 of the epic.",
      "wordGoal": null
    },
