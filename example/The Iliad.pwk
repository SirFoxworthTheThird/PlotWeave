      "timelineId": "iliad-timeline-wrath",
      "number": 12,
      "title": "The Battle at the Wall",
      "synopsis": "Hector rejects Polydamasâ€™ omen and smashes through the Achaean gate with a stone.",
      "notes": "Book 12 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
