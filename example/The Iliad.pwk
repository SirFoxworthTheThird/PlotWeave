  "factionRelationships": [
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-faction-rel-1",
      "factionAId": "iliad-faction-achaeans",
      "factionBId": "iliad-faction-trojans",
      "stance": "hostile",
      "notes": "The two coalitions contest Troy and Helen in the war’s tenth year."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-faction-rel-2",
      "factionAId": "iliad-faction-achaeans",
      "factionBId": "iliad-faction-myrmidons",
      "stance": "mixed",
      "notes": "The Myrmidons belong to the coalition but withdraw with Achilles."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-faction-rel-3",
      "factionAId": "iliad-faction-achaean-gods",
      "factionBId": "iliad-faction-trojan-gods",
      "stance": "hostile",
      "notes": "Divine rivalries reproduce and intensify the mortal war."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-faction-rel-4",
      "factionAId": "iliad-faction-house-priam",
      "factionBId": "iliad-faction-trojans",
      "stance": "allied",
      "notes": "The coalition defends the city and dynasty of Priam."
    },
    {
      "worldId": "iliad-world",
