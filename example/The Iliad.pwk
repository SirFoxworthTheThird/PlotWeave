  "characterGoals": [
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-1",
      "characterId": "iliad-char-achilles",
      "startEventId": "iliad-event-001",
      "endEventId": "iliad-event-072",
      "type": "need",
      "text": "Defend his honour without letting rage erase every human bond and limit."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-2",
      "characterId": "iliad-char-agamemnon",
      "startEventId": "iliad-event-001",
      "endEventId": "iliad-event-057",
      "type": "want",
      "text": "Preserve supreme command over a coalition of independent kings."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-3",
      "characterId": "iliad-char-hector",
      "startEventId": "iliad-event-007",
      "endEventId": "iliad-event-066",
      "type": "want",
      "text": "Keep Troy and its households alive by holding the field against the Achaeans."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-4",
      "characterId": "iliad-char-patroclus",
      "startEventId": "iliad-event-031",
      "endEventId": "iliad-event-048",
      "type": "want",
      "text": "Save the ships and the suffering army by acting through Achilles’ borrowed identity."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-5",
      "characterId": "iliad-char-priam",
      "startEventId": "iliad-event-007",
      "endEventId": "iliad-event-072",
      "type": "need",
      "text": "Remain king and father through cumulative loss, then recover Hector for burial."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-6",
      "characterId": "iliad-char-andromache",
      "startEventId": "iliad-event-016",
      "endEventId": "iliad-event-072",
      "type": "want",
      "text": "Keep Hector within the household and preserve a future for Astyanax."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-goal-7",
      "characterId": "iliad-char-thetis",
      "startEventId": "iliad-event-001",
      "endEventId": "iliad-event-072",
      "type": "want",
      "text": "Secure honour and dignity for the short life she cannot lengthen."
    }
  ],
  "plotThreads": [
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-thread-wrath",
      "name": "The Wrath of Achilles",
      "color": "#a4493f",
      "description": "Injury, withdrawal, consequence, grief, vengeance, and the first return to mercy."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-thread-honour",
      "name": "Honour and Command",
      "color": "#9a7447",
      "description": "Prizes, speeches, rank, restitution, and contests measure unstable claims to public worth."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-thread-troy",
      "name": "The Defence of Troy",
      "color": "#76534a",
      "description": "Hector and the Trojan household hold together a city already shadowed by destruction."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-thread-gods",
      "name": "The War on Olympus",
      "color": "#7a668d",
      "description": "Divine favour and rivalry alter the field without releasing mortals from fate."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-thread-patroclus",
      "name": "The Fate of Patroclus",
      "color": "#4e7580",
      "description": "Compassion and borrowed identity bring Patroclus glory, overreach, and death."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-thread-bodies",
      "name": "Bodies and Burial",
      "color": "#69615b",
      "description": "The treatment of Sarpedon, Patroclus, and Hector tests the limit between victory and desecration."
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-thread-fate",
      "name": "Fate and Foreknowledge",
      "color": "#81723f",
      "description": "Gods and mortals know pieces of what must happen but remain responsible for how they meet it."
    }
  ],
