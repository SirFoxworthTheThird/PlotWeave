      "timelineId": "iliad-timeline-wrath",
      "number": 17,
      "title": "The Body of Patroclus",
      "synopsis": "Menelaus, the Ajaxes, and their allies preserve Patroclusâ€™ corpse while Hector takes Achillesâ€™ armour.",
      "notes": "Book 17 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-18",
      "timelineId": "iliad-timeline-wrath",
      "number": 18,
      "title": "Achilles Learns the News",
      "synopsis": "Grief ends Achillesâ€™ withdrawal; Thetis promises new armour and his unarmed appearance terrifies the Trojans.",
      "notes": "Book 18 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-19",
      "timelineId": "iliad-timeline-wrath",
      "number": 19,
      "title": "Reconciliation",
      "synopsis": "Achilles and Agamemnon settle their quarrel; Briseis mourns, the army eats, and the immortal horse foretells death.",
      "notes": "Book 19 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
