  "relationships": [
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-relationship-1",
      "characterAId": "iliad-char-achilles",
      "characterBId": "iliad-char-agamemnon",
      "label": "rival claimants to honour",
      "strength": 5,
      "sentiment": "negative",
      "description": "Their quarrel separates supreme command from supreme fighting ability and structures the entire poem.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-relationship-2",
      "characterAId": "iliad-char-achilles",
      "characterBId": "iliad-char-patroclus",
      "label": "beloved companions",
      "strength": 5,
      "sentiment": "positive",
      "description": "Patroclus can move Achilles through affection when public obligation and compensation fail.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-relationship-3",
      "characterAId": "iliad-char-achilles",
      "characterBId": "iliad-char-thetis",
      "label": "mortal son and divine mother",
      "strength": 5,
      "sentiment": "positive",
      "description": "Thetis can secure honour and armour but cannot cancel the early death Achilles accepts.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-relationship-4",
      "characterAId": "iliad-char-achilles",
      "characterBId": "iliad-char-hector",
      "label": "avenger and doomed defender",
      "strength": 5,
      "sentiment": "negative",
      "description": "Patroclus’ death turns Hector into the single object of Achilles’ grief and rage.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-relationship-5",
      "characterAId": "iliad-char-hector",
      "characterBId": "iliad-char-andromache",
      "label": "husband and wife",
      "strength": 5,
      "sentiment": "positive",
      "description": "Their tenderness is inseparable from the civic duty that will destroy their household.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-relationship-6",
      "characterAId": "iliad-char-hector",
      "characterBId": "iliad-char-priam",
      "label": "son and father",
      "strength": 5,
      "sentiment": "positive",
      "description": "Hector carries Priam’s city in battle; Priam later crosses the enemy camp to recover him.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-relationship-7",
      "characterAId": "iliad-char-hector",
      "characterBId": "iliad-char-paris",
      "label": "brothers under unequal burdens",
      "strength": 4,
      "sentiment": "mixed",
      "description": "Hector depends upon and condemns the brother whose choices brought the war.",
      "isBidirectional": true,
      "startEventId": null
    },
    {
