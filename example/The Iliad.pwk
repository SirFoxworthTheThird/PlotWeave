  "timelines": [
    {
      "id": "iliad-timeline-wrath",
      "worldId": "iliad-world",
      "name": "The Wrath of Achilles",
      "description": "The continuous action from Apollo’s plague through Hector’s burial in the tenth year of the war.",
      "color": "#9b4d3f",
      "dayOffset": 0,
      "createdAt": 1799539200000
    }
  ],
  "chapters": [
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-01",
      "timelineId": "iliad-timeline-wrath",
      "number": 1,
      "title": "The Quarrel",
      "synopsis": "Apollo’s plague exposes the conflict between public command and heroic honour; Agamemnon takes Briseis, and Achilles withdraws.",
      "notes": "Book 1 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-02",
      "timelineId": "iliad-timeline-wrath",
      "number": 2,
      "title": "The Dream and the Catalogue",
      "synopsis": "Zeus sends a deceptive dream, the army nearly sails home, and the assembled forces of Achaea and Troy are named.",
      "notes": "Book 2 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-03",
      "timelineId": "iliad-timeline-wrath",
      "number": 3,
      "title": "The Duel for Helen",
      "synopsis": "Paris and Menelaus agree to settle the war in single combat, but Aphrodite removes Paris from defeat.",
      "notes": "Book 3 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-04",
      "timelineId": "iliad-timeline-wrath",
      "number": 4,
      "title": "The Truce Is Broken",
      "synopsis": "Athena engineers a broken oath; Agamemnon rallies the wounded coalition and general battle resumes.",
      "notes": "Book 4 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-05",
      "timelineId": "iliad-timeline-wrath",
      "number": 5,
      "title": "Diomedes’ Aristeia",
      "synopsis": "Athena empowers Diomedes to distinguish gods from mortals; he wounds Aphrodite and Ares.",
      "notes": "Book 5 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-06",
      "timelineId": "iliad-timeline-wrath",
      "number": 6,
      "title": "Hector Returns to Troy",
      "synopsis": "The battlefield pauses around acts of inherited friendship while Hector visits the city, Helen, Paris, Andromache, and Astyanax.",
      "notes": "Book 6 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-07",
      "timelineId": "iliad-timeline-wrath",
      "number": 7,
      "title": "Ajax Fights Hector",
      "synopsis": "Divine pressure drives battle toward an inconclusive duel between the foremost available champions.",
      "notes": "Book 7 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-08",
      "timelineId": "iliad-timeline-wrath",
      "number": 8,
      "title": "The Trojans Reach the Camp",
      "synopsis": "Zeus forbids divine aid and grants Hector a decisive advance that confines the Achaeans behind their wall.",
      "notes": "Book 8 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-09",
      "timelineId": "iliad-timeline-wrath",
      "number": 9,
      "title": "The Embassy to Achilles",
      "synopsis": "Agamemnon offers restitution; Odysseus, Phoenix, and Ajax ask Achilles to return, but he refuses.",
      "notes": "Book 9 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-10",
      "timelineId": "iliad-timeline-wrath",
      "number": 10,
      "title": "The Night Raid",
      "synopsis": "Diomedes and Odysseus capture Dolon, learn the Trojan dispositions, and raid the newly arrived Thracians.",
      "notes": "Book 10 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-11",
      "timelineId": "iliad-timeline-wrath",
      "number": 11,
      "title": "The Achaean Leaders Fall",
      "synopsis": "Agamemnon’s offensive collapses as successive commanders are wounded and Hector drives toward the ships.",
      "notes": "Book 11 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-12",
      "timelineId": "iliad-timeline-wrath",
      "number": 12,
      "title": "The Battle at the Wall",
      "synopsis": "Hector rejects Polydamas’ omen and smashes through the Achaean gate with a stone.",
      "notes": "Book 12 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-13",
      "timelineId": "iliad-timeline-wrath",
      "number": 13,
      "title": "The Battle at the Ships",
      "synopsis": "Poseidon rallies the defenders while Zeus is distracted; Hector and Ajax contest the line before the fleet.",
      "notes": "Book 13 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-14",
      "timelineId": "iliad-timeline-wrath",
      "number": 14,
      "title": "Zeus Is Deceived",
      "synopsis": "Hera seduces and sleeps Zeus, allowing Poseidon to help the Achaeans drive Hector back.",
      "notes": "Book 14 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-15",
      "timelineId": "iliad-timeline-wrath",
      "number": 15,
      "title": "The Fire at the Ships",
      "synopsis": "Zeus restores Trojan momentum; Hector reaches the fleet and sets one ship ablaze.",
      "notes": "Book 15 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-16",
      "timelineId": "iliad-timeline-wrath",
      "number": 16,
      "title": "Patroclus Enters Battle",
      "synopsis": "Patroclus borrows Achilles’ identity, saves the ships, kills Sarpedon, and exceeds the limit placed upon him.",
      "notes": "Book 16 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-17",
      "timelineId": "iliad-timeline-wrath",
      "number": 17,
      "title": "The Body of Patroclus",
      "synopsis": "Menelaus, the Ajaxes, and their allies preserve Patroclus’ corpse while Hector takes Achilles’ armour.",
      "notes": "Book 17 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-18",
      "timelineId": "iliad-timeline-wrath",
      "number": 18,
      "title": "Achilles Learns the News",
      "synopsis": "Grief ends Achilles’ withdrawal; Thetis promises new armour and his unarmed appearance terrifies the Trojans.",
      "notes": "Book 18 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-19",
      "timelineId": "iliad-timeline-wrath",
      "number": 19,
      "title": "Reconciliation",
      "synopsis": "Achilles and Agamemnon settle their quarrel; Briseis mourns, the army eats, and the immortal horse foretells death.",
      "notes": "Book 19 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-20",
      "timelineId": "iliad-timeline-wrath",
      "number": 20,
      "title": "The Gods Return to Battle",
      "synopsis": "Zeus releases the gods to fight while Achilles pursues Hector and nearly meets Aeneas.",
      "notes": "Book 20 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-21",
      "timelineId": "iliad-timeline-wrath",
      "number": 21,
      "title": "Achilles and the River",
      "synopsis": "Achilles’ slaughter provokes Scamander, and a divine battle erupts around his escape from the flood.",
      "notes": "Book 21 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-22",
      "timelineId": "iliad-timeline-wrath",
      "number": 22,
      "title": "The Death of Hector",
      "synopsis": "Apollo preserves Troy’s retreat; Athena deceives Hector, Achilles kills him, and the corpse is dragged away.",
      "notes": "Book 22 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-23",
      "timelineId": "iliad-timeline-wrath",
      "number": 23,
      "title": "The Funeral Games",
      "synopsis": "Patroclus receives funeral rites and Achilles manages contests that expose rivalry, honour, skill, and reconciliation.",
      "notes": "Book 23 of the epic.",
      "wordGoal": null
    },
    {
      "worldId": "iliad-world",
      "createdAt": 1799539200000,
      "updatedAt": 1799539200000,
      "id": "iliad-chapter-24",
      "timelineId": "iliad-timeline-wrath",
      "number": 24,
      "title": "Priam and Achilles",
      "synopsis": "The gods compel ransom; Priam appeals to Achilles as a grieving father, and Troy buries Hector.",
      "notes": "Book 24 of the epic.",
      "wordGoal": null
    }
  ],
