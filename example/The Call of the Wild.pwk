      "updatedAt": 1788393600000,
      "id": "call-wild-faction-stampeders",
      "name": "Hal’s Party",
      "description": "Three inexperienced travellers bring overloaded habits and collapsing discipline onto the spring trail.",
      "color": "#805c4f",
      "coverImageId": null,
      "tags": []
    },
    {
      "worldId": "call-wild-world",
      "createdAt": 1788393600000,
