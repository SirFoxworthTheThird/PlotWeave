  "characters": [
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-char-jane",
      "name": "Jane Eyre",
      "aliases": [],
      "description": "An orphaned, observant, and morally independent girl who becomes a teacher and governess while insisting that love cannot cost her self-respect.",
