      "characterBId": "jane-eyre-char-mrs-reed",
      "label": "dependent niece and hostile guardian",
      "strength": 5,
      "sentiment": "negative",
      "notes": "Childhood rejection remains real even when Jane returns willing to forgive.",
      "isMutual": false,
      "createdAtEventId": "jane-eyre-event-001"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
