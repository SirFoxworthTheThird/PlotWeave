      "id": "jane-eyre-relationship-2",
      "characterAId": "jane-eyre-char-jane",
      "characterBId": "jane-eyre-char-helen",
      "label": "school friends and moral counterparts",
      "strength": 5,
      "sentiment": "positive",
      "notes": "Helen’s friendship gives Jane solidarity and a spiritual vocabulary she remembers without simply adopting.",
      "isMutual": true,
      "createdAtEventId": "jane-eyre-event-009"
    },
    {
      "worldId": "jane-eyre-world",
