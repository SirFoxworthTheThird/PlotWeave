      "characterAId": "jane-eyre-char-jane",
      "characterBId": "jane-eyre-char-bessie",
      "label": "former charge and imperfect caregiver",
      "strength": 4,
      "sentiment": "mixed",
      "notes": "Bessie’s affection is inconsistent at Gateshead but becomes a valued tie across Jane’s departure and return.",
      "isMutual": true,
      "createdAtEventId": "jane-eyre-event-001"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
