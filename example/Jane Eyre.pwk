      "characterBId": "jane-eyre-char-temple",
      "label": "pupil and trusted mentor",
      "strength": 5,
      "sentiment": "positive",
      "notes": "Miss Temple hears Jane fairly, clears her name, and models humane authority.",
      "isMutual": true,
      "createdAtEventId": "jane-eyre-event-009"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
