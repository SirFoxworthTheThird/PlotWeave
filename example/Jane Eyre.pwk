  "characterGoals": [
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-goal-1",
      "characterId": "jane-eyre-char-jane",
      "startEventId": "jane-eyre-event-001",
      "endEventId": "jane-eyre-event-019",
      "type": "need",
      "text": "Find a life beyond hostile dependence through education and useful work."
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-goal-2",
      "characterId": "jane-eyre-char-jane",
      "startEventId": "jane-eyre-event-021",
      "endEventId": "jane-eyre-event-054",
      "type": "want",
      "text": "Love Rochester without accepting inferiority, concealment, or ownership."
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-goal-3",
      "characterId": "jane-eyre-char-jane",
      "startEventId": "jane-eyre-event-056",
      "endEventId": "jane-eyre-event-069",
      "type": "need",
      "text": "Rebuild independence, livelihood, and family after leaving Thornfield."
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-goal-4",
      "characterId": "jane-eyre-char-jane",
      "startEventId": "jane-eyre-event-071",
      "endEventId": "jane-eyre-event-077",
      "type": "want",
      "text": "Return to Rochester only if love and conscience can coexist."
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-goal-5",
      "characterId": "jane-eyre-char-rochester",
      "startEventId": "jane-eyre-event-023",
      "endEventId": "jane-eyre-event-054",
      "type": "want",
      "text": "Secure Jane’s love while escaping the legal and moral consequences of his concealed marriage."
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-goal-6",
