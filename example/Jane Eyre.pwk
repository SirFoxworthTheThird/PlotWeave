  "relationshipSnapshots": [],
  "timelines": [
    {
      "id": "jane-eyre-timeline-main",
      "worldId": "jane-eyre-world",
      "name": "Jane’s Life, c. 1800–1821",
      "description": "A single editorial chronology for Jane’s narrated life. Exact calendar dates are approximate because the novel’s internal dating is not fully consistent; the sequence and elapsed intervals follow the narrative.",
      "color": "#6c5966",
      "dayOffset": 0,
      "createdAt": 1786464000000
    }
  ],
  "chapters": [
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-01",
      "timelineId": "jane-eyre-timeline-main",
      "number": 1,
      "title": "The Window-Seat",
      "synopsis": "Excluded from the Reed family circle, Jane retreats into an illustrated book until John finds her. John strikes Jane and throws the book; she answers his tyranny aloud and is seized for punishment.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-02",
      "timelineId": "jane-eyre-timeline-main",
      "number": 2,
      "title": "The Red-Room",
      "synopsis": "Mrs Reed orders Jane confined in the chamber where Mr Reed died. A moving light and the thought of Mr Reed’s spirit overwhelm Jane before the adults return.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-03",
      "timelineId": "jane-eyre-timeline-main",
      "number": 3,
      "title": "A New Prospect",
      "synopsis": "The apothecary questions Jane about her unhappiness and takes seriously her wish for another life. Mr Lloyd proposes school, giving Jane her first practical route beyond Gateshead.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-04",
      "timelineId": "jane-eyre-timeline-main",
      "number": 4,
      "title": "Jane Speaks",
      "synopsis": "Lowood’s treasurer questions Jane’s religion while Mrs Reed privately labels her deceitful. After Brocklehurst leaves, Jane declares that she does not love her aunt and will tell others how she was treated.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-05",
      "timelineId": "jane-eyre-timeline-main",
      "number": 5,
      "title": "Arrival at Lowood",
      "synopsis": "Jane travels alone through winter darkness and is received at the remote institution. Cold water, burnt food, crowded lessons, and unfamiliar names define Jane’s first day.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-06",
      "timelineId": "jane-eyre-timeline-main",
      "number": 6,
      "title": "Helen Burns",
      "synopsis": "Miss Scatcherd singles Helen out for disorder and carelessness during lessons. In the evening Jane challenges Helen’s willingness to forgive injustice.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-07",
      "timelineId": "jane-eyre-timeline-main",
      "number": 7,
      "title": "Public Shame",
      "synopsis": "Brocklehurst visits during class and turns Jane’s accident into a public accusation of deceit. The girls pass Jane’s stool while Helen silently refuses the imposed verdict.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-08",
      "timelineId": "jane-eyre-timeline-main",
      "number": 8,
      "title": "Miss Temple’s Justice",
      "synopsis": "Miss Temple invites Jane and Helen to tea and hears the full Gateshead history. After Mr Lloyd confirms the account, Miss Temple announces that Jane is innocent.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-09",
      "timelineId": "jane-eyre-timeline-main",
      "number": 9,
      "title": "Helen’s Last Night",
      "synopsis": "Disease spreads through the underfed school, drawing outside attention to its conditions. Jane finds Helen dying of consumption and spends the night beside her.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-10",
      "timelineId": "jane-eyre-timeline-main",
      "number": 10,
      "title": "A Door Beyond Lowood",
      "synopsis": "Reform improves the school; Jane becomes first a successful pupil and then a teacher. Miss Temple’s marriage and departure awaken Jane’s desire for a wider field, so she seeks a governess post.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-11",
      "timelineId": "jane-eyre-timeline-main",
      "number": 11,
      "title": "Thornfield Hall",
      "synopsis": "Mrs Fairfax welcomes Jane, and Adèle’s presence clarifies the work awaiting her. During a tour of Thornfield, an uncanny laugh is attributed to Grace Poole.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-12",
      "timelineId": "jane-eyre-timeline-main",
      "number": 12,
      "title": "The Rider in Hay Lane",
      "synopsis": "Jane passes through the garden side of Thornfield on an errand that answers her need for movement beyond the household. Routine and confinement make Jane seek air, distance, and an errand beyond the estate. A horse slips on ice; Jane assists the injured stranger who will prove to be Rochester.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-13",
      "timelineId": "jane-eyre-timeline-main",
      "number": 13,
      "title": "The Master Returns",
      "synopsis": "Back at Thornfield, Rochester asks about Jane’s history, education, and accomplishments. Rochester studies three watercolours and recognizes emotional experience beyond Jane’s formal biography.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-14",
      "timelineId": "jane-eyre-timeline-main",
      "number": 14,
      "title": "An Evening Examination",
      "synopsis": "Rochester presses Jane into an intense fireside conversation about command, experience, and remorse. He speaks of past error and a hoped-for new life without naming the obstacle hidden in the house.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-15",
      "timelineId": "jane-eyre-timeline-main",
      "number": 15,
      "title": "Fire in the Night",
      "synopsis": "Rochester recounts Céline Varens’s betrayal and why he brought Adèle to England. Smoke wakes Jane; she finds Rochester’s curtains burning and extinguishes the flames.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-16",
      "timelineId": "jane-eyre-timeline-main",
      "number": 16,
      "title": "The Ingram Expectation",
      "synopsis": "The morning after the fire, Jane finds Grace sewing calmly and apparently unpunished. Learning that Blanche Ingram may marry Rochester, Jane contrasts her own plain image with an imagined society beauty.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-17",
      "timelineId": "jane-eyre-timeline-main",
      "number": 17,
      "title": "The House Party",
      "synopsis": "Rochester returns with fashionable guests who fill Thornfield with display and hierarchy. Music and conversation make the apparent courtship public while Jane measures affection against performance.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-18",
      "timelineId": "jane-eyre-timeline-main",
      "number": 18,
      "title": "Charades and Watchfulness",
      "synopsis": "Rochester and Blanche enact courtship, marriage, and captivity before the assembled company. A supposed fortune-teller refuses to leave until the unmarried women hear their futures.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-19",
      "timelineId": "jane-eyre-timeline-main",
      "number": 19,
      "title": "The Gypsy and the Stranger",
      "synopsis": "The disguised Rochester probes Jane’s feelings and claims her face reveals more than her words. A visitor from Spanish Town abruptly changes Rochester’s confidence.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-20",
      "timelineId": "jane-eyre-timeline-main",
      "number": 20,
      "title": "The Wounded Guest",
      "synopsis": "A cry wakes the house; Rochester contains the guests and leads Jane to a bleeding Mason. Jane sponges blood and prevents conversation until a surgeon can take Mason away.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-21",
      "timelineId": "jane-eyre-timeline-main",
      "number": 21,
      "title": "Return to Gateshead",
      "synopsis": "Bessie summons Jane to Mrs Reed, whose son is dead and whose health is failing. The dying woman admits that Jane’s uncle sought to adopt her and that she falsely reported Jane dead.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-22",
      "timelineId": "jane-eyre-timeline-main",
      "number": 22,
      "title": "Back to Thornfield",
      "synopsis": "Rochester waits on the road and turns Jane’s homecoming into an intimate welcome. Jane resumes teaching and evening conversation under the apparent deadline of Rochester’s marriage.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-23",
      "timelineId": "jane-eyre-timeline-main",
      "number": 23,
      "title": "Under the Chestnut Tree",
      "synopsis": "Under the chestnut tree, Rochester says marriage will send Jane to a distant post. Rochester reveals that Blanche was a provocation and asks Jane to marry him; a storm splits the tree that night.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-24",
      "timelineId": "jane-eyre-timeline-main",
      "number": 24,
      "title": "The Bride He Would Make",
      "synopsis": "Rochester orders jewels and luxurious clothes; Jane insists on remaining recognizable to herself. Jane plans to write to her uncle so that any inheritance might lessen the financial imbalance of marriage.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-25",
      "timelineId": "jane-eyre-timeline-main",
      "number": 25,
      "title": "Dreams and the Torn Veil",
      "synopsis": "During Rochester’s absence, Jane dreams of separation, a child she cannot carry, and the house reduced to ruin. Jane wakes to see an unknown woman examine and rend the wedding veil before the mirror.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-26",
      "timelineId": "jane-eyre-timeline-main",
      "number": 26,
      "title": "The Interrupted Wedding",
      "synopsis": "Briggs and Mason stop the ceremony with proof that Rochester has a living wife. The party enters the attic and sees Rochester’s confined wife.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-27",
      "timelineId": "jane-eyre-timeline-main",
      "number": 27,
      "title": "Rochester’s History",
      "synopsis": "Rochester recounts his arranged marriage, Caribbean life, and years of concealment. Jane refuses to become Rochester’s mistress and departs with little money while the household sleeps.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-28",
      "timelineId": "jane-eyre-timeline-main",
      "number": 28,
      "title": "Whitcross",
      "synopsis": "After spending nearly all her money on travel, Jane enters an unknown upland district with no planned destination. The coach sets Jane down at a lonely crossroads with almost no money and no known refuge. Repeated refusals leave Jane exposed to rain and starvation until light guides her toward Moor House.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-29",
      "timelineId": "jane-eyre-timeline-main",
      "number": 29,
      "title": "Moor House",
      "synopsis": "St John brings the exhausted stranger inside after Hannah initially turns her away. Jane gives an assumed surname and gradually joins the sisters’ reading and conversation.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-30",
      "timelineId": "jane-eyre-timeline-main",
      "number": 30,
      "title": "Morton School",
      "synopsis": "A modest village teaching post gives Jane work and a cottage of her own. The sisters return to governess positions, leaving Jane and St John to their separate duties.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-31",
      "timelineId": "jane-eyre-timeline-main",
      "number": 31,
      "title": "The First Day’s Work",
      "synopsis": "The village school begins with limited resources and pupils whose abilities Jane initially underestimates. The patron’s daughter brings beauty, generosity, and visible emotional disturbance to St John’s austere routine.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-32",
      "timelineId": "jane-eyre-timeline-main",
      "number": 32,
      "title": "Rosamond’s Portrait",
      "synopsis": "Jane’s pupils progress, and village respect replaces her first sense of degradation. Rosamond sits for a portrait while St John studies the likeness he refuses to claim in life.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-33",
      "timelineId": "jane-eyre-timeline-main",
      "number": 33,
      "title": "A Name and an Inheritance",
      "synopsis": "A torn scrap of paper connects Jane Elliott with the heiress sought by Briggs. John Eyre’s fortune belongs to Jane, and the Rivers siblings are revealed as her relatives.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-34",
      "timelineId": "jane-eyre-timeline-main",
      "number": 34,
      "title": "Christmas at Moor House",
      "synopsis": "Jane insists that the fortune be shared equally among all four cousins. The cousins furnish, cook, read, and celebrate together while St John remains emotionally apart.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-35",
      "timelineId": "jane-eyre-timeline-main",
      "number": 35,
      "title": "The Proposal for India",
      "synopsis": "St John argues that Jane’s abilities make her a suitable missionary wife, though he does not love her. At the brink of submission, Jane hears Rochester’s voice call her name across an impossible distance.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-36",
      "timelineId": "jane-eyre-timeline-main",
      "number": 36,
      "title": "The Ruins of Thornfield",
      "synopsis": "Jane returns and discovers the house roofless, blackened, and abandoned. At an inn Jane learns that Bertha burned the house and died, while Rochester lost a hand and his sight rescuing others.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-37",
      "timelineId": "jane-eyre-timeline-main",
      "number": 37,
      "title": "Ferndean",
      "synopsis": "Jane enters the secluded house and lets Rochester recognize her by voice and touch. Jane tells enough of her inheritance and family to establish that dependence no longer structures the proposal.",
      "notes": "",
      "wordGoal": null
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-chapter-38",
      "timelineId": "jane-eyre-timeline-main",
      "number": 38,
      "title": "Reader, I Married Him",
      "synopsis": "A quiet marriage begins the shared domestic life Jane narrates from ten years’ distance. Jane records their son, Rochester’s partial recovery of sight, her cousins’ lives, and St John’s final letter from India.",
      "notes": "",
      "wordGoal": null
    }
  ],
