      "startEventId": "jane-eyre-event-073",
      "endEventId": "jane-eyre-event-077",
      "type": "need",
      "text": "Accept truth, dependence, and mutual care after Thornfield’s destruction."
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-goal-7",
