      "characterBId": "jane-eyre-char-bertha",
      "label": "husband and confined wife",
      "strength": 5,
      "sentiment": "negative",
      "notes": "A legally binding marriage is transformed by secrecy, illness, coercion, and confinement into catastrophe.",
      "isMutual": false,
      "createdAtEventId": "jane-eyre-event-030"
    },
    {
      "worldId": "jane-eyre-world",
