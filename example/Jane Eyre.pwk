      "characterAId": "jane-eyre-char-jane",
      "characterBId": "jane-eyre-char-brocklehurst",
      "label": "pupil and oppressive authority",
      "strength": 5,
      "sentiment": "negative",
      "notes": "Brocklehurst imports Mrs Reed’s accusation into Lowood and uses public religion to shame Jane.",
      "isMutual": false,
      "createdAtEventId": "jane-eyre-event-007"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
