  "lorePages": [
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-1",
      "categoryId": "jane-eyre-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The structure follows Charlotte Brontë’s 1847 public-domain novel as presented by Project Gutenberg. Linked visual material includes F. H. Townsend and Edmund H. Garrett book illustrations from Wikimedia Commons. Historical overview maps and representative floor plans are editorial spatial aids, not canonical plans.",
      "tags": [],
      "coverImageId": "jane-eyre-image-cover",
      "linkedEntityIds": [
        "jane-eyre-world"
      ],
      "visibleFromEventId": "jane-eyre-event-001"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-2",
      "categoryId": "jane-eyre-lore-category-sources",
      "title": "An Editorial Geography",
      "body": "Gateshead, Lowood, Thornfield, Millcote, Whitcross, Morton, and Ferndean form a coherent fictional journey but cannot all be fixed to exact real coordinates. The overview therefore shows relative regions and the child layers organize narrative movement.",
      "tags": [],
      "coverImageId": "jane-eyre-image-map-england",
      "linkedEntityIds": [
        "jane-eyre-world"
      ],
      "visibleFromEventId": "jane-eyre-event-001"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-3",
      "categoryId": "jane-eyre-lore-category-setting",
      "title": "Lowood Institution",
      "body": "Lowood combines charitable education with privation. Its reform after the typhus epidemic shows that suffering came from governance and provision, not from an inevitable educational ideal.",
      "tags": [],
      "coverImageId": "jane-eyre-image-townsend-5",
      "linkedEntityIds": [
        "jane-eyre-map-lowood",
        "jane-eyre-faction-lowood"
      ],
      "visibleFromEventId": "jane-eyre-event-009"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-4",
      "categoryId": "jane-eyre-lore-category-setting",
      "title": "Thornfield’s Divided House",
      "body": "Public rooms support teaching, hospitality, and courtship; the upper passage supports concealment, paid surveillance, and confinement. The house’s vertical division is moral as well as architectural.",
      "tags": [],
      "coverImageId": "jane-eyre-image-garrett-bertha",
      "linkedEntityIds": [
        "jane-eyre-map-thornfield"
      ],
      "visibleFromEventId": "jane-eyre-event-021"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-5",
      "categoryId": "jane-eyre-lore-category-society",
      "title": "The Governess’s Position",
      "body": "A governess is educated yet employed, intimate with a family yet excluded from its class. Jane’s work at Thornfield makes that unstable social position central to courtship and self-respect.",
      "tags": [],
      "coverImageId": "jane-eyre-image-townsend-10",
      "linkedEntityIds": [
        "jane-eyre-char-jane",
        "jane-eyre-faction-ingram"
      ],
      "visibleFromEventId": "jane-eyre-event-021"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-6",
      "categoryId": "jane-eyre-lore-category-society",
      "title": "Marriage, Property, and Legal Identity",
      "body": "The interrupted wedding depends on a prior marriage that remains legally binding. Jane’s later inheritance changes the economic relation under which she could choose marriage.",
      "tags": [],
      "coverImageId": "jane-eyre-image-item-letter",
      "linkedEntityIds": [
        "jane-eyre-item-john-letter",
        "jane-eyre-char-briggs"
      ],
      "visibleFromEventId": "jane-eyre-event-052"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-7",
      "categoryId": "jane-eyre-lore-category-themes",
      "title": "Voice and Moral Equality",
      "body": "Jane’s defining acts repeatedly involve speaking when silence is expected: to Mrs Reed, Brocklehurst’s verdict, Rochester’s authority, and St John’s religious pressure.",
      "tags": [],
      "coverImageId": "jane-eyre-image-rochester-jane",
      "linkedEntityIds": [
        "jane-eyre-char-jane"
      ],
      "visibleFromEventId": "jane-eyre-event-007"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-8",
      "categoryId": "jane-eyre-lore-category-themes",
      "title": "Fire, Shelter, and Destruction",
      "body": "Fire warms rooms and makes fellowship possible, but at Thornfield it also reveals hidden danger and finally destroys the architecture of concealment.",
      "tags": [],
      "coverImageId": "jane-eyre-image-townsend-15",
      "linkedEntityIds": [
        "jane-eyre-map-thornfield"
      ],
      "visibleFromEventId": "jane-eyre-event-030"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-9",
      "categoryId": "jane-eyre-lore-category-themes",
      "title": "Seeing and Recognition",
      "body": "Portraits, mirrors, watching, blindness, and recovered sight distinguish outward appearance from sustained recognition of another person.",
      "tags": [],
      "coverImageId": "jane-eyre-image-ending",
      "linkedEntityIds": [
        "jane-eyre-char-rochester",
        "jane-eyre-item-drawings"
      ],
      "visibleFromEventId": "jane-eyre-event-026"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
      "updatedAt": 1786464000000,
      "id": "jane-eyre-lore-page-10",
      "categoryId": "jane-eyre-lore-category-themes",
      "title": "Faith Without Erasure",
      "body": "Helen’s consolation, Brocklehurst’s cruelty, St John’s vocation, and Jane’s conscience show religious language serving very different relations to suffering and freedom.",
      "tags": [],
      "coverImageId": "jane-eyre-image-townsend-12",
      "linkedEntityIds": [
        "jane-eyre-char-helen",
        "jane-eyre-char-brocklehurst",
        "jane-eyre-char-st-john"
      ],
      "visibleFromEventId": "jane-eyre-event-011"
    }
  ],
