  "world": {
    "id": "jane-eyre-world",
    "name": "Jane Eyre",
    "description": "Charlotte Brontë’s novel follows Jane Eyre from an unloved childhood through Lowood School, work as a governess at Thornfield Hall, flight across the moors, and the discovery of family and independence. Its Gothic secrets and intense love story remain governed by Jane’s insistence that conscience, economic freedom, and equality are necessary conditions of belonging.",
    "coverImageId": "jane-eyre-image-cover",
    "theme": "theme-gothic",
    "readingMode": true,
