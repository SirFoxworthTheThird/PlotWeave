      "strength": 5,
      "sentiment": "positive",
      "notes": "Teaching becomes affection, and Jane later secures healthier schooling for Adèle.",
      "isMutual": true,
      "createdAtEventId": "jane-eyre-event-021"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
