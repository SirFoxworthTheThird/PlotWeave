      "id": "jane-eyre-relationship-1",
      "characterAId": "jane-eyre-char-jane",
      "characterBId": "jane-eyre-char-rochester",
      "label": "lovers seeking equality",
      "strength": 5,
      "sentiment": "positive",
      "notes": "Intellectual recognition and desire survive only when Jane can return freely and Rochester can no longer conceal or command.",
      "isMutual": true,
      "createdAtEventId": "jane-eyre-event-023"
    },
    {
      "worldId": "jane-eyre-world",
      "createdAt": 1786464000000,
