  "lorePages": [
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-lore-page-1",
      "categoryId": "three-musketeers-lore-category-sources",
      "title": "Text, Maps, and Illustrations",
      "body": "The structure follows Alexandre Dumas’s 1844 public-domain novel. The linked visual record uses historical maps and nineteenth-century illustrations, especially work associated with Maurice Leloir; they are editorial aids rather than claims that every setting has an exact canonical plan.",
      "tags": [],
      "coverImageId": "three-musketeers-image-cover",
      "linkedEntityIds": [
        "three-musketeers-world"
      ],
      "visibleFromEventId": "three-musketeers-event-001"
    },
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-lore-page-2",
      "categoryId": "three-musketeers-lore-category-setting",
      "title": "Paris and the Two Guards",
      "body": "The novel’s Paris divides military prestige between the King’s Musketeers and the Cardinal’s guards. Inns, palaces, convents, and private lodgings make that political rivalry immediate and personal.",
      "tags": [],
      "coverImageId": "three-musketeers-image-four",
      "linkedEntityIds": [
        "three-musketeers-map-paris",
        "three-musketeers-faction-musketeers"
      ],
      "visibleFromEventId": "three-musketeers-event-002"
    },
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-lore-page-3",
      "categoryId": "three-musketeers-lore-category-setting",
      "title": "La Rochelle",
      "body": "The 1627–28 siege of the Protestant port is the historical campaign around which Dumas builds the novel’s invented missions, friendships, and private revenge.",
      "tags": [],
      "coverImageId": "three-musketeers-image-ship",
      "linkedEntityIds": [
        "three-musketeers-map-la-rochelle",
        "three-musketeers-faction-court"
      ],
      "visibleFromEventId": "three-musketeers-event-017"
    },
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-lore-page-4",
      "categoryId": "three-musketeers-lore-category-history",
      "title": "Fact and Romance",
      "body": "Dumas draws on historical names and conflicts but reshapes dates, relationships, and causality for romance. The d’Artagnan of the novel is not a biographical account of Charles de Batz de Castelmore.",
      "tags": [],
      "coverImageId": "three-musketeers-image-dartagnan",
      "linkedEntityIds": [
        "three-musketeers-char-dartagnan"
      ],
      "visibleFromEventId": "three-musketeers-event-001"
    },
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-lore-page-5",
      "categoryId": "three-musketeers-lore-category-themes",
      "title": "Friendship and Performance",
      "body": "Duels, clothing, rank, and public stories repeatedly test whether the four companions will treat honour as display or as care for one another.",
      "tags": [],
      "coverImageId": "three-musketeers-image-four",
      "linkedEntityIds": [
        "three-musketeers-char-athos",
        "three-musketeers-char-porthos",
        "three-musketeers-char-aramis"
      ],
      "visibleFromEventId": "three-musketeers-event-004"
    },
    {
      "worldId": "three-musketeers-world",
      "createdAt": 1786579200000,
      "updatedAt": 1786579200000,
      "id": "three-musketeers-lore-page-6",
      "categoryId": "three-musketeers-lore-category-themes",
      "title": "Secrets as Political Currency",
      "body": "Letters, jewels, identity, and witnesses become tools of power because a court depends on who may speak, who must remain hidden, and who controls a document.",
      "tags": [],
      "coverImageId": "three-musketeers-image-letter",
      "linkedEntityIds": [
        "three-musketeers-world",
        "three-musketeers-world"
      ],
      "visibleFromEventId": "three-musketeers-event-006"
    }
  ],
