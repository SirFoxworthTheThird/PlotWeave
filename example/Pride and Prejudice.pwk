"factionId":"pp-faction-pemberley","characterId":"pp-char-mrs-reynolds","role":"Housekeeper","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-21","factionId":"pp-faction-rosings","characterId":"pp-char-lady-catherine","role":"Mistress","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-22","factionId":"pp-faction-rosings","characterId":"pp-char-anne-de-bourgh","role":"Daughter","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-23","factionId":"pp-faction-rosings","characterId":"pp-char-jenkinson","role":"Companion","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-24","factionId":"pp-faction-rosings","characterId":"pp-char-collins","role":"Clerical dependent","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-25","factionId":"pp-faction-militia","characterId":"pp-char-forster","role":"Colonel","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-26","factionId":"pp-faction-militia","characterId":"pp-char-denny","role":"Officer","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-27","factionId":"pp-faction-militia","characterId":"pp-char-wickham","role":"Officer","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-28","factionId":"pp-faction-gardiners","characterId":"pp-char-gardiner","role":"Father and merchant","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-29","factionId":"pp-faction-gardiners","characterId":"pp-char-mrs-gardiner","role":"Mother","startEventId":null,"endEventId":null,"notes":""}],"factionRelationships":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-rel-1","factionAId":"pp-faction-bennets","factionBId":"pp-faction-netherfield","stance":"allied","notes":"Two courtships connect the households despite Caroline’s resistance."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-rel-2","factionAId":"pp-faction-bennets","factionBId":"pp-faction-militia","stance":"hostile","notes":"The regiment’s glamour culminates in Lydia’s flight and family crisis."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-rel-3","factionAId":"pp-faction-pemberley","factionBId":"pp-faction-rosings","stance":"strained","notes":"Family ties remain, but Darcy rejects Lady Catherine’s marriage design."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-rel-4","factionAId":"pp-faction-pemberley","factionBId":"pp-faction-gardiners","stance":"allied","notes":"Pemberley ultimately values the Gardiners’ character over their commercial connections."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-rel-5","factionAId":"pp-faction-lucases","factionBId":"pp-faction-rosings","stance":"dependent","notes":"The Hunsford household depends upon Lady Catherine’s patronage."}],"knowledgeFacts":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-slight","title":"Darcy insulted Elizabeth at the assembly","description":"Elizabeth overheard Darcy call her merely tolerable.","tags":[],"readerLearnsAtEventId":"pp-event-4","originEventId":"pp-event-4"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-wickham-story","title":"Wickham claims Darcy denied him a living","description":"Wickham presents himself as the victim of Darcy’s jealousy and injustice.","tags":[],"readerLearnsAtEventId":"pp-event-26","originEventId":"pp-event-26"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-caroline-design","title":"Caroline intends to separate Jane and Bingley","description":"Her London letter disguises active interference as friendly information.","tags":[],"readerLearnsAtEventId":"pp-event-34","originEventId":"pp-event-34"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-charlotte-choice","title":"Charlotte accepted Collins","description":"Charlotte chooses financial security and household independence.","tags":[],"readerLearnsAtEventId":"pp-event-35","originEventId":"pp-event-35"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-darcy-separated","title":"Darcy separated Bingley from Jane","description":"Colonel Fitzwilliam’s disclosure connects Darcy to Jane’s disappointment.","tags":[],"readerLearnsAtEventId":"pp-event-49","originEventId":"pp-event-49"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-georgiana","title":"Wickham attempted to elope with Georgiana","description":"Darcy’s letter reveals Wickham targeted his fifteen-year-old sister and her fortune.","tags":[],"readerLearnsAtEventId":"pp-event-54","originEventId":"pp-event-54"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-misjudgment","title":"Elizabeth misjudged Darcy and Wickham","description":"Rereading the letter exposes how vanity shaped her certainty.","tags":[],"readerLearnsAtEventId":"pp-event-54","originEventId":"pp-event-54"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-elopement","title":"Lydia fled without a secured marriage","description":"Jane’s delayed letters reveal the full risk of the Brighton flight.","tags":[],"readerLearnsAtEventId":"pp-event-70","originEventId":"pp-event-70"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-darcy-rescue","title":"Darcy funded Lydia’s marriage","description":"Mrs Gardiner reveals Darcy found the couple, paid debts, and arranged the settlement.","tags":[],"readerLearnsAtEventId":"pp-event-81","originEventId":"pp-event-81"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-catherine-hope","title":"Lady Catherine gave Darcy hope","description":"Elizabeth’s refusal to renounce him suggested her feelings had changed.","tags":[],"readerLearnsAtEventId":"pp-event-91","originEventId":"pp-event-91"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-fact-elizabeth-love","title":"Elizabeth loves Darcy","description":"Elizabeth confirms that esteem, gratitude, and understanding have become love.","tags":[],"readerLearnsAtEventId":"pp-event-92","originEventId":"pp-event-92"}],"knowledgeReveals":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-1","factId":"pp-fact-slight","characterId":"pp-char-elizabeth","eventId":"pp-event-4","note":"Elizabeth hears the dismissal directly."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-2","factId":"pp-fact-wickham-story","characterId":"pp-char-elizabeth","eventId":"pp-event-26","note":"Wickham wins Elizabeth’s initial trust."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-3","factId":"pp-fact-caroline-design","characterId":"pp-char-elizabeth","eventId":"pp-event-34","note":"Elizabeth recognises strategy where Jane sees friendship."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-4","factId":"pp-fact-charlotte-choice","characterId":"pp-char-elizabeth","eventId":"pp-event-35","note":"Elizabeth learns how differently Charlotte values marriage."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-5","factId":"pp-fact-darcy-separated","characterId":"pp-char-elizabeth","eventId":"pp-event-49","note":"The colonel unknowingly identifies Darcy’s role."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-6","factId":"pp-fact-georgiana","characterId":"pp-char-elizabeth","eventId":"pp-event-54","note":"Darcy entrusts Elizabeth with his sister’s secret history."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-7","factId":"pp-fact-misjudgment","characterId":"pp-char-elizabeth","eventId":"pp-event-54","note":"Elizabeth corrects her own account rather than merely replacing one man’s story with another."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-8","factId":"pp-fact-elopement","characterId":"pp-char-elizabeth","eventId":"pp-event-70","note":"Elizabeth receives the delayed family news."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-9","factId":"pp-fact-darcy-rescue","characterId":"pp-char-elizabeth","eventId":"pp-event-81","note":"Her aunt supplies the hidden history of the settlement."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-10","factId":"pp-fact-catherine-hope","characterId":"pp-char-elizabeth","eventId":"pp-event-91","note":"Darcy explains why he dared propose again."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-reveal-11","factId":"pp-fact-elizabeth-love","characterId":"pp-char-jane","eventId":"pp-event-92","note":"Jane becomes the first family member to know Elizabeth’s feelings."}],"characterGoals":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-1","characterId":"pp-char-elizabeth","startEventId":"pp-event-4","endEventId":"pp-event-90","type":"want","text":"Preserve independence while judging character for herself."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-2","characterId":"pp-char-elizabeth","startEventId":"pp-event-26","endEventId":"pp-event-54","type":"need","text":"Learn to test appealing stories against conduct and self-knowledge."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-3","characterId":"pp-char-darcy","startEventId":"pp-event-8","endEventId":"pp-event-90","type":"want","text":"Win Elizabeth without initially understanding why rank and manner estrange her."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-4","characterId":"pp-char-darcy","startEventId":"pp-event-51","endEventId":"pp-event-66","type":"need","text":"Replace entitlement and reserve with humility, civility, and accountable action."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-5","characterId":"pp-char-jane","startEventId":"pp-event-3","endEventId":"pp-event-84","type":"want","text":"Sustain hope in Bingley without sacrificing generosity or composure."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-6","characterId":"pp-char-bingley","startEventId":"pp-event-3","endEventId":"pp-event-84","type":"want","text":"Marry Jane and become independent of stronger personalities."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-7","characterId":"pp-char-mrs-bennet","startEventId":"pp-event-1","endEventId":"pp-event-96","type":"want","text":"Secure advantageous marriages for her daughters before the entail takes effect."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-8","characterId":"pp-char-charlotte","startEventId":"pp-event-35","endEventId":"pp-event-44","type":"want","text":"Gain a stable household through a practical marriage."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-9","characterId":"pp-char-lydia","startEventId":"pp-event-10","endEventId":"pp-event-79","type":"want","text":"Turn officers, attention, and escape into the status of marriage."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-10","characterId":"pp-char-wickham","startEventId":"pp-event-26","endEventId":"pp-event-74","type":"want","text":"Use charm, credit, and advantageous matches to escape consequences."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-11","characterId":"pp-char-gardiner","startEventId":"pp-event-72","endEventId":"pp-event-76","type":"want","text":"Protect Lydia and contain the Bennet family crisis through practical action."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-goal-12","characterId":"pp-char-caroline","startEventId":"pp-event-8","endEventId":"pp-event-82","type":"want","text":"Separate Jane from Bingley and prevent Darcy’s attachment to Elizabeth."}],"sceneTexts":[],"plotThreads":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-darcy-elizabeth","name":"Elizabeth and Darcy","color":"#845f72","description":"Mutual misjudgment becomes self-knowledge, changed conduct, and love."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-first-impressions","name":"First Impressions","color":"#6f7486","description":"Elizabeth and Darcy learn how vanity, reserve, testimony, and context distort judgment."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-bingley-jane","name":"Jane and Bingley","color":"#a27883","description":"A gentle courtship is interrupted by social interference and restored through greater independence."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-class-rank","name":"Class and Rank","color":"#75644e","description":"Land, trade, manners, and family connections shape how every courtship is judged."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-bennet-fortunes","name":"The Bennet Fortunes","color":"#8b6d56","description":"The entail and five daughters make marriage an economic as well as emotional pressure."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-caroline-jealousy","name":"Caroline’s Jealousy","color":"#80647d","description":"Caroline attempts to separate Jane and Bingley and discredit Elizabeth before Darcy."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-sisterhood","name":"The Bennet Sisters","color":"#a66f7c","description":"Jane and Elizabeth’s confidence contrasts with Kitty and Lydia’s imitation and risk."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-lydia-wickham","name":"Lydia and Wickham","color":"#9c594f","description":"Impulsive attraction and predatory opportunism threaten the entire family."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-collins-charlotte","name":"Collins and Charlotte","color":"#797557","description":"Charlotte chooses security through a marriage Elizabeth cannot admire."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-wickham-deception","name":"Wickham’s Deception","color":"#675d58","description":"Charm, selective storytelling, debt, and secrecy conceal Wickham’s conduct."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-thread-gardiners","name":"The Gardiners","color":"#61786f","description":"Elizabeth’s aunt and uncle provide judgment, practical aid, and a bridge to Pemberley."}],"motifs":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-manners","name":"Manners","color":"#7c6f75","description":"Courtesy can express character, conceal hostility, or bridge social distance."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-property","name":"Property and Home","color":"#796a52","description":"Longbourn, Netherfield, Rosings, and Pemberley reveal economic and moral structures."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-marriage-market","name":"The Marriage Market","color":"#9d6d70","description":"Courtship is evaluated through affection, income, security, family, and reputation."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-dancing","name":"Dancing","color":"#9a7958","description":"Balls turn attraction, refusal, rank, and embarrassment into public movement."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-pride","name":"Pride","color":"#745d68","description":"Self-respect, vanity, family honour, and inherited rank repeatedly collide."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-judgment","name":"Judgment and Misreading","color":"#637683","description":"Characters interpret looks, letters, stories, houses, and silences with uneven accuracy."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-sisterhood","name":"Sisterhood","color":"#9c7586","description":"Sisters confide, imitate, protect, embarrass, and learn from one another."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-letters","name":"Letters","color":"#6f7890","description":"Written accounts separate action from knowledge and repeatedly revise the plot."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-family","name":"Family","color":"#806d60","description":"Affection and embarrassment coexist with duty, inheritance, and influence."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-uniforms","name":"Officers and Uniforms","color":"#687788","description":"Military display gives Wickham status and Lydia a dangerous fantasy of romance."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-storytelling","name":"Competing Stories","color":"#7c697f","description":"The person who tells a history first often controls its moral meaning."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-music","name":"Music and Performance","color":"#8a6e84","description":"Public performance exposes vanity, confidence, and social pressure."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-secrets","name":"Secrets","color":"#695f70","description":"Concealed motives, histories, interventions, and hopes determine what others can judge."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-travel","name":"Journeys","color":"#60766e","description":"Movement beyond Longbourn creates new evidence, independence, and crisis."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-portraits","name":"Portraits and Appearances","color":"#766a5d","description":"Faces, painted likenesses, and outward polish are tested against conduct."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-motif-money","name":"Money and Settlement","color":"#80714f","description":"Income, debts, dowries, inheritance, and rescue shape the possible marriages."}],"continuitySuppressions":[],"writingLogs":[],"sceneRevisions":[]}