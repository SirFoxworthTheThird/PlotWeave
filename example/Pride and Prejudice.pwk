lacement-81-2","itemId":"pp-item-settlement","eventId":"pp-event-81","locationMarkerId":"pp-loc-longbourn","sortKey":801,"notes":"Present during “Mrs Gardiner Reveals Darcy’s Intervention”."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-placement-88-1","itemId":"pp-item-collins-letter","eventId":"pp-event-88","locationMarkerId":"pp-loc-longbourn","sortKey":870,"notes":"Present during “Mr Collins Warns of a Rumoured Match”."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-placement-89-1","itemId":"pp-item-aunt-letter","eventId":"pp-event-89","locationMarkerId":"pp-loc-oakham-mount","sortKey":880,"notes":"Present during “Darcy and Elizabeth Walk Together”."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-placement-94-1","itemId":"pp-item-darcy-letter","eventId":"pp-event-94","locationMarkerId":"pp-loc-longbourn","sortKey":930,"notes":"Present during “Elizabeth and Darcy Compare Their Changes”."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-placement-95-1","itemId":"pp-item-aunt-letter","eventId":"pp-event-95","locationMarkerId":"pp-loc-longbourn","sortKey":940,"notes":"Present during “The Engagement Letters Are Written”."}],"locationSnapshots":[],"itemSnapshots":[],"relationships":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-1","characterAId":"pp-char-elizabeth","characterBId":"pp-char-darcy","label":"Love through self-knowledge","strength":"strong","sentiment":"positive","description":"Their mutual attraction becomes durable only after both correct pride and prejudice.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-2","characterAId":"pp-char-jane","characterBId":"pp-char-bingley","label":"Devoted courtship","strength":"strong","sentiment":"positive","description":"Their open affection survives separation, persuasion, and misunderstanding.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-3","characterAId":"pp-char-elizabeth","characterBId":"pp-char-jane","label":"Confidante sisters","strength":"strong","sentiment":"positive","description":"They test one another’s judgments with trust, affection, and different temperaments.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-4","characterAId":"pp-char-elizabeth","characterBId":"pp-char-bennet","label":"Favourite daughter and father","strength":"strong","sentiment":"positive","description":"Shared wit creates intimacy, though Elizabeth sees the cost of his detachment.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-5","characterAId":"pp-char-elizabeth","characterBId":"pp-char-mrs-bennet","label":"Embarrassed daughter and anxious mother","strength":"medium","sentiment":"negative","description":"Elizabeth resists her mother’s pressure and public indiscretion.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-6","characterAId":"pp-char-bennet","characterBId":"pp-char-mrs-bennet","label":"Unequal marriage","strength":"medium","sentiment":"negative","description":"His contempt and withdrawal worsen the disorder created by her anxiety and folly.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-7","characterAId":"pp-char-lydia","characterBId":"pp-char-wickham","label":"Reckless marriage","strength":"strong","sentiment":"negative","description":"Lydia’s infatuation and Wickham’s opportunism require financial rescue.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-8","characterAId":"pp-char-collins","characterBId":"pp-char-charlotte","label":"Practical marriage","strength":"medium","sentiment":"neutral","description":"Charlotte exchanges romantic expectation for a manageable home and security.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-9","characterAId":"pp-char-caroline","characterBId":"pp-char-bingley","label":"Interfering siblings","strength":"strong","sentiment":"neutral","description":"Caroline tries to govern Bingley’s friendships and marriage through status.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-10","characterAId":"pp-char-caroline","characterBId":"pp-char-darcy","label":"Unreturned pursuit","strength":"medium","sentiment":"negative","description":"Caroline seeks Darcy’s approval while he grows interested in Elizabeth.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-11","characterAId":"pp-char-darcy","characterBId":"pp-char-georgiana","label":"Protective siblings","strength":"strong","sentiment":"positive","description":"Darcy’s guardianship protects Georgiana after Wickham’s attempted exploitation.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-12","characterAId":"pp-char-darcy","characterBId":"pp-char-wickham","label":"Former companions and enemies","strength":"strong","sentiment":"negative","description":"Childhood proximity gives way to debt, resentment, exposure, and reluctant rescue.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-13","characterAId":"pp-char-darcy","characterBId":"pp-char-bingley","label":"Influential friends","strength":"strong","sentiment":"positive","description":"Darcy’s judgment first separates Bingley from Jane and later helps repair the harm.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-14","characterAId":"pp-char-elizabeth","characterBId":"pp-char-mrs-gardiner","label":"Niece and confidante","strength":"strong","sentiment":"positive","description":"Mrs Gardiner offers affection, caution, and insight without control.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-15","characterAId":"pp-char-gardiner","characterBId":"pp-char-mrs-gardiner","label":"Capable partners","strength":"strong","sentiment":"positive","description":"They combine practical responsibility, observation, and hospitality.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-16","characterAId":"pp-char-elizabeth","characterBId":"pp-char-charlotte","label":"Friends divided by marriage","strength":"strong","sentiment":"neutral","description":"Their affection persists despite a profound disagreement over Collins.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-17","characterAId":"pp-char-lady-catherine","characterBId":"pp-char-darcy","label":"Aunt and resistant nephew","strength":"medium","sentiment":"neutral","description":"She treats family expectation as authority; Darcy ultimately rejects it.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-18","characterAId":"pp-char-lady-catherine","characterBId":"pp-char-collins","label":"Patroness and dependent","strength":"strong","sentiment":"neutral","description":"Collins converts Lady Catherine’s patronage into constant deference.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-19","characterAId":"pp-char-lady-catherine","characterBId":"pp-char-elizabeth","label":"Social adversaries","strength":"strong","sentiment":"negative","description":"Lady Catherine’s intimidation strengthens Elizabeth’s defence of choice.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-20","characterAId":"pp-char-kitty","characterBId":"pp-char-lydia","label":"Imitative sisters","strength":"strong","sentiment":"negative","description":"Kitty follows Lydia until separation creates room for improvement.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-21","characterAId":"pp-char-bennet","characterBId":"pp-char-lydia","label":"Neglectful father and reckless daughter","strength":"medium","sentiment":"negative","description":"His refusal to set limits helps leave Lydia exposed to Wickham.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-22","characterAId":"pp-char-forster","characterBId":"pp-char-lydia","label":"Failed guardianship","strength":"medium","sentiment":"negative","description":"The Brighton invitation grants freedom without adequate supervision.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-23","characterAId":"pp-char-wickham","characterBId":"pp-char-georgiana","label":"Predator and former target","strength":"strong","sentiment":"negative","description":"Wickham once planned to elope with Georgiana for her fortune.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-24","characterAId":"pp-char-elizabeth","characterBId":"pp-char-wickham","label":"Deceived listener","strength":"strong","sentiment":"negative","description":"Elizabeth’s wounded vanity makes Wickham’s false history attractive.","isBidirectional":true,"startEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-relationship-25","characterAId":"pp-char-jane","characterBId":"pp-char-caroline","label":"False friendship","strength":"medium","sentiment":"negative","description":"Jane offers sincerity while Caroline uses intimacy to separate her from Bingley.","isBidirectional":true,"startEventId":null}],"relationshipSnapshots":[],"timelines":[{"id":"pp-timeline-main","worldId":"pride-prejudice-world","name":"Pride and Prejudice — Master Chronology","description":"A single reading-order timeline from the Netherfield lease to the marriages and their aftermath.","color":"#845f72","dayOffset":0,"createdAt":1785672000000}],"chapters":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-01","timelineId":"pp-timeline-main","number":1,"title":"Chapter 1","synopsis":"Netherfield’s new tenant turns marriage into urgent neighbourhood business.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-02","timelineId":"pp-timeline-main","number":2,"title":"Chapter 2","synopsis":"Mr Bennet reveals that he has already visited Bingley.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-03","timelineId":"pp-timeline-main","number":3,"title":"Chapter 3","synopsis":"At the Meryton assembly Bingley admires Jane while Darcy insults Elizabeth.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-04","timelineId":"pp-timeline-main","number":4,"title":"Chapter 4","synopsis":"Jane and Elizabeth compare Bingley’s openness with Darcy’s reserve.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-05","timelineId":"pp-timeline-main","number":5,"title":"Chapter 5","synopsis":"The Lucases and Bennets debate pride, vanity, and the assembly.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-06","timelineId":"pp-timeline-main","number":6,"title":"Chapter 6","synopsis":"Darcy’s interest in Elizabeth grows while she remains amused by him.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-07","timelineId":"pp-timeline-main","number":7,"title":"Chapter 7","synopsis":"The militia arrives; Jane rides to Netherfield, falls ill, and summons Elizabeth.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-08","timelineId":"pp-timeline-main","number":8,"title":"Chapter 8","synopsis":"Elizabeth’s muddy arrival exposes class judgments at Netherfield.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-09","timelineId":"pp-timeline-main","number":9,"title":"Chapter 9","synopsis":"Mrs Bennet’s visit embarrasses Elizabeth and encourages Lydia.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-10","timelineId":"pp-timeline-main","number":10,"title":"Chapter 10","synopsis":"Darcy and Elizabeth spar while Caroline tries to command his attention.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-11","timelineId":"pp-timeline-main","number":11,"title":"Chapter 11","synopsis":"The Netherfield party debates accomplished women, defects, and resentment.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-12","timelineId":"pp-timeline-main","number":12,"title":"Chapter 12","synopsis":"Jane recovers and the Bennet sisters return home.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-13","timelineId":"pp-timeline-main","number":13,"title":"Chapter 13","synopsis":"Mr Collins writes and arrives as the male heir to Longbourn.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-14","timelineId":"pp-timeline-main","number":14,"title":"Chapter 14","synopsis":"Collins praises Rosings and fails to improve the family evening.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-15","timelineId":"pp-timeline-main","number":15,"title":"Chapter 15","synopsis":"In Meryton, Wickham meets Elizabeth and exchanges a charged look with Darcy.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-16","timelineId":"pp-timeline-main","number":16,"title":"Chapter 16","synopsis":"Wickham gives Elizabeth his persuasive account of Darcy’s injustice.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-17","timelineId":"pp-timeline-main","number":17,"title":"Chapter 17","synopsis":"Elizabeth tells Jane; a Netherfield ball is announced.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-18","timelineId":"pp-timeline-main","number":18,"title":"Chapter 18","synopsis":"The Netherfield ball magnifies every attraction, error, and embarrassment.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-19","timelineId":"pp-timeline-main","number":19,"title":"Chapter 19","synopsis":"Collins proposes to Elizabeth and refuses to believe her refusal.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-20","timelineId":"pp-timeline-main","number":20,"title":"Chapter 20","synopsis":"Mrs Bennet pressures Elizabeth; Mr Bennet supports her decision.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-21","timelineId":"pp-timeline-main","number":21,"title":"Chapter 21","synopsis":"Collins withdraws while Caroline’s letter announces Bingley’s departure.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-22","timelineId":"pp-timeline-main","number":22,"title":"Chapter 22","synopsis":"Collins proposes to Charlotte, who accepts for practical security.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-23","timelineId":"pp-timeline-main","number":23,"title":"Chapter 23","synopsis":"The Lucas engagement shocks Elizabeth and enrages Mrs Bennet.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-24","timelineId":"pp-timeline-main","number":24,"title":"Chapter 24","synopsis":"Jane suffers quietly while Elizabeth condemns Bingley’s friends and Darcy.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-25","timelineId":"pp-timeline-main","number":25,"title":"Chapter 25","synopsis":"The Gardiners arrive and Mrs Gardiner observes Jane and Wickham.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-26","timelineId":"pp-timeline-main","number":26,"title":"Chapter 26","synopsis":"Jane’s London hopes fade; Elizabeth maintains correspondence with Charlotte.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-27","timelineId":"pp-timeline-main","number":27,"title":"Chapter 27","synopsis":"Elizabeth travels toward Hunsford through London and the Gardiner household.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-28","timelineId":"pp-timeline-main","number":28,"title":"Chapter 28","synopsis":"Elizabeth reaches the Collinses’ parsonage and sees Rosings.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-29","timelineId":"pp-timeline-main","number":29,"title":"Chapter 29","synopsis":"Lady Catherine interrogates the visitors at dinner.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-30","timelineId":"pp-timeline-main","number":30,"title":"Chapter 30","synopsis":"Darcy and Colonel Fitzwilliam arrive at Rosings.","notes":"","wordGoal":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-chapter-31","timeli