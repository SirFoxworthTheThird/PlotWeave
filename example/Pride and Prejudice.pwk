/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Thomson-PP21.jpg?width=720","createdAt":1785672000000},{"id":"pp-image-art-anne-de-bourgh","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Thomson-PP22.jpg?width=720","createdAt":1785672000000},{"id":"pp-image-art-jenkinson","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P%20ch%2028.jpg?width=720","createdAt":1785672000000},{"id":"pp-image-art-hill","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Thomson-PP-Ch51.JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-peacock","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Thomson-P%26P-Incipit.jpg?width=720","createdAt":1785672000000},{"id":"pp-image-art-proposal","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P34-D%C3%A9claration%20de%20Darcy%20(BrockNB).JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-letter","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P35-la%20lettre.JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-pemberley","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P43-Devant%20le%20portrait%20de%20Darcy%20(BrockNB).JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-ring","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Lydia%20showing%20her%20ring%20CH51.jpg?width=720","createdAt":1785672000000},{"id":"pp-image-art-dance","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/PrideandPrejudiceCH3.jpg?width=720","createdAt":1785672000000},{"id":"pp-image-art-netherfield","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P10-Netherfield%20(NB).JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-sermons","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P14-Collins%20lit%20Fordice.JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-carriage","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P27%20(a%20troop%20of%20boys%20%26%20girls).JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-visiting","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P44-Visiting%20Lambton.JPG?width=720","createdAt":1785672000000},{"id":"pp-image-art-reconciliation","worldId":"pride-prejudice-world","mimeType":"image/jpeg","url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/P%26P52-Do%20not%20let%20us%20quarrel%20about%20the%20past.JPG?width=720","createdAt":1785672000000}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-route-meryton-circuit","mapLayerId":"pp-map-hertfordshire","name":"The Meryton Social Circuit","routeType":"foot","waypoints":["pp-loc-longbourn","pp-loc-meryton","pp-loc-assembly","pp-loc-lucas-lodge","pp-loc-netherfield"],"color":"#8e6f75","notes":"The local movement through which first impressions, gossip, and courtship develop."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-route-london-visits","mapLayerId":"pp-map-london","name":"London Visits and Search","routeType":"carriage","waypoints":["pp-loc-gardiner-house","pp-loc-darcy-london","pp-loc-wickham-lodgings"],"color":"#65798a","notes":"Editorially combines Jane’s visit, Darcy’s metropolitan connections, and the search for Lydia."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-route-hunsford","mapLayerId":"pp-map-kent","name":"Hunsford and Rosings Walks","routeType":"foot","waypoints":["pp-loc-hunsford","pp-loc-rosings","pp-loc-rosings-grove"],"color":"#7d6d55","notes":"Elizabeth’s repeated movement between the parsonage, Rosings, and the grove where the letter is delivered."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-route-pemberley","mapLayerId":"pp-map-derbyshire","name":"The Derbyshire Tour","routeType":"carriage","waypoints":["pp-loc-lambton","pp-loc-lambton-inn","pp-loc-pemberley"],"color":"#64766d","notes":"The Gardiners and Elizabeth approach Pemberley from Lambton and move between inn, house, and grounds."}],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"pp-lore-category-property","worldId":"pride-prejudice-world","name":"Property and Inheritance","color":"#7d6a52","sortOrder":1},{"id":"pp-lore-category-courtship","worldId":"pride-prejudice-world","name":"Courtship and Reputation","color":"#966b76","sortOrder":2},{"id":"pp-lore-category-society","worldId":"pride-prejudice-world","name":"Rank and Manners","color":"#68778a","sortOrder":3},{"id":"pp-lore-category-knowledge","worldId":"pride-prejudice-world","name":"Letters and Knowledge","color":"#706581","sortOrder":4},{"id":"pp-lore-category-sources","worldId":"pride-prejudice-world","name":"Sources and Editorial Notes","color":"#85775e","sortOrder":5}],"lorePages":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-1","categoryId":"pp-lore-category-property","title":"The Longbourn Entail","body":"Longbourn is entailed in the male line to Mr Collins. Mrs Bennet’s anxiety is comic in expression but grounded in the real insecurity facing five daughters with limited fortunes.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-2","categoryId":"pp-lore-category-property","title":"Marriage Settlements and Income","body":"Annual income, dowries, debts, property, and settlements define what characters call prudence, advantage, or rescue. The novel never reduces marriage to money, but never permits money to disappear from it.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-3","categoryId":"pp-lore-category-courtship","title":"Balls and Dancing","body":"Assemblies and private balls make preference public. A second dance signals attention; a refusal can humiliate; a partner forces conversation within a strict social form.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-4","categoryId":"pp-lore-category-courtship","title":"Elopement and Reputation","body":"Lydia’s unmarried flight with Wickham threatens not only her position but the marriage prospects of every Bennet sister. The settlement contains the scandal without reforming the couple.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-5","categoryId":"pp-lore-category-society","title":"The Meryton Militia","body":"The regiment supplies Meryton with uniforms, gossip, and mobile young men. It also gives Wickham borrowed prestige and leads Lydia from local flirtation to Brighton.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-6","categoryId":"pp-lore-category-society","title":"Trade, Land, and Gentility","body":"The Gardiners’ trade connections expose Darcy’s early snobbery, yet their conduct repeatedly exceeds that of wealthier characters. Pemberley ultimately welcomes character rather than pedigree.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-7","categoryId":"pp-lore-category-knowledge","title":"Darcy and Wickham’s History","body":"Darcy’s letter explains Wickham’s exchanged living, debts, and attempted elopement with Georgiana. Later conduct and independent testimony confirm the account.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-8","categoryId":"pp-lore-category-knowledge","title":"The Hunsford Letter","body":"Darcy’s letter is the novel’s epistemic hinge: a private document that requires Elizabeth to reread both the page and herself.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-9","categoryId":"pp-lore-category-knowledge","title":"Pemberley as Testimony","body":"The estate, Mrs Reynolds, Georgiana, and Darcy’s hospitality reveal responsibility through a network of conduct rather than a single self-defence.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-10","categoryId":"pp-lore-category-sources","title":"Editorial Calendar","body":"The event dates form a coherent reading calendar anchored broadly to the novel’s autumn-to-autumn sequence. Exact days are an editorial reconstruction where Austen supplies only relative time.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-11","categoryId":"pp-lore-category-sources","title":"Fictional Geography","body":"Longbourn, Meryton, Netherfield, Rosings, and Pemberley are fictional. Their markers preserve narrative relationships on historical or regional maps rather than claiming canonical coordinates.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-lore-12","categoryId":"pp-lore-category-sources","title":"Text, Illustration, and Map Sources","body":"Chapter checking follows the public-domain Project Gutenberg edition (ebook 1342). Illustration links use Hugh Thomson and C. E. Brock images on Wikimedia Commons; maps link to historical and locator maps there. Summaries and status notes are newly written.","tags":[],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":null}],"factions":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-bennets","name":"The Bennet Household","description":"The Longbourn family, whose affection and disorder drive every marriage plot.","color":"#8b6771","coverImageId":null,"tags":[]},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-netherfield","name":"The Netherfield Party","description":"Bingley’s household, including sisters who attempt to manage his social future.","color":"#63788b","coverImageId":null,"tags":[]},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-lucases","name":"The Lucas and Collins Household","description":"The Lucas family and Charlotte’s practical Hunsford establishment.","color":"#74765f","coverImageId":null,"tags":[]},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-pemberley","name":"The Pemberley Family","description":"Darcy, Georgiana, and the household shaped by responsibility and inheritance.","color":"#5f7180","coverImageId":null,"tags":[]},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-rosings","name":"The Rosings Circle","description":"Lady Catherine’s household and dependants, organised around rank and patronage.","color":"#765b68","coverImageId":null,"tags":[]},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-militia","name":"The Meryton Militia","description":"Officers whose arrival transforms local social life and enables Wickham.","color":"#687786","coverImageId":null,"tags":[]},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-faction-gardiners","name":"The Gardiner Household","description":"The capable London relations who support the Bennets in travel and crisis.","color":"#62786d","coverImageId":null,"tags":[]}],"factionMemberships":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-1","factionId":"pp-faction-bennets","characterId":"pp-char-bennet","role":"Father","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-2","factionId":"pp-faction-bennets","characterId":"pp-char-mrs-bennet","role":"Mother","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-membership-3","factionId":"pp-faction-bennets","characterId":"pp-char-jane","role":"Daughter","startEventId":null,"endEventId":null,"notes":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":17856