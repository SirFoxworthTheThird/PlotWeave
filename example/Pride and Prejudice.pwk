{"version":16,"type":"worldbreaker-export","exportedAt":1785672000000,"world":{"id":"pride-prejudice-world","name":"Pride and Prejudice","description":"Jane Austen’s novel follows Elizabeth Bennet and Fitzwilliam Darcy through attraction, error, social pressure, family crisis, and the difficult revision of first impressions, alongside the contrasting courtships of the Bennet sisters.","coverImageId":"pp-image-cover","theme":"theme-romance","readingMode":true,"createdAt":1785672000000,"updatedAt":1785672000000,"continuityStaleThreshold":5,"calendar":{"startYear":1811,"yearSuffix":" (editorial reconstruction)","months":[{"name":"January","days":31},{"name":"February","days":28},{"name":"March","days":31},{"name":"April","days":30},{"name":"May","days":31},{"name":"June","days":30},{"name":"July","days":31},{"name":"August","days":31},{"name":"September","days":30},{"name":"October","days":31},{"name":"November","days":30},{"name":"December","days":31}]},"wordTarget":null},"mapLayers":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-map-england","parentMapId":null,"name":"England in the Regency Era","description":"The novel’s journeys between Hertfordshire, London, Kent, Derbyshire, Sussex, and the north.","imageId":"pp-image-map-england","imageWidth":960,"imageHeight":1483,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-map-hertfordshire","parentMapId":"pp-map-england","name":"Hertfordshire and the Meryton Neighbourhood","description":"Editorial placements for Longbourn, Netherfield, Lucas Lodge, and Meryton on a historical county map.","imageId":"pp-image-map-hertfordshire","imageWidth":1280,"imageHeight":944,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":""},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":17856