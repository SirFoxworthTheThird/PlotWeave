 match."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-snapshot-3-elizabeth","characterId":"pp-char-elizabeth","eventId":"pp-event-3","isAlive":true,"currentLocationMarkerId":"pp-loc-assembly","currentMapLayerId":"pp-map-hertfordshire","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":23,"statusNotes":"Observing Jane’s happiness and Bingley’s easy sociability."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-snapshot-4-darcy","characterId":"pp-char-darcy","eventId":"pp-event-4","isAlive":true,"currentLocationMarkerId":"pp-loc-assembly","currentMapLayerId":"pp-map-hertfordshire","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":30,"statusNotes":"Withdrawing behind rank and reserve, dismissing Elizabeth as merely tolerable."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-snapshot-4-bingley","characterId":"pp-char-bingley","eventId":"pp-event-4","isAlive":true,"currentLocationMarkerId":"pp-loc-assembly","currentMapLayerId":"pp-map-hertfordshire","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":31,"statusNotes":"Urging Darcy to join the dance and enjoy the company."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-snapshot-4-elizabeth","characterId":"pp-char-elizabeth","eventId":"pp-event-4","isAlive":true,"currentLocationMarkerId":"pp-loc-assembly","currentMapLayerId":"pp-map-hertfordshire","inventoryItemIds":[],"inventoryNotes":"","travelModeId":null,"sortKey":32,"statusNotes":"Turning a public slight into a story she can laugh about."},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-snapshot-4-jane","characterId":"pp-char-jane","eventId":"pp-event-4","isAlive":true,"currentLocationMarkerId":"pp-loc-assembly","currentMapLayerId":"pp-map-hertfordshire","inventor