d":null,"imageId":"pp-image-art-carriage"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-loc-brighton-camp","mapLayerId":"pp-map-sussex","linkedMapLayerId":null,"name":"Brighton Militia Camp","description":"The Forsters’ station where Lydia follows the regiment.","x":740,"y":250,"iconType":"building","tags":[],"factionId":null,"imageId":"pp-image-art-mrs-forster"},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-loc-brighton-town","mapLayerId":"pp-map-sussex","linkedMapLayerId":null,"name":"Brighton","description":"The seaside town from which Lydia and Wickham disappear.","x":700,"y":225,"iconType":"town","tags":[],"factionId":null,"imageId":"pp-image-art-lydia"}],"characters":[{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-elizabeth","name":"Elizabeth Bennet","aliases":[],"description":"Intelligent and independent second Bennet daughter whose judgments of Darcy and Wickham must be revised.","portraitImageId":"pp-image-art-elizabeth","color":"#8f6d78","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-darcy","name":"Fitzwilliam Darcy","aliases":[],"description":"Wealthy master of Pemberley whose reserve, pride, loyalty, and capacity for change shape the central courtship.","portraitImageId":"pp-image-art-darcy","color":"#556b78","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-jane","name":"Jane Bennet","aliases":[],"description":"The eldest Bennet daughter, generous in judgment and quietly in love with Bingley.","portraitImageId":"pp-image-art-jane","color":"#9a7a82","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-bingley","name":"Charles Bingley","aliases":[],"description":"Good-humoured tenant of Netherfield who falls readily in love with Jane.","portraitImageId":"pp-image-art-bingley","color":"#718297","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-bennet","name":"Mr Bennet","aliases":[],"description":"Witty but withdrawn father whose amusement often substitutes for responsible action.","portraitImageId":"pp-image-art-bennet","color":"#756a5b","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mrs-bennet","name":"Mrs Bennet","aliases":[],"description":"Anxious and indiscreet mother determined to marry her five daughters advantageously.","portraitImageId":"pp-image-art-mrs-bennet","color":"#a06c70","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mary","name":"Mary Bennet","aliases":[],"description":"Bookish third Bennet daughter given to moral observations and public performance.","portraitImageId":"pp-image-art-mary","color":"#74677b","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-kitty","name":"Catherine “Kitty” Bennet","aliases":[],"description":"Impressionable fourth Bennet daughter who follows Lydia until separation improves her.","portraitImageId":"pp-image-art-kitty","color":"#a17c8c","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-lydia","name":"Lydia Bennet","aliases":[],"description":"Impulsive youngest Bennet daughter whose elopement with Wickham threatens the family.","portraitImageId":"pp-image-art-lydia","color":"#b36c76","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-wickham","name":"George Wickham","aliases":[],"description":"Charming militia officer who conceals debts, attempted exploitation, and bad faith.","portraitImageId":"pp-image-art-wickham","color":"#76685c","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-collins","name":"Mr William Collins","aliases":[],"description":"Obsequious clergyman and Longbourn heir who proposes first to Elizabeth and then Charlotte.","portraitImageId":"pp-image-art-collins","color":"#847853","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-charlotte","name":"Charlotte Lucas","aliases":[],"description":"Elizabeth’s pragmatic friend, who secures stability by marrying Mr Collins.","portraitImageId":"pp-image-art-charlotte","color":"#74806c","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-caroline","name":"Caroline Bingley","aliases":[],"description":"Bingley’s status-conscious sister, hostile to Jane and Elizabeth and attentive to Darcy.","portraitImageId":"pp-image-art-caroline","color":"#876885","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mrs-hurst","name":"Louisa Hurst","aliases":[],"description":"Bingley’s married sister and Caroline’s ally in social exclusion.","portraitImageId":"pp-image-art-mrs-hurst","color":"#7f7188","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mr-hurst","name":"Mr Hurst","aliases":[],"description":"Louisa’s indolent husband, chiefly interested in cards, food, and comfort.","portraitImageId":"pp-image-art-mr-hurst","color":"#756b63","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-georgiana","name":"Georgiana Darcy","aliases":[],"description":"Darcy’s shy younger sister, once targeted by Wickham and later befriended by Elizabeth.","portraitImageId":"pp-image-art-georgiana","color":"#8c8296","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-colonel-fitzwilliam","name":"Colonel Fitzwilliam","aliases":[],"description":"Darcy’s sociable cousin, Georgiana’s co-guardian, and Elizabeth’s companion at Hunsford.","portraitImageId":"pp-image-art-colonel-fitzwilliam","color":"#687889","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-lady-catherine","name":"Lady Catherine de Bourgh","aliases":[],"description":"Darcy’s domineering aunt, patroness of Collins, and defender of inherited rank.","portraitImageId":"pp-image-art-lady-catherine","color":"#815a64","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-anne-de-bourgh","name":"Anne de Bourgh","aliases":[],"description":"Lady Catherine’s sickly daughter and imagined future wife for Darcy.","portraitImageId":"pp-image-art-anne-de-bourgh","color":"#8a7c83","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-jenkinson","name":"Mrs Jenkinson","aliases":[],"description":"Anne de Bourgh’s attentive companion.","portraitImageId":"pp-image-art-jenkinson","color":"#77716c","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-sir-william","name":"Sir William Lucas","aliases":[],"description":"Courteous former mayor who delights in ceremony and social distinction.","portraitImageId":"pp-image-art-sir-william","color":"#8a744f","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-lady-lucas","name":"Lady Lucas","aliases":[],"description":"Charlotte’s mother and Mrs Bennet’s neighbourly rival.","portraitImageId":"pp-image-art-lady-lucas","color":"#917360","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-maria","name":"Maria Lucas","aliases":[],"description":"Charlotte’s younger sister and Elizabeth’s fellow traveller to Hunsford.","portraitImageId":"pp-image-art-maria","color":"#8d7f72","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-gardiner","name":"Mr Edward Gardiner","aliases":[],"description":"Mrs Bennet’s sensible brother, a London merchant and responsible uncle.","portraitImageId":"pp-image-art-gardiner","color":"#65766c","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mrs-gardiner","name":"Mrs Gardiner","aliases":[],"description":"Elizabeth’s perceptive aunt, trusted confidante, and companion at Pemberley.","portraitImageId":"pp-image-art-mrs-gardiner","color":"#7e7770","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mr-philips","name":"Mr Philips","aliases":[],"description":"Meryton attorney and Mrs Bennet’s brother-in-law.","portraitImageId":"pp-image-art-mr-philips","color":"#6f7069","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mrs-philips","name":"Mrs Philips","aliases":[],"description":"Mrs Bennet’s gossip-loving sister in Meryton.","portraitImageId":"pp-image-art-mrs-philips","color":"#9a716d","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-denny","name":"Mr Denny","aliases":[],"description":"Militia officer who introduces Wickham to the Bennet circle.","portraitImageId":"pp-image-art-denny","color":"#65717b","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-forster","name":"Colonel Forster","aliases":[],"description":"Commander of the militia regiment and host responsible for Lydia in Brighton.","portraitImageId":"pp-image-art-forster","color":"#5f7181","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mrs-forster","name":"Mrs Forster","aliases":[],"description":"Young wife of Colonel Forster and Lydia’s friend, who invites her to Brighton.","portraitImageId":"pp-image-art-mrs-forster","color":"#a17f8a","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-miss-king","name":"Miss Mary King","aliases":[],"description":"A young heiress briefly courted by Wickham.","portraitImageId":"pp-image-art-miss-king","color":"#8a7a65","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mrs-reynolds","name":"Mrs Reynolds","aliases":[],"description":"Pemberley housekeeper whose testimony challenges Elizabeth’s view of Darcy.","portraitImageId":"pp-image-art-mrs-reynolds","color":"#737b70","tags":[],"isAlive":true,"birthDate":null},{"worldId":"pride-prejudice-world","createdAt":1785672000000,"updatedAt":1785672000000,"id":"pp-char-mrs-younge","name":"Mrs Younge","aliases":[],"description":"Former Georgiana companion whose connection 