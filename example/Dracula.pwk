ue,"startEventId":"dracula-event-24","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-2","worldId":"dracula-1897-world","characterAId":"dracula-char-mina","characterBId":"dracula-char-lucy","label":"Closest Friends","strength":"bond","sentiment":"positive","description":"Intimate friends whose correspondence and shared summer at Whitby anchor the early English record.","isBidirectional":true,"startEventId":"dracula-event-13","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-3","worldId":"dracula-1897-world","characterAId":"dracula-char-lucy","characterBId":"dracula-char-arthur","label":"Engaged","strength":"bond","sentiment":"positive","description":"Lucy accepts Arthur; their love gives the final release from undeath its emotional force.","isBidirectional":true,"startEventId":"dracula-event-13","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-4","worldId":"dracula-1897-world","characterAId":"dracula-char-lucy","characterBId":"dracula-char-seward","label":"Friend and Former Suitor","strength":"strong","sentiment":"complex","description":"Seward remains her doctor and loyal friend after she declines his proposal.","isBidirectional":false,"startEventId":"dracula-event-14","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-5","worldId":"dracula-1897-world","characterAId":"dracula-char-lucy","characterBId":"dracula-char-quincey","label":"Friend and Former Suitor","strength":"strong","sentiment":"positive","description":"Quincey accepts Lucy’s refusal and continues to serve her interests.","isBidirectional":false,"startEventId":"dracula-event-15","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-6","worldId":"dracula-1897-world","characterAId":"dracula-char-seward","characterBId":"dracula-char-van-helsing","label":"Student and Mentor","strength":"bond","sentiment":"positive","description":"Seward trusts his former teacher, who leads him beyond conventional medicine.","isBidirectional":true,"startEventId":"dracula-event-29","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-7","worldId":"dracula-1897-world","characterAId":"dracula-char-seward","characterBId":"dracula-char-renfield","label":"Doctor and Patient","strength":"strong","sentiment":"complex","description":"Clinical fascination grows into tragic responsibility when Seward misreads Renfield’s warning.","isBidirectional":false,"startEventId":"dracula-event-14","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-8","worldId":"dracula-1897-world","characterAId":"dracula-char-dracula","characterBId":"dracula-char-jonathan","label":"Captor and Prisoner","strength":"strong","sentiment":"negative","description":"Dracula imprisons Jonathan, exploits his legal knowledge, and later becomes the object of his vengeance.","isBidirectional":false,"startEventId":"dracula-event-4","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-9","worldId":"dracula-1897-world","characterAId":"dracula-char-dracula","characterBId":"dracula-char-lucy","label":"Predator and Victim","strength":"strong","sentiment":"negative","description":"Dracula repeatedly feeds on Lucy and turns her into an undead predator.","isBidirectional":false,"startEventId":"dracula-event-25","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-10","worldId":"dracula-1897-world","characterAId":"dracula-char-dracula","characterBId":"dracula-char-mina","label":"Blood Bond","strength":"bond","sentiment":"negative","description":"Dracula attacks Mina and creates a coercive psychic connection that the hunters reverse into a tracking link.","isBidirectional":false,"startEventId":"dracula-event-67","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-11","worldId":"dracula-1897-world","characterAId":"dracula-char-dracula","characterBId":"dracula-char-renfield","label":"Master and Thrall","strength":"strong","sentiment":"complex","description":"Renfield worships the promised giver of lives, then resists him to protect Mina.","isBidirectional":false,"startEventId":"dracula-event-17","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-12","worldId":"dracula-1897-world","characterAId":"dracula-char-dracula","characterBId":"dracula-char-three-women","label":"Master and Household","strength":"strong","sentiment":"complex","description":"Dracula commands the three vampire women and denies them Jonathan.","isBidirectional":false,"startEventId":"dracula-event-9","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-13","worldId":"dracula-1897-world","characterAId":"dracula-char-arthur","characterBId":"dracula-char-quincey","label":"Loyal Friends","strength":"bond","sentiment":"positive","description":"The former rivals maintain an affectionate, practical friendship.","isBidirectional":true,"startEventId":"dracula-event-15","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-14","worldId":"dracula-1897-world","characterAId":"dracula-char-arthur","characterBId":"dracula-char-seward","label":"Loyal Friends","strength":"bond","sentiment":"positive","description":"Lucy’s illness and death turn the former rivals into brothers in grief.","isBidirectional":true,"startEventId":"dracula-event-32","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-15","worldId":"dracula-1897-world","characterAId":"dracula-char-mina","characterBId":"dracula-char-van-helsing","label":"Trusted Collaborators","strength":"bond","sentiment":"positive","description":"Van Helsing recognizes Mina’s intellect and later protects her during the final approach.","isBidirectional":true,"startEventId":"dracula-event-45","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-relationship-16","worldId":"dracula-1897-world","characterAId":"dracula-char-jonathan","characterBId":"dracula-char-quincey","label":"Fellow Hunters","strength":"strong","sentiment":"positive","description":"They strike the final paired blows against Dracula.","isBidirectional":true,"startEventId":"dracula-event-48","createdAt":1785499200000,"updatedAt":1785499200000}],"relationshipSnapshots":[],"timelines":[{"id":"dracula-timeline-main","worldId":"dracula-1897-world","name":"Dracula — Master Chronology","description":"The complete dated sequence of journals, letters, logs, telegrams, and other records across all locations and narrators.","color":"#8f1d2c","dayOffset":0,"createdAt":1785499200000}],"chapters":[{"id":"dracula-chapter-1","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":1,"title":"Jonathan Harker’s Journal","synopsis":"Jonathan travels through Bistritz and the Borgo Pass to Castle Dracula.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-2","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":2,"title":"Jonathan Harker’s Journal","synopsis":"Jonathan discovers his host’s unnatural habits and his own imprisonment.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-3","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":3,"title":"Jonathan Harker’s Journal","synopsis":"Dracula’s history, the vampire women, and the castle’s dangers become clearer.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-4","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":4,"title":"Jonathan Harker’s Journal","synopsis":"Jonathan searches the castle, finds Dracula’s earth-box refuge, and attempts escape.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-5","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":5,"title":"Letters—Lucy and Mina","synopsis":"Lucy and Mina exchange news while Seward records Renfield’s strange appetites.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-6","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":6,"title":"Mina Murray’s Journal","synopsis":"Mina joins Lucy in Whitby as Renfield’s behavior grows more ominous.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-7","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":7,"title":"Cutting from “The Dailygraph,” 8 August","synopsis":"A storm drives the apparently abandoned Demeter into Whitby Harbour.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-8","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":8,"title":"Mina Murray’s Journal","synopsis":"Lucy sleepwalks, Dracula attacks, and Mina receives news of Jonathan.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-9","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":9,"title":"Mina Murray’s Journal","synopsis":"Mina finds Jonathan in Budapest and Lucy’s decline resumes at Hillingham.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-10","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":10,"title":"Mina Murray’s Journal","synopsis":"Van Helsing begins transfusions and wards Lucy’s room with garlic.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-11","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":11,"title":"Lucy Westenra’s Diary","synopsis":"Bersicker breaks the window; Mrs Westenra dies and Lucy is left near death.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-12","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":12,"title":"Dr Seward’s Diary","synopsis":"Repeated transfusions fail and Lucy dies after a final change.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-13","worldId":"dracula-1897-world","timelineId":"dracula-timeline-main","number":13,"title":"Dr Seward’s Diary","synopsis":"Arthur mourns, Van Helsing delays burial, and child attacks suggest Lucy’s return.","notes":"The source novel is epistolary; events are dated from the documents collected within this chapter.","wordGoal":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-chapter-14","worldId":"dracula-1897-world","timelineId":"dracula-t