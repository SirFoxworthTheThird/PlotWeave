"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-czarina-captain","worldId":"dracula-1897-world","name":"Captain Donelson","aliases":[],"description":"Captain of the Czarina Catherine, deceived by Dracula’s fog-driven passage.","portraitImageId":"dracula-char-czarina-captain-portrait","color":"#496b80","tags":["sailor"],"isAlive":true,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-szgany","worldId":"dracula-1897-world","name":"Szgany Retainers","aliases":[],"description":"The armed group racing Dracula’s box back to the castle.","portraitImageId":"dracula-char-szgany-portrait","color":"#7a5538","tags":["collective","retainers"],"isAlive":true,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null}],"items":[{"id":"dracula-item-journal","worldId":"dracula-1897-world","name":"Jonathan’s Journal","description":"The shorthand record of Castle Dracula and the later hunt.","iconType":"book","imageId":"dracula-item-journal-image","tags":["document"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-mina-diary","worldId":"dracula-1897-world","name":"Mina’s Journal and Transcripts","description":"The diary and typed archive that unify the group’s evidence.","iconType":"book","imageId":"dracula-item-mina-diary-image","tags":["document"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-phonograph","worldId":"dracula-1897-world","name":"Seward’s Phonograph Diary","description":"Wax-cylinder case notes and personal record.","iconType":"device","imageId":"dracula-item-phonograph-image","tags":["document","technology"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-demeter-log","worldId":"dracula-1897-world","name":"Demeter Log","description":"The captain’s account of disappearances at sea.","iconType":"book","imageId":"dracula-item-demeter-log-image","tags":["document"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-letters","worldId":"dracula-1897-world","name":"Letters and Telegrams","description":"The distributed correspondence that connects the archive.","iconType":"letter","imageId":"dracula-item-letters-image","tags":["document"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-crucifix","worldId":"dracula-1897-world","name":"Crucifix","description":"A protective gift Jonathan receives before reaching the castle.","iconType":"jewelry","imageId":"dracula-item-crucifix-image","tags":["sacred"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-mirror","worldId":"dracula-1897-world","name":"Shaving Mirror","description":"Jonathan’s mirror, destroyed when it reveals Dracula casts no reflection.","iconType":"tool","imageId":"dracula-item-mirror-image","tags":["evidence"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-keys","worldId":"dracula-1897-world","name":"Castle Keys","description":"Keys Jonathan seeks while attempting escape.","iconType":"key","imageId":"dracula-item-keys-image","tags":["escape"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-earth-boxes","worldId":"dracula-1897-world","name":"Boxes of Transylvanian Earth","description":"Fifty boxes that provide Dracula with portable refuges.","iconType":"crate","imageId":"dracula-item-earth-boxes-image","tags":["vampire","logistics"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-garlic","worldId":"dracula-1897-world","name":"Garlic Flowers","description":"Van Helsing’s ward around Lucy and her room.","iconType":"plant","imageId":"dracula-item-garlic-image","tags":["sacred","ward"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-wafer","worldId":"dracula-1897-world","name":"Consecrated Wafers","description":"Sacred hosts used to seal and sterilize vampire refuges.","iconType":"religious","imageId":"dracula-item-wafer-image","tags":["sacred","weapon"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-stake","worldId":"dracula-1897-world","name":"Wooden Stake and Hammer","description":"Tools used to release undead Lucy.","iconType":"weapon","imageId":"dracula-item-stake-image","tags":["vampire","weapon"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-transfusion","worldId":"dracula-1897-world","name":"Transfusion Equipment","description":"Apparatus used in repeated attempts to save Lucy.","iconType":"medical","imageId":"dracula-item-transfusion-image","tags":["medicine"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-maps","worldId":"dracula-1897-world","name":"Maps and Timetables","description":"Routes, schedules, and shipping intelligence used in the pursuit.","iconType":"map","imageId":"dracula-item-maps-image","tags":["technology","hunt"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-kukri","worldId":"dracula-1897-world","name":"Jonathan’s Kukri Knife","description":"The blade Jonathan uses in the final attack on Dracula’s box.","iconType":"weapon","imageId":"dracula-item-kukri-image","tags":["weapon"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-bowie","worldId":"dracula-1897-world","name":"Quincey’s Bowie Knife","description":"The blade Quincey uses in the final attack.","iconType":"weapon","imageId":"dracula-item-bowie-image","tags":["weapon"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-item-rifles","worldId":"dracula-1897-world","name":"Winchester Rifles","description":"Firearms carried during the Transylvanian pursuit.","iconType":"weapon","imageId":"dracula-item-rifles-image","tags":["weapon"],"createdAt":1785499200000,"updatedAt":1785499200000}],"characterSnapshots":[{"id":"dracula-snapshot-1-jonathan","worldId":"dracula-1897-world","characterId":"dracula-char-jonathan","eventId":"dracula-event-1","isAlive":true,"currentLoca