512&height=512","createdAt":1785499200000},{"id":"dracula-char-hawkins-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/briefcase.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-sister-agatha-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/nun-face.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-three-women-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/vampire-cape.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-captain-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/captain-hat-profile.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-mate-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/anchor.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-swales-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/beard.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-bilder-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/lion.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-bersicker-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/wolf-head.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-nurse-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/nurse-male.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-billington-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/archive-register.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-snelling-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/hand-truck.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-hildesheim-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/contract.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-skinsky-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/cargo-ship.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-czarina-captain-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/ship-wheel.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-char-szgany-portrait","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/mounted-knight.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-journal-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/quill.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-mina-diary-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/notebook.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-phonograph-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/speaker.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-demeter-log-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/scroll-quill.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-letters-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/envelope.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-crucifix-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/crucifix.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-mirror-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/mirror-mirror.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-keys-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/keyring.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-earth-boxes-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/wooden-crate.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-garlic-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/garlic.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-wafer-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/bread.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-stake-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/stake-hammer.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-transfusion-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/medical-drip.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-maps-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/treasure-map.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-kukri-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/machete.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-bowie-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/bowie-knife.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000},{"id":"dracula-item-rifles-image","worldId":"dracula-1897-world","mimeType":"image/svg+xml","url":"https://api.iconify.design/game-icons/winchester-rifle.svg?color=%23e8d7ad&width=512&height=512","createdAt":1785499200000}],"travelModes":[],"timelineRelationships":[],"crossTimelineArtifacts":[],"mapRoutes":[{"id":"dracula-route-1","worldId":"dracula-1897-world","mapLayerId":"dracula-map-europe","name":"Jonathan’s Eastward Journey","routeType":"rail","waypoints":["dracula-loc-munich","dracula-loc-vienna","dracula-loc-budapest","dracula-loc-transylvania-portal"],"color":"#8f1d2c","notes":"Munich through Central Europe to the Carpathians.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-route-2","worldId":"dracula-1897-world","mapLayerId":"dracula-map-europe","name":"The Demeter’s Voyage","routeType":"sea_route","waypoints":["dracula-loc-varnav","dracula-loc-demeter-portal","dracula-loc-whitby-portal"],"color":"#577b91","notes":"Varna through the Mediterranean and Atlantic to Whitby.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-route-3","worldId":"dracula-1897-world","mapLayerId":"dracula-map-europe","name":"The Hunters to Varna","routeType":"rail","waypoints":["dracula-loc-london-portal","dracula-loc-munich","dracula-loc-vienna","dracula-loc-budapest","dracula-loc-varnav"],"color":"#8f1d2c","notes":"The rapid continental rail route used to intercept the Count.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-route-4","worldId":"dracula-1897-world","mapLayerId":"dracula-map-transylvania","name":"Final Pursuit","routeType":"river","waypoints":["dracula-loc-galatz-regional","dracula-loc-river","dracula-loc-fundu","dracula-loc-borgo","dracula-loc-castle-portal"],"color":"#8f1d2c","notes":"The divided river and overland race toward Castle Dracula.","createdAt":1785499200000,"updatedAt":1785499200000}],"mapRegions":[],"mapRegionSnapshots":[],"mapAnnotations":[],"loreCategories":[{"id":"dracula-lore-category-vampire","worldId":"dracula-1897-world","name":"Vampire Lore","color":"#8f1d2c","sortOrder":1},{"id":"dracula-lore-category-places","worldId":"dracula-1897-world","name":"Places and Routes","color":"#5f7382","sortOrder":2},{"id":"dracula-lore-category-archive","worldId":"dracula-1897-world","name":"Documents and Technology","color":"#7889a5","sortOrder":3},{"id":"dracula-lore-category-society","worldId":"dracula-1897-world","name":"People and Institutions","color":"#8b7559","sortOrder":4},{"id":"dracula-lore-category-sources","worldId":"dracula-1897-world","name":"Sources and Editorial Notes","color":"#a28d67","sortOrder":5}],"lorePages":[{"id":"dracula-lore-1","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-vampire","title":"Vampire Powers and Limits","body":"Dracula can alter apparent age, command animals, become mist or animal, scale walls, and exert hypnotic influence. He is limited by daylight, thresholds, sacred objects, and the need to rest in native earth.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-rules"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-2","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-vampire","title":"The Un-Dead State","body":"A vampire victim may rise after death, feed on others, and retain a corrupted version of personality. The hunters understand destruction as release rather than punishment.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-lucy"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-3","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-vampire","title":"Consecrated Protection","body":"Crucifixes, garlic, and consecrated wafers repel, bar, or sterilize vampire spaces. Their use depends on careful placement and intact thresholds.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-rules"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-4","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-vampire","title":"Blood and Transfusion","body":"Four transfusions temporarily sustain Lucy. Dracula’s forced exchange with Mina is both physical violation and supernatural bond.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-mina"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-5","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-places","title":"Castle Dracula","body":"A fictional castle near the Borgo Pass. The novel does not identify it with Bran Castle; the interior maps here are interpretive schematics only.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-harker"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-6","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-places","title":"Whitby","body":"The harbour, East Cliff, churchyard, and Abbey form the English landing ground for the Demeter and the setting of Lucy’s first documented attack.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-lucy"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-7","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-places","title":"Carfax and Purfleet","body":"Dracula’s purchased estate lies beside Seward’s asylum. Its ruined chapel initially stores the fifty earth boxes.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-earth"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-8","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-places","title":"The Return Route","body":"The hunters travel London–Paris–Munich–Vienna–Budapest–Bucharest–Varna, then reverse toward Galatz and the Carpathians.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-hunt"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-9","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-archive","title":"The Epistolary Method","body":"The story exists as a constructed archive: journals, diaries, letters, telegrams, newspaper clippings, memoranda, shipping logs, and phonograph recordings.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-archive"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-10","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-archive","title":"Modern Tools","body":"Shorthand, typewriting, phonographs, rail timetables, telegrams, blood transfusion, and commercial records let the group match an ancient enemy with coordinated modern systems.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-archive"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-11","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-society","title":"The Hunters of Dracula","body":"Jonathan, Mina, Seward, Van Helsing, Arthur, and Quincey combine distinct expertise. Mina’s editing turns individual witnesses into a functioning group.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-hunt"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-12","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-society","title":"Seward’s Asylum","body":"The asylum is both a modern clinical institution and a dangerously porous neighbour to Carfax. Renfield becomes an unwilling sensor of the Count.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-renfield"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-13","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-sources","title":"Calendar Convention","body":"The novel explicitly dates its documents from 3 May through 6 November but does not state a year. This example uses 1893 solely as an editorial calendar scaffold; month and day follow the text.","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-archive"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-lore-14","worldId":"dracula-1897-world","categoryId":"dracula-lore-category-sources","title":"Map Sources and Attribution","body":"All images are linked rather than embedded. The regional maps and most reference plans are hosted by Wikimedia Commons; the coordinated Castle Dracula plans are externally linked image references. Castle, Carfax, asylum, and ship plans are non-canonical visual backdrops; marker placement remains an editorial aid rather than a claim about a real building.\n\n- Dracula cover: https://commons.wikimedia.org/wiki/File:Dracula1st.jpeg\n- Europe: https://commons.wikimedia.org/wiki/File:Europa_1890.jpg\n- London: https://commons.wikimedia.org/wiki/File:1890_Bacon_Traveler%27s_Pocket_Map_of_London,_England_-_Geographicus_-_London-bacon-1890.jpg\n- Transylvania, Hungary, and Galicia: https://commons.wikimedia.org/wiki/File:Dracula's_land.jpg\n- Whitby: https://commons.wikimedia.org/wiki/File:Yorkshire._Maps_and_plans_by_Bartholomew_(1890)_(14595180159).jpg\n- Castle ground-floor reference: https://i.pinimg.com/1200x/91/dc/44/91dc44a26649447003673051af348fe7.jpg\n- Castle top-floor reference: https://i.pinimg.com/1200x/03/78/fd/0378fd82c22d1f64eaf38fe80c0013ee.jpg\n- Castle basement reference: https://i.pinimg.com/1200x/c5/6e/5a/c56e5a26b61594a32605695bc131f14c.jpg\n- Carfax house reference: https://commons.wikimedia.org/wiki/File:Sample_Floorplan.jpg\n- Asylum reference: https://commons.wikimedia.org/wiki/File:Mental_Hospital_Plan.jpg\n- Demeter reference: https://commons.wikimedia.org/wiki/File:Spray_deck_plan.jpg\n\nCharacter and item illustrations\n\nCharacter portraits and item images use hand-drawn vector illustrations from Game-icons.net, delivered through the Iconify API. They are illustrations rather than photographs and are used under the Creative Commons Attribution 3.0 license.\n\n- Illustration collection: https://game-icons.net/\n- Delivery API: https://iconify.design/\n- License: https://creativecommons.org/licenses/by/3.0/","tags":[],"coverImageId":null,"linkedEntityIds":["dracula-thread-archive"],"visibleFromEventId":null,"createdAt":1785499200000,"updatedAt":1785499200000}],"factions":[{"id":"dracula-faction-hunters","worldId":"dracula-1897-world","name":"The Hunters of Dracula","description":"The coalition that combines medicine, law, money, faith, technology, and fieldcraft against the Count.","color":"#b99a62","coverImageId":null,"tags":["alliance","protagonists"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-undead","worldId":"dracula-1897-world","name":"Dracula’s Undead Household","description":"Count Dracula, the three vampire women, and those he turns or enthralls.","color":"#781b28","coverImageId":null,"tags":["vampire","antagonists"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-asylum","worldId":"dracula-1897-world","name":"Seward’s Asylum","description":"Dr John Seward’s Purfleet institution and its attendants.","color":"#4f6d7a","coverImageId":null,"tags":["medical","institution"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-demeter","worldId":"dracula-1897-world","name":"Crew of the Demeter","description":"The captain, mate, and sailors who carry Dracula’s cargo from Varna.","color":"#426b82","coverImageId":null,"tags":["ship","victims"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-transport","worldId":"dracula-1897-world","name":"Solicitors and Carriers","description":"The legal and commercial chain moving Dracula’s property and boxes of earth.","color":"#766b5b","coverImageId":null,"tags":["legal","logistics"],"createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-szgany","worldId":"dracula-1897-world","name":"The Szgany","description":"Romani retainers who transport and defend Dracula’s box in Transylvania.","color":"#7b5937","coverImageId":null,"tags":["retainers","transport"],"createdAt":1785499200000,"updatedAt":1785499200000}],"factionMemberships":[{"id":"dracula-membership-1","worldId":"dracula-1897-world","factionId":"dracula-faction-hunters","characterId":"dracula-char-jonathan","role":"Hunter","startEventId":"dracula-event-48","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-2","worldId":"dracula-1897-world","factionId":"dracula-faction-hunters","characterId":"dracula-char-mina","role":"Archivist and tracker","startEventId":"dracula-event-45","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-3","worldId":"dracula-1897-world","factionId":"dracula-faction-hunters","characterId":"dracula-char-seward","role":"Physician and recorder","startEventId":"dracula-event-47","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-4","worldId":"dracula-1897-world","factionId":"dracula-faction-hunters","characterId":"dracula-char-van-helsing","role":"Leader and vampire expert","startEventId":"dracula-event-29","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-5","worldId":"dracula-1897-world","factionId":"dracula-faction-hunters","characterId":"dracula-char-arthur","role":"Patron and hunter","startEventId":"dracula-event-47","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-6","worldId":"dracula-1897-world","factionId":"dracula-faction-hunters","characterId":"dracula-char-quincey","role":"Tracker and fighter","startEventId":"dracula-event-47","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-7","worldId":"dracula-1897-world","factionId":"dracula-faction-undead","characterId":"dracula-char-dracula","role":"Master","startEventId":"dracula-event-1","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-8","worldId":"dracula-1897-world","factionId":"dracula-faction-undead","characterId":"dracula-char-three-women","role":"Castle household","startEventId":"dracula-event-9","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-9","worldId":"dracula-1897-world","factionId":"dracula-faction-undead","characterId":"dracula-char-lucy","role":"Newly made vampire","startEventId":"dracula-event-31","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-10","worldId":"dracula-1897-world","factionId":"dracula-faction-asylum","characterId":"dracula-char-seward","role":"Director","startEventId":"dracula-event-1","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-11","worldId":"dracula-1897-world","factionId":"dracula-faction-asylum","characterId":"dracula-char-renfield","role":"Patient","startEventId":"dracula-event-14","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-12","worldId":"dracula-1897-world","factionId":"dracula-faction-asylum","characterId":"dracula-char-nurse","role":"Attendant","startEventId":"dracula-event-17","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-13","worldId":"dracula-1897-world","factionId":"dracula-faction-demeter","characterId":"dracula-char-captain","role":"Captain","startEventId":"dracula-event-19","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-14","worldId":"dracula-1897-world","factionId":"dracula-faction-demeter","characterId":"dracula-char-mate","role":"First mate","startEventId":"dracula-event-19","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-15","worldId":"dracula-1897-world","factionId":"dracula-faction-transport","characterId":"dracula-char-hawkins","role":"Solicitor","startEventId":"dracula-event-1","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-16","worldId":"dracula-1897-world","factionId":"dracula-faction-transport","characterId":"dracula-char-billington","role":"London solicitor","startEventId":"dracula-event-58","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-17","worldId":"dracula-1897-world","factionId":"dracula-faction-transport","characterId":"dracula-char-snelling","role":"Carrier","startEventId":"dracula-event-58","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-18","worldId":"dracula-1897-world","factionId":"dracula-faction-transport","characterId":"dracula-char-hildesheim","role":"Broker","startEventId":"dracula-event-77","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-19","worldId":"dracula-1897-world","factionId":"dracula-faction-transport","characterId":"dracula-char-skinsky","role":"Carrier","startEventId":"dracula-event-77","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-membership-20","worldId":"dracula-1897-world","factionId":"dracula-faction-szgany","characterId":"dracula-char-szgany","role":"Retainers","startEventId":"dracula-event-12","endEventId":null,"notes":"","createdAt":1785499200000,"updatedAt":1785499200000}],"factionRelationships":[{"id":"dracula-faction-rel-1","worldId":"dracula-1897-world","factionAId":"dracula-faction-hunters","factionBId":"dracula-faction-undead","stance":"hostile","notes":"The hunters form specifically to destroy Dracula and release his victims.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-rel-2","worldId":"dracula-1897-world","factionAId":"dracula-faction-asylum","factionBId":"dracula-faction-undead","stance":"hostile","notes":"The Count exploits the asylum’s proximity and kills Renfield.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-rel-3","worldId":"dracula-1897-world","factionAId":"dracula-faction-transport","factionBId":"dracula-faction-undead","stance":"neutral","notes":"Commercial intermediaries unknowingly move the Count and his refuges.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-faction-rel-4","worldId":"dracula-1897-world","factionAId":"dracula-faction-szgany","factionBId":"dracula-faction-undead","stance":"allied","notes":"The Szgany carry and defend Dracula’s box on the final route.","createdAt":1785499200000,"updatedAt":1785499200000}],"knowledgeFacts":[{"id":"dracula-fact-no-reflection","worldId":"dracula-1897-world","title":"Dracula casts no reflection","description":"The Count is invisible in a mirror and reacts violently when exposed.","tags":[],"readerLearnsAtEventId":"dracula-event-5","originEventId":"dracula-event-5","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-prison","worldId":"dracula-1897-world","title":"Jonathan is imprisoned","description":"The castle doors are locked and Jonathan cannot leave.","tags":[],"readerLearnsAtEventId":"dracula-event-6","originEventId":"dracula-event-6","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-vampire","worldId":"dracula-1897-world","title":"Dracula is a vampire","description":"The combined evidence identifies Dracula as an undead blood-drinker.","tags":[],"readerLearnsAtEventId":"dracula-event-45","originEventId":"dracula-event-45","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-earth","worldId":"dracula-1897-world","title":"Dracula must rest in native earth","description":"The boxes provide portable refuges that can be sterilized with sacred wafer.","tags":[],"readerLearnsAtEventId":"dracula-event-45","originEventId":"dracula-event-45","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-lucy-attacked","worldId":"dracula-1897-world","title":"Lucy’s blood loss is caused by nocturnal attacks","description":"The throat wounds and repeated collapse are not an ordinary illness.","tags":[],"readerLearnsAtEventId":"dracula-event-29","originEventId":"dracula-event-29","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-lucy-undead","worldId":"dracula-1897-world","title":"Lucy has become undead","description":"The empty tomb and child attacks prove Lucy rises after burial.","tags":[],"readerLearnsAtEventId":"dracula-event-38","originEventId":"dracula-event-38","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-renfield-signal","worldId":"dracula-1897-world","title":"Renfield reacts to Dracula’s proximity","description":"His moods map the Count’s approach, residence, and departure.","tags":[],"readerLearnsAtEventId":"dracula-event-17","originEventId":"dracula-event-17","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-fifty-boxes","worldId":"dracula-1897-world","title":"Fifty earth boxes arrived at Carfax","description":"The Demeter cargo and carrier records establish the original count.","tags":[],"readerLearnsAtEventId":"dracula-event-21","originEventId":"dracula-event-21","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-distributed","worldId":"dracula-1897-world","title":"The boxes were distributed across London","description":"Carrier records reveal Piccadilly, Bermondsey, and Mile End refuges.","tags":[],"readerLearnsAtEventId":"dracula-event-58","originEventId":"dracula-event-58","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-mina-bond","worldId":"dracula-1897-world","title":"Mina’s blood bond can locate Dracula","description":"Hypnosis at dawn and sunset yields sensory information from the Count.","tags":[],"readerLearnsAtEventId":"dracula-event-70","originEventId":"dracula-event-70","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-ship","worldId":"dracula-1897-world","title":"Dracula is aboard the Czarina Catherine","description":"Shipping records identify the vessel carrying the final box.","tags":[],"readerLearnsAtEventId":"dracula-event-71","originEventId":"dracula-event-71","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-galatz","worldId":"dracula-1897-world","title":"The ship landed at Galatz","description":"A telegram reveals that Dracula bypassed Varna.","tags":[],"readerLearnsAtEventId":"dracula-event-75","originEventId":"dracula-event-75","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-fact-skinsky","worldId":"dracula-1897-world","title":"Skinsky carried the box inland","description":"Hildesheim identifies the carrier, establishing the overland trail.","tags":[],"readerLearnsAtEventId":"dracula-event-77","originEventId":"dracula-event-77","createdAt":1785499200000,"updatedAt":1785499200000}],"knowledgeReveals":[{"id":"dracula-reveal-no-reflection-jonathan","worldId":"dracula-1897-world","factId":"dracula-fact-no-reflection","characterId":"dracula-char-jonathan","eventId":"dracula-event-5","note":"Learns or confirms this at “No Reflection”.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-reveal-prison-jonathan","worldId":"dracula-1897-world","factId":"dracula-fact-prison","characterId":"dracula-char-jonathan","eventId":"dracula-event-6","note":"Learns or confirms this at “A Prison Without Doors”.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-reveal-vampire-van-helsing","worldId":"dracula-1897-world","factId":"dracula-fact-vampire","characterId":"dracula-char-van-helsing","eventId":"dracula-event-45","note":"Learns or confirms this at “The Empty Coffin”.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-reveal-vampire-seward","worldId":"dracula-1897-world","factId":"dracula-fact-vampire","characterId":"dracula-char-seward","eventId":"dracula-event-45","note":"Learns or confirms this at “The Empty Coffin”.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-reveal-vampire-jonathan","worldId":"dracula-1897-world","factId":"dracula-fact-vampire","characterId":"dracula-char-jonathan","eventId":"dracula-event-45","note":"Learns or confirms this at “The Empty Coffin”.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-reveal-vampire-mina","worldId":"dracula-1897-world","factId":"dracula-fact-vampire","characterId":"dracula-char-mina","eventId":"dracula-event-45","note":"Learns or confirms this at “The Empty Coffin”.","createdAt":1785499200000,"updatedAt":1785499200000},{"id":"dracula-reveal-vampire-arthur","worldId":"dracula-1897-world","factId":"dracu