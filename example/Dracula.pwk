"dracula-char-arthur","worldId":"dracula-1897-world","name":"Arthur Holmwood","aliases":["Lord Godalming"],"description":"Lucy’s fiancé and later a principal member of the hunting party.","portraitImageId":"dracula-char-arthur-portrait","color":"#8f7aa8","tags":["hunter","noble"],"isAlive":true,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-quincey","worldId":"dracula-1897-world","name":"Quincey P. Morris","aliases":["Quincey Morris"],"description":"An American adventurer, Lucy’s former suitor, and steadfast hunter.","portraitImageId":"dracula-char-quincey-portrait","color":"#a96b4d","tags":["hunter","adventurer"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-renfield","worldId":"dracula-1897-world","name":"R. M. Renfield","aliases":[],"description":"Seward’s zoöphagous patient, psychically sensitive to Dracula’s movements.","portraitImageId":"dracula-char-renfield-portrait","color":"#758c68","tags":["patient","thrall"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-mrs-westenra","worldId":"dracula-1897-world","name":"Mrs Westenra","aliases":[],"description":"Lucy’s ailing mother, whose well-meant actions repeatedly defeat the doctors’ safeguards.","portraitImageId":"dracula-char-mrs-westenra-portrait","color":"#9b8080","tags":["family"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-hawkins","worldId":"dracula-1897-world","name":"Mr Peter Hawkins","aliases":[],"description":"Jonathan’s employer and later benefactor in Exeter.","portraitImageId":"dracula-char-hawkins-portrait","color":"#817561","tags":["solicitor"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-sister-agatha","worldId":"dracula-1897-world","name":"Sister Agatha","aliases":[],"description":"Nurse at the Budapest hospital who reports Jonathan’s condition to Mina.","portraitImageId":"dracula-char-sister-agatha-portrait","color":"#aaa08d","tags":["nurse"],"isAlive":true,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-three-women","worldId":"dracula-1897-world","name":"The Three Vampire Women","aliases":["The Weird Sisters"],"description":"Three undead women inhabiting Castle Dracula.","portraitImageId":"dracula-char-three-women-portrait","color":"#9c4760","tags":["vampire","collective"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-captain","worldId":"dracula-1897-world","name":"Captain of the Demeter","aliases":[],"description":"The shipmaster who keeps his post after the crew disappears.","portraitImageId":"dracula-char-captain-portrait","color":"#496b80","tags":["sailor"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-mate","worldId":"dracula-1897-world","name":"First Mate of the Demeter","aliases":[],"description":"The final crewman to challenge the hidden presence aboard ship.","portraitImageId":"dracula-char-mate-portrait","color":"#5c7180","tags":["sailor"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-swales","worldId":"dracula-1897-world","name":"Mr Swales","aliases":[],"description":"An elderly Whitby resident whose skepticism gives way to dread.","portraitImageId":"dracula-char-swales-portrait","color":"#7b756c","tags":["whitby"],"isAlive":false,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"dracula-char-bilder","worldId":"dracula-1897-world","name":"Thomas Bilder","aliases":[],"description":"The zookeeper who recounts the escape and return of Bersicker.","portraitImageId":"dracula-char-bilder-portrait","color":"#88734e","tags":["zookeeper"],"isAlive":true,"createdAt":1785499200000,"updatedAt":1785499200000,"birthDate":null},{"id":"