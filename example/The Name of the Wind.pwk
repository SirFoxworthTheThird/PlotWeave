":"70000000-0000-4000-a000-000000000016","isActive":true,"sentiment":"negative","strength":"strong","label":"Survivor and Chandrian Leader","description":"Survivor and Chandrian Leader","sortKey":16.02,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-cinder-haliax","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-cinder-haliax","eventId":"70000000-0000-4000-a000-000000000016","isActive":true,"sentiment":"complex","strength":"strong","label":"Subordinate and Leader","description":"Subordinate and Leader","sortKey":16.021,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-denna-deoch","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-denna-deoch","eventId":"70000000-0000-4000-a000-000000000056","isActive":true,"sentiment":"complex","strength":"moderate","label":"Former Lovers","description":"Former Lovers","sortKey":56.022,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-kvothe-threpe","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-kvothe-threpe","eventId":"70000000-0000-4000-a000-000000000055","isActive":true,"sentiment":"positive","strength":"moderate","label":"Musician and Patron","description":"Musician and Patron","sortKey":55.023,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-kvothe-fela","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-kvothe-fela","eventId":"70000000-0000-4000-a000-000000000043","isActive":true,"sentiment":"positive","strength":"moderate","label":"Friends","description":"Friends","sortKey":43.024,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-kvothe-mola","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-kvothe-mola","eventId":"70000000-0000-4000-a000-000000000067","isActive":true,"sentiment":"positive","strength":"moderate","label":"Friends","description":"Friends","sortKey":67.025,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-kvothe-roent","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-kvothe-roent","eventId":"70000000-0000-4000-a000-000000000030","isActive":true,"sentiment":"positive","strength":"moderate","label":"Passenger and Caravan Master","description":"Passenger and Caravan Master","sortKey":30.026,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-kvothe-draccus","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-kvothe-draccus","eventId":"70000000-0000-4000-a000-000000000076","isActive":true,"sentiment":"negative","strength":"strong","label":"Hunter and Beast","description":"Hunter and Beast","sortKey":76.027,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-selitos-haliax","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-selitos-haliax","eventId":"70000000-0000-4000-a000-000000000026","isActive":true,"sentiment":"negative","strength":"strong","label":"Cursed Enemies","description":"Cursed Enemies","sortKey":26.028,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-kvothe-pike","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-kvothe-pike","eventId":"70000000-0000-4000-a000-000000000020","isActive":true,"sentiment":"negative","strength":"strong","label":"Street Enemies","description":"Street Enemies","sortKey":20,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-kvothe-fenton","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-kvothe-fenton","eventId":"70000000-0000-4000-a000-000000000038","isActive":true,"sentiment":"neutral","strength":"moderate","label":"Fellow Sympathists","description":"Fellow Sympathists","sortKey":38,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"relsnap-rel-denna-ash","worldId":"10000000-0000-4000-a000-000000000000","relationshipId":"rel-denna-ash","eventId":"70000000-0000-4000-a000-000000000091","isActive":true,"sentiment":"negative","strength":"strong","label":"Secret Patronage","description":"Secret Patronage","sortKey":91,"createdAt":1713200000000,"updatedAt":1713200000000}],"timelines":[{"id":"20000000-0000-4000-a000-000000000001","worldId":"10000000-0000-4000-a000-000000000000","name":"The Waystone","description":"The framing present narrative at the Waystone Inn.","color":"#6366f1","createdAt":1713200000000},{"id":"20000000-0000-4000-a000-000000000002","worldId":"10000000-0000-4000-a000-000000000000","name":"Kvothe's Story","description":"The inner narrative recounting Kvothe's childhood and time at the University.","color":"#f59e0b","createdAt":1713200000000}],"chapters":[{"id":"60000000-0000-4000-a000-000000000000","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":0,"title":"Prologue: A Silence of Three Parts","synopsis":"Three silences define the empty Waystone Inn and its keeper, Kote, a man waiting to die.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000001","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":1,"title":"A Place for Demons","synopsis":"Carter interrupts Old Cob's story by bringing a dead scrael to the inn; Kote recognizes that more of the creatures must be nearby.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000002","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":2,"title":"A Beautiful Day","synopsis":"Deserters rob the traveling scribe Chronicler on the road to Newarre.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000003","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":3,"title":"Wood and Word","synopsis":"Kote mounts the sword Folly, is recognized by a traveler, and quietly prepares to hunt the scrael.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000004","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":4,"title":"Halfway to Newarre","synopsis":"Kote destroys a pack of scrael at a bonfire and rescues Chronicler, suffering deep wounds.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000005","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":5,"title":"Notes","synopsis":"Kote carries Chronicler home, where Bast stitches his master's wounds and keeps watch.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000006","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":6,"title":"The Price of Remembering","synopsis":"Chronicler reveals his purpose, and Kote agrees to dictate his life only if the account receives three full days.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000007","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":7,"title":"Of Beginnings and the Names of Things","synopsis":"Kvothe demonstrates Chronicler's cipher, lists the names attached to his legend, and begins with his Edema Ruh childhood.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000008","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":8,"title":"Thieves, Heretics, and Whores","synopsis":"Young Kvothe sees Abenthy call the wind and persuades the arcanist to join his parents' troupe.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000009","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":9,"title":"Riding in the Wagon with Ben","synopsis":"Ben recognizes Kvothe's extraordinary memory and begins teaching him the sciences and arts of the Arcanum.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000010","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":10,"title":"Alar and the Several Stones","synopsis":"Ben trains Kvothe in Alar, Heart of Stone, and splitting his mind between contradictory beliefs.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000011","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":11,"title":"The Binding of Iron","synopsis":"Kvothe learns the laws of sympathy and practices bindings that transfer energy between linked objects.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000012","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":12,"title":"Puzzle Pieces Fitting","synopsis":"Arliden researches the Chandrian for his Lanre song while Ben warns the family about dangerous names and Kvothe's future.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000013","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":13,"title":"Interlude: Flesh with Blood Beneath","synopsis":"Chronicler mistakes Bast for a demon and binds him with iron until Kote forces an uneasy peace.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000014","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":14,"title":"The Name of the Wind","synopsis":"Kvothe binds his lungs to the outside air and nearly dies; Ben calls the wind to save him.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000015","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":15,"title":"Distractions and Farewells","synopsis":"At Hallowfell, Ben leaves the troupe and gives Kvothe Rhetoric and Logic with a warning to beware folly.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000016","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":16,"title":"Hope","synopsis":"Kvothe returns to find his troupe murdered and meets Cinder and Haliax before the Chandrian flee.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000017","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":17,"title":"Interlude: Autumn","synopsis":"Bast and Chronicler make peace while Kote privately grieves outside the inn.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000018","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":18,"title":"Roads to Safe Places","synopsis":"Traumatized Kvothe wanders alone into the forest while his sleeping mind protects him from memory.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000019","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":19,"title":"Fingers and Strings","synopsis":"Kvothe survives through music until broken strings and bleeding fingers finally silence his father's lute.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000020","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":20,"title":"Bloody Hands Into Stinging Fists","synopsis":"Newly arrived in Tarbean, Kvothe is robbed and beaten by street boys and loses nearly everything.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000021","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":21,"title":"Basement, Bread and Bucket","synopsis":"Kvothe finds Trapis's cellar, earns bread through work, and discovers one fragile refuge in Waterside.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000022","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":22,"title":"A Time for Demons","synopsis":"A Hillside guard beats Kvothe during Midwinter, but a reveler dressed as Encanis gives him gloves, money, and warmth.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000023","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":23,"title":"The Burning Wheel","synopsis":"Recovering from fever, Kvothe hears Trapis tell the story of Tehlu, Encanis, and the burning wheel.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000024","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":24,"title":"Shadows Themselves","synopsis":"Years later, Kvothe enters a Dockside tavern and hears Skarpi begin the story of Lanre and Myr Tariniel.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000025","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":25,"title":"Interlude: Eager for Reasons","synopsis":"Bast questions Kvothe's long delay in acting while Chronicler insists the tale unfold on its own terms.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000026","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":26,"title":"Lanre Turned","synopsis":"Skarpi's tale reveals Lanre's fall, Selitos's curse, Haliax, and the founding purpose of the Amyr.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000027","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":27,"title":"His Eyes Unveiled","synopsis":"Skarpi speaks Kvothe's name as Tehlin authorities arrest him, awakening Kvothe's buried memory and purpose.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000028","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":28,"title":"Tehlu's Watchful Eye","synopsis":"Kvothe retrieves Ben's book, cleans himself, and resolves to reach the University to seek the Chandrian and Amyr.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000029","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":29,"title":"The Doors of My Mind","synopsis":"Using Heart of Stone, Kvothe recovers music, sympathy, and the purpose hidden during his Tarbean years.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000030","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":30,"title":"The Broken Binding","synopsis":"Kvothe sells Ben's inscribed book at the Broken Binding to finance his transformation and journey.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000031","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":31,"title":"The Nature of Nobility","synopsis":"Kvothe uses acting, stolen clothes, and bargaining to outfit himself as a respectable traveler.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000032","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":32,"title":"Coppers, Cobblers and Crowds","synopsis":"Kvothe joins Roent's caravan on the Great Stone Road toward the University.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000033","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":33,"title":"A Sea of Stars","synopsis":"Kvothe meets Denna on the caravan journey and shares stories with her beneath the stars.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000034","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":34,"title":"Yet to Learn","synopsis":"Borrowing Josn's lute, Kvothe plays for the caravan and rediscovers the music silenced in Tarbean.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000035","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":35,"title":"A Parting of Ways","synopsis":"Kvothe and Denna part at Anilin while he continues toward the University.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000036","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":36,"title":"Less Talents","synopsis":"Kvothe astonishes the nine masters during admissions and manipulates the interview into a negative tuition.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000037","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":37,"title":"Bright-Eyed","synopsis":"Simmon introduces Kvothe to Wilem, Manet, and University life while Ambrose blocks him at the Archives.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000038","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":38,"title":"Sympathy in the Mains","synopsis":"Fela helps Kvothe find books on the Chandrian and Amyr before Lorren warns him away from childish subjects.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000039","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":39,"title":"Enough Rope","synopsis":"Kvothe teaches Hemme's sympathy class and uses the master's permission to demonstrate a painful binding.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000040","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":40,"title":"On the Horns","synopsis":"The masters reduce Hemme's demand for expulsion to three lashes and admit Kvothe into the Arcanum.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000041","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":41,"title":"Friend's Blood","synopsis":"Kvothe takes nahlrout and endures three lashes without crying out, beginning the Bloodless legend.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000042","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":42,"title":"Bloodless","synopsis":"Arwyl discovers Kvothe's preparation while Mola stitches his wounds at the Medica.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000043","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":43,"title":"The Flickering Way","synopsis":"Ambrose tricks Kvothe into carrying a candle into the Stacks, causing Lorren to ban him from the Archives.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000044","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":44,"title":"The Burning Glass","synopsis":"Kilvin accepts Kvothe into the Fishery and teaches that clever hands must be governed by sound judgment.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000045","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":45,"title":"Interlude: Some Tavern Tale","synopsis":"Kote pauses while Bast and Chronicler compare the painful facts with the heroic tavern versions.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000046","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":46,"title":"The Ever-Changing Wind","synopsis":"Elodin shows Kvothe the Rookery and names stone, then rejects him after Kvothe jumps from the roof.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000047","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":47,"title":"Barbs","synopsis":"Kvothe settles into Artificery and friendship with Wil and Sim while his rivalry with Ambrose escalates.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000048","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":48,"title":"Interlude: A Silence of a Different Kind","synopsis":"Kote struggles to describe Denna and rejects any attempt to reduce her to a list of features.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000049","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":49,"title":"The Nature of Wild Things","synopsis":"A hostile admissions exam leaves Kvothe owing three talents and searching Imre for a dangerous moneylender.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000050","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":50,"title":"Negotiations","synopsis":"Devi lends Kvothe tuition money for three drops of blood, and he buys a secondhand lute.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000051","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":51,"title":"Tar and Tin","synopsis":"Kvothe masters sygaldry, passes his examination, and begins earning money in the Fishery.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000052","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":52,"title":"Burning","synopsis":"Overworked Kvothe wins a difficult sympathy duel but suffers binder's chills.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000053","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":53,"title":"Slow Circles","synopsis":"Playing alone in a courtyard, Kvothe befriends the mysterious girl beneath the University and names her Auri.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000054","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":54,"title":"A Place to Burn","synopsis":"At the Eolian, Kvothe performs the Lay of Sir Savien while an unseen woman joins after Ambrose breaks a string.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000055","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":55,"title":"Flame and Thunder","synopsis":"The Eolian erupts in applause as Kvothe completes the song on six strings.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000056","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":56,"title":"Patrons, Maids and Metheglin","synopsis":"Kvothe receives silver talent pipes and discovers that the singer who saved his performance is Denna.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000057","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":57,"title":"Interlude: The Parts that Form Us","synopsis":"Kote tears up Chronicler's first description of Denna and begins again.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000058","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":58,"title":"Names for Beginning","synopsis":"Kvothe and Denna recognize each other at the Eolian and cautiously renew their connection.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000059","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":59,"title":"All This Knowing","synopsis":"Kvothe, Wil, and Sim walk home drunk beneath a beautiful night, secure in their friendship.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000060","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":60,"title":"Fortune","synopsis":"Kvothe navigates admissions, Devi's interest, Fishery work, music, and his search for Denna.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000061","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":61,"title":"Jackass, Jackass","synopsis":"Kvothe and Threpe's mocking song about Ambrose spreads, prompting another charge and a venomous apology.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000062","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":62,"title":"Leaves","synopsis":"After Ambrose drives him from the Horse and Four, Kvothe finds Anker's and walks with Denna for hours.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000063","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":63,"title":"Walking and Talking","synopsis":"Wil and Sim urge Kvothe to declare himself to Denna, but he fears losing her friendship.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000064","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":64,"title":"Nine in the Fire","synopsis":"Kilvin praises Kvothe's clever sympathy lamp but refuses to sell a design useful to thieves.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000065","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":65,"title":"Spark","synopsis":"Kvothe balances work, music, friendship, and study while waiting for Denna to return.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000066","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":66,"title":"Volatile","synopsis":"A bone-tar canister ruptures in the Fishery, and Kvothe crosses fire to carry Fela to safety.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000067","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":67,"title":"A Matter of Hands","synopsis":"Kilvin explains how he contained the fire while Kvothe learns his rescue has already become legend.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000068","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":68,"title":"The Ever-Changing Wind","synopsis":"Fela gives Kvothe a fine cloak, and he introduces Mola to Auri to protect the hidden girl.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000069","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":69,"title":"Wind or Women's Fancy","synopsis":"Hired men attack Kvothe with a dowsing compass; he escapes but knows they carry his blood.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000070","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":70,"title":"Signs","synopsis":"Kvothe hears that blue fire marked a wedding massacre near Trebon and borrows from Devi to investigate.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000071","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":71,"title":"Strange Attraction","synopsis":"Kvothe buys a supposedly black horse, uncovers the swindle, trades with a tinker, and reaches Trebon to find Denna.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000072","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":72,"title":"Borrorill","synopsis":"Kvothe and Denna inspect the Mauthen farm and find rusted iron and shattered wood matching Chandrian signs.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000073","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":73,"title":"Pegs","synopsis":"By mirroring Schiem's dialect, Kvothe learns about the Mauthen excavation and strange events near Barrow Hill.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000074","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":74,"title":"Waystone","synopsis":"Kvothe and Denna camp atop greystones and see a huge fire-breathing draccus.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000075","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":75,"title":"Interlude: Obedience","synopsis":"Kote expects disbelief about the draccus but receives only Chronicler's obedient silence.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000076","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":76,"title":"The Mating Habits of the Common Draccus","synopsis":"Kvothe identifies the draccus from Chronicler's book as an ancient herbivore with iron scales.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000077","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":77,"title":"Bluffs","synopsis":"Kvothe and Denna find a dead farmer and discover denner trees whose resin has addicted the draccus.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000078","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":78,"title":"Poison","synopsis":"After Denna tastes denner resin, the pair decide they must poison the creature before it reaches Trebon.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000079","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":79,"title":"Sweet Talk","synopsis":"While preparing bait, Kvothe cares for delirious Denna, who reveals that Master Ash gave her bruises.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000080","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":80,"title":"Touching Iron","synopsis":"The drugged draccus charges Trebon; Kvothe controls the fires and drops the church's iron wheel onto it.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000081","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":81,"title":"Pride","synopsis":"With the draccus dead, the damaged roof collapses and Kvothe is knocked unconscious.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000082","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":82,"title":"Ash and Elm...","synopsis":"Kvothe learns Denna vanished and hears Nina describe the vase depicting the Chandrian and their signs.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000083","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":83,"title":"Return","synopsis":"Kvothe returns to Imre, repays Devi, reassures his friends, and worries about Denna.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000084","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":84,"title":"A Sudden Storm","synopsis":"Ambrose breaks Kvothe's lute; Kvothe's sleeping mind calls the wind, and Elodin restores him.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000085","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":85,"title":"Hands Against Me","synopsis":"Ambrose accuses Kvothe of malfeasance before the masters, who vote on lashes and expulsion.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000086","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":86,"title":"The Fire Itself","synopsis":"The masters suspend expulsion, raise Kvothe to Re'lar, and Elodin explains his sleeping mind named the wind.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000087","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":87,"title":"Winter","synopsis":"Auri guides Kvothe through the ancient machinery and forgotten chambers of the Underthing.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000088","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000001","number":88,"title":"Interlude: Looking","synopsis":"A possessed mercenary attacks the Waystone, kills Shep, and dies while Kote fails to perform sympathy.","notes":"Frame narrative at or around the Waystone Inn.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000089","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":89,"title":"A Pleasant Afternoon","synopsis":"Kvothe takes six lashes and spends Ambrose's restitution on a lute, clothes, his blood, and a dress for Auri.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000090","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":90,"title":"Half-Built Houses","synopsis":"Auri leads Kvothe through the Underthing to a hidden Archives entrance, where Fela teaches him the Stacks.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000091","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-0000-4000-a000-000000000002","number":91,"title":"Worthy of Pursuit","synopsis":"Kvothe studies naming and the Chandrian, sees Denna, and leaves her name unanswered in the Questioning Hall.","notes":"Kvothe's narrated past.","createdAt":1713200000000,"updatedAt":1713200000000,"wordGoal":null},{"id":"60000000-0000-4000-a000-000000000092","worldId":"10000000-0000-4000-a000-000000000000","timelineId":"20000000-00