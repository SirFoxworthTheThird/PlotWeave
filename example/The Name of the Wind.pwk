rous lower district where Kvothe lives on the streets.","x":508,"y":573.1120601360777,"factionId":null,"createdAt":1713200000000,"updatedAt":1785111270937},{"id":"loc-trapis-cellar","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-tarbean","name":"Trapis's Cellar","description":"Hidden refuge where Trapis feeds and shelters street children.","x":251,"y":390.2198801588984,"factionId":null,"createdAt":1713200000000,"updatedAt":1785111305261},{"id":"loc-trebon-countryside","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-trebon","name":"Trebon Countryside","description":"Fields, woods, and farms searched by Kvothe and Denna.","x":343,"y":635.9582045978954,"factionId":null,"createdAt":1713200000000,"updatedAt":1785111072568},{"id":"loc-trebon-hall","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-trebon","name":"Trebon Town Hall","description":"Building threatened during the draccus's rampage.","x":325,"y":688.9703192072011,"factionId":null,"createdAt":1713200000000,"updatedAt":1785111069232},{"id":"loc-trebon-road","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-trebon","name":"Road to Trebon","description":"Route from Imre toward the mining town.","x":97,"y":575.966079093944,"factionId":null,"createdAt":1713200000000,"updatedAt":1785111058387},{"id":"loc-trebon-root","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-temerant","name":"Trebon","description":"Mining town near the Mauthen farm.","x":581.5222792363306,"y":607.9583663588312,"factionId":null,"createdAt":1713200000000,"updatedAt":1785110466113,"linkedMapLayerId":"notw-map-trebon","iconType":"town","tags":["sub-map"]},{"id":"loc-trebon-town","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-trebon","name":"Trebon","description":"Mining town threatened by the drugged draccus.","x":351,"y":675.0109031483751,"factionId":null,"createdAt":1713200000000,"updatedAt":1785111065484},{