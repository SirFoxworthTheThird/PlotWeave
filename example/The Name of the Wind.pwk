{"version":18,"type":"data","exportedAt":1785112071227,"world":{"id":"10000000-0000-4000-a000-000000000000","name":"The Name of the Wind","description":"At the Waystone Inn, an innkeeper known as Kote reveals that he is the legendary Kvothe. Over the first day of his testimony, he recounts his childhood among traveling performers, the murder of his family, years of hardship, and his rise at the University.","coverImageId":null,"createdAt":1713200000000,"updatedAt":1713200000000,"continuityStaleThreshold":5,"theme":null,"calendar":null,"wordTarget":null,"targetDate":null},"mapLayers":[{"id":"notw-map-tarbean","worldId":"10000000-0000-4000-a000-000000000000","parentMapId":"notw-map-temerant","name":"Tarbean","description":"Kvothe's years in the divided city of Tarbean.","imageId":"CaVhj4TfAYSEF-YwH8zV5","imageWidth":724,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1713200000000,"updatedAt":1785111229152},{"id":"notw-map-temerant","worldId":"10000000-0000-4000-a000-000000000000","parentMapId":null,"name":"Temerant","description":"Regional map of the Four Corners of Civilization, supporting the routes between the troupe, Tarbean, the University, Newarre, and Trebon.","imageId":"1l9hEkp3N8Q6cMqviPc8_","imageWidth":1066,"imageHeight":1600,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1713200000000,"updatedAt":1785109162727},{"id":"notw-map-trebon","worldId":"10000000-0000-4000-a000-000000000000","parentMapId":"notw-map-temerant","name":"Trebon and the Mauthen Farm","description":"Trebon, the Mauthen wedding site, the bluffs, and the draccus's range.","imageId":"cfQux6JuHMF6B5yKGmYmu","imageWidth":724,"imageHeight":1024,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1713200000000,"updatedAt":1785111048444},{"id":"notw-map-university","worldId":"10000000-0000-4000-a000-000000000