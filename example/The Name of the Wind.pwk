yId":"lore-cat-magic","title":"The Archives and the Four-Plate Door","body":"The Archives hold a vast but disordered body of knowledge; a sealed stone door with four copper plates remains unexplained.","tags":["archives","mystery"],"coverImageId":null,"linkedEntityIds":["loc-archives"],"visibleFromEventId":"70000000-0000-4000-a000-000000000043","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-chandrian","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-history","title":"The Chandrian","body":"Seven feared figures identified by signs such as blue flame, rust, decay, and silence; they destroy reliable knowledge of themselves.","tags":["chandrian","secret"],"coverImageId":null,"linkedEntityIds":["notw-char-cinder","notw-char-haliax"],"visibleFromEventId":"70000000-0000-4000-a000-000000000016","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-draccus","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-creatures","title":"The Common Draccus","body":"A huge herbivorous reptile whose iron scales and denner-resin addiction make it catastrophically dangerous.","tags":["draccus","denner"],"coverImageId":null,"linkedEntityIds":["notw-char-draccus","notw-item-denner-resin"],"visibleFromEventId":"70000000-0000-4000-a000-000000000076","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-edema","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-society","title":"The Edema Ruh","body":"Traveling performers who preserve songs, drama, and stories while facing deep prejudice from settled society.","tags":["edema-ruh","culture"],"coverImageId":null,"linkedEntityIds":["notw-char-kvothe","notw-char-arliden"],"visibleFromEventId":"70000000-0000-4000-a000-000000000007","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-lanre","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-history","title":"Lanre and Haliax","body":"Lanre returned from death, betrayed Myr Tariniel, and was cursed by Selitos to wear shadow on his face.","tags":["legend","chandrian"],"coverImageId":null,"linkedEntityIds":["notw-char-haliax","notw-char-selitos"],"visibleFromEventId":"70000000-0000-4000-a000-000000000026","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-money","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-society","title":"Money and Tuition","body":"Jots, talents, drabs, and Cealdish currency govern survival; University tuition can determine Kvothe's fate each term.","tags":["money","debt"],"coverImageId":null,"linkedEntityIds":["notw-char-devi"],"visibleFromEventId":"70000000-0000-4000-a000-000000000036","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-naming","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-magic","title":"Naming","body":"Knowing a thing's true name grants direct power over it. The sleeping mind hears names more clearly than the waking mind.","tags":["naming","wind"],"coverImageId":null,"linkedEntityIds":["notw-char-elodin","notw-char-kvothe"],"visibleFromEventId":"70000000-0000-4000-a000-000000000014","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-scrael","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-creatures","title":"Scrael","body":"Hard, spiderlike creatures of stone and iron that appear near Newarre in groups.","tags":["scrael","creature"],"coverImageId":null,"linkedEntityIds":["loc-scrael-camp"],"visibleFromEventId":"70000000-0000-4000-a000-000000000001","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-skin-dancers","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-creatures","title":"Skin Dancers","body":"Possessing entities that can seize human bodies and move between hosts.","tags":["skin-dancer","creature"],"coverImageId":null,"linkedEntityIds":["notw-char-skin-dancer"],"visibleFromEventId":"70000000-0000-4000-a000-000000000088","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-sygaldry","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-magic","title":"Sygaldry and Artificery","body":"Runes make sympathy bindings durable and allow artificers to build lamps, clocks, and protective devices.","tags":["sygaldry","artificery"],"coverImageId":null,"linkedEntityIds":["notw-char-kilvin","notw-item-sympathy-lamp"],"visibleFromEventId":"70000000-0000-4000-a000-000000000051","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-sympathy","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-magic","title":"Sympathy and Alar","body":"Sympathy links objects through bindings; its power depends on energy, similarity, and the sympathist's disciplined belief called Alar.","tags":["sympathy","alar"],"coverImageId":null,"linkedEntityIds":["notw-char-kvothe","notw-char-abenthy"],"visibleFromEventId":"70000000-0000-4000-a000-000000000010","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-taborlin","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-history","title":"Taborlin the Great","body":"Legendary namer and arcanist whose stories shape popular ideas about magic.","tags":["legend","naming"],"coverImageId":null,"linkedEntityIds":[],"visibleFromEventId":"70000000-0000-4000-a000-000000000001","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-tarbean","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-places","title":"Tarbean","body":"A divided coastal city whose Waterside poverty and Hillside wealth shape Kvothe's childhood survival.","tags":["tarbean"],"coverImageId":null,"linkedEntityIds":["loc-tarbean-waterside","loc-tarbean-hillside"],"visibleFromEventId":"70000000-0000-4000-a000-000000000018","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"lore-tehlin","worldId":"10000000-0000-4000-a000-000000000000","categoryId":"lore-cat-society","title":"The Tehlin Church","body":"