000000","name":"Old Cob","aliases":[],"description":"Newarre storyteller and regular at the Waystone Inn.","portraitImageId":null,"color":null,"tags":["frame","villager"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-carter","worldId":"10000000-0000-4000-a000-000000000000","name":"Carter","aliases":[],"description":"Newarre farmer injured by a scrael.","portraitImageId":null,"color":null,"tags":["frame","villager"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-graham","worldId":"10000000-0000-4000-a000-000000000000","name":"Graham","aliases":[],"description":"Newarre carpenter and Waystone regular.","portraitImageId":null,"color":null,"tags":["frame","villager"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-aaron","worldId":"10000000-0000-4000-a000-000000000000","name":"Aaron","aliases":[],"description":"Young smith's apprentice who hears stories at the Waystone.","portraitImageId":null,"color":null,"tags":["frame","villager"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-shep","worldId":"10000000-0000-4000-a000-000000000000","name":"Shep","aliases":[],"description":"Newarre farmer killed by the mercenary possessed by a skin dancer.","portraitImageId":null,"color":null,"tags":["frame","villager"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-skin-dancer","worldId":"10000000-0000-4000-a000-000000000000","name":"Skin Dancer","aliases":["Possessed Mercenary"],"description":"Hostile being that possesses a mercenary and attacks the Waystone patrons.","portraitImageId":null,"color":null,"tags":["creature","antagonist"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-arliden","worldId":"10000000-0000-4000-a000-000000000000","name":"Arliden","aliases":[],"description":"Kvothe's father, troupe leader, actor, and songwriter researching the Chandrian.","portraitImageId":null,"color":null,"tags":["family","edema-ruh"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-laurian","worldId":"10000000-0000-4000-a000-000000000000","name":"Laurian","aliases":["Netalia Lackless"],"description":"Kvothe's mother, a gifted performer who left nobility for the Ruh.","portraitImageId":null,"color":null,"tags":["family","edema-ruh"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-abenthy","worldId":"10000000-0000-4000-a000-000000000000","name":"Abenthy","aliases":["Ben"],"description":"Traveling arcanist who becomes Kvothe's first teacher.","portraitImageId":null,"color":null,"tags":["mentor","arcanist"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-teren","worldId":"10000000-0000-4000-a000-000000000000","name":"Teren","aliases":[],"description":"Sword performer in Arliden's troupe.","portraitImageId":null,"color":null,"tags":["edema-ruh"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-trip","worldId":"10000000-0000-4000-a000-000000000000","name":"Trip","aliases":[],"description":"Troupe performer with an uncanny knack for rolling sevens.","portraitImageId":null,"color":null,"tags":["edema-ruh"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-shandi","worldId":"10000000-0000-4000-a000-000000000000","name":"Shandi","aliases":[],"description":"Dancer in Arliden's troupe.","portraitImageId":null,"color":null,"tags":["edema-ruh"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-cinder","worldId":"10000000-0000-4000-a000-000000000000","name":"Cinder","aliases":[],"description":"Cruel pale member of the Chandrian encountered at the ruined troupe camp.","portraitImageId":null,"color":null,"tags":["chandrian","antagonist"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-haliax","worldId":"10000000-0000-4000-a000-000000000000","name":"Haliax","aliases":["Lanre"],"description":"Shadow-hamed leader of the Chandrian, once the legendary Lanre.","portraitImageId":null,"color":null,"tags":["chandrian","antagonist"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-skarpi","worldId":"10000000-0000-4000-a000-000000000000","name":"Skarpi","aliases":[],"description":"Tarbean storyteller who relates the tragedy of Lanre and Selitos.","portraitImageId":null,"color":null,"tags":["storyteller"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-trapis","worldId":"10000000-0000-4000-a000-000000000000","name":"Trapis","aliases":[],"description":"Gentle caretaker who feeds and shelters Tarbean's street children.","portraitImageId":null,"color":null,"tags":["tarbean","caretaker"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-erlus","worldId":"10000000-0000-4000-a000-000000000000","name":"Erlus","aliases":[],"description":"Tehlin justice who arrests Skarpi for heresy.","portraitImageId":null,"color":null,"tags":["tehlin"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-selitos","worldId":"10000000-0000-4000-a000-000000000000","name":"Selitos","aliases":[],"description":"Legendary ruler of Myr Tariniel who curses Lanre and founds the Amyr.","portraitImageId":null,"color":null,"tags":["legend","amyr"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-tehlu","worldId":"10000000-0000-4000-a000-000000000000","name":"Tehlu","aliases":[],"description":"Central divine figure of the Tehlin faith and the story Trapis tells.","portraitImageId":null,"color":null,"tags":["legend","tehlin"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-roent","worldId":"10000000-0000-4000-a000-000000000000","name":"Roent","aliases":[],"description":"Cealdish caravan master who carries Kvothe toward the University.","portraitImageId":null,"color":null,"tags":["merchant"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-reta","worldId":"10000000-0000-4000-a000-000000000000","name":"Reta","aliases":[],"description":"Roent's wife and partner in the caravan.","portraitImageId":null,"color":null,"tags":["merchant"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-josn","worldId":"10000000-0000-4000-a000-000000000000","name":"Josn","aliases":[],"description":"Caravan musician whose lute awakens Kvothe's buried musical self.","portraitImageId":null,"color":null,"tags":["musician"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-denna","worldId":"10000000-0000-4000-a000-000000000000","name":"Denna","aliases":["Dianne","Dinnah","Dyane"],"description":"Elusive singer and Kvothe's recurring love, living under shifting names.","portraitImageId":null,"color":"#db2777","tags":["musician","love-interest"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-simmon","worldId":"10000000-0000-4000-a000-000000000000","name":"Simmon","aliases":["Sim"],"description":"Warm-hearted University student and one of Kvothe's closest friends.","portraitImageId":null,"color":null,"tags":["student","friend"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-wilem","worldId":"10000000-0000-4000-a000-000000000000","name":"Wilem","aliases":["Wil"],"description":"Cealdish University student and one of Kvothe's closest friends.","portraitImageId":null,"color":null,"tags":["student","friend"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-ambrose","worldId":"10000000-0000-4000-a000-000000000000","name":"Ambrose Jakis","aliases":[],"description":"Wealthy, vindictive student whose rivalry with Kvothe repeatedly turns dangerous.","portraitImageId":null,"color":null,"tags":["student","antagonist"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-devi","worldId":"10000000-0000-4000-a000-000000000000","name":"Devi","aliases":["Devi the Demon"],"description":"Expelled arcanist and formidable moneylender who finances Kvothe.","portraitImageId":null,"color":null,"tags":["moneylender","arcanist"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-auri","worldId":"10000000-0000-4000-a000-000000000000","name":"Auri","aliases":[],"description":"Secretive young woman living in the Underthing who befriends Kvothe.","portraitImageId":null,"color":null,"tags":["underthing","friend"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-elodin","worldId":"10000000-0000-4000-a000-000000000000","name":"Master Elodin","aliases":[],"description":"Eccentric Master Namer who recognizes Kvothe's potential.","portraitImageId":null,"color":null,"tags":["master","namer"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-kilvin","worldId":"10000000-0000-4000-a000-000000000000","name":"Master Kilvin","aliases":[],"description":"Master Artificer and Kvothe's mentor in the Fishery.","portraitImageId":null,"color":null,"tags":["master","artificer"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-lorren","worldId":"10000000-0000-4000-a000-000000000000","name":"Master Lorren","aliases":[],"description":"Master Archivist, austere guardian of the Archives.","portraitImageId":null,"color":null,"tags":["master","archivist"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-arwyl","worldId":"10000000-0000-4000-a000-000000000000","name":"Master Arwyl","aliases":[],"description":"Master Physicker and head of the Medica.","portraitImageId":null,"color":null,"tags":["master","physicker"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"