13200000000,"birthDate":null},{"id":"notw-char-josn","worldId":"10000000-0000-4000-a000-000000000000","name":"Josn","aliases":[],"description":"Caravan musician whose lute awakens Kvothe's buried musical self.","portraitImageId":null,"color":null,"tags":["musician"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000,"birthDate":null},{"id":"notw-char-kaerva","worldId":"10000000-0000-4000-a000-000000000000","name":"Kaerva","aliases":[],"description":"Trebon townsman connected to the Mauthen farm inquiry.","portraitImageId":null,"color":null,"tags":["trebon"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000,"birthDate":null},{"id":"notw-char-kilvin","worldId":"10000000-0000-4000-a000-000000000000","name":"Master Kilvin","aliases":[],"description":"Master Artificer and Kvothe's mentor in the Fishery.","portraitImageId":null,"color":null,"tags":["master","artificer"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000,"birthDate":null},{"id":"notw-char-kvothe","worldId":"10000000-0000-4000-a000-000000000000","name":"Kvothe","aliases":["Kote","Kvothe the Bloodless"],"description":"Prodigious Edema Ruh musician and arcanist who recounts his youth while hiding as an innkeeper.","portraitImageId":null,"color":"#b91c1c","tags":["protagonist","edema-ruh"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000,"birthDate":null},{"id":"notw-char-laurian","worldId":"10000000-0000-4000-a000-000000000000","name":"Laurian","aliases":["Netalia Lackless"],"description":"Kvothe's mother, a gifted performer who left nobility for the Ruh.","portraitImageId":null,"color":null,"tags":["family","edema-ruh"],"isAlive":false,"createdAt":1713200000000,"updatedAt":1713200000000,"birthDate":null},{"id":"notw-char-lorren","worldId":"10000000-0000-4000-a000-000000000000","name":"Master Lorren","aliases":[],"description":"Master Archivist, austere guardian of the Archives.","portraitImageId":null,"color":null,"tags":["master","archivist"