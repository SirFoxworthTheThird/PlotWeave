":1713200000000},{"id":"loc-tarbean-rooftops","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-tarbean","name":"Tarbean Rooftops","description":"Kvothe's precarious sleeping places above Waterside.","x":500,"y":650,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-university-courtyard","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"University Courtyard","description":"Central open space among the University's buildings.","x":820,"y":680,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-masters-hall","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Masters' Hall","description":"Admissions, disciplinary hearings, and formal business of the masters.","x":930,"y":460,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-mains","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"The Mains","description":"Lecture rooms and common academic buildings.","x":720,"y":530,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-archives","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Archives","description":"Vast library containing the Stacks, Tomes, and the mysterious Four-Plate Door.","x":1080,"y":400,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-medica","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Medica","description":"University hospital and center for the study of medicine.","x":580,"y":420,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-fishery","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Fishery","description":"Artificery workshop supervised by Kilvin.","x":540,"y":760,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-rookery","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Haven","description":"The University's asylum, commonly called the Rookery.","x":1250,"y":420,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-underthing","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"The Underthing","description":"Ancient network of tunnels and forgotten rooms beneath the University.","x":900,"y":1030,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-underthing-entrance","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Underthing Entrance","description":"Concealed access point used by Auri and Kvothe.","x":760,"y":900,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-house-of-wind","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"House of the Wind","description":"Roof above the University where Elodin teaches Kvothe to listen.","x":1190,"y":250,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-stonebridge","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Stonebridge","description":"Ancient bridge crossing the Omethi between the University and Imre.","x":1020,"y":720,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-imre","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"Imre","description":"Town of musicians, patrons, and fashionable society across the river.","x":1350,"y":780,"factionId":null,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"loc-eolian","worldId":"10000000-0000-4000-a000-000000000000","mapLayerId":"notw-map-university","name":"The Eolian","description":"Imre's celebrated music venue, where musicians earn silver ta