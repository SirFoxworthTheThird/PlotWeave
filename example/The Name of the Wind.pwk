{"version":7,"type":"data","exportedAt":1776284698287,"world":{"id":"10000000-0000-4000-a000-000000000000","name":"The Name of the Wind","description":"The autobiography of Kvothe, told over three days to Chronicler at the Waystone Inn.","coverImageId":null,"createdAt":1713200000000,"updatedAt":1713200000000,"continuityStaleThreshold":5},"mapLayers":[{"id":"notw-map-temerant","worldId":"10000000-0000-4000-a000-000000000000","parentMapId":null,"name":"Temerant","description":"Regional map of the Four Corners of Civilization, supporting the routes between the troupe, Tarbean, the University, Newarre, and Trebon.","imageId":"notw-map-image","imageWidth":2048,"imageHeight":1536,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-map-waystone","worldId":"10000000-0000-4000-a000-000000000000","parentMapId":"notw-map-temerant","name":"Newarre and the Waystone Inn","description":"Frame-story locations in and around Newarre.","imageId":"notw-map-image","imageWidth":2048,"imageHeight":1536,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-map-tarbean","worldId":"10000000-0000-4000-a000-000000000000","parentMapId":"notw-map-temerant","name":"Tarbean","description":"Kvothe's years in the divided city of Tarbean.","imageId":"notw-map-image","imageWidth":2048,"imageHeight":1536,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":null,"levelIndex":0,"levelLabel":"","createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-map-university","worldId":"10000000-0000-4000-a000-000000000000","parentMapId":"notw-map-temerant","name":"The University and Imre","description":"The University, the Omethi River, Stonebridge, and neighboring Imre.","imageId":"notw-map-image","imageWidth":2048,"imageHeight":1536,"scalePixelsPerUnit":null,"scaleUnit":null,"levelGroupId":n