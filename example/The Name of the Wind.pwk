rienced guide to its customs.","portraitImageId":null,"color":null,"tags":["student"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-sovoy","worldId":"10000000-0000-4000-a000-000000000000","name":"Sovoy","aliases":[],"description":"Modegan student who socializes with Kvothe, Simmon, and Wilem.","portraitImageId":null,"color":null,"tags":["student"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-deoch","worldId":"10000000-0000-4000-a000-000000000000","name":"Deoch","aliases":[],"description":"Former lover of Denna and doorman at the Eolian.","portraitImageId":null,"color":null,"tags":["eolian"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-stanchion","worldId":"10000000-0000-4000-a000-000000000000","name":"Stanchion","aliases":[],"description":"Co-owner and master of ceremonies at the Eolian.","portraitImageId":null,"color":null,"tags":["eolian"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-threpe","worldId":"10000000-0000-4000-a000-000000000000","name":"Count Threpe","aliases":[],"description":"Imre patron who tries to find Kvothe a wealthy sponsor.","portraitImageId":null,"color":null,"tags":["patron"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-anker","worldId":"10000000-0000-4000-a000-000000000000","name":"Anker","aliases":[],"description":"Innkeeper who later rents Kvothe a room in Imre.","portraitImageId":null,"color":null,"tags":["innkeeper"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-kaerva","worldId":"10000000-0000-4000-a000-000000000000","name":"Kaerva","aliases":[],"description":"Trebon townsman connected to the Mauthen farm inquiry.","portraitImageId":null,"color":null,"tags":["trebon"],"isAlive":true,"createdAt":1713200000000,"updatedAt":1713200000000},{"id":"notw-char-schiem","worldId":"10000000-0000-4000-a000-000000000