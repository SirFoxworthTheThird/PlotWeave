1785115320805,"wordGoal":null},{"id":"wmf-chapter-28","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":28,"title":"Kindling","synopsis":"At the University and in Imre, Kvothe advances his studies and rivalries through Kindling.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-29","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":29,"title":"Stolen","synopsis":"Kvothe breaks into Ambrose's rooms and recovers Denna's stolen ring.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-30","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":30,"title":"More Than Salt","synopsis":"At the University and in Imre, Kvothe advances his studies and rivalries through More Than Salt.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-31","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":31,"title":"The Crucible","synopsis":"Believing Devi may possess his blood, Kvothe confronts her and loses a fierce sympathy duel.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-32","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":32,"title":"Blood and Ash","synopsis":"At the University and in Imre, Kvothe advances his studies and rivalries through Blood and Ash.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-33","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":33,"title":"Fire","synopsis":"Kvothe and his friends destroy the mommet Ambrose used to 