apters":[{"id":"wmf-chapter-0","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-waystone","number":0,"title":"Prologue: A Silence of Three Parts","synopsis":"Dawn approaches the silent Waystone while Kote lies awake and Bast moves quietly below.","notes":"Frame narrative at the Waystone Inn.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-1","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-waystone","number":1,"title":"Apple and Elderberry","synopsis":"Kote and Bast prepare the inn after the skin dancer attack, and Graham brings supplies and grim news.","notes":"Frame narrative at the Waystone Inn.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-2","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-waystone","number":2,"title":"Holly","synopsis":"Bast returns with protective holly, Chronicler joins breakfast, and Kote tries to dissuade Aaron from enlisting.","notes":"Frame narrative at the Waystone Inn.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-3","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":3,"title":"Luck","synopsis":"Kvothe draws an admissions slot, learns of Elodin's naming class from Fela, and trades places with Wilem.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-4","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":4,"title":"Tar and Tin","synopsis":"Kvothe builds deck lamps, visits Auri, and uses the Underthing to enter the Archives in secret.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-5","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":5,"title":"The Eolian","synopsis":"Kvothe joins Simmon, Wilem, and Manet at the Eolian and finds Denna with Lord Kellin.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-6","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":6,"title":"Love","synopsis":"Kvothe performs a musical joke at the Eolian while Threpe continues seeking him a patron.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-7","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":7,"title":"Admissions","synopsis":"Ambrose doses Kvothe with a plum bob; Simmon steadies him and Fela helps delay his admissions interview.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-8","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":8,"title":"Questions","synopsis":"Kvothe suffers the plum bob's aftereffects and confronts Elodin, who responds by setting fire to Hemme's rooms.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-9","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":9,"title":"A Civil Tongue","synopsis":"Kvothe faces the Masters while the plum bob drives him into a furious exchange with Hemme.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-10","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":10,"title":"Being Treasured","synopsis":"Kvothe visits Denna, borrows tuition money from Devi, and struggles to keep his finances intact.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-11","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":11,"title":"Haven","synopsis":"Auri offers Kvothe sanctuary, and Elodin discovers her secret before admitting Kvothe to naming class.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-12","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":12,"title":"The Sleeping Mind","synopsis":"Elodin begins his strange instruction in naming and assigns a deliberately impossible reading list.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-13","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":13,"title":"The Hunt","synopsis":"Kvothe, Simmon, and Wilem hunt through the Archives for Elodin's obscure books.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-14","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":14,"title":"The Hidden City","synopsis":"Kvothe searches the Archives for the Chandrian but finds Denna gone from Imre.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-15","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":15,"title":"Interesting Fact","synopsis":"Fela wins Elodin's contest, and Kvothe sees Denna walking with Ambrose.","notes":"university arc of Kvothe's narrated past.","createdAt":1785115320805,"updatedAt":1785115320805,"wordGoal":null},{"id":"wmf-chapter-16","worldId":"ag5-SfCGAP0HIVKimJBe7","timelineId":"wmf-timeline-kvothe-story","number":16,"title":"Unspoken Fear","synopsis":"Kvothe's research confirms that even scholars avoid speaking openly about the Chandrian.","note