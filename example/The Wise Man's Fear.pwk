805},{"id":"wmf-fact-cthaeh-amyr","worldId":"ag5-SfCGAP0HIVKimJBe7","title":"The Maer has come close to the Amyr","description":"The Cthaeh claims Alveron has unknowingly approached the hidden Amyr.","tags":[],"readerLearnsAtEventId":"wmf-event-104","originEventId":"wmf-event-104","createdAt":1785115320805,"updatedAt":1785115320805},{"id":"wmf-fact-rhinta","worldId":"ag5-SfCGAP0HIVKimJBe7","title":"The Adem know names of the Rhinta","description":"Shehyn preserves an account whose names and signs align with the Chandrian.","tags":[],"readerLearnsAtEventId":"wmf-event-128","originEventId":"wmf-event-128","createdAt":1785115320805,"updatedAt":1785115320805},{"id":"wmf-fact-meluan","worldId":"ag5-SfCGAP0HIVKimJBe7","title":"Meluan belongs to Kvothe's maternal family","description":"Meluan's lost older sister and Lackless heritage connect her to Kvothe's mother.","tags":[],"readerLearnsAtEventId":"wmf-event-139","originEventId":"wmf-event-139","createdAt":1785115320805,"updatedAt":1785115320805},{"id":"wmf-fact-false-ruh","worldId":"ag5-SfCGAP0HIVKimJBe7","title":"Alleg's troupe are not Edema Ruh","description":"The troupe uses Ruh customs as a disguise while committing kidnapping and murder.","tags":[],"readerLearnsAtEventId":"wmf-event-131","originEventId":"wmf-event-131","createdAt":1785115320805,"updatedAt":1785115320805},{"id":"wmf-fact-kote-ketan","worldId":"ag5-SfCGAP0HIVKimJBe7","title":"Kote still remembers the Ketan","description":"After the second day of narration, Kote privately performs a perfect Adem step.","tags":[],"readerLearnsAtEventId":"wmf-event-153","originEventId":"wmf-event-153","createdAt":1785115320805,"updatedAt":1785115320805}],"knowledgeReveals":[{"id":"wmf-reveal-0-0","worldId":"ag5-SfCGAP0HIVKimJBe7","factId":"wmf-fact-caudicus","characterId":"yESmakRTZSWXPm8qKw-Ru","eventId":"wmf-event-61","note":"Kvothe knows this by the end of Deadnettle.","createdAt":1785115320805,"updatedAt":1785115320805},{"id":"wmf-reveal-0-1","worldId":"ag5-SfCGAP0H